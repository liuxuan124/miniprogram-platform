@import "/styles/warm-theme.wxss";

/* 对齐 prototypes-warm/order.html ④ 订单详情 */

.od {
  padding-bottom: 32rpx;
}

.od-stbar {
  margin: 28rpx 32rpx 0;
  border-radius: 36rpx;
  padding: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #7c2d12, #b45309);
  box-shadow: 0 16rpx 40rpx rgba(124, 45, 18, 0.22);
}

.od-stbar__title {
  font-size: 34rpx;
  font-weight: 770;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.od-stbar__ico {
  font-size: 30rpx;
}

.od-stbar__desc {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.65;
  opacity: 0.84;
}

.od-card {
  margin: 24rpx 32rpx 0;
  border-radius: 36rpx;
  background: var(--sheet);
  box-shadow: var(--shadow-s);
  overflow: hidden;
}

.od-addr {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 30rpx;
}

.od-addr__ico {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  margin-top: 4rpx;
}

.od-addr__body {
  flex: 1;
  min-width: 0;
}

.od-addr__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.od-addr__name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.od-addr__phone {
  font-size: 26rpx;
  color: var(--ink-2);
}

.od-addr__detail {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.45;
}

.od-goods {
  padding: 28rpx 30rpx;
}

.od-goods__row {
  display: flex;
  gap: 24rpx;
}

.od-goods__row + .od-goods__row {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.od-goods__im {
  width: 124rpx;
  height: 124rpx;
  border-radius: 22rpx;
  flex: none;
  background: var(--sheet-2);
}

.od-goods__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.od-goods__name {
  font-size: 28rpx;
  font-weight: 720;
  color: var(--ink);
  line-height: 1.42;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.od-goods__sub {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--mute);
}

.od-goods__btm {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.od-goods__pr {
  font-size: 30rpx;
  font-weight: 820;
  color: var(--brand);
}

.od-goods__qty {
  font-size: 22rpx;
  color: var(--mute);
}

.od-total {
  padding: 12rpx 30rpx 24rpx;
}

.od-total__li {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  font-size: 25rpx;
  color: var(--ink-2);
}

.od-total__v {
  margin-left: auto;
  font-weight: 640;
  color: var(--ink);
}

.od-total__v.cut {
  color: var(--brand);
  font-weight: 740;
}

.od-total__sum {
  margin-top: 12rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed var(--line);
  display: flex;
  align-items: baseline;
}

.od-total__sum text:first-child {
  font-size: 25rpx;
  color: var(--ink-2);
}

.od-total__pay {
  margin-left: auto;
  font-size: 42rpx;
  font-weight: 820;
  color: var(--brand);
}

.od-total__yen {
  font-size: 24rpx;
  font-weight: 820;
}

.od-kv {
  padding: 12rpx 30rpx 24rpx;
}

.od-kv__li {
  display: flex;
  padding: 18rpx 0;
  font-size: 25rpx;
}

.od-kv__k {
  width: 148rpx;
  flex: none;
  color: var(--mute);
}

.od-kv__v {
  flex: 1;
  color: var(--ink);
  word-break: break-all;
  line-height: 1.45;
}

.od-kv__cp {
  color: var(--brand);
  font-weight: 680;
  margin-left: 14rpx;
}

.od-links__li {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 30rpx;
  border-top: 1rpx solid var(--line);
  font-size: 27rpx;
}

.od-links__li:first-child {
  border-top: 0;
}

.od-links__k {
  color: var(--ink);
  font-weight: 640;
}

.od-links__v {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--mute);
  font-weight: 400;
}

.od-links__ar {
  color: #ccb49c;
  margin-left: 8rpx;
}

.od-refund {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  border: 1rpx dashed #e3c9a8;
  background: #fffdf9;
  font-size: 21rpx;
  line-height: 1.75;
  color: var(--ink-2);
}

.od-refund__b {
  color: var(--brand);
  font-weight: 700;
}

.od-btn {
  height: 88rpx;
  padding: 0 36rpx;
  box-sizing: border-box;
}

.od-btn--grow {
  flex: 1;
}

.od-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 10, 4, 0.42);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.od-panel {
  width: 600rpx;
  background: var(--sheet);
  border-radius: 32rpx;
  padding: 40rpx;
}

.od-panel__title {
  font-size: 32rpx;
  color: var(--ink);
  font-weight: 700;
  text-align: center;
  display: block;
  margin-bottom: 24rpx;
}

.od-panel__input {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: var(--bg);
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.od-panel__btns {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.od-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-size: 28rpx;
  color: var(--mute);
  background: var(--bg);
}
