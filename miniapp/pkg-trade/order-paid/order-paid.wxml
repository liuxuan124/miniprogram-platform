<!-- pkg-trade/order-paid/order-paid.wxml — 支付成功 / 支付未完成 -->
<page-meta page-style="{{themePageStyle}}" />
<view class="paid-page" wx:if="{{!payFailed}}">
  <view class="hero okhero">
    <view class="ok ring">{{paymentConfirmed ? '✓' : '…'}}</view>
    <view class="title warm-serif">{{paymentConfirmed ? '支付成功' : '正在确认支付结果'}}</view>
    <view class="sub" wx:if="{{!paymentConfirmed}}">请稍候，系统正在同步订单状态</view>
    <view class="sub" wx:elif="{{isVirtualDelivery}}">¥{{payAmount}} 已支付 · 阅读权限已开通
订单号 {{orderNo}}</view>
    <view class="sub" wx:elif="{{isDigital}}">订单已付款，商家发货后可在订单详情查看</view>
    <view class="sub" wx:elif="{{isService}}">服务订单已付款，请按预约安排使用服务</view>
    <view class="sub" wx:else>订单已付款，商家将尽快安排发货</view>
  </view>

  <view class="actions okbtns">
    <view class="btn btn-o" bindtap="goOrders">查看订单</view>
    <view class="btn btn-p" bindtap="goResources" wx:if="{{isVirtualDelivery && paymentConfirmed}}">立即阅读</view>
    <view class="btn btn-p" bindtap="goOrderDetail" wx:elif="{{isDigital}}">{{paymentConfirmed ? '查看订单详情' : '确认中'}}</view>
    <view class="btn btn-p" bindtap="goAppointments" wx:elif="{{isService}}">查看预约</view>
    <view class="btn btn-p" bindtap="goOrderDetail" wx:else>查看详情</view>
  </view>

  <view class="unlock card" wx:if="{{isVirtualDelivery && paymentConfirmed}}">
    <view class="unlock__h">本次解锁</view>
    <view class="unlock__li"><text class="ck">✓</text>《{{productName || '已购内容'}}》全 12 章在线阅读</view>
    <view class="unlock__li"><text class="ck">✓</text>EPUB / PDF 可转发保存到微信</view>
    <view class="unlock__li"><text class="ck">✓</text>随书资料包 3 份已存入资料库</view>
  </view>

  <view class="invite" wx:if="{{paymentConfirmed}}" bindtap="goShare">
    <view class="invite__h">把它分享给朋友 🎁</view>
    <view class="invite__p">好友通过你的分享首次进入，双方各得 7 天会员。你已邀请 {{inviteCount || 3}} 人，累计 {{inviteDays || 21}} 天。</view>
    <view class="invite__b2">生成分享海报</view>
  </view>

  <view class="card receipt" wx:if="{{orderNo}}">
    <view class="row"><text>订单号</text><text>{{orderNo}}</text></view>
    <view class="row"><text>实付金额</text><text class="price">¥{{payAmount}}</text></view>
    <view class="row"><text>商品</text><text class="ellipsis">{{productName}}</text></view>
  </view>

  <view class="card links">
    <view class="link-row" bindtap="goJoin"><text>👥 加入读者群</text><text class="mute">更新第一时间通知 ›</text></view>
    <view class="link-row" bindtap="goService"><text>💬 联系客服</text><text class="mute">解锁异常找我 ›</text></view>
  </view>

  <view class="card reward" wx:if="{{rewardText}}" bindtap="goCoupons">
    <text class="ic">🎁</text>
    <view class="txt">
      <view class="t">支付成功奖励</view>
      <view class="d">{{rewardText}}</view>
    </view>
    <text class="go">去查看 ›</text>
  </view>

  <view class="sec" wx:if="{{recs.length}}">
    <view class="sec-h">买了这份的人还在看</view>
    <view class="recs">
      <view wx:for="{{recs}}" wx:key="id" class="rec" data-id="{{item.id}}" bindtap="goProduct">
        <image src="{{item.cover}}" mode="aspectFill" />
        <view class="n">{{item.name}}</view>
        <view class="p">¥{{item.price}}</view>
      </view>
    </view>
  </view>
</view>

<!-- ⑤ 支付失败 / 未完成 — 对齐 states.html -->
<view class="paid-page payfail" wx:else>
  <view class="failbox">
    <view class="failbox__ring">!</view>
    <view class="failbox__h">支付未完成</view>
    <view class="failbox__p">订单已保留，<text class="brand">15 分钟内</text>可继续支付
超时后将自动关闭，需重新下单</view>
    <view class="failbox__code">订单号 {{orderNo || '—'}}
错误码 {{failCode}} · {{failReason}}</view>
    <view class="failbox__btns">
      <view class="btn btn-ghost" bindtap="goLater">稍后再说</view>
      <view class="btn btn-p" bindtap="goPayAgain">继续支付</view>
    </view>
  </view>
  <view class="reasons">
    <view class="reasons__li"><text class="b">余额不足</text>：换一张银行卡或先充值零钱</view>
    <view class="reasons__li"><text class="b">已扣款但未开通</text>：通常 1 分钟内自动同步，可下拉刷新；仍未到账请联系客服并提供订单号</view>
    <view class="reasons__li"><text class="b">重复支付</text>：系统会自动识别并原路退回多付部分</view>
  </view>
  <view class="svc-link" bindtap="goService">💬 找客服核实订单 ›</view>
</view>
<login-sheet id="global-login-sheet" />
