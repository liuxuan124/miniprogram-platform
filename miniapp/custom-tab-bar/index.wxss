/* 原生式底部导航：完整承接安全区，当前项以轻量胶囊突出 */

.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 10rpx 22rpx env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid rgba(224, 229, 239, 0.92);
  box-shadow: 0 -10rpx 30rpx rgba(28, 43, 76, 0.07);
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  height: 98rpx;
}

.tab-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 50rpx;
  border-radius: 999rpx;
  transition: background 0.18s ease;
}

.tab-item.active .tab-icon-shell {
  background: rgba(0, 47, 167, 0.1);
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.86;
}

.tab-item.active .tab-icon {
  opacity: 1;
  transform: scale(1.04);
}

.tab-text {
  max-width: 100rpx;
  margin-top: 2rpx;
  overflow: hidden;
  color: #7c879d;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-item.active .tab-text {
  color: #002FA7;
  font-weight: 700;
}
