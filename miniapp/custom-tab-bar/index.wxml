<view
  class="tab-bar"
  style="background-color: {{backgroundColor}};"
>
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image
      class="tab-icon"
      src="{{selected === index ? item.selectedIcon : item.icon}}"
      mode="aspectFit"
    />
    <view
      class="tab-text"
      style="color: {{selected === index ? activeColor : inactiveColor}};"
    >{{item.text}}</view>
  </view>
</view>
