<view
  class="tab-bar"
  style="background-color: {{backgroundColor}};"
>
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    style="color: {{selected === index ? activeColor : inactiveColor}};"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view
      class="tab-icon"
      style="{{selected === index ? 'background-color: rgba(47,91,255,0.10);' : ''}}"
    >{{item.icon}}</view>
    <view
      class="tab-text"
      style="color: {{selected === index ? activeColor : inactiveColor}};"
    >{{item.text}}</view>
  </view>
</view>
