/* app.wxss — 极简主义全局 Token */

page {
  --brand: #111111;
  --brand-soft: #f3f3f3;
  --brand-muted: #666666;
  --ink: #111111;
  --ink-2: #333333;
  --ink-3: #888888;
  --ink-4: #bbbbbb;
  --line: #eeeeee;
  --line-2: #f5f5f5;
  --bg: #fafafa;
  --card: #ffffff;
  --ok: #111111;
  --warn: #d14343;
  --wx: #07c160;
  --r: 16rpx;
  --r-s: 12rpx;
  --r-l: 24rpx;
  --sh1: none;
  --sh2: none;

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--ink);
  background-color: var(--bg);
  box-sizing: border-box;
  letter-spacing: 0;
}

view, text, image, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.page-wrapper {
  min-height: 100vh;
  background-color: var(--bg);
}

/* 极简按钮 */
.btn-p {
  background: var(--ink);
  color: #fff;
  box-shadow: none;
}
.btn-g {
  background: var(--brand-soft);
  color: var(--ink);
}
.btn-o {
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
}

.text-brand { color: var(--ink); }
.text-accent { color: var(--ink); }
.bg-brand-50 { background: var(--brand-soft); }

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.text-center {
  text-align: center;
}

.text-primary {
  color: var(--ink);
}

.text-secondary {
  color: var(--ink-3);
}

.text-danger {
  color: var(--warn);
}

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

.card {
  background-color: var(--card);
  border-radius: var(--r);
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--line);
  box-shadow: none;
}

.btn-primary {
  background-color: var(--ink);
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-weight: 500;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.82;
}

.divider {
  height: 1rpx;
  background-color: var(--line);
  margin: 24rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state__icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  opacity: 0.35;
}

.empty-state__text {
  font-size: 26rpx;
  color: var(--ink-3);
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
