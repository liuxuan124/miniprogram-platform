/* app.wxss — 出海笔记 Design System 2.0 */

page {
  --brand: #C2410C;
  --brand-dark: #9A3412;
  --brand-soft: #FDE8D8;
  --brand-muted: #C47A52;
  --brand-50: #FDE8D8;
  --brand-100: #FBD5B8;
  --accent: #EA580C;
  --ink: #292524;
  --ink-2: #57534E;
  --ink-3: #78716C;
  --ink-4: #A8A29E;
  --line: #ECD9C4;
  --line-2: #F5E6D4;
  --bg: #FDF6EC;
  --card: #FFFAF3;
  --ok: #0aaa75;
  --warn: #f05b5b;
  --gold: #D97706;
  --wx: #07c160;
  --r: 24rpx;
  --r-s: 16rpx;
  --r-l: 32rpx;
  --sh1: 0 8rpx 28rpx rgba(140, 80, 30, 0.07);
  --sh2: 0 18rpx 48rpx rgba(140, 80, 30, 0.11);

  width: 100%;
  max-width: 100%;
  /* 勿设 overflow-x:hidden：会隐式变成裁切容器，导航负 margin 叠在头图上会被裁掉 */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--ink);
  background: var(--bg);
  box-sizing: border-box;
  letter-spacing: 0;
}

view, text, image, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.page-wrapper {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  background-color: var(--bg);
  box-sizing: border-box;
}

/* 通用按钮 */
.btn-p {
  background: linear-gradient(135deg, var(--brand), #EA580C);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(194, 65, 12, 0.22);
}
.btn-g {
  background: var(--brand-soft);
  color: var(--ink);
}
.btn-o {
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
}

.text-brand { color: var(--brand); }
.text-accent { color: var(--brand); }
.bg-brand-50 { background: var(--brand-soft); }

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.text-center {
  text-align: center;
}

.text-primary {
  color: var(--ink);
}

.text-secondary {
  color: var(--ink-3);
}

.text-danger {
  color: var(--warn);
}

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

.card {
  background-color: var(--card);
  border-radius: var(--r);
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--sh1);
}

.btn-primary {
  background: linear-gradient(135deg, var(--brand), #EA580C);
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-weight: 500;
  box-shadow: 0 12rpx 28rpx rgba(49, 94, 251, 0.22);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.82;
}

.divider {
  height: 1rpx;
  background-color: var(--line);
  margin: 24rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state__icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  opacity: 0.35;
}

.empty-state__text {
  font-size: 26rpx;
  color: var(--ink-3);
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
