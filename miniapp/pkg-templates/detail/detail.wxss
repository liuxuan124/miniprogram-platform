.tpl-page {
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  background: #fdf6ec;
  box-sizing: border-box;
}

.tpl-empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #9a7b6a;
}

.tpl-hero {
  background: #fffaf3;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  border: 2rpx solid rgba(194, 65, 12, 0.12);
}

.tpl-hero__badges {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tpl-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(148, 163, 184, 0.2);
  color: #64748b;
}

.tpl-badge--live {
  background: rgba(194, 65, 12, 0.15);
  color: #c2410c;
  font-weight: 600;
}

.tpl-hero__name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #9a3412;
  margin-bottom: 16rpx;
}

.tpl-hero__notes {
  display: block;
  font-size: 28rpx;
  line-height: 1.55;
  color: #78716c;
  margin-bottom: 16rpx;
}

.tpl-hero__meta {
  font-size: 24rpx;
  color: #a8a29e;
}

.tpl-activate {
  margin-top: 48rpx;
  background: #c2410c !important;
  color: #fff !important;
  border-radius: 999rpx !important;
  font-weight: 600;
}

.tpl-using {
  margin-top: 48rpx;
  text-align: center;
  color: #c2410c;
  font-weight: 600;
  font-size: 28rpx;
}
