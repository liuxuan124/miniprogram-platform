/* components/dsl-activity-entry/dsl-activity-entry.wxss — 活动入口组件样式 */

.dsl-activity-entry {
  width: 100%;
  box-sizing: border-box;
}

.dsl-activity-entry--card {
  padding: 0 20rpx;
}

.dsl-activity-entry--full {
  padding: 0;
}

.dsl-activity-entry__card {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 20rpx;
}

.dsl-activity-entry--full .dsl-activity-entry__card {
  border-radius: 0;
  box-shadow: none;
  margin-bottom: 0;
}

.dsl-activity-entry__cover {
  position: relative;
  width: 100%;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1769ff, #20b7ff);
  overflow: hidden;
}

.dsl-activity-entry--purple .dsl-activity-entry__cover {
  background: linear-gradient(135deg, #7c3aed, #a855f7);
}

.dsl-activity-entry--dark .dsl-activity-entry__cover {
  background: linear-gradient(135deg, #111827, #374151);
}

.dsl-activity-entry--gold .dsl-activity-entry__cover {
  background: linear-gradient(135deg, #b45309, #f59e0b);
}

.dsl-activity-entry__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.dsl-activity-entry__cover-text {
  position: relative;
  z-index: 1;
  padding: 0 24rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}

.dsl-activity-entry__info {
  padding: 20rpx 24rpx;
}

.dsl-activity-entry__title {
  font-size: 30rpx;
  color: #172033;
  font-weight: 700;
  display: block;
}

.dsl-activity-entry__subtitle {
  font-size: 22rpx;
  color: #7b8798;
  margin-top: 8rpx;
  display: block;
}

.dsl-activity-entry__meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  color: #7b8798;
  font-size: 22rpx;
}

.dsl-activity-entry__countdown {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.dsl-activity-entry__countdown-label {
  font-size: 22rpx;
  color: #999999;
  margin-right: 12rpx;
}

.dsl-activity-entry__countdown-time {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.dsl-activity-entry__quota {
  margin-top: 8rpx;
  color: #1769ff;
  font-size: 22rpx;
  font-weight: 600;
}

.dsl-activity-entry__btn {
  margin-top: 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  background: #1769ff;
  border-radius: 12rpx;
}

.dsl-activity-entry--purple .dsl-activity-entry__btn {
  background: #7c3aed;
}

.dsl-activity-entry--dark .dsl-activity-entry__btn {
  background: #111827;
}

.dsl-activity-entry--gold .dsl-activity-entry__btn {
  background: #b45309;
}

.dsl-activity-entry__list {
  width: 100%;
}

.dsl-activity-entry__list .dsl-activity-entry__card:last-child {
  margin-bottom: 0;
}
