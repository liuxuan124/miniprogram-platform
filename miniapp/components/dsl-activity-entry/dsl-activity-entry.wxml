<!--components/dsl-activity-entry/dsl-activity-entry.wxml — 活动入口组件-->
<view class="dsl-activity-entry dsl-activity-entry--{{processedConfig.theme || 'blue'}} dsl-activity-entry--{{processedConfig.style_type || 'card'}}" style="{{styleString}}">
  <view
    wx:if="{{!processedRuntimeData.length}}"
    class="dsl-activity-entry__card"
    bindtap="onTapActivity"
  >
    <view class="dsl-activity-entry__cover">
      <image
        class="dsl-activity-entry__image"
        wx:if="{{processedConfig.hasValidImage}}"
        src="{{processedConfig.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view wx:if="{{processedConfig.cover_text || !processedConfig.hasValidImage}}" class="dsl-activity-entry__cover-text">
        {{processedConfig.cover_text || ('🎪 ' + (processedConfig.title || '活动入口'))}}
      </view>
    </view>
    <view class="dsl-activity-entry__info">
      <text class="dsl-activity-entry__title" style="{{processedConfig.titleStyle}}">{{processedConfig.title || '热门活动'}}</text>
      <text class="dsl-activity-entry__subtitle" style="{{processedConfig.metaStyle}}" wx:if="{{processedConfig.subtitle}}">{{processedConfig.subtitle}}</text>
      <view class="dsl-activity-entry__meta" style="{{processedConfig.metaStyle}}" wx:if="{{processedConfig.date || processedConfig.location}}">
        <text wx:if="{{processedConfig.date}}">📅 {{processedConfig.date}}</text>
        <text wx:if="{{processedConfig.location}}">📍 {{processedConfig.location}}</text>
      </view>
      <view class="dsl-activity-entry__countdown" wx:if="{{processedConfig.countdown && countdown}}">
        <text class="dsl-activity-entry__countdown-label">距结束</text>
        <text class="dsl-activity-entry__countdown-time">{{countdown}}</text>
      </view>
      <view class="dsl-activity-entry__btn" wx:if="{{processedConfig.show_button !== false}}">{{processedConfig.button_text || '立即预约'}}</view>
    </view>
  </view>

  <view wx:else class="dsl-activity-entry__list">
    <view
      class="dsl-activity-entry__card"
      wx:for="{{processedRuntimeData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapActivity"
    >
      <view class="dsl-activity-entry__cover">
        <image
          class="dsl-activity-entry__image"
          wx:if="{{item.hasValidImage}}"
          src="{{item.displayImage}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:else class="dsl-activity-entry__cover-text">🎪 {{item.displayTitle}}</view>
      </view>
      <view class="dsl-activity-entry__info">
        <text class="dsl-activity-entry__title" style="{{processedConfig.titleStyle}}">{{item.displayTitle}}</text>
        <text class="dsl-activity-entry__subtitle" style="{{processedConfig.metaStyle}}" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
        <view class="dsl-activity-entry__meta" style="{{processedConfig.metaStyle}}" wx:if="{{item.date || item.location}}">
          <text wx:if="{{item.date}}">📅 {{item.date}}</text>
          <text wx:if="{{item.location}}">📍 {{item.location}}</text>
        </view>
        <view class="dsl-activity-entry__btn" wx:if="{{processedConfig.show_button !== false}}">{{processedConfig.button_text || '立即预约'}}</view>
      </view>
    </view>
  </view>
</view>
