/* components/dsl-renderer/dsl-renderer.wxss ??DSL ?????? */

.dsl-renderer {
  width: 100%;
}

.dsl-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 24rpx; margin-right: 24rpx;
  padding: 18rpx 20rpx;
  background: #f4f7fb;
  border: 1rpx solid #e3e8f0;
  border-radius: 16rpx;
}

.dsl-search__text {
  color: #8a94a6;
  font-size: 24rpx;
}

.dsl-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 24rpx; margin-right: 24rpx;
  padding: 14rpx 18rpx;
  background: #FFF9E6;
  border: 1rpx solid #FFE082;
  border-radius: 14rpx;
}

.dsl-notice__title {
  color: #E53935;
  font-size: 20rpx;
  font-weight: 700;
}

.dsl-notice__text {
  flex: 1;
  color: #E53935;
  font-size: 22rpx;
}

.dsl-category {
  margin-left: 24rpx; margin-right: 24rpx;
  padding: 16rpx;
  background: #fff;
  border: 1rpx solid #e6edf6;
  border-radius: 16rpx;
}

.dsl-category__title {
  margin-bottom: 12rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.dsl-category__list {
  white-space: nowrap;
}

.dsl-category__grid {
  display: grid;
  gap: 12rpx;
}

.dsl-category__grid--grid-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.dsl-category__grid--grid-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.dsl-category__grid--pill {
  display: flex;
  flex-wrap: wrap;
}

.dsl-category__item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 136rpx;
  margin-right: 12rpx;
  padding: 14rpx;
  background: #f8faff;
  border-radius: 12rpx;
}

.dsl-category__grid .dsl-category__item {
  min-width: 0;
  margin-right: 0;
}

.dsl-category__grid--pill .dsl-category__item {
  width: auto;
  min-width: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
}

.dsl-category__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto;
  font-size: 34rpx;
  background: #eef4ff;
  border-radius: 999rpx;
}

.dsl-category--icon-square .dsl-category__icon {
  border-radius: 12rpx;
}

.dsl-category--icon-plain .dsl-category__icon {
  width: auto;
  height: auto;
  background: transparent;
}

.dsl-category__icon-img {
  width: 48rpx;
  height: 48rpx;
}

.dsl-category--icon-square .dsl-category__icon-img {
  width: 42rpx;
  height: 42rpx;
}

.dsl-category--icon-plain .dsl-category__icon-img {
  width: 48rpx;
  height: 48rpx;
}

.dsl-category__name {
  margin-top: 8rpx;
  color: #475569;
  font-size: 22rpx;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dsl-category__grid--pill .dsl-category__icon,
.dsl-category__grid--pill .dsl-category__icon-img {
  display: none;
}

.dsl-category__grid--pill .dsl-category__name {
  margin-top: 0;
}

.dsl-flash {
  margin-left: 24rpx; margin-right: 24rpx;
  padding: 16rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 16rpx;
}

.dsl-flash__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dsl-flash__title {
  color: #9a3412;
  font-size: 28rpx;
  font-weight: 800;
}

.dsl-flash__tag {
  padding: 2rpx 12rpx;
  color: #fff;
  font-size: 20rpx;
  background: #ea580c;
  border-radius: 999rpx;
}

.dsl-flash__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.dsl-flash__item {
  padding: 12rpx;
  background: #fff;
  border-radius: 12rpx;
}

.dsl-flash__img {
  text-align: center;
  font-size: 36rpx;
}

.dsl-flash__name {
  margin-top: 6rpx;
  color: #475569;
  font-size: 22rpx;
}

.dsl-flash__price {
  margin-top: 4rpx;
  color: #dc2626;
  font-size: 24rpx;
  font-weight: 700;
}

.dsl-activity-list-shell {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.dsl-activity-list {
  padding: 16rpx;
  background: #fff;
  border: 1rpx solid #e6edf6;
  border-radius: 20rpx;
}

.dsl-activity-list__title {
  margin-bottom: 12rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.dsl-activity-list__item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  padding: 12rpx;
  background: #f8faff;
  border-radius: 0;
}

.dsl-activity-list__cover {
  width: 104rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  background: #eef2f7;
}

.dsl-activity-list__body {
  flex: 1;
  min-width: 0;
}

.dsl-activity-list__name {
  color: #1e293b;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dsl-activity-list__meta {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dsl-activity-list__btn {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  color: #fff;
  font-size: 20rpx;
  background: #1769ff;
  border-radius: 999rpx;
}

.dsl-service-shell {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.dsl-service {
  padding: 16rpx;
  background: #fff;
  border: 1rpx solid #e6edf6;
  border-radius: 20rpx;
}

.dsl-service__title {
  margin-bottom: 12rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.dsl-service__item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  padding: 12rpx;
  background: #f8faff;
  border-radius: 0;
}

.dsl-service__body {
  flex: 1;
  min-width: 0;
}

.dsl-service__name {
  color: #1e293b;
  font-size: 24rpx;
  font-weight: 600;
}

.dsl-service__desc {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 20rpx;
}

.dsl-service__btn {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  background: #1769ff;
  border-radius: 999rpx;
}

.dsl-ai-entry-shell {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.dsl-ai-entry {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  color: #fff;
  background: linear-gradient(135deg, #409eff, #337ecc);
  border-radius: 20rpx;
}

.dsl-ai-entry--blue {
  background: linear-gradient(135deg, #409eff, #337ecc);
}

.dsl-ai-entry--green {
  background: linear-gradient(135deg, #67c23a, #529b2e);
}

.dsl-ai-entry--purple {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
}

.dsl-ai-entry--dark {
  background: linear-gradient(135deg, #111827, #374151);
}

.dsl-ai-entry--gold {
  background: linear-gradient(135deg, #b45309, #f59e0b);
}

.dsl-ai-entry__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  overflow: hidden;
  font-size: 34rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
}

.dsl-ai-entry__avatar-img {
  width: 100%;
  height: 100%;
}

.dsl-ai-entry__info {
  flex: 1;
  min-width: 0;
}

.dsl-ai-entry__title {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dsl-ai-entry__desc {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 24rpx;
  opacity: 0.92;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dsl-brand {
  display: flex;
  gap: 24rpx;
  margin: 0;
  padding: 40rpx 32rpx 44rpx;
  color: #fff;
  background: linear-gradient(155deg, #1b1f31 0%, #2f3654 55%, #454d78 100%);
  border-radius: 0;
  box-sizing: border-box;
}
.dsl-brand--logo-top {
  flex-direction: column;
}
.dsl-brand--logo-left {
  flex-direction: row;
  align-items: flex-start;
}
.dsl-brand--logo-right {
  flex-direction: row-reverse;
  align-items: flex-start;
}
.dsl-brand--align-left {
  text-align: left;
}
.dsl-brand--align-center {
  text-align: center;
}
.dsl-brand--align-right {
  text-align: right;
}
.dsl-brand--logo-top.dsl-brand--align-center .dsl-brand__logo {
  align-self: center;
}
.dsl-brand--logo-top.dsl-brand--align-right .dsl-brand__logo {
  align-self: flex-end;
}
.dsl-brand--logo-top.dsl-brand--align-left .dsl-brand__logo {
  align-self: flex-start;
}
.dsl-brand__logo {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.12);
  display: block;
}
.dsl-brand__text {
  flex: 1;
  min-width: 0;
}
.dsl-brand__title { font-size: 36rpx; font-weight: 800; letter-spacing: -0.02em; }
.dsl-brand__subtitle { margin-top: 10rpx; font-size: 24rpx; opacity: 0.88; }
.dsl-brand__desc { margin-top: 16rpx; font-size: 26rpx; line-height: 1.7; opacity: 0.92; }
.dsl-brand__kpi { margin-top: 20rpx; font-size: 22rpx; opacity: 0.85; }

.dsl-image-text {
  display: flex;
  gap: 12rpx;
  margin-left: 24rpx; margin-right: 24rpx;
  padding: 16rpx;
  background: #fff;
  border: 1rpx solid #e6edf6;
  border-radius: 16rpx;
}

.dsl-image-text--right-image {
  flex-direction: row-reverse;
}

.dsl-image-text--top-image {
  flex-direction: column;
}

.dsl-image-text--top-image .dsl-image-text__img {
  width: 100%;
  height: 240rpx;
}

.dsl-image-text__img-real {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.dsl-image-text__img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 96rpx;
  font-size: 36rpx;
  background: #f1f5fb;
  border-radius: 12rpx;
}

.dsl-image-text__body {
  flex: 1;
}

.dsl-image-text__title {
  color: #1e293b;
  font-size: 26rpx;
  font-weight: 700;
}

.dsl-image-text__desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.6;
}

.dsl-contact-shell {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.dsl-contact {
  padding: 16rpx;
  background: #fff;
  border: 1rpx solid #e6edf6;
  border-radius: 20rpx;
}

.dsl-contact--card {
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.dsl-contact--list {
  border: none;
  border-bottom: 1rpx solid #e6edf6;
  border-radius: 0;
  box-shadow: none;
}

.dsl-contact--minimal {
  padding: 8rpx 0;
  border: none;
  background: transparent;
  box-shadow: none;
}

.dsl-contact--align-center {
  text-align: center;
}

.dsl-contact--align-center .dsl-contact__body {
  justify-content: center;
}

.dsl-contact--align-center .dsl-contact__item {
  justify-content: center;
}

.dsl-contact__title {
  margin-bottom: 10rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.dsl-contact__body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dsl-contact--layout-row .dsl-contact__body {
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
}

.dsl-contact--layout-grid .dsl-contact__body {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.dsl-contact__item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 0;
  color: #475569;
}

.dsl-contact__item--phone {
  color: #1769ff;
}

.dsl-contact__icon {
  flex-shrink: 0;
  line-height: 1.4;
}

.dsl-contact__text {
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-all;
}

.dsl-cert {
  margin-left: 24rpx; margin-right: 24rpx;
  padding: 16rpx;
  background: #fff;
  border: 1rpx solid #e6edf6;
  border-radius: 0;
}

.dsl-cert__header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: -16rpx -16rpx 16rpx;
  padding: 22rpx 28rpx 22rpx 24rpx;
  min-height: 96rpx;
  background-color: #002FA7;
  background-image: linear-gradient(90deg, rgba(0, 47, 167, 0.5) 0%, rgba(26, 75, 191, 0.22) 42%, rgba(42, 91, 201, 0.06) 100%), url('/images/section-bar-tech-bg.jpg'), linear-gradient(90deg, #002FA7 0%, #1A4BBF 52%, #2A5BC9 100%);
  background-size: cover, cover, auto;
  background-position: center, center bottom, center;
  background-repeat: no-repeat;
}

.dsl-cert__bars {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 6rpx;
  width: 18rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.dsl-cert__bar {
  width: 6rpx;
  border-radius: 2rpx;
  background: #B8D0FF;
}

.dsl-cert__bar--down {
  height: 72%;
  align-self: flex-start;
}

.dsl-cert__bar--up {
  height: 72%;
  align-self: flex-end;
}

.dsl-cert__title {
  margin: 0;
  color: #f3f7fc;
  font-size: 30rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.35);
}

.dsl-cert__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.dsl-cert__grid--cols-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.dsl-cert__item {
  padding: 0 0 12rpx;
  text-align: center;
  background: #f8faff;
  border-radius: 12rpx;
  overflow: hidden;
}

.dsl-cert__img {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 140rpx;
  font-size: 36rpx;
  background: #eef2f7;
  border-radius: 0;
}

.dsl-cert__img-real {
  width: 100%;
  height: 140rpx;
  border-radius: 0;
  display: block;
}

.dsl-cert__name {
  margin-top: 8rpx;
  padding: 0 12rpx;
  color: #475569;
  font-size: 22rpx;
  font-weight: 600;
}

.dsl-cert__desc {
  margin-top: 4rpx;
  padding: 0 12rpx;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.3;
}

.dsl-section-title {
  margin-left: 24rpx; margin-right: 24rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #1769ff;
}

.dsl-section-title--center {
  padding-left: 0;
  border-left: none;
  text-align: center;
}

.dsl-section-title__main {
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
}

.dsl-section-title__sub {
  margin-top: 4rpx;
  color: #7b8798;
  font-size: 22rpx;
}

.dsl-renderer__unknown {
  padding: 20rpx;
  background-color: #fff7e6;
  border: 1rpx dashed #ffc53d;
  border-radius: 8rpx;
  text-align: center;
}

.dsl-renderer__unknown-text {
  font-size: 24rpx;
  color: #d48806;
}

