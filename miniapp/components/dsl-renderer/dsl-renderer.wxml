<!--components/dsl-renderer/dsl-renderer.wxml — DSL 渲染引擎-->
<view
  class="dsl-renderer"
  wx:if="{{comp && comp.visible !== false}}"
>
  <!-- 品牌顶栏：必须用 block 包住自定义组件，否则部分基础库 if/elif 链会落到未知组件 -->
  <block wx:if="{{comp.type === 'brand_header'}}">
    <dsl-brand-header
      config="{{comp.props}}"
      runtimeData="{{comp.runtimeData}}"
      actions="{{comp.actions}}"
      styleString="{{comp.styleString}}"
      bind:componentevent="onComponentEvent"
    />
  </block>

  <!-- 0. 搜索组件 search -->
  <block wx:if="{{comp.type === 'search'}}">
    <view
      class="dsl-search dsl-search--{{comp.props._shape}} dsl-search--align-{{comp.props._align}} {{comp.props._sticky ? 'is-sticky' : ''}}"
      style="{{comp.props._boxStyle}}"
      bindtap="onSearchTap"
    >
      <text class="dsl-search__icon" style="color:{{comp.props._textColor}}">🔍</text>
      <text class="dsl-search__text" style="color:{{comp.props._textColor}}">{{comp.props._phText}}</text>

      <!-- 右侧附加交互 -->
      <text
        wx:if="{{comp.props._rightAction === 'button'}}"
        class="dsl-search__btn"
        style="color:{{comp.props._btnColor}}"
        catchtap="onSearchActionTap"
      >{{comp.props._rightActionText}}</text>
      <text
        wx:elif="{{comp.props._rightAction === 'scan'}}"
        class="dsl-search__ico"
        style="color:{{comp.props._textColor}}"
        catchtap="onSearchActionTap"
      >⌗</text>
      <text
        wx:elif="{{comp.props._rightAction === 'category'}}"
        class="dsl-search__ico"
        style="color:{{comp.props._textColor}}"
        catchtap="onSearchActionTap"
      >☰</text>
    </view>

    <!-- 弹窗搜索：tap_target = popup 时在当前页浮层内直接搜 -->
    <view wx:if="{{popupSearchOpen}}" class="dsl-search-popup" catchtap="noop">
      <view class="dsl-search-popup__mask" bindtap="closePopupSearch"></view>
      <view class="dsl-search-popup__panel" style="background:{{comp.props._bgColor}}">
        <view class="dsl-search-popup__head">
          <text class="dsl-search-popup__title" style="color:{{comp.props._textColor}}">搜索 · {{comp.props._scopeText}}</text>
          <text class="dsl-search-popup__close" bindtap="closePopupSearch">✕</text>
        </view>
        <input
          class="dsl-search-popup__input"
          style="color:{{comp.props._textColor}};background:{{comp.props._bgColor}}"
          focus="{{popupSearchOpen}}"
          confirm-type="search"
          placeholder="{{comp.props._phText}}"
          value="{{popupKeyword}}"
          bindinput="onPopupKeywordInput"
          bindconfirm="doPopupSearch"
        />
      </view>
    </view>
  </block>

  <!-- 0. 公告栏 notice_bar -->
  <dsl-notice-bar
    wx:elif="{{comp.type === 'notice_bar'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    styleString="{{comp.styleString}}"
  />

  <!-- 0. 分类导航 category_nav -->
  <view
    wx:elif="{{comp.type === 'category_nav'}}"
    class="dsl-category dsl-category--surface-{{comp.props._surface}} dsl-category--shape-{{comp.props._iconShape}}"
    style="{{comp.styleString}}"
  >
    <!-- showTitle=false 时整行不渲染 -->
    <view wx:if="{{comp.props._showTitle && comp.props._title}}" class="dsl-category__title">
      {{comp.props._title}}
    </view>

    <!-- 固定网格 -->
    <view
      wx:if="{{comp.props._layout === 'grid'}}"
      class="dsl-category__grid"
      style="grid-template-columns: repeat({{comp.props._columns}}, minmax(0, 1fr));"
    >
      <view
        wx:for="{{comp.props._items}}"
        wx:key="id"
        class="dsl-category__item"
        data-link="{{item.link_url}}"
        bindtap="onQuickNavigate"
      >
        <view
          class="dsl-category__icon"
          style="border-radius:{{comp.props._iconRadius}}rpx;{{comp.props._iconShape === 'none' ? 'background:transparent;' : ''}}"
        >
          <image wx:if="{{item.isImage}}" class="dsl-category__icon-img" src="{{item.icon}}" mode="aspectFit" />
          <text wx:else class="dsl-category__icon-emoji">{{item.icon || '📌'}}</text>
          <text wx:if="{{item.badge}}" class="dsl-category__badge" style="background:{{item.badgeColor}}">{{item.badge}}</text>
        </view>
        <text class="dsl-category__name" style="color:{{comp.props._titleColor}}">{{item.title || '分类'}}</text>
        <text
          wx:if="{{item.subtitle}}"
          class="dsl-category__sub"
          style="color:{{comp.props._subtitleColor}};font-size:{{comp.props._subtitleSize}}rpx;"
        >{{item.subtitle}}</text>
      </view>
    </view>

    <!-- 单行横滑 -->
    <scroll-view
      wx:elif="{{comp.props._layout === 'scroll'}}"
      class="dsl-category__scroll"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="dsl-category__scroll-inner">
        <view
          wx:for="{{comp.props._items}}"
          wx:key="id"
          class="dsl-category__item dsl-category__item--fixed"
          data-link="{{item.link_url}}"
          bindtap="onQuickNavigate"
        >
          <view
            class="dsl-category__icon"
            style="border-radius:{{comp.props._iconRadius}}rpx;{{comp.props._iconShape === 'none' ? 'background:transparent;' : ''}}"
          >
            <image wx:if="{{item.isImage}}" class="dsl-category__icon-img" src="{{item.icon}}" mode="aspectFit" />
            <text wx:else class="dsl-category__icon-emoji">{{item.icon || '📌'}}</text>
            <text wx:if="{{item.badge}}" class="dsl-category__badge" style="background:{{item.badgeColor}}">{{item.badge}}</text>
          </view>
          <text class="dsl-category__name" style="color:{{comp.props._titleColor}}">{{item.title || '分类'}}</text>
          <text
            wx:if="{{item.subtitle}}"
            class="dsl-category__sub"
            style="color:{{comp.props._subtitleColor}};font-size:{{comp.props._subtitleSize}}rpx;"
          >{{item.subtitle}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 双行分页滑动：内层横向 scroll-view，每页宽度 = 100% -->
    <view wx:else class="dsl-category__pager">
      <scroll-view
        class="dsl-category__pager-scroll"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        circular
        bindscroll="onCategoryPagerScroll"
      >
        <view class="dsl-category__pager-track">
          <!-- 🔴 分页切片在 JS 里算好（_pageGroups 是二维数组），不在 WXML 里写 index 比较：
               嵌套 wx:for 会让内层 index 覆盖外层，且 item0 不是 WXML 合法变量，
               那种写法在小程序端静默不渲染。此处只做纯遍历。 -->
          <view
            wx:for="{{comp.props._pageGroups}}"
            wx:for-item="pageItems"
            wx:key="pageKey"
            class="dsl-category__page"
            style="grid-template-columns: repeat({{comp.props._pageColumns}}, minmax(0, 1fr));"
          >
            <view
              wx:for="{{pageItems}}"
              wx:for-item="item"
              wx:key="id"
              class="dsl-category__item"
              data-link="{{item.link_url}}"
              bindtap="onQuickNavigate"
            >
              <view
                class="dsl-category__icon"
                style="border-radius:{{comp.props._iconRadius}}rpx;{{comp.props._iconShape === 'none' ? 'background:transparent;' : ''}}"
              >
                <image wx:if="{{item.isImage}}" class="dsl-category__icon-img" src="{{item.icon}}" mode="aspectFit" />
                <text wx:else class="dsl-category__icon-emoji">{{item.icon || '📌'}}</text>
                <text wx:if="{{item.badge}}" class="dsl-category__badge" style="background:{{item.badgeColor}}">{{item.badge}}</text>
              </view>
              <text class="dsl-category__name" style="color:{{comp.props._titleColor}}">{{item.title || '分类'}}</text>
              <text
                wx:if="{{item.subtitle}}"
                class="dsl-category__sub"
                style="color:{{comp.props._subtitleColor}};font-size:{{comp.props._subtitleSize}}rpx;"
              >{{item.subtitle}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{comp.props._pages > 1}}" class="dsl-category__dots">
        <view
          wx:for="{{comp.props._pages}}"
          wx:key="*this"
          class="dsl-category__dot {{index === categoryPagerIndex ? 'is-on' : ''}}"
        ></view>
      </view>
    </view>
  </view>

  <!-- 1. 轮播图 banner -->
  <dsl-banner
    wx:elif="{{comp.type === 'banner'}}"
    config="{{comp.props}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 2. 导航宫格 nav -->
  <dsl-nav
    wx:elif="{{comp.type === 'nav'}}"
    config="{{comp.props}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 3. 单图 image -->
  <dsl-image
    wx:elif="{{comp.type === 'image'}}"
    config="{{comp.props}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 4. 商品列表 product_list -->
  <dsl-product-list
    wx:elif="{{comp.type === 'product_list'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    dataSource="{{comp.dataSource}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 4. 限时秒杀 flash_sale -->
  <dsl-flash-sale
    wx:elif="{{comp.type === 'flash_sale'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    styleString="{{comp.styleString}}"
  />

  <!-- 4. 文章列表 article_list -->
  <dsl-article-list
    wx:elif="{{comp.type === 'article_list'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 4a. 文章流 article_feed -->
  <dsl-article-feed
    wx:elif="{{comp.type === 'article_feed'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 4a2. 笔记瀑布流 note_feed -->
  <dsl-note-feed
    wx:elif="{{comp.type === 'note_feed'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 4a3. 动态时间线 moments_feed -->
  <dsl-moments-feed
    wx:elif="{{comp.type === 'moments_feed'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 4b. 今日热门资讯 hot_news -->
  <dsl-hot-news
    wx:elif="{{comp.type === 'hot_news'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 4c. 加入群聊 join_group -->
  <dsl-join-group
    wx:elif="{{comp.type === 'join_group'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 5. 活动入口 activity_entry -->
  <dsl-activity-entry
    wx:elif="{{comp.type === 'activity_entry'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 5. 活动列表 activity_list：外壳承载背景/边距（直角），内卡可调圆角 -->
  <view
    wx:elif="{{comp.type === 'activity_list'}}"
    class="dsl-activity-list-shell"
    style="{{comp.props._shellStyle}}"
  >
    <view class="dsl-activity-list" style="{{comp.props._cardStyle}}">
      <view class="dsl-activity-list__title" style="{{comp.props._sectionTitleStyle}}">{{comp.props.title || '热门活动'}}</view>
      <view
        wx:for="{{comp.props.items || []}}"
        wx:key="index"
        class="dsl-activity-list__item"
        data-link="{{item.link_url}}"
        bindtap="onQuickNavigate"
      >
        <image
          wx:if="{{item.cover}}"
          class="dsl-activity-list__cover"
          src="{{item.cover}}"
          mode="aspectFill"
        />
        <view class="dsl-activity-list__body">
          <view class="dsl-activity-list__name" style="{{comp.props._titleStyle}}">{{item.title || '活动名称'}}</view>
          <view class="dsl-activity-list__meta" style="{{comp.props._subtitleStyle}}">
            <text wx:if="{{item.date}}">{{item.date}}</text>
            <text wx:if="{{item.date && item.location}}"> · </text>
            <text wx:if="{{item.location}}">{{item.location}}</text>
            <text wx:if="{{!item.date && !item.location}}">待定</text>
          </view>
        </view>
        <view wx:if="{{comp.props._showButton}}" class="dsl-activity-list__btn">{{comp.props._buttonText || '报名'}}</view>
      </view>
    </view>
  </view>

  <!-- 5. 预约服务 appointment_service：外壳承载背景/边距（直角），内卡可调圆角；每条独立预约按钮 -->
  <view
    wx:elif="{{comp.type === 'appointment_service'}}"
    class="dsl-service-shell"
    style="{{comp.props._shellStyle}}"
  >
    <view class="dsl-service" style="{{comp.props._cardStyle}}">
      <view class="dsl-service__title" style="{{comp.props._sectionTitleStyle}}">{{comp.props.title || '预约服务'}}</view>
      <view
        wx:for="{{comp.props.services || []}}"
        wx:key="index"
        class="dsl-service__item"
        data-link="{{item.link_url}}"
        bindtap="onQuickNavigate"
      >
        <view class="dsl-service__body">
          <view class="dsl-service__name" style="{{comp.props._titleStyle}}">{{item.name || '服务名称'}}</view>
          <view class="dsl-service__desc" style="{{comp.props._subtitleStyle}}">{{item.desc || '服务说明'}}</view>
        </view>
        <view class="dsl-service__btn">{{item.button_text || '立即预约'}}</view>
      </view>
    </view>
  </view>

  <!-- AI 入口 ai_entry -->
  <view
    wx:elif="{{comp.type === 'ai_entry'}}"
    class="dsl-ai-entry-shell"
    style="{{comp.props._shellStyle}}"
  >
    <view
      class="dsl-ai-entry dsl-ai-entry--{{comp.props._theme || 'gold'}}"
      style="{{comp.props._cardStyle}}"
      bindtap="onAiEntryTap"
    >
      <view class="dsl-ai-entry__avatar">
        <image wx:if="{{comp.props.avatar}}" class="dsl-ai-entry__avatar-img" src="{{comp.props.avatar}}" mode="aspectFill" />
        <text wx:else>🤖</text>
      </view>
      <view class="dsl-ai-entry__info">
        <view class="dsl-ai-entry__title" style="{{comp.props._titleStyle}}">{{comp.props.title || 'AI智能助手'}}</view>
        <view wx:if="{{comp.props.description}}" class="dsl-ai-entry__desc" style="{{comp.props._descStyle}}">{{comp.props.description}}</view>
      </view>
    </view>
  </view>

  <!-- 表单入口 form_entry -->
  <view
    wx:elif="{{comp.type === 'form_entry'}}"
    class="dsl-form-entry-shell"
    style="{{comp.props._shellStyle}}"
  >
    <view
      class="dsl-form-entry dsl-form-entry--{{comp.props._styleType || 'card'}}"
      style="{{comp.props._cardStyle}}"
      data-link="{{comp.props._formLink}}"
      bindtap="onQuickNavigate"
    >
      <view class="dsl-form-entry__icon">📋</view>
      <view class="dsl-form-entry__info">
        <view class="dsl-form-entry__title" style="{{comp.props._titleStyle}}">{{comp.props.title || '填写信息'}}</view>
        <view wx:if="{{comp.props._subtitleText}}" class="dsl-form-entry__sub" style="{{comp.props._subtitleStyle}}">{{comp.props._subtitleText}}</view>
      </view>
      <view class="dsl-form-entry__btn">{{comp.props._buttonText || '立即填写'}}</view>
    </view>
  </view>

  <!-- 6. 会员卡 member_card -->
  <dsl-member-card
    wx:elif="{{comp.type === 'member_card'}}"
    config="{{comp.props}}"
    actions="{{comp.actions}}"
    styleString="{{comp.props._shellStyle || comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <dsl-promo-banner
    wx:elif="{{comp.type === 'promo_banner'}}"
    config="{{comp.props}}"
    styleString="{{comp.styleString}}"
  />

  <!-- 7. 优惠券 coupon -->
  <dsl-coupon
    wx:elif="{{comp.type === 'coupon'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
    bind:componentevent="onComponentEvent"
  />

  <!-- 8. 视频 video -->
  <dsl-video
    wx:elif="{{comp.type === 'video'}}"
    config="{{comp.props}}"
    styleString="{{comp.styleString}}"
  />
  <dsl-audio
    wx:elif="{{comp.type === 'audio'}}"
    config="{{comp.props}}"
    styleString="{{comp.styleString}}"
  />

  <!-- 8. 品牌介绍 brand_intro -->
  <view
    wx:elif="{{comp.type === 'brand_intro'}}"
    class="dsl-brand {{comp.props._layoutClass}}"
    style="{{comp.styleString}}"
  >
    <image
      wx:if="{{comp.props.logo}}"
      class="dsl-brand__logo"
      src="{{comp.props.logo}}"
      mode="aspectFit"
      style="{{comp.props._logoStyle}}"
    />
    <view class="dsl-brand__text" style="{{comp.props._textWrapStyle}}">
      <view class="dsl-brand__title" style="{{comp.props._titleStyle}}">{{comp.props.title || '品牌介绍'}}</view>
      <view wx:if="{{comp.props.subtitle}}" class="dsl-brand__subtitle" style="{{comp.props._subtitleStyle}}">{{comp.props.subtitle}}</view>
      <view class="dsl-brand__desc" style="{{comp.props._descStyle}}">{{comp.props.description || comp.props.desc || '请输入品牌介绍'}}</view>
      <view class="dsl-brand__kpi" wx:if="{{comp.props.kpi}}">{{comp.props.kpi}}</view>
    </view>
  </view>

  <!-- 8. 图文组合 image_text -->
  <view
    wx:elif="{{comp.type === 'image_text'}}"
    class="dsl-image-text dsl-image-text--{{comp.props.layout || 'left-image'}}"
    style="{{comp.styleString}}"
  >
    <view class="dsl-image-text__img">
      <image wx:if="{{comp.props.image}}" src="{{comp.props.image}}" mode="aspectFill" class="dsl-image-text__img-real" />
      <text wx:else>🖼️</text>
    </view>
    <view class="dsl-image-text__body">
      <view class="dsl-image-text__title" style="{{comp.props._titleStyle}}">{{comp.props.title || '图文组合'}}</view>
      <view class="dsl-image-text__desc" style="{{comp.props._subtitleStyle}}">{{comp.props.content || '请输入图文说明'}}</view>
    </view>
  </view>

  <!-- 8. 联系方式 contact_info -->
  <view
    wx:elif="{{comp.type === 'contact_info'}}"
    class="dsl-contact-shell"
    style="{{comp.props._shellStyle}}"
  >
    <view
      class="dsl-contact dsl-contact--{{comp.props._styleType || 'card'}} dsl-contact--layout-{{comp.props._layout || 'list'}} dsl-contact--align-{{comp.props._align || 'left'}}"
      style="{{comp.props._cardStyle}}"
    >
      <view class="dsl-contact__title" style="{{comp.props._titleStyle}}">{{comp.props.title || '联系我们'}}</view>
      <view class="dsl-contact__body">
        <view
          wx:for="{{comp.props._items || []}}"
          wx:key="key"
          class="dsl-contact__item {{item.key === 'phone' ? 'dsl-contact__item--phone' : ''}}"
          data-phone="{{item.key === 'phone' ? item.raw : ''}}"
          bindtap="onPhoneTap"
        >
          <text wx:if="{{comp.props._showIcons}}" class="dsl-contact__icon">{{item.icon}}</text>
          <text class="dsl-contact__text" style="{{comp.props._subtitleStyle}}">{{item.text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 8. 资质证书 certificate -->
  <view
    wx:elif="{{comp.type === 'certificate'}}"
    class="dsl-cert"
    style="{{comp.styleString}}"
  >
    <view class="dsl-cert__header">
      <view class="dsl-cert__bars" aria-hidden="true">
        <view class="dsl-cert__bar dsl-cert__bar--down"></view>
        <view class="dsl-cert__bar dsl-cert__bar--up"></view>
      </view>
      <view class="dsl-cert__title" style="{{comp.props._titleStyle}}">{{comp.props.title || '资质证书'}}</view>
    </view>
    <view class="dsl-cert__grid dsl-cert__grid--cols-{{comp.props._columns || 2}}">
      <view wx:for="{{comp.props.items || []}}" wx:key="index" class="dsl-cert__item">
        <image
          wx:if="{{item.image || item.cover}}"
          class="dsl-cert__img-real"
          src="{{item.image || item.cover}}"
          mode="aspectFill"
        />
        <view wx:else class="dsl-cert__img">📜</view>
        <view class="dsl-cert__name" style="{{comp.props._subtitleStyle}}">{{item.name || '证书'}}</view>
        <view wx:if="{{item.desc}}" class="dsl-cert__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 9. 倒计时 countdown -->
  <dsl-countdown
    wx:elif="{{comp.type === 'countdown'}}"
    config="{{comp.props}}"
    styleString="{{comp.styleString}}"
  />

  <!-- 10. 浮动按钮 float_button -->
  <dsl-float-button
    wx:elif="{{comp.type === 'float_button'}}"
    config="{{comp.props}}"
    actions="{{comp.actions}}"
    styleString="{{comp.styleString}}"
  />

  <!-- 11. 富文本 rich_text -->
  <dsl-rich-text
    wx:elif="{{comp.type === 'rich_text'}}"
    config="{{comp.props}}"
    styleString="{{comp.styleString}}"
  />

  <dsl-material-list
    wx:elif="{{comp.type === 'material_list'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    styleString="{{comp.styleString}}"
  />

  <dsl-member-plans
    wx:elif="{{comp.type === 'member_plan'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    styleString="{{comp.styleString}}"
  />

  <dsl-qa-list
    wx:elif="{{comp.type === 'qa_list'}}"
    config="{{comp.props}}"
    runtimeData="{{comp.runtimeData}}"
    styleString="{{comp.styleString}}"
  />

