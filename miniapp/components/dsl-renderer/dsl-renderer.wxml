  <dsl-spacer
    wx:elif="{{comp.type === 'spacer'}}"
    config="{{comp.props}}"
    styleString="{{comp.styleString}}"
  />

  <dsl-image-cube
    wx:elif="{{comp.type === 'image_cube'}}"
    config="{{comp.props}}"
    styleString="{{comp.styleString}}"
    bind:tapitem="onCubeTap"
  />

  <dsl-content-tabs
    wx:elif="{{comp.type === 'content_tabs'}}"
    config="{{comp.props}}"
    styleString="{{comp.styleString}}"
    bind:tapitem="onCubeTap"
  />

  <!-- 容器/通栏/热区/卖点（DSL v2 轻量渲染） -->
  <view wx:elif="{{comp.type === 'container'}}" class="dsl-container" style="{{comp.styleString}}">
    <view wx:if="{{comp.props.title}}" class="dsl-container__title">{{comp.props.title}}</view>
    <view class="dsl-container__body dsl-container__body--{{comp.props.layout || 'row'}}" style="gap: {{(comp.props.gap || 12) * 2}}rpx;">
      <view
        wx:for="{{comp.children}}"
        wx:key="id"
        class="dsl-container__child"
        style="{{comp.props.layout === 'grid' ? ('width:' + (100 / (comp.props.columns || 2)) + '%;box-sizing:border-box;') : (comp.props.layout === 'stack' ? 'width:100%;' : 'flex:1;min-width:0;')}}"
      >
        <dsl-renderer component="{{item}}" />
      </view>
    </view>
  </view>

  <view
    wx:elif="{{comp.type === 'section_bg'}}"
    class="dsl-section-bg"
    style="{{comp.styleString}};min-height:{{(comp.props.min_height || 120) * 2}}rpx;{{comp.props.background_type === 'gradient' ? ('background:linear-gradient(180deg,' + (comp.props.gradient_from || '#F5F7FB') + ',' + (comp.props.gradient_to || '#fff') + ');') : (comp.props.background_type === 'image' && comp.props.background_image ? ('background-image:url(' + comp.props.background_image + ');background-size:cover;background-position:center;') : ('background:' + (comp.props.background_color || '#F5F7FB') + ';'))}}"
  >
    <view wx:if="{{comp.props.title}}" class="dsl-section-bg__title">{{comp.props.title}}</view>
    <dsl-renderer wx:for="{{comp.children}}" wx:key="id" component="{{item}}" />
  </view>

  <view wx:elif="{{comp.type === 'image_hotspot'}}" class="dsl-hotspot" style="{{comp.styleString}}">
    <image wx:if="{{comp.props.image}}" src="{{comp.props.image}}" mode="widthFix" class="dsl-hotspot__img" />
    <view wx:else class="dsl-hotspot__empty">请配置热区底图</view>
    <view
      wx:for="{{comp.props.hotspots}}"
      wx:key="index"
      class="dsl-hotspot__spot"
      style="left:{{item.x || 0}}%;top:{{item.y || 0}}%;width:{{item.w || 20}}%;height:{{item.h || 15}}%;"
      data-url="{{item.link_url}}"
      bindtap="onHotspotTap"
    ></view>
  </view>

  <view wx:elif="{{comp.type === 'feature_cards'}}" class="dsl-feature-cards" style="{{comp.styleString}}">
    <view
      wx:for="{{comp.props.items}}"
      wx:key="title"
      class="dsl-feature-card"
      style="width: {{100 / (comp.props.columns || 3)}}%;"
    >
      <text class="dsl-feature-card__icon">{{item.icon}}</text>
      <text class="dsl-feature-card__title">{{item.title}}</text>
      <text class="dsl-feature-card__desc">{{item.desc}}</text>
    </view>
  </view>

  <dsl-planet-hero
    wx:elif="{{comp.type === 'planet_hero'}}"
    config="{{comp.props}}"
  />

  <block wx:elif="{{comp.type === 'planet_topics'}}">
    <view
      wx:if="{{comp.props.source_mode === 'manual'}}"
      class="dsl-planet-topics pl-fc"
      style="{{comp.styleString}}"
    >
      <view class="pl-fc__t">
        <text class="pl-fc__ic">{{comp.props.icon || '📈'}}</text>
        <text class="pl-fc__h">{{comp.props.title || '本周热门话题'}}</text>
        <text class="warm-tag warm-tag--gold" wx:if="{{comp.props.badge}}">{{comp.props.badge}}</text>
      </view>
      <view class="pl-fc__bar">
        <view class="pl-fc__row" wx:for="{{comp.props.items}}" wx:key="name">
          <text class="pl-fc__nm">{{item.name}}</text>
          <view class="pl-fc__tr"><view class="pl-fc__fill" style="width:{{item.width}}%"></view></view>
          <text class="pl-fc__pct {{item.down ? 'pl-fc__pct--dn' : ''}}">{{item.pct}}</text>
        </view>
      </view>
      <view class="pl-fc__note" wx:if="{{comp.props.note}}">{{comp.props.note}}</view>
    </view>
    <dsl-planet-topics
      wx:else
      config="{{comp.props}}"
      styleString="{{comp.styleString}}"
    />
  </block>

  <dsl-warm-block
    wx:elif="{{comp.type === 'warm_greet' || comp.type === 'warm_authors' || comp.type === 'warm_feature' || comp.type === 'warm_columns' || comp.type === 'warm_planet_rec' || comp.type === 'warm_feed'}}"
    type="{{comp.type}}"
    config="{{comp.props}}"
    warm="{{comp.runtimeData}}"
    shellStyle="{{comp.style}}"
  />

  <view
    wx:elif="{{comp.type === 'warm_home' || comp.type === 'warm_discover' || comp.type === 'warm_planet' || comp.type === 'warm_shop' || comp.type === 'warm_mine'}}"
    class="dsl-tab-page__state"
    style="padding:48rpx 32rpx;color:#6b5443;text-align:center;"
  >固定模板入口：发现/商城/星球/我的走原生业务页；首页请拆成可编辑区块</view>

  <!--
    styleString 透传：组件要知道自己有没有被配了通栏底色。
    外层 parseStyle 已把 background_color 下发成 background（真机通栏底色本来就生效），
    但组件内部卡片是不透明米白，会把底色整块遮死 —— 组件据此把卡片让成半透明。
    与后台 PlanetFeedRenderer 的 has-bg 判定同规则。
  -->
  <dsl-planet-feed
    wx:elif="{{comp.type === 'planet_feed'}}"
    config="{{comp.props}}"
    style-string="{{comp.styleString}}"
  />

  <!-- ============================================================
       暖调装修器 22 个新组件（内联渲染，省主包体积）
       视觉/文案与后台 admin/src/components/page-builder/{planet,growth,
       horizontal,content,layout}/* 同源；样式在 styles/warm-kit.wxss
       归一化与 mock 兜底在 utils/warm-kit.js
       ============================================================ -->

  <!-- ---------- 星球互动 1/5：planet_qa_card 精选问答卡 ---------- -->
  <view
    wx:elif="{{comp.type === 'planet_qa_card'}}"
    class="wk-card wk-qa"
    style="{{comp.styleString}};background:{{comp.props._bg}}"
  >
    <view wx:if="{{comp.props.title || comp.props.subtitle}}" class="wk-qa__head">
      <text wx:if="{{comp.props.title}}" class="wk-title">{{comp.props.title}}</text>
      <text wx:if="{{comp.props.subtitle}}" class="wk-sub">{{comp.props.subtitle}}</text>
    </view>
    <view wx:if="{{!comp.props._items.length}}" class="wk-empty">暂无精选问答</view>
    <view
      wx:for="{{comp.props._items}}"
      wx:key="id"
      class="wk-qa__item"
      data-link="{{item.link}}"
      catchtap="onQuickNavigate"
    >
      <view class="wk-qa__q">{{item.question}}</view>
      <view class="wk-qa__answerer">
        <image wx:if="{{item.answererAvatar}}" class="wk-qa__avatar" src="{{item.answererAvatar}}" mode="aspectFill" />
        <view wx:else class="wk-qa__avatar wk-qa__avatar--text">{{item._initial}}</view>
        <text class="wk-qa__who">{{item.answerer}}</text>
        <text wx:if="{{item.answererRole}}" class="wk-qa__role">{{item.answererRole}}</text>
      </view>
      <view class="wk-qa__a" style="-webkit-line-clamp:{{comp.props._clamp}};">{{item.answer}}</view>
      <view wx:if="{{comp.props.showViews || comp.props.showLikes}}" class="wk-qa__meta">
        <text wx:if="{{comp.props.showViews}}" class="wk-qa__stat">👁 {{item._views}}</text>
        <text wx:if="{{comp.props.showLikes}}" class="wk-qa__stat">♥ {{item._likes}}</text>
      </view>
    </view>
    <view
      wx:if="{{comp.props.moreText}}"
      class="wk-qa__more"
      style="color:{{comp.props._accent}}"
      data-link="{{comp.props.moreLink}}"
      catchtap="onQuickNavigate"
    >{{comp.props.moreText}} →</view>
  </view>

  <!-- ---------- 星球互动 2/5：planet_ask_banner 向主理人提问 ---------- -->
  <view
    wx:elif="{{comp.type === 'planet_ask_banner'}}"
    class="wk-card wk-ask"
    style="{{comp.styleString}};background:{{comp.props._bg}}"
  >
    <view wx:if="{{comp.props.title}}" class="wk-ask__head">
      <text class="wk-title">{{comp.props.title}}</text>
    </view>
    <view class="wk-ask__host">
      <image wx:if="{{comp.props.hostAvatar}}" class="wk-ask__avatar" src="{{comp.props.hostAvatar}}" mode="aspectFill" />
      <view wx:else class="wk-ask__avatar">{{comp.props._hostInitial}}</view>
      <view class="wk-ask__who">
        <view class="wk-ask__name-row">
          <text class="wk-ask__name">{{comp.props.hostName}}</text>
          <text wx:if="{{comp.props.hostRole}}" class="wk-ask__role">{{comp.props.hostRole}}</text>
        </view>
        <view class="wk-ask__stat">
          <text class="wk-ask__answered">已解答 {{comp.props._answered}} 次</text>
          <text wx:if="{{comp.props.showSla && comp.props.responseSla}}" class="wk-ask__sla">
            <text class="wk-ask__dot"></text>{{comp.props.responseSla}}
          </text>
        </view>
      </view>
    </view>
    <view wx:if="{{comp.props.desc}}" class="wk-ask__desc">{{comp.props.desc}}</view>
    <view
      wx:if="{{comp.props.ctaText}}"
      class="wk-ask__cta"
      style="background:{{comp.props._accent}}"
      data-link="{{comp.props.askLink}}"
      catchtap="onQuickNavigate"
    >{{comp.props.ctaText}}</view>
  </view>

  <!-- ---------- 星球互动 3/5：planet_members_strip 活跃成员排 ---------- -->
  <view
    wx:elif="{{comp.type === 'planet_members_strip'}}"
    class="wk-card wk-members"
    style="{{comp.styleString}};background:{{comp.props._bg}}"
  >
    <view wx:if="{{comp.props.title}}" class="wk-members__head">
      <text class="wk-title">{{comp.props.title}}</text>
      <text class="wk-members__count">{{comp.props._countText}}</text>
    </view>
    <view wx:if="{{!comp.props._items.length}}" class="wk-members__empty">{{comp.props.emptyText}}</view>
    <scroll-view
      wx:else
      class="wk-members__track"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view wx:for="{{comp.props._items}}" wx:key="id" class="wk-members__cell">
        <view class="wk-members__avatar">
          <image wx:if="{{item.avatar}}" class="wk-members__avatar-img" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="wk-members__initial">{{item._initial}}</view>
          <text wx:if="{{item.role}}" class="wk-members__tag" style="background:{{item._tagBg}}">{{item.role}}</text>
        </view>
        <view wx:if="{{comp.props.showName}}" class="wk-members__name">{{item.name}}</view>
      </view>
      <view wx:if="{{comp.props.showMoreBubble}}" class="wk-members__cell">
        <view class="wk-members__more" style="color:{{comp.props._accent}};border-color:{{comp.props._accent}}">
          <text class="wk-members__plus">+{{comp.props._moreText}}</text>
          <text class="wk-members__more-label">更多成员</text>
        </view>
        <view wx:if="{{comp.props.showName}}" class="wk-members__name">等你来</view>
      </view>
    </scroll-view>
  </view>

  <!-- ---------- 星球互动 4/5：planet_challenge_card 打卡挑战营 ---------- -->
  <view
    wx:elif="{{comp.type === 'planet_challenge_card'}}"
    class="wk-card wk-chal"
    style="{{comp.styleString}};background:{{comp.props._bg}}"
  >
    <view class="wk-chal__head">
      <view class="wk-chal__head-left">
        <text wx:if="{{comp.props.title}}" class="wk-title">{{comp.props.title}}</text>
        <text class="wk-chal__cycle">{{comp.props._cycle}}</text>
      </view>
      <text class="wk-chal__pct" style="color:{{comp.props._accent}}">{{chalCheckedToday ? comp.props._percentDone : comp.props._percent}}%</text>
    </view>
    <view wx:if="{{comp.props.showCalendar}}" class="wk-chal__cal">
      <view
        wx:for="{{chalCheckedToday ? comp.props._cellsDone : comp.props._cells}}"
        wx:key="_i"
        class="wk-chal__cell {{item._on ? 'wk-chal__cell--on' : ''}}"
        style="{{item._on ? ('background:' + comp.props._accent) : ''}}"
      ></view>
    </view>
    <view class="wk-chal__body">
      <view class="wk-chal__streak">
        <text class="wk-chal__num" style="color:{{comp.props._accent}}">{{comp.props._streak}}</text>
        <text class="wk-chal__unit">天连击</text>
      </view>
      <view class="wk-chal__meta">
        <text class="wk-chal__done">{{chalCheckedToday ? comp.props._doneTextDone : comp.props._doneText}}</text>
        <text class="wk-chal__tip">{{comp.props._tip}}</text>
      </view>
    </view>
    <view
      wx:if="{{comp.props.ctaText}}"
      class="wk-chal__cta"
      style="background:{{chalCheckedToday ? '#0AAA75' : comp.props._accent}}"
      catchtap="onWarmChallengeToggle"
    >{{chalCheckedToday ? comp.props.doneText : comp.props.ctaText}}</view>
  </view>

  <!-- ---------- 星球互动 5/5：planet_benefit_card 轻量权益卡 ---------- -->
  <view
    wx:elif="{{comp.type === 'planet_benefit_card'}}"
    class="wk-card wk-benefit"
    style="{{comp.styleString}};background:{{comp.props._bg}}"
  >
    <text wx:if="{{comp.props.badge}}" class="wk-benefit__badge" style="{{comp.props._badgeStyle}}">{{comp.props.badge}}</text>
    <view class="wk-benefit__head">
      <view class="wk-benefit__name">{{comp.props.planetName}}</view>
      <view wx:if="{{comp.props.tagline}}" class="wk-benefit__tagline">{{comp.props.tagline}}</view>
    </view>
    <view
      wx:for="{{comp.props._items}}"
      wx:key="id"
      class="wk-benefit__item {{index === 0 ? 'wk-benefit__item--first' : ''}}"
    >
      <text class="wk-benefit__icon">{{item.icon}}</text>
      <view class="wk-benefit__text">
        <view class="wk-benefit__btitle">{{item.title}}</view>
        <view class="wk-benefit__bdesc">{{item.desc}}</view>
      </view>
    </view>
    <view class="wk-benefit__foot">
      <view class="wk-benefit__price">
        <text wx:if="{{comp.props.originalPrice}}" class="wk-benefit__orig">¥{{comp.props.originalPrice}}</text>
        <text class="wk-benefit__now" style="color:{{comp.props._accent}}">
          <text class="wk-benefit__symbol">¥</text>{{comp.props.price}}
        </text>
        <text wx:if="{{comp.props.priceUnit}}" class="wk-benefit__unit">{{comp.props.priceUnit}}</text>
      </view>
      <view
        wx:if="{{comp.props.ctaText}}"
        class="wk-benefit__cta"
        style="background:{{comp.props._accent}}"
        data-link="{{comp.props.ctaLink}}"
        catchtap="onQuickNavigate"
      >{{comp.props.ctaText}}</view>
    </view>
  </view>

  <!-- ---------- 增长转化 1/5：op_creator_banner 创作者招募 ---------- -->
  <view
    wx:elif="{{comp.type === 'op_creator_banner'}}"
    class="wk-card wk-creator"
    style="{{comp.styleString}};{{comp.props._rootStyle}}"
  >
    <view class="wk-creator__head">
      <text wx:if="{{comp.props.showStatus && comp.props.statusTag}}" class="wk-creator__tag" style="{{comp.props._tagStyle}}">{{comp.props.statusTag}}</text>
      <view class="wk-creator__slogan">{{comp.props.slogan}}</view>
    </view>
    <view wx:if="{{comp.props.incomeText}}" class="wk-creator__income">{{comp.props.incomeText}}</view>
    <view wx:if="{{comp.props.ctaText}}" class="wk-creator__foot">
      <text
        class="wk-creator__cta"
        style="color:{{comp.props._accent}};border-color:{{comp.props._accent}}"
        data-link="{{comp.props.ctaLink}}"
        catchtap="onQuickNavigate"
      >{{comp.props.ctaText}} →</text>
    </view>
  </view>

  <!-- ---------- 增长转化 2/5：op_quote_card 金句卡 ---------- -->
  <view
    wx:elif="{{comp.type === 'op_quote_card'}}"
    class="wk-card wk-quote"
    style="{{comp.styleString}};background:{{comp.props._bg}}"
  >
    <view class="wk-quote__body {{comp.props._alignClass}}">
      <text wx:if="{{comp.props.showQuoteMark}}" class="wk-quote__mark" style="{{comp.props._markStyle}};left:{{comp.props._markLeft}}">「</text>
      <view class="wk-quote__text" style="{{comp.props._textStyle}}">{{comp.props.quote}}</view>
    </view>
    <view wx:if="{{comp.props.author || comp.props.authorTitle}}" class="wk-quote__by {{comp.props._alignClass}}">
      <text wx:if="{{comp.props.author}}" class="wk-quote__author" style="color:{{comp.props._accent}}">—— {{comp.props.author}}</text>
      <text wx:if="{{comp.props.authorTitle}}" class="wk-quote__title">{{comp.props.authorTitle}}</text>
    </view>
  </view>

  <!-- ---------- 增长转化 3/5：op_smart_group_card 智能群卡 ---------- -->
  <view
    wx:elif="{{comp.type === 'op_smart_group_card'}}"
    class="wk-card wk-group"
    style="{{comp.styleString}};background:{{comp.props._bg}}"
  >
    <view class="wk-group__head">
      <text class="wk-group__name">{{comp.props.groupName}}</text>
      <text wx:if="{{comp.props.memberScale}}" class="wk-group__scale">{{comp.props.memberScale}}</text>
    </view>
    <view class="wk-group__main">
      <view class="wk-group__qrbox">
        <image wx:if="{{comp.props.qrImage}}" class="wk-group__qr" src="{{comp.props.qrImage}}" mode="aspectFill" />
        <view wx:else class="wk-group__qr wk-group__qr--ph">二维码</view>
        <view wx:if="{{comp.props.qrTip}}" class="wk-group__qrtip">{{comp.props.qrTip}}</view>
      </view>
      <view class="wk-group__benefits">
        <view
          wx:for="{{comp.props._items}}"
          wx:key="id"
          class="wk-group__benefit {{index > 0 ? 'wk-group__benefit--sep' : ''}}"
        >
          <text wx:if="{{item.icon}}" class="wk-group__bicon">{{item.icon}}</text>
          <text class="wk-group__btext">{{item.text}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{comp.props.showFallback}}" class="wk-group__foot">
      <text
        class="wk-group__cta"
        style="color:{{comp.props._accent}};border-color:{{comp.props._accent}}"
