  <view
    wx:elif="{{comp.type === 'op_gated_download_card'}}"
    class="wk-card wk-gate"
    style="{{comp.styleString}};background:{{comp.props._bg}}"
  >
    <view class="wk-gate__top">
      <image wx:if="{{comp.props.cover}}" class="wk-gate__cover" src="{{comp.props.cover}}" mode="aspectFill" />
      <view wx:else class="wk-gate__cover wk-gate__cover--ph">白皮书</view>
