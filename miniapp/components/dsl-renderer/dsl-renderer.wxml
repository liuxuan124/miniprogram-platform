  <!-- ---------- 增长转化 4/5：op_referral_banner 邀请 banner ---------- -->
  <view
    wx:elif="{{comp.type === 'op_referral_banner'}}"
    class="wk-card wk-referral"
    style="{{comp.styleString}};background:{{comp.props._bg}}"
  >
    <view class="wk-referral__incentive">{{comp.props.incentive}}</view>
