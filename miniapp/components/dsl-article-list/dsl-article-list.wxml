<!--components/dsl-article-list/dsl-article-list.wxml — 文章列表（无内置标题栏，标题请用 section_title）-->
<view class="dsl-article-list {{showCategoryTabs ? 'dsl-article-list--tabs' : ''}}" style="{{styleString}}">
  <view wx:if="{{showCategoryTabs}}" class="dsl-article-list__tabs-bar">
  <scroll-view
    class="dsl-article-list__tabs"
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{categoryTabs}}"
      wx:key="name"
      class="dsl-article-list__tab {{activeTabId === item.id ? 'is-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTapTab"
    >{{item.name}}</view>
  </scroll-view>
  </view>

  <!-- 紧凑布局 -->
  <view
    wx:if="{{layout === 'compact'}}"
    class="dsl-article-list__list"
    style="{{listStyle}}"
  >
    <view
      class="dsl-article-list__item dsl-article-list__item--compact"
      wx:for="{{displayData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapArticle"
    >
      <image
        class="dsl-article-list__item-cover dsl-article-list__item-cover--compact"
        wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
        src="{{item.cover_url || item.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="dsl-article-list__item-content">
        <text class="dsl-article-list__item-title dsl-article-list__item-title--compact" style="{{titleStyle}}">{{item.title || item.name}}</text>
        <view class="dsl-article-list__item-meta-row" wx:if="{{config.show_date !== false}}">
          <text class="dsl-article-list__item-date" style="{{metaStyle}}" wx:if="{{item.created_at || item.publish_time}}">时间 {{item.created_at || item.publish_time}}</text>
          <text class="dsl-article-list__item-source" style="{{metaStyle}}" wx:if="{{item.source}}">来源 {{item.source}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 列表布局 -->
  <view
    wx:elif="{{layout !== 'card'}}"
    class="dsl-article-list__list"
    style="{{listStyle}}"
  >
    <view
      class="dsl-article-list__item dsl-article-list__item--list"
      wx:for="{{displayData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapArticle"
    >
      <image
        class="dsl-article-list__item-cover"
        wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
        src="{{item.cover_url || item.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="dsl-article-list__item-placeholder" wx:elif="{{config.show_cover !== false}}">
        <text>📖</text>
      </view>
      <view class="dsl-article-list__item-content">
        <text class="dsl-article-list__item-title text-ellipsis-2" style="{{titleStyle}}">{{item.title || item.name}}</text>
        <view class="dsl-article-list__item-meta-row" wx:if="{{config.show_date !== false}}">
          <text class="dsl-article-list__item-date" style="{{metaStyle}}" wx:if="{{item.created_at || item.publish_time}}">时间 {{item.created_at || item.publish_time}}</text>
          <text class="dsl-article-list__item-source" style="{{metaStyle}}" wx:if="{{item.source}}">来源 {{item.source}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 卡片布局 -->
  <view
    wx:else
    class="dsl-article-list__cards"
    style="{{listStyle}}"
  >
    <view
      class="dsl-article-list__item dsl-article-list__item--card"
      wx:for="{{displayData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapArticle"
    >
      <image
        class="dsl-article-list__item-cover-card"
        wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
        src="{{item.cover_url || item.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="dsl-article-list__item-placeholder dsl-article-list__item-placeholder--card" wx:elif="{{config.show_cover !== false}}">
        <text>📖</text>
      </view>
      <view class="dsl-article-list__item-content">
        <text class="dsl-article-list__item-title text-ellipsis-2" style="{{titleStyle}}">{{item.title || item.name}}</text>
        <view class="dsl-article-list__item-meta-row">
          <text
            class="dsl-article-list__item-date"
            style="{{metaStyle}}"
            wx:if="{{config.show_date !== false && (item.created_at || item.publish_time)}}"
          >时间 {{item.created_at || item.publish_time}}</text>
          <text class="dsl-article-list__item-source" style="{{metaStyle}}" wx:if="{{item.source}}">来源 {{item.source}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="dsl-article-list__empty" wx:if="{{!displayData.length && !tabLoading}}">
    <text class="dsl-article-list__empty-text">暂无内容</text>
  </view>
  <view class="dsl-article-list__empty" wx:elif="{{tabLoading}}">
    <text class="dsl-article-list__empty-text">加载中...</text>
  </view>
  <view class="dsl-article-list__footer" wx:elif="{{showCategoryTabs && displayData.length && footerText}}">
    <text class="dsl-article-list__footer-text">{{footerText}}</text>
  </view>
</view>
