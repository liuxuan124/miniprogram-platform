<view
  class="dsl-planet-topics pl-fc"
  style="{{styleString}}"
  wx:if="{{config.source_mode === 'manual' || visible}}"
>
  <view class="pl-fc__t">
    <text class="pl-fc__ic">{{config.icon || icon || '📈'}}</text>
    <text class="pl-fc__h">{{config.title || title}}</text>
    <text class="warm-tag warm-tag--gold" wx:if="{{config.badge || badge}}">{{config.badge || badge}}</text>
  </view>
  <view class="pl-fc__bar">
    <view class="pl-fc__row" wx:for="{{config.source_mode === 'manual' ? config.items : topics}}" wx:key="name">
      <text class="pl-fc__nm">{{item.name}}</text>
      <view class="pl-fc__tr"><view class="pl-fc__fill" style="width:{{item.width}}%"></view></view>
      <text class="pl-fc__pct {{item.down ? 'pl-fc__pct--dn' : ''}}">{{item.pct}}</text>
    </view>
  </view>
  <view class="pl-fc__note" wx:if="{{config.note || note}}">{{config.note || note}}</view>
</view>
