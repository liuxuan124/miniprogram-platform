/* components/dsl-image/dsl-image.wxss — 单图组件样式 */
.dsl-image {
  width: auto;
  max-width: 100%;
  overflow: hidden;
  background: #f1f5fb;
  /* 圆角由 styleString 注入；默认直角，与装修面板一致 */
  border-radius: 0;
  box-sizing: border-box;
}

.dsl-image__media {
  width: 100%;
}

.dsl-image__img--cover {
  display: block;
}

.dsl-image__img--pending {
  opacity: 0;
}

.dsl-image__img--ready {
  opacity: 1;
  transition: opacity 0.18s ease-out;
}

.dsl-image__img--auto {
  display: block;
  width: 100%;
  height: auto;
}

.dsl-image__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  color: #8a94a6;
}

.dsl-image__icon {
  font-size: 56rpx;
  line-height: 1.2;
}

.dsl-image__text {
  margin-top: 10rpx;
  font-size: 24rpx;
}
