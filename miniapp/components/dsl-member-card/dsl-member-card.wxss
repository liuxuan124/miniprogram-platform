/* components/dsl-member-card/dsl-member-card.wxss — 会员卡组件样式 */

.dsl-member-card-shell {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.dsl-member-card {
  position: relative;
  width: 100%;
  border-radius: 28rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #0f2150, #1769ff);
  background-size: cover;
  background-position: center;
  color: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
}

.dsl-member-card--purple {
  background: linear-gradient(135deg, #7c3aed, #a855f7);
}

.dsl-member-card--dark {
  background: linear-gradient(135deg, #111827, #374151);
}

.dsl-member-card--gold {
  background: linear-gradient(135deg, #b45309, #f59e0b);
}

.dsl-member-card--solid {
  background: #0f2150;
}

.dsl-member-card--image {
  background-color: #0f2150;
}

.dsl-member-card--image::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 33, 80, 0.25), rgba(15, 33, 80, 0.55));
  pointer-events: none;
}

.dsl-member-card--image > view {
  position: relative;
  z-index: 1;
}

.dsl-member-card__header {
  display: flex;
  align-items: flex-start;
}

.dsl-member-card__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.dsl-member-card__avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dsl-member-card__avatar-icon {
  font-size: 40rpx;
}

.dsl-member-card__user {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dsl-member-card__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dsl-member-card__nickname {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dsl-member-card__upgrade {
  flex-shrink: 0;
  height: auto;
  min-height: 48rpx;
  line-height: 1.2;
  padding: 8rpx 20rpx;
  color: #0f2150;
  font-size: 22rpx;
  font-weight: 700;
  background: #fff;
  border-radius: 999rpx;
  white-space: nowrap;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.dsl-member-card__subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.dsl-member-card__benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.dsl-member-card__benefit {
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
}

.dsl-member-card__stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 28rpx;
}

.dsl-member-card__stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dsl-member-card__stat-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.dsl-member-card__stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}
