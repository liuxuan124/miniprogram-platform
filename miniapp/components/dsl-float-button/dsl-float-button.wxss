/* components/dsl-float-button/dsl-float-button.wxss — 浮动按钮组件样式 */

.dsl-float-button {
  gap: 10rpx;
}

.dsl-float-button.is-dragging {
  opacity: 0.92 !important;
}

.dsl-float-button__icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.dsl-float-button__emoji {
  font-size: 34rpx;
  line-height: 1;
  color: #ffffff;
}

.dsl-float-button__text {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}
