<!--components/dsl-float-button/dsl-float-button.wxml — 浮动按钮组件-->
<view
  class="dsl-float-button {{dragging ? 'is-dragging' : ''}}"
  style="{{floatButtonStyle}}"
  catchtap="onTap"
  catchtouchstart="onTouchStart"
  catchtouchmove="onTouchMove"
  catchtouchend="onTouchEnd"
>
  <image
    wx:if="{{iconSrc}}"
    class="dsl-float-button__icon"
    src="{{iconSrc}}"
    mode="aspectFit"
  />
  <text wx:else class="dsl-float-button__emoji">{{displayEmoji}}</text>
  <text wx:if="{{showText}}" class="dsl-float-button__text">{{displayTitle}}</text>
</view>
