<!--components/dsl-float-button/dsl-float-button.wxml — 圆形可拖动悬浮按钮-->
<view
  class="dsl-float-button {{dragging ? 'is-dragging' : ''}} {{docked ? 'is-docked' : ''}}"
  style="{{floatButtonStyle}}"
  catchtap="onTap"
  catchtouchstart="onTouchStart"
  catchtouchmove="onTouchMove"
  catchtouchend="onTouchEnd"
  catchtouchcancel="onTouchEnd"
>
  <image
    wx:if="{{iconSrc}}"
    class="dsl-float-button__icon"
    src="{{iconSrc}}"
    mode="aspectFit"
  />
  <text wx:else class="dsl-float-button__emoji">{{displayEmoji}}</text>
</view>
