/* components/dsl-article-feed/dsl-article-feed.wxss */
.dsl-article-feed {
  width: auto;
  max-width: 100%;
  min-width: 0;
  background: transparent;
  box-sizing: border-box;
}

.dsl-article-feed--tabs {
  padding: 0;
}

.dsl-article-feed__tabs-bar {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  background: #fff;
}

.dsl-article-feed__tabs {
  width: 100%;
  overflow-x: scroll;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  white-space: nowrap;
  border-bottom: 1rpx solid #edf0f5;
}

.dsl-article-feed__tabs::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.dsl-article-feed__tabs-inner {
  display: inline-block;
  padding: 8rpx 24rpx 16rpx;
  white-space: nowrap;
}

.dsl-article-feed__tab {
  display: inline-block;
  vertical-align: top;
  margin-right: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  color: #94a3b8;
  font-size: 28rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.dsl-article-feed__tab:last-child {
  margin-right: 24rpx;
}

.dsl-article-feed__tab.is-active {
  /* 文字色与浅底由 activeTabStyle 内联注入（跟随主题色） */
}

.dsl-article-feed__list,
.dsl-article-feed__cards {
  display: flex;
  flex-direction: column;
}

.dsl-article-feed__item--list,
.dsl-article-feed__item--compact {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 43, 76, 0.06);
  box-sizing: border-box;
}

.dsl-article-feed__item--compact {
  padding: 16rpx 20rpx;
}

.dsl-article-feed__item--card {
  overflow: hidden;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 43, 76, 0.06);
}

.dsl-article-feed__cover {
  width: 124rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #eef2f7;
}

.dsl-article-feed__cover--compact {
  width: 96rpx;
  height: 80rpx;
}

.dsl-article-feed__cover-card {
  width: 100%;
  height: 240rpx;
  background: #eef2f7;
}

.dsl-article-feed__placeholder {
  width: 124rpx;
  height: 104rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #eef2f7;
  border-radius: 8rpx;
}

.dsl-article-feed__placeholder--card {
  width: 100%;
  height: 240rpx;
  font-size: 56rpx;
  border-radius: 0;
}

.dsl-article-feed__content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dsl-article-feed__item--card .dsl-article-feed__content {
  padding: 20rpx 24rpx 24rpx;
}

.dsl-article-feed__title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.dsl-article-feed__title--compact {
  font-size: 24rpx;
}

.dsl-article-feed__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 28rpx;
  margin-top: 12rpx;
}

.dsl-article-feed__date,
.dsl-article-feed__source {
  color: #94a3b8;
  font-size: 22rpx;
}

.dsl-article-feed__empty,
.dsl-article-feed__footer {
  padding: 28rpx 16rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}

.text-ellipsis-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
