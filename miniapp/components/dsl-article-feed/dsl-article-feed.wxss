/* components/dsl-article-feed/dsl-article-feed.wxss */
.dsl-article-feed {
  width: auto;
  max-width: 100%;
  min-width: 0;
  background: transparent;
  box-sizing: border-box;
}

.dsl-article-feed--tabs {
  padding: 0;
}

.dsl-article-feed__tabs-bar {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  background: #fff;
}

.dsl-article-feed__tabs {
  width: 100%;
  overflow-x: scroll;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  white-space: nowrap;
  border-bottom: 1rpx solid #edf0f5;
}

.dsl-article-feed__tabs::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.dsl-article-feed__tabs-inner {
  display: inline-block;
  padding: 8rpx 24rpx 16rpx;
  white-space: nowrap;
}

.dsl-article-feed__tab {
  display: inline-block;
  vertical-align: top;
  margin-right: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  color: #94a3b8;
  font-size: 28rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.dsl-article-feed__tab:last-child {
  margin-right: 24rpx;
}

.dsl-article-feed__tab.is-active {
  /* 文字色与浅底由 activeTabStyle 内联注入（跟随主题色） */
}

.dsl-article-feed__list,
.dsl-article-feed__cards {
  display: flex;
  flex-direction: column;
}

.dsl-article-feed__item--list,
.dsl-article-feed__item--compact {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 43, 76, 0.06);
  box-sizing: border-box;
}

.dsl-article-feed__item--compact {
  padding: 16rpx 20rpx;
}

.dsl-article-feed__item--card {
  overflow: hidden;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 43, 76, 0.06);
}

.dsl-article-feed__cover {
  width: 124rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #eef2f7;
}

.dsl-article-feed__cover--compact {
  width: 96rpx;
  height: 80rpx;
}

.dsl-article-feed__cover-card {
  width: 100%;
  height: 240rpx;
  background: #eef2f7;
}

.dsl-article-feed__placeholder {
  width: 124rpx;
  height: 104rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #eef2f7;
  border-radius: 8rpx;
}

.dsl-article-feed__placeholder--card {
  width: 100%;
  height: 240rpx;
  font-size: 56rpx;
  border-radius: 0;
}

.dsl-article-feed__content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dsl-article-feed__item--card .dsl-article-feed__content {
  padding: 20rpx 24rpx 24rpx;
}

.dsl-article-feed__title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.dsl-article-feed__title--compact {
  font-size: 24rpx;
}

.dsl-article-feed__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 28rpx;
  margin-top: 12rpx;
}

.dsl-article-feed__date,
.dsl-article-feed__source {
  color: #94a3b8;
  font-size: 22rpx;
}

.dsl-article-feed__empty,
.dsl-article-feed__footer {
  padding: 28rpx 16rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}

.text-ellipsis-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.dsl-article-feed__overlay,
.dsl-article-feed__magazine {
  padding: 0 20rpx;
}

.dsl-article-feed__item--overlay {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(12, 18, 32, 0.18);
}

.dsl-article-feed__overlay-cover {
  display: block;
  width: 100%;
  height: 420rpx;
  background: linear-gradient(135deg, #1c2b4c, #3d4f73);
}

.dsl-article-feed__overlay-cover--hero {
  height: 480rpx;
}

.dsl-article-feed__overlay-mask {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 80rpx 28rpx 28rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(10, 16, 28, 0.88) 78%);
}

.dsl-article-feed__overlay-kicker {
  display: block;
  margin-bottom: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  letter-spacing: 0.18em;
}

.dsl-article-feed__overlay-title {
  display: -webkit-box;
  overflow: hidden;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dsl-article-feed__overlay-meta {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
}

.dsl-article-feed__magazine .dsl-article-feed__item--overlay {
  margin-bottom: 8rpx;
}

.dsl-article-feed__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 20rpx;
}

.dsl-article-feed__item--grid {
  width: calc((100% - 16rpx) / 2);
  overflow: hidden;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.dsl-article-feed__grid-cover {
  display: block;
  width: 100%;
  height: 220rpx;
  background: #e8edf5;
}

.dsl-article-feed__grid-body {
  padding: 16rpx 18rpx 20rpx;
}

.dsl-article-feed__grid-title {
  display: -webkit-box;
  overflow: hidden;
  color: #152033;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.4;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dsl-article-feed__grid-meta {
  display: block;
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 20rpx;
}

.dsl-article-feed__editorial {
  padding: 0 28rpx;
}

.dsl-article-feed__item--editorial {
  display: flex;
  flex-direction: row-reverse;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #ece7de;
}

.dsl-article-feed__editorial-cover {
  width: 168rpx;
  height: 126rpx;
  flex-shrink: 0;
  border-radius: 4rpx;
  background: #ece7de;
}

.dsl-article-feed__editorial-body {
  flex: 1;
  min-width: 0;
}

.dsl-article-feed__editorial-title {
  display: -webkit-box;
  overflow: hidden;
  color: #1a1712;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.4;
  letter-spacing: 0.02em;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dsl-article-feed__editorial-excerpt {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #7a7468;
  font-size: 24rpx;
  line-height: 1.55;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dsl-article-feed__editorial-meta {
  color: #a39b8d;
  font-size: 22rpx;
}
