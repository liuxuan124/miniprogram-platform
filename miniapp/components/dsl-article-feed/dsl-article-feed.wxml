<!-- components/dsl-article-feed/dsl-article-feed.wxml — 文章流（无限加载） -->
<view class="dsl-article-feed {{showCategoryTabs ? 'dsl-article-feed--tabs' : ''}}" style="{{styleString}}">
  <view wx:if="{{showCategoryTabs}}" class="dsl-article-feed__tabs-bar">
    <view class="dsl-article-feed__tabs">
      <view class="dsl-article-feed__tabs-inner">
        <view
          wx:for="{{categoryTabs}}"
          wx:key="name"
          class="dsl-article-feed__tab {{activeTabId === item.id ? 'is-active' : ''}}"
          style="{{activeTabId === item.id ? activeTabStyle : ''}}"
          data-id="{{item.id}}"
          catchtap="onTapTab"
        >{{item.name}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{layout === 'compact'}}" class="dsl-article-feed__list" style="{{listStyle}}">
    <view
      class="dsl-article-feed__item dsl-article-feed__item--compact"
      style="{{itemCardStyle}}"
      wx:for="{{displayData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapArticle"
    >
      <image
        wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
        class="dsl-article-feed__cover dsl-article-feed__cover--compact"
        src="{{item.cover_url || item.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="dsl-article-feed__content">
        <text class="dsl-article-feed__title dsl-article-feed__title--compact" style="{{titleStyle}}">{{item.title || item.name}}</text>
        <view class="dsl-article-feed__meta" wx:if="{{config.show_date !== false}}">
          <text class="dsl-article-feed__date" style="{{metaStyle}}" wx:if="{{item.created_at || item.publish_time}}">{{item.created_at || item.publish_time}}</text>
          <text class="dsl-article-feed__source" style="{{metaStyle}}" wx:if="{{item.source}}">{{item.source}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{layout === 'overlay'}}" class="dsl-article-feed__overlay" style="{{listStyle}}">
    <view
      class="dsl-article-feed__item dsl-article-feed__item--overlay"
      style="{{itemCardStyle}}"
      wx:for="{{displayData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapArticle"
    >
      <image
        wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
        class="dsl-article-feed__overlay-cover"
        src="{{item.cover_url || item.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view wx:elif="{{config.show_cover !== false}}" class="dsl-article-feed__overlay-cover"></view>
      <view class="dsl-article-feed__overlay-mask">
        <text class="dsl-article-feed__overlay-kicker" wx:if="{{item.source}}">{{item.source}}</text>
        <text class="dsl-article-feed__overlay-title">{{item.title || item.name}}</text>
        <text class="dsl-article-feed__overlay-meta" wx:if="{{config.show_date !== false && (item.created_at || item.publish_time)}}">{{item.created_at || item.publish_time}}</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{layout === 'magazine'}}" class="dsl-article-feed__magazine">
    <block wx:for="{{displayData}}" wx:key="id">
      <view
        wx:if="{{index === 0}}"
        class="dsl-article-feed__item dsl-article-feed__item--overlay"
        style="{{itemCardStyle}}"
        data-id="{{item.id}}"
        bindtap="onTapArticle"
      >
        <image
          wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
          class="dsl-article-feed__overlay-cover dsl-article-feed__overlay-cover--hero"
          src="{{item.cover_url || item.image}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:elif="{{config.show_cover !== false}}" class="dsl-article-feed__overlay-cover dsl-article-feed__overlay-cover--hero"></view>
        <view class="dsl-article-feed__overlay-mask">
          <text class="dsl-article-feed__overlay-kicker" wx:if="{{item.source}}">{{item.source}}</text>
          <text class="dsl-article-feed__overlay-title">{{item.title || item.name}}</text>
          <text class="dsl-article-feed__overlay-meta" wx:if="{{config.show_date !== false && (item.created_at || item.publish_time)}}">{{item.created_at || item.publish_time}}</text>
        </view>
      </view>
      <view
        wx:else
        class="dsl-article-feed__item dsl-article-feed__item--editorial"
        data-id="{{item.id}}"
        bindtap="onTapArticle"
      >
        <image
          wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
          class="dsl-article-feed__editorial-cover"
          src="{{item.cover_url || item.image}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="dsl-article-feed__editorial-body">
          <text class="dsl-article-feed__editorial-title">{{item.title || item.name}}</text>
          <text class="dsl-article-feed__editorial-excerpt" wx:if="{{item.summary}}">{{item.summary}}</text>
          <view class="dsl-article-feed__meta" wx:if="{{config.show_date !== false}}">
            <text class="dsl-article-feed__editorial-meta" wx:if="{{item.created_at || item.publish_time}}">{{item.created_at || item.publish_time}}</text>
            <text class="dsl-article-feed__editorial-meta" wx:if="{{item.source}}">{{item.source}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:elif="{{layout === 'grid'}}" class="dsl-article-feed__grid">
    <view
      class="dsl-article-feed__item dsl-article-feed__item--grid"
      style="{{itemCardStyle}}"
      wx:for="{{displayData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapArticle"
    >
      <image
        wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
        class="dsl-article-feed__grid-cover"
        src="{{item.cover_url || item.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view wx:elif="{{config.show_cover !== false}}" class="dsl-article-feed__grid-cover"></view>
      <view class="dsl-article-feed__grid-body">
        <text class="dsl-article-feed__grid-title">{{item.title || item.name}}</text>
        <text class="dsl-article-feed__grid-meta" wx:if="{{config.show_date !== false && (item.created_at || item.publish_time)}}">{{item.created_at || item.publish_time}}</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{layout === 'editorial'}}" class="dsl-article-feed__editorial">
    <view
      class="dsl-article-feed__item dsl-article-feed__item--editorial"
      wx:for="{{displayData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapArticle"
    >
      <image
        wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
        class="dsl-article-feed__editorial-cover"
        src="{{item.cover_url || item.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="dsl-article-feed__editorial-body">
        <text class="dsl-article-feed__editorial-title">{{item.title || item.name}}</text>
        <text class="dsl-article-feed__editorial-excerpt" wx:if="{{item.summary}}">{{item.summary}}</text>
        <view class="dsl-article-feed__meta" wx:if="{{config.show_date !== false}}">
          <text class="dsl-article-feed__editorial-meta" wx:if="{{item.created_at || item.publish_time}}">{{item.created_at || item.publish_time}}</text>
          <text class="dsl-article-feed__editorial-meta" wx:if="{{item.source}}">{{item.source}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{layout === 'card'}}" class="dsl-article-feed__cards" style="{{listStyle}}">
    <view
      class="dsl-article-feed__item dsl-article-feed__item--card"
      style="{{itemCardStyle}}"
      wx:for="{{displayData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapArticle"
    >
      <image
        wx:if="{{config.show_cover !== false && (item.cover_url || item.image)}}"
        class="dsl-article-feed__cover-card"
        src="{{item.cover_url || item.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view wx:elif="{{config.show_cover !== false}}" class="dsl-article-feed__placeholder dsl-article-feed__placeholder--card">
        <text>📖</text>
      </view>
      <view class="dsl-article-feed__content">
        <text wx:if="{{showColumnTag && item.columnName}}" class="dsl-article-feed__column">{{item.columnName}}</text>
        <text class="dsl-article-feed__title text-ellipsis-2" style="{{titleStyle}}">{{item.title || item.name}}</text>
        <text wx:if="{{showExcerpt && item.summary}}" class="dsl-article-feed__excerpt text-ellipsis-2" style="color:{{excerptColor}};">{{item.summary}}</text>
        <view class="dsl-article-feed__meta" wx:if="{{config.show_date !== false || showAuthor || metricTypes.length || (badgePosition === 'meta' && badgeTypes.length) || showCta}}">
          <text class="dsl-article-feed__author" wx:if="{{showAuthor && item.authorName}}">
            <image wx:if="{{item.authorAvatar}}" class="dsl-article-feed__avatar" src="{{item.authorAvatar}}" mode="aspectFill" />
            <text class="dsl-article-feed__author-name">{{item.authorName}}</text>
            <text wx:if="{{item.authorVerified}}" class="dsl-article-feed__v">V</text>
          </text>
          <!-- 🔴 此前硬编码了「时间 」「来源 」前缀，运营看到的是「时间 2026-01-01」这种怪字符串 -->
          <text class="dsl-article-feed__date" style="{{metaStyle}}" wx:if="{{config.show_date !== false && (item.created_at || item.publish_time)}}">{{item.created_at || item.publish_time}}</text>
          <text class="dsl-article-feed__source" style="{{metaStyle}}" wx:if="{{item.source}}">{{item.source}}</text>
          <text class="dsl-article-feed__metric" style="{{metaStyle}}" wx:if="{{metricTypes.indexOf('views') >= 0 && item.viewCount}}">◉ {{item.viewCount}}</text>
          <text class="dsl-article-feed__metric" style="{{metaStyle}}" wx:if="{{metricTypes.indexOf('likes') >= 0 && item.likeCount}}">♥ {{item.likeCount}}</text>
          <text class="dsl-article-feed__metric" style="{{metaStyle}}" wx:if="{{metricTypes.indexOf('reading') >= 0 && item.readingMinutes}}">⏱ 阅读 {{item.readingMinutes}} 分钟</text>
          <text class="dsl-article-feed__badges" wx:if="{{badgePosition === 'meta' && badgeTypes.length}}">
            <text wx:for="{{badgeTypes}}" wx:key="*this" wx:for-item="bt" class="dsl-article-feed__badge" wx:if="{{item[bt]}}">{{bt}}</text>
          </text>
          <text class="dsl-article-feed__cta" wx:if="{{showCta}}">{{ctaText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="dsl-article-feed__list {{dividerStyle === 'card' ? 'dsl-article-feed__list--card' : ''}} {{coverOnLeft ? 'dsl-article-feed__list--cover-left' : ''}}" style="{{listStyle}}">
    <view
      class="dsl-article-feed__item dsl-article-feed__item--list"
      style="{{itemCardStyle}}"
      wx:for="{{displayData}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapArticle"
    >
      <image
        wx:if="{{!hideCover && config.show_cover !== false && (item.cover_url || item.image)}}"
        class="dsl-article-feed__cover"
        src="{{item.cover_url || item.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view wx:elif="{{!hideCover && config.show_cover !== false}}" class="dsl-article-feed__placeholder">
        <text>📖</text>
      </view>
      <view class="dsl-article-feed__content">
        <!-- 专栏 / 话题胶囊 -->
        <text wx:if="{{showColumnTag && item.columnName}}" class="dsl-article-feed__column">{{item.columnName}}</text>
        <text class="dsl-article-feed__title text-ellipsis-{{excerptLines}}" style="{{titleStyle}}">
          <text wx:if="{{badgePosition === 'title' && badgeTypes.length}}" class="dsl-article-feed__badges">
            <text wx:for="{{badgeTypes}}" wx:key="*this" wx:for-item="bt" class="dsl-article-feed__badge" wx:if="{{item[bt]}}">{{bt}}</text>
          </text>
          {{item.title || item.name}}
        </text>
        <text wx:if="{{showExcerpt && item.summary}}" class="dsl-article-feed__excerpt text-ellipsis-{{excerptLines}}" style="color:{{excerptColor}};">{{item.summary}}</text>
        <view class="dsl-article-feed__meta" wx:if="{{config.show_date !== false || showAuthor || metricTypes.length || (badgePosition === 'meta' && badgeTypes.length) || showCta}}">
          <text class="dsl-article-feed__author" wx:if="{{showAuthor && item.authorName}}">
            <image wx:if="{{item.authorAvatar}}" class="dsl-article-feed__avatar" src="{{item.authorAvatar}}" mode="aspectFill" />
            <text class="dsl-article-feed__author-name">{{item.authorName}}</text>
            <text wx:if="{{item.authorVerified}}" class="dsl-article-feed__v">V</text>
          </text>
          <text class="dsl-article-feed__date" style="{{metaStyle}}" wx:if="{{config.show_date !== false && (item.created_at || item.publish_time)}}">{{item.created_at || item.publish_time}}</text>
          <text class="dsl-article-feed__metric" style="{{metaStyle}}" wx:if="{{metricTypes.indexOf('views') >= 0 && item.viewCount}}">◉ {{item.viewCount}}</text>
          <text class="dsl-article-feed__metric" style="{{metaStyle}}" wx:if="{{metricTypes.indexOf('likes') >= 0 && item.likeCount}}">♥ {{item.likeCount}}</text>
          <text class="dsl-article-feed__metric" style="{{metaStyle}}" wx:if="{{metricTypes.indexOf('reading') >= 0 && item.readingMinutes}}">⏱ 阅读 {{item.readingMinutes}} 分钟</text>
          <text class="dsl-article-feed__badges" wx:if="{{badgePosition === 'meta' && badgeTypes.length}}">
            <text wx:for="{{badgeTypes}}" wx:key="*this" wx:for-item="bt" class="dsl-article-feed__badge" wx:if="{{item[bt]}}">{{bt}}</text>
          </text>
          <text class="dsl-article-feed__cta" wx:if="{{showCta}}">{{ctaText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="dsl-article-feed__empty" wx:if="{{!displayData.length && (loading || tabLoading)}}">
    <text>加载中...</text>
  </view>
  <view class="dsl-article-feed__empty" wx:elif="{{!displayData.length && !loading && !tabLoading}}">
    <text>暂无内容</text>
  </view>
  <view class="dsl-article-feed__footer" wx:elif="{{footerText}}">
    <text>{{footerText}}</text>
  </view>
</view>
