.dsl-moments-feed { width: 100%; box-sizing: border-box; }
.dsl-moments-feed__list { display: flex; flex-direction: column; }
.dsl-moments-feed__card { background: #fff; border-radius: 24rpx; padding: 24rpx; box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04); }
.dsl-moments-feed__head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.dsl-moments-feed__av, .dsl-moments-feed__av-img { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; }
.dsl-moments-feed__av { display: flex; align-items: center; justify-content: center; background: linear-gradient(140deg, #5c7cff, #2f5bff); color: #fff; font-size: 28rpx; font-weight: 700; }
.dsl-moments-feed__meta { flex: 1; min-width: 0; }
.dsl-moments-feed__name { display: block; font-size: 28rpx; font-weight: 700; color: #0f172a; }
.dsl-moments-feed__time { display: block; margin-top: 4rpx; font-size: 22rpx; color: #94a3b8; }
.dsl-moments-feed__body { display: block; font-size: 28rpx; line-height: 1.7; color: #334155; margin-bottom: 16rpx; white-space: pre-wrap; }
.dsl-moments-feed__images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin-bottom: 12rpx; }
.dsl-moments-feed__img { width: 100%; aspect-ratio: 1; border-radius: 12rpx; background: #eef2f7; }
.dsl-moments-feed__files { font-size: 24rpx; color: #64748b; background: #f8fafc; border-radius: 12rpx; padding: 12rpx 16rpx; }
.dsl-moments-feed__footer { padding: 24rpx 0; text-align: center; color: #94a3b8; font-size: 24rpx; }
