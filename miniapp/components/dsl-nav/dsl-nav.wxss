/* components/dsl-nav/dsl-nav.wxss — 导航宫格组件样式 */

.dsl-nav {
  width: 100%;
  background-color: transparent;
  overflow: hidden;
  box-sizing: border-box;
  padding-left: 8rpx;
  padding-right: 8rpx;
}

.dsl-nav--frame {
  padding-left: 16rpx;
  padding-right: 16rpx;
  border: 1rpx solid #edf1f7;
  box-shadow: 0 8rpx 28rpx rgba(28, 43, 76, 0.06);
}

/* 网格布局 */
.dsl-nav__grid {
  display: grid;
  gap: 0;
  padding: 0;
}

.dsl-nav__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
}

/* emoji 图标容器 */
.dsl-nav__item-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 4rpx;
  border-radius: 32rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.dsl-nav__emoji {
  font-size: 44rpx;
  line-height: 1;
}

/* 图片 / SVG 扁平图标（自带柔和色底，无黑边） */
.dsl-nav__item-icon-img {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 4rpx;
  border-radius: 32rpx;
  display: block;
}

.dsl-nav__item-text {
  font-size: 22rpx;
  line-height: 1.2;
  color: #4b5563;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

/* 横向滚动 */
.dsl-nav__scroll {
  width: 100%;
  white-space: nowrap;
}

.dsl-nav__scroll-inner {
  display: inline-flex;
  padding: 0 16rpx;
  gap: 24rpx;
}

.dsl-nav__scroll .dsl-nav__item {
  min-width: 120rpx;
  padding: 0 8rpx;
}
