/* components/dsl-brand-header/dsl-brand-header.wxss */
.dsl-brand-header-root {
  width: 100%;
}

.dsl-brand-header {
  width: 100%;
  box-sizing: border-box;
  background: var(--card);
}

.dsl-brand-header--pinned {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 120;
}

.dsl-brand-header__spacer {
  width: 100%;
  flex-shrink: 0;
}

.dsl-brand-header__safe {
  width: 100%;
  flex-shrink: 0;
}

.dsl-brand-header__bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
}

.dsl-brand-header__brand {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  max-width: 160rpx;
}

.dsl-brand-header__logo {
  /* keep_ratio 时 width:auto 由 inline style 给，宽度自适应不拉伸 */
  display: block;
}

.dsl-brand-header__logo-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--brand);
  white-space: nowrap;
}

/* 空态占位：给固定高度，避免整条顶栏塌成 0 */
.dsl-brand-header__blank {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #b3a596;
  border: 2rpx dashed #d8d2c8;
  border-radius: 12rpx;
}

/* 右侧快捷入口 */
.dsl-brand-header__action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-left: 16rpx;
  background: rgba(127, 127, 127, 0.08);
  border-radius: 999rpx;
}

.dsl-brand-header__action-icon {
  font-size: 26rpx;
  line-height: 1;
}

.dsl-brand-header__divider {
  flex-shrink: 0;
  width: 2rpx;
  height: 32rpx;
  /* 间距统一由 bar 的 gap 控制，这里不能再加 margin，否则会与 gap 叠加 */
  background: #d0d8e8;
  border-radius: 2rpx;
}

.dsl-brand-header__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
}

.dsl-brand-header__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dsl-brand-header__subtitle {
  font-size: 20rpx;
  color: #7b8798;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
