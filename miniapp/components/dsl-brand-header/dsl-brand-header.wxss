/* components/dsl-brand-header/dsl-brand-header.wxss */
.dsl-brand-header-root {
  width: 100%;
}

.dsl-brand-header {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
}

.dsl-brand-header--pinned {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 120;
}

.dsl-brand-header__spacer {
  width: 100%;
  flex-shrink: 0;
}

.dsl-brand-header__bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
}

.dsl-brand-header__brand {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  max-width: 160rpx;
}

.dsl-brand-header__logo {
  width: auto;
  display: block;
}

.dsl-brand-header__logo-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #002FA7;
  white-space: nowrap;
}

.dsl-brand-header__divider {
  flex-shrink: 0;
  width: 2rpx;
  height: 32rpx;
  margin: 0 16rpx;
  background: #d0d8e8;
  border-radius: 2rpx;
}

.dsl-brand-header__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
}

.dsl-brand-header__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #172033;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dsl-brand-header__subtitle {
  font-size: 20rpx;
  color: #7b8798;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
