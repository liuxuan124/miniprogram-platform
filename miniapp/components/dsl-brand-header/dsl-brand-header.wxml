<!-- components/dsl-brand-header/dsl-brand-header.wxml — 品牌顶栏（替代系统导航栏） -->
<view class="dsl-brand-header-root">
  <view
    class="dsl-brand-header {{fixedTop ? 'dsl-brand-header--pinned' : ''}}"
    style="{{headerStyle}}"
  >
    <view class="dsl-brand-header__safe" style="height:{{statusBarHeight}}px;"></view>
    <view class="dsl-brand-header__bar" style="{{barStyle}}">
      <!-- Logo 区：按 logo_mode 决定显示图片 / 文字 / 图文 / 都不显示 -->
      <view wx:if="{{logoMode !== 'none'}}" class="dsl-brand-header__brand" bindtap="onTapBrand">
        <image
          wx:if="{{showsLogoImage && logoUrl}}"
          class="dsl-brand-header__logo"
          src="{{logoUrl}}"
          mode="{{logoFitMode}}"
          style="{{logoStyle}}"
        />
        <text wx:if="{{showsLogoText && logoText}}" class="dsl-brand-header__logo-text" style="{{logoTextStyle}}">{{logoText}}</text>
      </view>

      <view wx:if="{{showDivider}}" class="dsl-brand-header__divider" style="{{dividerStyle}}"></view>

      <view class="dsl-brand-header__text">
        <!-- 空态：Logo 与标题都空时的占位，避免顶栏塌成 0 高 -->
        <view wx:if="{{isBlank}}" class="dsl-brand-header__blank">点击配置品牌信息</view>
        <block wx:else>
          <text class="dsl-brand-header__title" style="{{titleStyle}}">{{titleText}}</text>
          <text wx:if="{{subtitleText}}" class="dsl-brand-header__subtitle" style="{{subtitleStyle}}">{{subtitleText}}</text>
        </block>
      </view>

      <!-- 右侧快捷入口 -->
      <view wx:if="{{showAction}}" class="dsl-brand-header__action" bindtap="onTapAction">
        <text class="dsl-brand-header__action-icon">{{actionGlyph}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{fixedTop}}" class="dsl-brand-header__spacer" style="height:{{totalHeight}}px;"></view>
</view>
