<!-- components/coupon-sheet/coupon-sheet.wxml -->
<view class="mask" wx:if="{{show}}" catchtouchmove="noop" bindtap="onClose"></view>
<view class="sheet {{show ? 'on' : ''}}" wx:if="{{show}}" catchtouchmove="noop">
  <view class="h">
    <text>选择优惠券</text>
    <text class="x" bindtap="onClose">✕</text>
  </view>
  <scroll-view scroll-y class="b">
    <view wx:if="{{!coupons.length}}" class="empty">暂无优惠券</view>
    <view
      wx:for="{{coupons}}"
      wx:key="id"
      class="c {{item.usable ? '' : 'disabled'}} {{selectedId == item.id ? 'on' : ''}}"
      data-id="{{item.id}}"
      data-usable="{{item.usable}}"
      bindtap="onPick"
    >
      <view class="amt">{{item.label}}</view>
      <view class="meta">
        <view class="n">{{item.name}}</view>
        <view class="d">{{item.desc}}</view>
        <view class="tag" wx:if="{{!item.usable}}">{{item.disableReason || '本商品不可用'}}</view>
      </view>
      <text class="ck" wx:if="{{item.usable}}">{{selectedId == item.id ? '●' : '○'}}</text>
      <text class="ck muted" wx:else>—</text>
    </view>
    <view
      wx:if="{{coupons.length}}"
      class="c {{!selectedId ? 'on' : ''}}"
      data-id=""
      data-usable="{{true}}"
      bindtap="onPick"
    >
      <view class="meta"><view class="n">不使用优惠券</view></view>
      <text class="ck">{{!selectedId ? '●' : '○'}}</text>
    </view>
  </scroll-view>
  <view class="f"><view class="btn" bindtap="onConfirm">确定</view></view>
</view>
