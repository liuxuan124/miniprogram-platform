/* components/coupon-sheet/coupon-sheet.wxss */
.mask { position:fixed; inset:0; background:rgba(10,13,20,.45); z-index:90; }
.sheet { position:fixed; left:0; right:0; bottom:0; max-height:70%; background:#fff; border-radius:40rpx 40rpx 0 0; z-index:91; transform:translateY(110%); transition:transform .28s cubic-bezier(.32,.72,0,1); display:flex; flex-direction:column; padding-bottom:env(safe-area-inset-bottom); }
.sheet.on { transform:none; }
.h { display:flex; align-items:center; padding:28rpx 32rpx 12rpx; font-size:32rpx; font-weight:700; }
.x { margin-left:auto; color:var(--ink-300); font-size:34rpx; }
.b { flex:1; max-height:50vh; padding:0 32rpx 16rpx; }
.c { display:flex; align-items:center; gap:16rpx; padding:24rpx; border:2rpx solid var(--line); border-radius:24rpx; margin-bottom:16rpx; }
.c.on { border-color:var(--brand); background:var(--brand-50); }
.amt { min-width:120rpx; color:var(--accent); font-weight:800; font-size:32rpx; }
.meta { flex:1; min-width:0; }
.n { font-size:28rpx; font-weight:600; }
.d { margin-top:6rpx; font-size:22rpx; color:var(--ink-300); }
.ck { color:var(--brand); }
.f { padding:16rpx 32rpx 28rpx; }
.btn { height:88rpx; border-radius:999rpx; background:var(--brand); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; }
