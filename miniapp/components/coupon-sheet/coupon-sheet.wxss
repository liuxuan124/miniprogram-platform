/* components/coupon-sheet/coupon-sheet.wxss */
.mask { position:fixed; inset:0; background:rgba(10,13,20,.45); z-index:200; }
.sheet {
  position:fixed; left:0; right:0; bottom:0; max-height:70%;
  background:#fff; border-radius:40rpx 40rpx 0 0; z-index:201;
  display:flex; flex-direction:column;
  padding-bottom:env(safe-area-inset-bottom);
}
.h { display:flex; align-items:center; padding:28rpx 32rpx 12rpx; font-size:32rpx; font-weight:700; }
.x { margin-left:auto; color:var(--ink-300, #98a1b3); font-size:34rpx; padding:8rpx; }
.b { flex:1; max-height:50vh; padding:0 32rpx 16rpx; box-sizing:border-box; }
.empty {
  padding:80rpx 0; text-align:center; color:var(--ink-300, #98a1b3); font-size:28rpx;
}
.c {
  display:flex; align-items:center; gap:16rpx; padding:24rpx;
  border:2rpx solid var(--line, #e7ebf3); border-radius:24rpx; margin-bottom:16rpx;
  background:#fff;
}
.c.on { border-color:var(--brand, #315efb); background:var(--brand-50, #eef2ff); }
.c.disabled {
  opacity:.55; background:#f5f6f8; border-color:#e8eaee;
}
.c.disabled .amt { color:#b0b6c3; }
.c.disabled .n, .c.disabled .d { color:#9aa3b2; }
.amt { min-width:120rpx; color:var(--accent, #ff4d4f); font-weight:800; font-size:32rpx; }
.meta { flex:1; min-width:0; }
.n { font-size:28rpx; font-weight:600; color:#172033; }
.d { margin-top:6rpx; font-size:22rpx; color:var(--ink-300, #98a1b3); }
.tag {
  margin-top:8rpx; display:inline-block; font-size:20rpx; color:#9aa3b2;
  background:#eef0f4; padding:4rpx 12rpx; border-radius:999rpx;
}
.ck { color:var(--brand, #315efb); font-size:28rpx; }
.ck.muted { color:#c5cad3; }
.f { padding:16rpx 32rpx 28rpx; }
.btn {
  height:88rpx; border-radius:999rpx; background:var(--brand, #315efb); color:#fff;
  display:flex; align-items:center; justify-content:center; font-weight:700;
}
