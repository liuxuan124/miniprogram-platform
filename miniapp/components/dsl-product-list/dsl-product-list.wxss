/* components/dsl-product-list/dsl-product-list.wxss — 商品列表组件样式 */

.dsl-product-list {
  width: 100%;
  padding: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.dsl-product-list__section-title {
  margin-bottom: 16rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 600;
}

.dsl-product-list__section-header {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin: 0 0 20rpx;
  padding: 4rpx 0 4rpx;
  box-sizing: border-box;
  position: relative;
}

.dsl-product-list__section-header--center {
  justify-content: center;
  text-align: center;
}

.dsl-product-list__section-header--center .dsl-product-list__section-bars,
.dsl-product-list__section-header--plain .dsl-product-list__section-bars,
.dsl-product-list__section-header--card .dsl-product-list__section-bars {
  display: none;
}

.dsl-product-list__section-header--bar {
  align-items: center;
  margin: -20rpx -20rpx 16rpx;
  padding: 22rpx 28rpx 22rpx 24rpx;
  min-height: 96rpx;
  border-left: none;
  border-radius: 0;
  background-color: #002FA7;
  background-image: linear-gradient(90deg, rgba(0, 47, 167, 0.5) 0%, rgba(26, 75, 191, 0.22) 42%, rgba(42, 91, 201, 0.06) 100%), url('/images/section-bar-tech-bg.jpg'), linear-gradient(90deg, #002FA7 0%, #1A4BBF 52%, #2A5BC9 100%);
  background-size: cover, cover, auto;
  background-position: center, center bottom, center;
  background-repeat: no-repeat;
}

.dsl-product-list__section-header--bar .dsl-product-list__section-main {
  color: #f3f7fc;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.35);
}

.dsl-product-list__section-header--bar .dsl-product-list__section-sub {
  color: #e8eeff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.28);
}

.dsl-product-list__section-header--bar .dsl-product-list__section-bar {
  background: #B8D0FF;
}

.dsl-product-list__section-header--bar.dsl-product-list__section-header--divider::after {
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.14);
}

.dsl-product-list__section-header--card {
  padding: 20rpx 24rpx;
  border-radius: 0;
  background: linear-gradient(90deg, #f3f7ff 0%, #ffffff 70%);
  border: 1rpx solid #e8eef8;
}

.dsl-product-list__section-bars {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 6rpx;
  width: 18rpx;
  flex-shrink: 0;
  min-height: 36rpx;
  height: 36rpx;
}

.dsl-product-list__section-bar {
  width: 6rpx;
  border-radius: 2rpx;
  background: #1769ff;
}

.dsl-product-list__section-bar--down {
  height: 72%;
  align-self: flex-start;
}

.dsl-product-list__section-bar--up {
  height: 72%;
  align-self: flex-end;
}

.dsl-product-list__section-text {
  min-width: 0;
  flex: 1;
}

.dsl-product-list__section-more {
  flex-shrink: 0;
  align-self: center;
  margin-left: auto;
  font-size: 24rpx;
  line-height: 1.2;
  color: #d4e2ff;
  white-space: nowrap;
}

.dsl-product-list__section-header--center .dsl-product-list__section-more {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  margin-left: 0;
}

.dsl-product-list__section-header--plain .dsl-product-list__section-more,
.dsl-product-list__section-header--card .dsl-product-list__section-more {
  color: #7b8798;
}

.dsl-product-list__section-header--divider {
  position: relative;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: none;
}

.dsl-product-list__section-header--divider::after {
  content: '';
  position: absolute;
  left: -20rpx;
  right: -20rpx;
  bottom: 0;
  height: 1rpx;
  background: #e8edf5;
}

.dsl-product-list__section-header--card.dsl-product-list__section-header--divider {
  border-bottom: none;
}

/* 渐变条上下内边距保持一致（覆盖 divider 可能拉大的底部） */
.dsl-product-list__section-header--bar {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.dsl-product-list__section-header--bar.dsl-product-list__section-header--divider {
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

.dsl-product-list__section-main {
  display: block;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.dsl-product-list__section-sub {
  display: block;
  margin-top: 4rpx;
  color: #7b8798;
  font-size: 22rpx;
  line-height: 1.4;
}

.dsl-product-list__grid {
  display: grid;
  gap: 16rpx;
}

.dsl-product-list__item {
  background-color: #ffffff;
  overflow: hidden;
  border: 1rpx solid #edf1f7;
  border-radius: 0;
  box-shadow: none;
}

.dsl-product-list__item-image {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  display: block;
}

.dsl-product-list__item-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  background: #f1f5fb;
  font-size: 64rpx;
}

.dsl-product-list__item-info {
  padding: 12rpx;
}

.dsl-product-list__item-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #172033;
  line-height: 1.4;
  height: auto;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dsl-product-list__item-tag {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  background-color: #fff1f0;
  border-radius: 4rpx;
}

.dsl-product-list__item-tag-text {
  font-size: 20rpx;
  color: #ff4d4f;
}

.dsl-product-list__item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 12rpx;
}

.dsl-product-list__item-meta-row {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  overflow: hidden;
}

.dsl-product-list__item-price {
  flex-shrink: 0;
  color: #E53935;
  font-size: 26rpx;
  font-weight: 700;
}

.dsl-product-list__item-sales {
  min-width: 0;
  color: #909399;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dsl-product-list__item-cart {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  font-size: 24rpx;
  background: #fff5f5;
  border: 1rpx solid #fecaca;
  border-radius: 50%;
}

.dsl-product-list__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.dsl-product-list__empty-text {
  font-size: 26rpx;
  color: #999999;
}

.dsl-product-list__grid--list .dsl-product-list__item {
  display: flex;
  flex-direction: row;
}

.dsl-product-list__grid--list .dsl-product-list__item-image,
.dsl-product-list__grid--list .dsl-product-list__item-placeholder {
  width: 200rpx;
  height: 150rpx;
  aspect-ratio: auto;
  flex-shrink: 0;
}

.dsl-product-list__grid--waterfall .dsl-product-list__item:nth-child(odd) .dsl-product-list__item-image,
.dsl-product-list__grid--waterfall .dsl-product-list__item:nth-child(odd) .dsl-product-list__item-placeholder {
  height: auto;
  aspect-ratio: 4 / 3;
}

.dsl-product-list__grid--waterfall .dsl-product-list__item:nth-child(even) .dsl-product-list__item-image,
.dsl-product-list__grid--waterfall .dsl-product-list__item:nth-child(even) .dsl-product-list__item-placeholder {
  height: auto;
  aspect-ratio: 16 / 9;
}
