<!--components/dsl-product-list/dsl-product-list.wxml — 商品列表-->
<view class="dsl-product-list" style="{{styleString}}">
  <!-- 内置标题行：showTitle=false 时整行不渲染（不靠空字符串糊过去） -->
  <view
    class="dsl-product-list__section-header dsl-product-list__section-header--{{sectionStyle}} dsl-product-list__section-header--{{sectionAlign}} {{sectionDivider ? 'has-divider' : ''}}"
    wx:if="{{showTitle && (sectionTitle || sectionSubtitle) && !isEmptyHidden}}"
  >
    <view class="dsl-product-list__section-bars" wx:if="{{sectionStyle === 'bar'}}">
      <view class="dsl-product-list__section-bar is-down"></view>
      <view class="dsl-product-list__section-bar is-up"></view>
    </view>
    <view class="dsl-product-list__section-text">
      <text class="dsl-product-list__section-title" style="{{sectionTitleStyle}}">{{sectionTitle}}</text>
      <text class="dsl-product-list__section-sub" wx:if="{{sectionSubtitle}}" style="{{sectionSubtitleStyle}}">{{sectionSubtitle}}</text>
    </view>
    <text
      class="dsl-product-list__section-more"
      wx:if="{{showMore}}"
      style="{{sectionMoreStyle}}"
      data-link="{{moreLink}}"
      catchtap="onTapMore"
    >{{moreText}}</text>
  </view>

  <view
    class="dsl-product-list__grid dsl-product-list__grid--{{layout}} card-{{cardStyle}}"
    style="{{gridGapStyle}}"
  >
    <!-- 横向单列（旧 list）：横卡 + 正方形图留白 + 标题/副文案/价格评分 -->
    <block wx:if="{{layout === 'row'}}">
      <view
        class="dsl-product-list__row"
        wx:for="{{displayData}}"
        wx:key="_key"
        data-id="{{item.id}}"
        bindtap="onTapProduct"
        style="{{itemCardStyle}}"
      >
        <view class="dsl-product-list__thumb" style="{{itemImageStyle}}">
          <image
            wx:if="{{item._cover}}"
            class="dsl-product-list__thumb-img"
            src="{{item._cover}}"
            mode="aspectFill"
            lazy-load="{{!item._eager}}"
          />
          <view wx:else class="dsl-product-list__thumb-ph" style="{{item._artStyle}}">
            <text>{{item._glyph || '🛍️'}}</text>
          </view>
          <text wx:if="{{item._badge}}" class="dsl-product-list__badge" style="{{badgeStyle}}">{{item._badge}}</text>
        </view>
        <view class="dsl-product-list__body">
          <text wx:if="{{showTitleInCard}}" class="dsl-product-list__row-name text-ellipsis-2" style="{{titleStyle}}">{{item.name || item.title}}</text>
          <text class="dsl-product-list__row-sub" style="{{salesStyle}}">{{item._meta}}</text>
          <view class="dsl-product-list__row-foot">
            <text
              wx:if="{{config.show_price !== false}}"
              class="dsl-product-list__row-price"
              style="{{item._isFree ? freePriceStyle : priceStyle}}"
            >{{item._priceLabel}}</text>
            <text
              wx:if="{{showOriginalPrice && item._originalPrice}}"
              class="dsl-product-list__row-origin"
              style="{{salesStyle}}"
            >¥{{item._originalPrice}}</text>
            <text wx:if="{{showRating}}" class="dsl-product-list__row-rate">{{item._ratingLine}}</text>
            <text wx:elif="{{showSales}}" class="dsl-product-list__row-sales" style="{{salesStyle}}">{{item._salesLabel}}</text>
            <text wx:if="{{ctaText}}" class="dsl-product-list__cta" style="{{ctaStyle}}" data-id="{{item.id}}" catchtap="onCtaTap">{{ctaText}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 宫格 / 瀑布流 / 横向滑动 -->
    <block wx:else>
      <view
        class="dsl-product-list__item {{item._isFree ? 'is-free' : ''}}"
        wx:for="{{displayData}}"
        wx:key="_key"
        data-id="{{item.id}}"
        bindtap="onTapProduct"
        style="{{itemCardStyle}}"
      >
        <view class="dsl-product-list__item-media" style="{{itemImageStyle}}">
          <image
            wx:if="{{item._cover}}"
            class="dsl-product-list__item-image"
            src="{{item._cover}}"
            mode="aspectFill"
            lazy-load="{{!item._eager}}"
          />
          <view wx:else class="dsl-product-list__item-placeholder">
            <text>🛍️</text>
          </view>
          <text wx:if="{{item._badge}}" class="dsl-product-list__badge" style="{{badgeStyle}}">{{item._badge}}</text>
        </view>

        <view class="dsl-product-list__item-info">
          <text wx:if="{{showTitleInCard}}" class="dsl-product-list__item-name text-ellipsis-2" style="{{titleStyle}}">{{item.name || item.title}}</text>
          <view
            class="dsl-product-list__item-tag"
            wx:if="{{config.show_tag && (item.tag || config.tag_text)}}"
          >
            <text class="dsl-product-list__item-tag-text">{{item.tag || config.tag_text}}</text>
          </view>
          <view class="dsl-product-list__item-bottom">
            <view class="dsl-product-list__item-meta-row">
              <text
                wx:if="{{config.show_price !== false}}"
                class="dsl-product-list__item-price"
                style="{{item._isFree ? freePriceStyle : priceStyle}}"
              >{{item._priceLabel}}</text>
              <text
                wx:if="{{showOriginalPrice && item._originalPrice}}"
                class="dsl-product-list__item-origin"
                style="{{salesStyle}}"
              >¥{{item._originalPrice}}</text>
              <text wx:if="{{showSales}}" class="dsl-product-list__item-sales" style="{{salesStyle}}">{{item._salesLabel}}</text>
            </view>
            <text wx:if="{{ctaText}}" class="dsl-product-list__cta" style="{{ctaStyle}}" data-id="{{item.id}}" catchtap="onCtaTap">{{ctaText}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!--
    空态兜底（2026-10-06，与后台 empty_behavior 同口径）：
      · hide（默认）→ 整块不渲染（原来无条件显示「暂无商品」，
        首页位没商品时留个空框比不渲染更难看）
      · placeholder → 渲染缺省图文占位，保留版式高度避免下方内容塌上来
    ⚠️ loadingMore 期间不判空 —— 触底加载时数据短暂为空是正常态，
    闪一下「暂无商品」会被当成加载失败。
  -->
  <view
    class="dsl-product-list__empty"
    wx:if="{{!displayData.length && !loadingMore && emptyBehavior === 'placeholder'}}"
  >
    <text class="dsl-product-list__empty-text">暂无商品</text>
  </view>
  <view class="dsl-product-list__footer" wx:elif="{{footerText}}">
    <text>{{footerText}}</text>
  </view>
</view>
