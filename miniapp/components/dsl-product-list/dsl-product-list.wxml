<!--components/dsl-product-list/dsl-product-list.wxml — 商品列表-->
<view class="dsl-product-list" style="{{styleString}}">
  <view
    class="dsl-product-list__grid dsl-product-list__grid--{{layout}}"
    style="{{gridGapStyle}}"
  >
    <!-- 列表布局：横卡 + 正方形图留白 + 标题/副文案/价格评分 -->
    <block wx:if="{{layout === 'list'}}">
      <view
        class="dsl-product-list__row"
        wx:for="{{displayData}}"
        wx:key="_key"
        data-id="{{item.id}}"
        bindtap="onTapProduct"
        style="{{itemCardStyle}}"
      >
        <view class="dsl-product-list__thumb" style="{{itemImageStyle}}">
          <image
            wx:if="{{item._cover}}"
            class="dsl-product-list__thumb-img"
            src="{{item._cover}}"
            mode="aspectFill"
            lazy-load
          />
          <view wx:else class="dsl-product-list__thumb-ph" style="{{item._artStyle}}">
            <text>{{item._glyph || '🛍️'}}</text>
          </view>
        </view>
        <view class="dsl-product-list__body">
          <text class="dsl-product-list__row-name text-ellipsis-2" style="{{titleStyle}}">{{item.name || item.title}}</text>
          <text class="dsl-product-list__row-sub" style="{{salesStyle}}">{{item._meta}}</text>
          <view class="dsl-product-list__row-foot">
            <text wx:if="{{config.show_price !== false}}" class="dsl-product-list__row-price" style="{{priceStyle}}">{{item._priceLabel}}</text>
            <text wx:if="{{showRating}}" class="dsl-product-list__row-rate">{{item._ratingLine}}</text>
            <text wx:elif="{{config.show_sales !== false}}" class="dsl-product-list__row-sales" style="{{salesStyle}}">{{item._salesLabel}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 宫格 / 瀑布流 -->
    <block wx:else>
      <view
        class="dsl-product-list__item"
        wx:for="{{displayData}}"
        wx:key="_key"
        data-id="{{item.id}}"
        bindtap="onTapProduct"
        style="{{itemCardStyle}}"
      >
        <view class="dsl-product-list__item-media" style="{{itemImageStyle}}">
          <image
            wx:if="{{item._cover}}"
            class="dsl-product-list__item-image"
            src="{{item._cover}}"
            mode="aspectFill"
            lazy-load
          />
          <view wx:else class="dsl-product-list__item-placeholder">
            <text>🛍️</text>
          </view>
        </view>

        <view class="dsl-product-list__item-info">
          <text class="dsl-product-list__item-name text-ellipsis-2" style="{{titleStyle}}">{{item.name || item.title}}</text>
          <view
            class="dsl-product-list__item-tag"
            wx:if="{{config.show_tag && (item.tag || config.tag_text)}}"
          >
            <text class="dsl-product-list__item-tag-text">{{item.tag || config.tag_text}}</text>
          </view>
          <view class="dsl-product-list__item-bottom">
            <view class="dsl-product-list__item-meta-row">
              <text wx:if="{{config.show_price !== false}}" class="dsl-product-list__item-price" style="{{priceStyle}}">{{item._priceLabel}}</text>
              <text wx:if="{{config.show_sales !== false}}" class="dsl-product-list__item-sales" style="{{salesStyle}}">{{item._salesLabel}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="dsl-product-list__empty" wx:if="{{!displayData.length && !loadingMore}}">
    <text class="dsl-product-list__empty-text">暂无商品</text>
  </view>
  <view class="dsl-product-list__footer" wx:elif="{{footerText}}">
    <text>{{footerText}}</text>
  </view>
</view>
