/* components/dsl-notice-bar/dsl-notice-bar.wxss */
.dsl-notice {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  background: #FFF9E6;
  border: 1rpx solid #FFE082;
  border-radius: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.dsl-notice__icon {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1;
}

.dsl-notice__title {
  flex-shrink: 0;
  font-size: 0.92em;
  font-weight: 700;
}

.dsl-notice__viewport {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.dsl-notice__viewport--vertical {
  height: 1.4em;
}

.dsl-notice__track {
  display: inline-flex;
  white-space: nowrap;
  animation-name: dsl-notice-marquee;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.dsl-notice__text {
  padding-right: 80rpx;
  white-space: nowrap;
  line-height: 1.4;
}

.dsl-notice__text--static {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dsl-notice__more,
.dsl-notice__close {
  flex-shrink: 0;
  opacity: 0.75;
  font-size: 28rpx;
  line-height: 1;
}

.dsl-notice__close {
  width: 36rpx;
  text-align: center;
}

@keyframes dsl-notice-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
