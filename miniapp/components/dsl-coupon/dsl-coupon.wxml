<!--components/dsl-coupon/dsl-coupon.wxml — 优惠券组件-->
<view class="dsl-coupon {{layoutClass}}" style="{{styleString}}">
  <view class="dsl-coupon__header" wx:if="{{title}}">
    <text class="dsl-coupon__title" style="{{titleStyle}}">{{title}}</text>
    <text class="dsl-coupon__more" bindtap="onMoreTap">更多</text>
  </view>

  <view class="dsl-coupon__list">
    <view
      class="dsl-coupon__item {{item.claimed ? 'dsl-coupon__item--claimed' : ''}}"
      wx:for="{{displayCoupons}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-index="{{index}}"
      bindtap="onTapCoupon"
    >
      <view class="dsl-coupon__item-left">
        <text class="dsl-coupon__item-amount">{{item.displayValue}}</text>
      </view>
      <view class="dsl-coupon__item-right">
        <text class="dsl-coupon__item-name">{{item.name}}</text>
        <text class="dsl-coupon__item-condition">{{item.condition}}</text>
        <text class="dsl-coupon__item-expire" wx:if="{{item.expireText}}">{{item.expireText}}</text>
      </view>
      <view class="dsl-coupon__item-action">
        <text class="dsl-coupon__item-btn">
          {{item.claimed ? '已领取' : (claimingId == item.id ? '领取中' : (item.button_text || '领取'))}}
        </text>
      </view>
    </view>
  </view>

  <view class="dsl-coupon__empty" wx:if="{{!displayCoupons.length}}">
    <text class="dsl-coupon__empty-text">暂无优惠券</text>
  </view>
</view>
