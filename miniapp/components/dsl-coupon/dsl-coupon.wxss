/* components/dsl-coupon/dsl-coupon.wxss — 优惠券组件样式 */

.dsl-coupon {
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.dsl-coupon__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dsl-coupon__title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
}

.dsl-coupon__more {
  color: #94a3b8;
  font-size: 24rpx;
}

.dsl-coupon__list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dsl-coupon--horizontal .dsl-coupon__list {
  flex-direction: row;
  overflow-x: auto;
}

.dsl-coupon--horizontal .dsl-coupon__item {
  flex: 0 0 420rpx;
}

.dsl-coupon__item {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 108rpx;
  overflow: hidden;
  background-color: #fff6f6;
  border: 1rpx solid #ffd6d6;
  border-radius: 12rpx;
}

.dsl-coupon__item--claimed {
  opacity: 0.72;
}

.dsl-coupon__item-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 160rpx;
  min-height: 108rpx;
  color: #f0646a;
  border-right: 1rpx dashed #ffd6d6;
}

.dsl-coupon__item-amount {
  color: #f0646a;
  font-size: 40rpx;
  font-weight: 700;
}

.dsl-coupon__item-right {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding: 16rpx 20rpx;
}

.dsl-coupon__item-name {
  overflow: hidden;
  color: #172033;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dsl-coupon__item-condition {
  margin-top: 4rpx;
  color: #8b95a5;
  font-size: 22rpx;
}

.dsl-coupon__item-expire {
  margin-top: 4rpx;
  color: #999;
  font-size: 20rpx;
}

.dsl-coupon__item-action {
  flex-shrink: 0;
  padding-right: 20rpx;
}

.dsl-coupon__item-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 48rpx;
  padding: 0 18rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  background: #f3656c;
  border-radius: 999rpx;
}

.dsl-coupon__item--claimed .dsl-coupon__item-btn {
  background: #cbd5e1;
}

.dsl-coupon__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.dsl-coupon__empty-text {
  color: #999;
  font-size: 26rpx;
}

.dsl-coupon--stack .dsl-coupon__list {
  gap: 12rpx;
}

.dsl-coupon--stack .dsl-coupon__item {
  min-height: 96rpx;
}

.dsl-coupon--vertical .dsl-coupon__list {
  flex-direction: column;
}
