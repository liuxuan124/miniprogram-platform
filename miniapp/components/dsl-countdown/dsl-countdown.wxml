<!--components/dsl-countdown/dsl-countdown.wxml — 倒计时组件-->
<view class="dsl-countdown dsl-countdown--{{styleType}}" style="{{styleString}}">
  <text class="dsl-countdown__title" style="{{titleStyle}}">{{displayTitle}}</text>

  <view wx:if="{{!hasEndTime}}" class="dsl-countdown__hint">请设置结束时间</view>

  <view wx:elif="{{isExpired}}" class="dsl-countdown__expired">
    <text class="dsl-countdown__expired-text">{{endText}}</text>
  </view>

  <view wx:else class="dsl-countdown__digits">
    <block wx:if="{{showDays}}">
      <view class="dsl-countdown__block">
        <text class="dsl-countdown__number">{{days}}</text>
      </view>
      <text class="dsl-countdown__unit">天</text>
    </block>
    <block wx:if="{{showHours}}">
      <view class="dsl-countdown__block">
        <text class="dsl-countdown__number">{{hours}}</text>
      </view>
      <text class="dsl-countdown__unit">时</text>
    </block>
    <block wx:if="{{showMinutes}}">
      <view class="dsl-countdown__block">
        <text class="dsl-countdown__number">{{minutes}}</text>
      </view>
      <text class="dsl-countdown__unit">分</text>
    </block>
    <block wx:if="{{showSeconds}}">
      <view class="dsl-countdown__block">
        <text class="dsl-countdown__number">{{seconds}}</text>
      </view>
      <text class="dsl-countdown__unit">秒</text>
    </block>
  </view>
</view>
