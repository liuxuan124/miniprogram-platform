<view
  wx:if="{{mounted}}"
  class="login-overlay {{visible ? 'login-overlay--visible' : ''}}"
>
  <view class="login-mask" catchtap="onCancelLogin" catchtouchmove="noop"></view>

  <view class="login-sheet" catchtouchmove="noop">
    <view class="sheet-top">
      <view class="sheet-handle"></view>
      <view
        class="sheet-close"
        catchtap="onCancelLogin"
        hover-class="sheet-close--pressed"
        aria-label="关闭登录"
      >✕</view>
    </view>

    <view class="brand-block">
      <image
        wx:if="{{brandLogoUrl}}"
        class="brand-mark brand-mark--img"
        src="{{brandLogoUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="brand-mark">{{brandMark}}</view>
      <view class="brand-copy">
        <text class="brand-name">{{brandName}}</text>
        <text class="brand-tagline">{{brandTagline}}</text>
      </view>
    </view>

    <view class="profile-panel {{avatarError || nicknameError ? 'profile-panel--error' : ''}}">
      <view class="profile-panel__row profile-panel__row--avatar {{avatarError ? 'profile-panel__row--invalid' : ''}}">
        <text class="profile-panel__label">头像</text>
        <button
          class="profile-panel__avatar-btn"
          open-type="chooseAvatar"
          bindtap="onAvatarTap"
          bindchooseavatar="onChooseAvatar"
          hover-class="profile-panel__avatar-btn--pressed"
          aria-label="{{avatarUrl ? '更换头像' : '选择头像'}}"
        >
          <image
            wx:if="{{avatarUrl}}"
            class="profile-panel__avatar"
            src="{{avatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="profile-panel__avatar profile-panel__avatar--empty">+</view>
        </button>
      </view>

      <view class="profile-panel__divider"></view>

      <view class="profile-panel__row profile-panel__row--nickname {{nicknameError ? 'profile-panel__row--invalid' : ''}}">
        <text class="profile-panel__label">昵称</text>
        <input
          class="profile-panel__nickname {{nicknameError ? 'profile-panel__nickname--error' : ''}}"
          type="nickname"
          maxlength="20"
          placeholder="点击填写昵称"
          placeholder-class="profile-panel__nickname-ph"
          value="{{nickName}}"
          disabled="{{pickingAvatar}}"
          focus="{{nicknameFocused}}"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
          bindnicknamereview="onNicknameReview"
        />
      </view>

      <view class="profile-panel__divider"></view>

      <view class="profile-panel__row profile-panel__row--phone">
        <text class="profile-panel__label">手机号</text>
        <text class="profile-panel__hint">点击授权手机号</text>
        <button
          wx:if="{{agreePrivacy}}"
          class="profile-panel__phone-trigger"
          open-type="getPhoneNumber"
          bindgetphonenumber="onOneTapLogin"
          disabled="{{loading}}"
          hover-class="profile-panel__row--pressed"
          aria-label="授权手机号"
        ></button>
        <button
          wx:else
          class="profile-panel__phone-trigger"
          bindtap="onPhoneRowTap"
          hover-class="profile-panel__row--pressed"
          aria-label="授权手机号"
        ></button>
      </view>
    </view>

    <view class="agreement {{privacyError ? 'agreement--error' : ''}} {{agreePrivacy ? 'agreement--on' : ''}}">
      <button
        wx:if="{{!agreePrivacy}}"
        id="privacy-agree-btn-form"
        class="agreement__check-btn"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
        hover-class="none"
        aria-label="同意用户协议与隐私政策"
      >
        <view class="agreement__check"></view>
      </button>
      <view
        wx:else
        class="agreement__check agreement__check--active"
        catchtap="onUncheckPrivacy"
        aria-label="取消同意用户协议与隐私政策"
      >
        <text>✓</text>
      </view>
      <view class="agreement__copy">
        <text class="agreement__text">已阅读并同意</text>
        <text class="agreement__link" catchtap="onViewTerms">《用户协议》</text>
        <text class="agreement__text">与</text>
        <text class="agreement__link" catchtap="onViewPrivacy">《隐私政策》</text>
      </view>
    </view>

    <text wx:if="{{formHint}}" class="form-hint">{{formHint}}</text>

    <button
      class="login-primary {{loading ? 'login-primary--disabled' : ''}} {{canSubmit ? '' : 'login-primary--pending'}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="onOneTapLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
      hover-class="login-primary--pressed"
    >
      {{loading ? '正在登录…' : '手机号快捷登录'}}
    </button>

    <button
      class="login-cancel"
      bindtap="onCancelLogin"
      disabled="{{loading}}"
      hover-class="login-cancel--pressed"
    >暂不登录</button>

    <view class="skip-hint">未登录也可浏览公开内容</view>
  </view>

  <view wx:if="{{showPrivacyPopup}}" class="privacy-layer" catchtouchmove="noop">
    <view class="privacy-layer__mask" catchtap="onRefusePrivacy"></view>
    <view class="privacy-layer__panel">
      <text class="privacy-layer__title">用户隐私保护提示</text>
      <view class="privacy-layer__desc">
        <text>在使用头像、昵称前，请阅读并同意</text>
        <text class="privacy-layer__link" catchtap="onViewPrivacy">《隐私政策》</text>
        <text>与</text>
        <text class="privacy-layer__link" catchtap="onViewTerms">《用户协议》</text>
      </view>
      <button
        id="privacy-agree-btn"
        class="privacy-layer__agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
        hover-class="privacy-layer__agree--pressed"
      >同意并继续</button>
      <button class="privacy-layer__refuse" bindtap="onRefusePrivacy" hover-class="none">不同意</button>
    </view>
  </view>
</view>
