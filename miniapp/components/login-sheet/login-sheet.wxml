<view
  wx:if="{{mounted}}"
  class="login-overlay {{visible ? 'login-overlay--visible' : ''}}"
>
  <view class="login-mask" catchtap="hide" catchtouchmove="noop"></view>

  <view class="login-sheet" catchtouchmove="noop">
    <view class="sheet-handle"></view>

    <view class="sheet-heading">
      <view class="sheet-heading__copy">
        <text class="sheet-heading__title">完善个人资料</text>
        <text class="sheet-heading__description">
          {{interceptAction ? '登录后即可' + interceptAction : '首次登录只需完成一次'}}
        </text>
      </view>
      <view class="sheet-heading__actions">
        <view class="security-badge">
          <text class="security-badge__dot"></text>
          <text>安全登录</text>
        </view>
        <view class="close-button" catchtap="hide" aria-label="关闭">×</view>
      </view>
    </view>

    <view class="avatar-section {{avatarError ? 'avatar-section--error' : ''}}">
      <button
        class="profile-avatar"
        open-type="chooseAvatar"
        bindtap="onAvatarTap"
        bindchooseavatar="onChooseAvatar"
        hover-class="profile-avatar--pressed"
        aria-label="选择微信头像"
      >
        <image
          class="profile-avatar__image"
          src="{{avatarUrl || '/images/default-avatar.svg'}}"
          mode="aspectFill"
        />
        <view class="profile-avatar__action">{{avatarUrl ? '↻' : '+'}}</view>
      </button>
      <text class="avatar-section__hint">{{avatarUrl ? '点击可更换微信头像' : '点击直接选择微信头像'}}</text>
    </view>

    <view class="nickname-section">
      <view class="nickname-control {{nicknameError ? 'nickname-control--error' : ''}} {{pickingAvatar ? 'nickname-control--locked' : ''}}">
        <text class="nickname-control__label">昵称</text>
        <view class="nickname-control__divider"></view>
        <input
          class="nickname-control__input"
          type="nickname"
          maxlength="20"
          placeholder="点击填写或选择微信昵称"
          placeholder-class="nickname-control__placeholder"
          value="{{nickName}}"
          disabled="{{pickingAvatar}}"
          focus="{{nicknameFocused}}"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
          bindnicknamereview="onNicknameReview"
        />
      </view>
    </view>

    <button
      wx:if="{{!agreePrivacy}}"
      id="privacy-agree-btn-form"
      class="agreement {{privacyError ? 'agreement--error' : ''}}"
      open-type="agreePrivacyAuthorization"
      bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
      hover-class="none"
    >
      <view class="agreement__check">
      </view>
      <view class="agreement__copy">
        <text>我已阅读并同意</text>
        <text class="agreement__link" catchtap="onViewTerms">《用户协议》</text>
        <text>与</text>
        <text class="agreement__link" catchtap="onViewPrivacy">《隐私政策》</text>
      </view>
    </button>
    <button
      wx:else
      class="agreement agreement--on"
      bindtap="onUncheckPrivacy"
      hover-class="none"
    >
      <view class="agreement__check agreement__check--active">
        <text>✓</text>
      </view>
      <view class="agreement__copy">
        <text>我已阅读并同意</text>
        <text class="agreement__link" catchtap="onViewTerms">《用户协议》</text>
        <text>与</text>
        <text class="agreement__link" catchtap="onViewPrivacy">《隐私政策》</text>
      </view>
    </button>

    <text wx:if="{{formHint}}" class="form-hint">{{formHint}}</text>
    <text wx:else class="form-hint form-hint--muted">新用户请先选择头像和昵称；老用户勾选协议后即可登录</text>

    <!-- 始终使用 getPhoneNumber，避免审核判定「手机号授权无响应」 -->
    <button
      class="login-button {{loading ? 'login-button--disabled' : ''}} {{canSubmit ? '' : 'login-button--pending'}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="onOneTapLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
      hover-class="login-button--pressed"
    >
      <text class="login-button__title">{{loading ? '正在登录…' : '手机号快捷登录'}}</text>
    </button>

    <text class="privacy-note">手机号仅用于登录和必要的服务通知，不会公开展示</text>
  </view>

  <view wx:if="{{showPrivacyPopup}}" class="privacy-layer" catchtouchmove="noop">
    <view class="privacy-layer__mask" catchtap="onRefusePrivacy"></view>
    <view class="privacy-layer__panel">
      <text class="privacy-layer__title">用户隐私保护提示</text>
      <view class="privacy-layer__desc">
        <text>在使用头像、昵称前，请阅读并同意</text>
        <text class="privacy-layer__link" catchtap="onViewPrivacy">《隐私政策》</text>
        <text>与</text>
        <text class="privacy-layer__link" catchtap="onViewTerms">《用户协议》</text>
      </view>
      <button
        id="privacy-agree-btn"
        class="privacy-layer__agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
        hover-class="privacy-layer__agree--pressed"
      >同意并继续</button>
      <button class="privacy-layer__refuse" bindtap="onRefusePrivacy" hover-class="none">不同意</button>
    </view>
  </view>
</view>
