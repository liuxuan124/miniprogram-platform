<view
  wx:if="{{mounted}}"
  class="login-overlay {{visible ? 'login-overlay--visible' : ''}}"
  catchtouchmove="noop"
>
  <view class="login-mask" catchtap="hide"></view>

  <view class="login-sheet" catchtap="noop">
    <view class="sheet-handle"></view>

    <view class="sheet-heading">
      <view class="sheet-heading__copy">
        <text class="sheet-heading__title">完善个人资料</text>
        <text class="sheet-heading__description">
          {{interceptAction ? '登录后即可' + interceptAction : '首次登录只需完成一次'}}
        </text>
      </view>
      <view class="sheet-heading__actions">
        <view class="security-badge">
          <text class="security-badge__dot"></text>
          <text>安全登录</text>
        </view>
        <view class="close-button" catchtap="hide" aria-label="关闭">×</view>
      </view>
    </view>

    <view class="avatar-section {{avatarError ? 'avatar-section--error' : ''}}">
      <button
        class="profile-avatar"
        bindtap="onChooseAvatarTap"
        hover-class="profile-avatar--pressed"
        aria-label="选择头像"
      >
        <image
          class="profile-avatar__image"
          src="{{avatarUrl || '/images/default-avatar.svg'}}"
          mode="aspectFill"
        />
        <view class="profile-avatar__action">{{avatarUrl ? '↻' : '+'}}</view>
      </button>
      <text class="avatar-section__hint">{{avatarUrl ? '点击头像可重新选择' : '点击选择头像'}}</text>
    </view>

    <view class="nickname-section">
      <view class="nickname-control {{nicknameError ? 'nickname-control--error' : ''}}">
        <text class="nickname-control__label">昵称</text>
        <view class="nickname-control__divider"></view>
        <input
          class="nickname-control__input"
          type="nickname"
          maxlength="20"
          placeholder="请输入昵称"
          placeholder-class="nickname-control__placeholder"
          value="{{nickName}}"
          disabled="{{!nicknameEditing}}"
          focus="{{nicknameFocused}}"
          bindfocus="onNicknameInputFocus"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
          bindnicknamereview="onNicknameReview"
        />
        <button
          wx:if="{{!nicknameEditing}}"
          class="nickname-control__tap"
          catchtap="onNicknameOptionsTap"
          hover-class="none"
          aria-label="选择昵称填写方式"
        ></button>
      </view>
    </view>

    <view class="agreement {{privacyError ? 'agreement--error' : ''}}" bindtap="onTogglePrivacy">
      <view class="agreement__check {{agreePrivacy ? 'agreement__check--active' : ''}}">
        <text wx:if="{{agreePrivacy}}">✓</text>
      </view>
      <view class="agreement__copy">
        <text>我已阅读并同意</text>
        <text class="agreement__link" catchtap="onViewTerms">《用户协议》</text>
        <text>与</text>
        <text class="agreement__link" catchtap="onViewPrivacy">《隐私政策》</text>
      </view>
    </view>

    <text wx:if="{{formHint}}" class="form-hint">{{formHint}}</text>

    <button
      wx:if="{{canSubmit}}"
      class="login-button {{loading ? 'login-button--disabled' : ''}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="onOneTapLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
      hover-class="login-button--pressed"
    >
      <text class="login-button__title">{{loading ? '正在登录…' : '手机号快捷登录'}}</text>
    </button>
    <button
      wx:else
      class="login-button login-button--pending"
      bindtap="onPrecheckLogin"
      hover-class="login-button--pressed"
    >
      <text class="login-button__title">手机号快捷登录</text>
    </button>

    <text class="privacy-note">手机号仅用于登录和必要的服务通知，不会公开展示</text>
  </view>

  <view wx:if="{{showAvatarOptions}}" class="source-layer" catchtouchmove="noop">
    <view class="source-layer__mask" catchtap="onCloseAvatarOptions"></view>
    <view class="source-sheet" catchtap="noop">
      <button
        class="source-sheet__option source-sheet__option--primary"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >使用微信头像</button>
      <button
        class="source-sheet__option"
        data-source="album"
        bindtap="onChooseMediaSource"
      >从相册选择</button>
      <button
        class="source-sheet__option"
        data-source="camera"
        bindtap="onChooseMediaSource"
      >拍照</button>
      <view class="source-sheet__gap"></view>
      <button class="source-sheet__option source-sheet__cancel" bindtap="onCloseAvatarOptions">取消</button>
    </view>
  </view>
</view>
