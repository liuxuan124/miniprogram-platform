.login-overlay {
  --brand: #315efb;
  --ink: #172033;
  --ink-2: #44506a;
  --ink-3: #7c879d;
  --line: #e7ebf3;
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  visibility: hidden;
  opacity: 0;
  transition: opacity 240ms ease, visibility 240ms ease;
}

.login-overlay--visible {
  visibility: visible;
  opacity: 1;
}

.login-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(11, 18, 33, 0.42);
  backdrop-filter: blur(5rpx);
}

.login-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 54vh;
  max-height: 76vh;
  box-sizing: border-box;
  padding: 18rpx 38rpx calc(env(safe-area-inset-bottom) + 28rpx);
  overflow-y: auto;
  background: #fff;
  border: 1rpx solid rgba(222, 227, 239, 0.92);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -22rpx 60rpx rgba(23, 32, 51, 0.16);
  transform: translateY(100%);
  transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

.login-overlay--visible .login-sheet {
  transform: translateY(0);
}

.sheet-handle {
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 28rpx;
  background: #dfe4ee;
  border-radius: 999rpx;
}

.sheet-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-heading__copy {
  min-width: 0;
}

.sheet-heading__title {
  display: block;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.sheet-heading__description {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--ink-3);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-heading__actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.security-badge {
  display: flex;
  align-items: center;
  padding: 9rpx 14rpx;
  color: #238963;
  font-size: 18rpx;
  font-weight: 650;
  background: #eaf8f2;
  border-radius: 999rpx;
}

.security-badge__dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 8rpx;
  background: #20a876;
  border-radius: 50%;
  box-shadow: 0 0 0 5rpx rgba(32, 168, 118, 0.1);
}

.close-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-left: 8rpx;
  color: #7c879d;
  font-size: 38rpx;
  font-weight: 300;
}

.avatar-section {
  margin-top: 28rpx;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-heading__label {
  color: var(--ink-2);
  font-size: 21rpx;
  font-weight: 700;
}

.field-heading__state {
  padding: 5rpx 10rpx;
  color: var(--ink-3);
  font-size: 17rpx;
  font-weight: 650;
  background: #f1f3f7;
  border-radius: 999rpx;
}

.field-heading__state--done {
  color: #0a8f6a;
  background: #eaf8f2;
}

.profile-avatar {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  padding: 0;
  margin: 18rpx auto 0;
  overflow: visible;
  background: transparent;
  border: 0;
  line-height: 1;
}

.profile-avatar::after {
  border: 0;
}

.profile-avatar--pressed {
  opacity: 0.68;
}

.profile-avatar__image {
  display: block;
  width: 108rpx;
  height: 108rpx;
  background: #eaf0ff;
  border: 4rpx solid #fff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 26rpx rgba(36, 70, 175, 0.15);
}

.profile-avatar__action {
  position: absolute;
  right: -8rpx;
  bottom: -7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 750;
  background: var(--brand);
  border: 3rpx solid #fff;
  border-radius: 50%;
}

.avatar-section__hint {
  display: block;
  margin-top: 13rpx;
  color: var(--ink-3);
  font-size: 18rpx;
  text-align: center;
}

.avatar-section--error .profile-avatar__image {
  border-color: #ffd2cc;
  box-shadow: 0 0 0 6rpx rgba(255, 91, 74, 0.08);
}

.nickname-section {
  margin-top: 24rpx;
}

.nickname-control {
  position: relative;
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 18rpx 0 22rpx;
  background: #f7f9fd;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  transition: border-color 180ms ease, background 180ms ease;
}

.nickname-control__tap {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: transparent;
  line-height: normal;
}

.nickname-control__tap::after {
  border: none;
}

.nickname-control:active {
  background: #f1f5fd;
}

.nickname-control__label {
  flex-shrink: 0;
  color: var(--ink-2);
  font-size: 21rpx;
  font-weight: 700;
}

.nickname-control__divider {
  flex-shrink: 0;
  width: 1rpx;
  height: 30rpx;
  margin: 0 18rpx;
  background: #dfe4ee;
}

.nickname-control__input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 550;
  opacity: 1;
}

.nickname-control__placeholder {
  color: #a1aabd;
  font-size: 21rpx;
  font-weight: 400;
}

.nickname-control--error {
  background: #fff8f7;
  border-color: #ffb8ae;
}

.agreement {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}

.agreement__check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 31rpx;
  height: 31rpx;
  margin-top: 2rpx;
  color: #fff;
  font-size: 19rpx;
  font-weight: 800;
  background: #fff;
  border: 2rpx solid #b7c0d2;
  border-radius: 9rpx;
}

.agreement__check--active {
  background: var(--brand);
  border-color: var(--brand);
}

.agreement__copy {
  display: flex;
  align-items: center;
  flex: 1;
  flex-wrap: wrap;
  margin-left: 12rpx;
  color: var(--ink-3);
  font-size: 19rpx;
  line-height: 1.6;
}

.agreement__link {
  color: var(--brand);
  font-weight: 650;
}

.agreement--error .agreement__check {
  background: #fff8f7;
  border-color: #ff8f80;
}

.form-hint {
  display: block;
  margin-top: 14rpx;
  color: #db4f3f;
  font-size: 18rpx;
  font-weight: 600;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 94rpx;
  padding: 0 24rpx;
  margin: 22rpx 0 0;
  color: #fff;
  line-height: 1;
  background: linear-gradient(135deg, var(--brand), #5980ff);
  border: 0;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 32rpx rgba(49, 94, 251, 0.25);
}

.login-button::after {
  border: 0;
}

.login-button__title {
  color: inherit;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1;
  text-align: center;
}

.login-button--pending {
  color: var(--brand);
  background: #eef3ff;
  border: 1rpx solid #d9e2ff;
  box-shadow: none;
}

.login-button--pressed {
  opacity: 0.86;
  transform: scale(0.99);
}

.login-button--disabled {
  opacity: 0.7;
  box-shadow: none;
}

.privacy-note {
  display: block;
  margin-top: 18rpx;
  color: #a1a9b9;
  font-size: 18rpx;
  text-align: center;
}

.source-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
}

.source-layer__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(11, 18, 33, 0.34);
}

.source-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  background: #f5f7fb;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -18rpx 54rpx rgba(23, 32, 51, 0.16);
  animation: source-sheet-in 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.source-sheet__option {
  width: 100%;
  height: 98rpx;
  padding: 0;
  margin: 0;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 550;
  line-height: 98rpx;
  background: #fff;
  border: 0;
  border-bottom: 1rpx solid #edf0f5;
  border-radius: 0;
}

.source-sheet__option::after {
  border: 0;
}

.source-sheet__option--primary {
  color: var(--brand);
  font-weight: 700;
}

.source-sheet__gap {
  height: 12rpx;
}

.source-sheet__cancel {
  border-bottom: 0;
  font-weight: 650;
}

@keyframes source-sheet-in {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

@media (max-height: 700px) {
  .login-sheet {
    min-height: 62vh;
    max-height: 84vh;
  }

  .sheet-handle {
    margin-bottom: 20rpx;
  }

  .avatar-section {
    margin-top: 20rpx;
  }

  .profile-avatar,
  .profile-avatar__image {
    width: 92rpx;
    height: 92rpx;
  }

  .nickname-section {
    margin-top: 18rpx;
  }

  .agreement,
  .login-button {
    margin-top: 18rpx;
  }
}
