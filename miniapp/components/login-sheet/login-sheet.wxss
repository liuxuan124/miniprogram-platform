.login-overlay {
  --brand: #315efb;
  --brand-deep: #2446c7;
  --ink: #2a3142;
  --ink-3: #9aa3b5;
  --panel-bg: #f6f3ee;
  --panel-line: rgba(42, 49, 66, 0.08);
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity 240ms ease, visibility 240ms ease;
}

.login-overlay--visible {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
}

.login-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(11, 18, 33, 0.42);
}

.login-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 82vh;
  padding: 12rpx 36rpx calc(env(safe-area-inset-bottom) + 28rpx);
  overflow-y: auto;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -16rpx 48rpx rgba(23, 32, 51, 0.12);
  transform: translateY(100%);
  transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
}

.login-overlay--visible .login-sheet {
  transform: translateY(0);
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 32rpx;
  background: #e5dfd6;
  border-radius: 999rpx;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.brand-mark {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  color: #fff;
  font-size: 38rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--brand), var(--brand-deep));
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(49, 94, 251, 0.24);
}

.brand-mark--img {
  background: #fff;
  object-fit: cover;
}

.brand-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.brand-name {
  display: block;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.brand-tagline {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.4;
}

.profile-panel {
  margin-bottom: 28rpx;
  padding: 8rpx 28rpx;
  background: var(--panel-bg);
  border: 2rpx solid transparent;
  border-radius: 28rpx;
}

.profile-panel--error {
  border-color: #ffb4b4;
  background: #fff8f6;
}

.profile-panel__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
}

.profile-panel__row--profile {
  position: relative;
}

.profile-panel__label {
  flex-shrink: 0;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.3;
}

.profile-panel__right {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  min-width: 0;
  min-height: 64rpx;
}

.profile-panel__hint {
  color: #b8b0a6;
  font-size: 24rpx;
  line-height: 1.35;
  text-align: right;
}

.profile-panel__row--phone {
  position: relative;
}

.profile-panel__row--pressed {
  opacity: 0.88;
}

.profile-panel__phone-trigger {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  margin: 0;
  padding: 0;
  opacity: 0;
  background: transparent;
  border: none;
}

.profile-panel__phone-trigger::after {
  border: none;
}

.profile-panel__avatar-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.profile-panel__avatar-btn::after {
  border: none;
}

.profile-panel__avatar-btn--pressed {
  opacity: 0.85;
}

.profile-panel__avatar {
  display: block;
  width: 52rpx;
  height: 52rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(23, 32, 51, 0.1);
}

.profile-panel__nickname {
  flex: 1;
  min-width: 120rpx;
  max-width: 320rpx;
  height: 56rpx;
  padding: 0 12rpx;
  color: var(--ink);
  font-size: 24rpx;
  text-align: right;
  background: transparent;
}

.profile-panel__nickname-ph {
  color: #b8b0a6;
  font-size: 24rpx;
}

.profile-panel__nickname--error {
  color: #d64545;
}

.profile-panel__avatar-trigger {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  margin: 0;
  padding: 0;
  opacity: 0;
  background: transparent;
  border: none;
}

.profile-panel__avatar-trigger::after {
  border: none;
}

.profile-panel__divider {
  height: 1rpx;
  background: var(--panel-line);
}

.agreement {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 20rpx;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1.45;
  text-align: left;
}

.agreement::after {
  border: none;
}

.agreement__check {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #d0cbc4;
  border-radius: 50%;
}

.agreement--on .agreement__check--active {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
  background: var(--brand);
  border-color: var(--brand);
}

.agreement--error .agreement__check {
  border-color: #ff6b6b;
}

.agreement__copy {
  flex: 1;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.5;
}

.agreement__link {
  color: var(--brand);
}

.form-hint {
  display: block;
  margin: -8rpx 0 16rpx;
  color: #e06a6a;
  font-size: 22rpx;
  line-height: 1.45;
}

.login-primary {
  width: 100%;
  height: 96rpx;
  margin-top: 4rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 96rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-deep));
  border: none;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 28rpx rgba(49, 94, 251, 0.28);
}

.login-primary::after {
  border: none;
}

.login-primary--pending {
  opacity: 0.72;
}

.login-primary--disabled {
  opacity: 0.6;
}

.login-primary--pressed {
  transform: scale(0.985);
  opacity: 0.92;
}

.skip-link {
  margin-top: 28rpx;
  padding: 8rpx 0 4rpx;
  color: #a8a196;
  font-size: 26rpx;
  text-align: center;
}

.privacy-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10000;
}

.privacy-layer__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
}

.privacy-layer__panel {
  position: absolute;
  right: 48rpx;
  bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  left: 48rpx;
  padding: 40rpx 36rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
}

.privacy-layer__title {
  display: block;
  margin-bottom: 16rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.privacy-layer__desc {
  display: block;
  margin-bottom: 28rpx;
  color: #44506a;
  font-size: 26rpx;
  line-height: 1.55;
}

.privacy-layer__link {
  color: var(--brand);
}

.privacy-layer__agree {
  width: 100%;
  height: 88rpx;
  margin-bottom: 12rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 88rpx;
  background: var(--brand);
  border: none;
  border-radius: 999rpx;
}

.privacy-layer__agree::after {
  border: none;
}

.privacy-layer__agree--pressed {
  opacity: 0.9;
}

.privacy-layer__refuse {
  width: 100%;
  height: 72rpx;
  color: var(--ink-3);
  font-size: 28rpx;
  line-height: 72rpx;
  background: transparent;
  border: none;
}

.privacy-layer__refuse::after {
  border: none;
}
