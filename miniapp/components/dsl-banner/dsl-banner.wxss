/* components/dsl-banner/dsl-banner.wxss — 轮播图组件样式 */

.dsl-banner {
  width: auto;
  max-width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

/* 悬浮卡片：左右留白 */
.dsl-banner.layout-card {
  padding-left: 28rpx;
  padding-right: 28rpx;
}

/* 露边画廊：容器不裁切，两侧露出邻卡 */
.dsl-banner.layout-peek {
  overflow: visible;
}

.dsl-banner__wrap {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.dsl-banner__swiper {
  width: 100%;
  display: block;
}

.dsl-banner__swiper--peek {
  overflow: visible;
}

.dsl-banner__item {
  height: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.dsl-banner__inner {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #eef2f7;
}

.dsl-banner__image {
  width: 100%;
  height: 100%;
  display: block;
}

.dsl-banner__fallback {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: var(--card);
  background: linear-gradient(135deg, #1d73ff 0%, #25b9f6 100%);
}

.dsl-banner__orb {
  position: absolute;
  right: -60rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
}

.dsl-banner__fallback-title {
  position: relative;
  z-index: 1;
  color: var(--card);
  font-size: 30rpx;
  font-weight: 800;
}

.dsl-banner__fallback-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  font-weight: 600;
}

/* ---------- 空态 ---------- */
.dsl-banner__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 280rpx;
  background: linear-gradient(135deg, #f6f4f1 0%, #eef1f6 100%);
  border-radius: 12rpx;
}

.dsl-banner__empty-text {
  font-size: 24rpx;
  color: #a89c8d;
}

/* ---------- 蒙层与文字 ---------- */
.dsl-banner__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 52rpx 24rpx 24rpx;
}

.dsl-banner__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 标题最多两行，超出省略 */
.dsl-banner__title {
  display: -webkit-box;
  overflow: hidden;
  font-weight: 700;
  line-height: 1.35;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dsl-banner__desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  line-height: 1.4;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.dsl-banner__cta {
  flex: none;
  margin-left: 12rpx;
  padding: 4rpx 18rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--card);
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
}

/* ---------- 自定义指示器 ---------- */
.dsl-banner__indicator {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 16rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  pointer-events: none;
}

.dsl-banner__indicator.ind-pos-center {
  justify-content: center;
}

.dsl-banner__indicator.ind-pos-right {
  justify-content: flex-end;
}

/* 外置浮动：脱离图片，压在容器下边缘之外 */
.dsl-banner__indicator.ind-pos-outside {
  position: relative;
  bottom: auto;
  left: auto;
  justify-content: flex-end;
  padding: 12rpx 24rpx 0;
}

.dsl-banner__ind-bar {
  width: 12rpx;
  height: 6rpx;
  margin-right: 8rpx;
  border-radius: 999rpx;
  transition: width 0.22s ease, background 0.2s ease;
}

.dsl-banner__ind-bar.is-on {
  width: 36rpx;
  background: #fff;
}

/* 细长线：更细更长 */
.dsl-banner__indicator.ind-line .dsl-banner__ind-bar {
  width: 20rpx;
  height: 4rpx;
}

.dsl-banner__indicator.ind-line .dsl-banner__ind-bar.is-on {
  width: 48rpx;
  background: #fff;
}

/* 胶囊：激活态更宽并用配置色 */
.dsl-banner__indicator.ind-pill .dsl-banner__ind-bar.is-on {
  background: var(--ind-active, #fff);
}

.dsl-banner__indicator.ind-pos-outside .dsl-banner__ind-bar {
  background: #d8d2c8;
}

.dsl-banner__indicator.ind-pos-outside .dsl-banner__ind-bar.is-on {
  background: #c08e6e;
}

.dsl-banner__ind-num {
  font-size: 22rpx;
  font-weight: 700;
}

.dsl-banner__ind-slash {
  padding: 0 4rpx;
  opacity: 0.6;
}
