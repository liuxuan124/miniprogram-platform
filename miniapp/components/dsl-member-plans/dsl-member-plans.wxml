<view class="dsl-member-plans" style="{{styleString}}">
  <view wx:if="{{showBanner}}" class="dsl-member-plans__banner">
    <view class="dsl-member-plans__banner-title">{{bannerTitle}}</view>
    <view class="dsl-member-plans__banner-sub">{{bannerSubtitle}}</view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="dsl-member-plans__state"><view class="dsl-member-plans__sk" /><view class="dsl-member-plans__sk" /></view>
  <view wx:elif="{{state === 'error'}}" class="dsl-member-plans__state"><text>加载失败</text><view bindtap="reload">重试</view></view>
  <view wx:elif="{{state === 'empty'}}" class="dsl-member-plans__state">暂无方案</view>
  <scroll-view wx:else scroll-x="{{scrollDirection === 'horizontal'}}" class="dsl-member-plans__cards dsl-member-plans__cards--{{scrollDirection}}">
    <view wx:for="{{plans}}" wx:key="id" class="dsl-member-plans__card {{item.recommend ? 'is-rec' : ''}}">
      <view wx:if="{{item.recommend}}" class="dsl-member-plans__badge">{{badgeText}}</view>
      <view class="dsl-member-plans__name">{{item.name}}</view>
      <view class="dsl-member-plans__price">{{item.priceText}}</view>
      <view wx:for="{{item.rights}}" wx:for-item="r" wx:key="*this" class="dsl-member-plans__right">· {{r}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{showAgreement}}" class="dsl-member-plans__agreement">{{agreementText}}</view>
  <view wx:if="{{iosAlt}}" class="dsl-member-plans__ios">{{iosAlt}}</view>
  <view class="dsl-member-plans__bar"><view class="dsl-member-plans__btn" bindtap="onCheckout">立即开通</view></view>
</view>
