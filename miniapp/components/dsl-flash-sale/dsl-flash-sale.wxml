<view class="dsl-flash" style="{{styleString}}">
  <view class="dsl-flash__head">
    <text class="dsl-flash__title" style="{{titleStyle}}">{{config.title || '限时秒杀'}}</text>
    <text wx:if="{{config.countdown !== false && countdownText}}" class="dsl-flash__countdown {{isExpired ? 'dsl-flash__countdown--expired' : ''}}">{{countdownText}}</text>
    <text class="dsl-flash__tag">{{isExpired ? '已结束' : '进行中'}}</text>
  </view>
  <view class="dsl-flash__grid">
    <view class="dsl-flash__item" wx:for="{{items}}" wx:key="index">
      <view class="dsl-flash__img">🔥</view>
      <view class="dsl-flash__name" style="{{titleStyle}}">{{item.name}}</view>
      <view class="dsl-flash__price" style="{{metaStyle}}">¥{{item.price}}</view>
    </view>
  </view>
</view>
