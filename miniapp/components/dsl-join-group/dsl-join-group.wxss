/* components/dsl-join-group/dsl-join-group.wxss */
.dsl-jg {
  width: auto;
  max-width: 100%;
  box-sizing: border-box;
}

.dsl-jg__card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf5;
  box-shadow: 0 8rpx 28rpx rgba(28, 43, 76, 0.05);
  box-sizing: border-box;
}

.dsl-jg__avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 0;
  background: #eef3ff;
}

.dsl-jg__avatar image {
  width: 100%;
  height: 100%;
}

.dsl-jg__avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 44rpx;
}

.dsl-jg__main {
  flex: 1;
  min-width: 0;
}

.dsl-jg__title {
  display: block;
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dsl-jg__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.dsl-jg__tag {
  padding: 2rpx 16rpx;
  color: #3b6cff;
  font-size: 22rpx;
  line-height: 1.5;
  border: 1rpx solid #b7c9ff;
  border-radius: 999rpx;
}

.dsl-jg__btn {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  background: #2f6bff;
  border-radius: 999rpx;
}

.dsl-jg-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.dsl-jg-mask--center {
  align-items: center;
}

.dsl-jg-mask__bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
}

.dsl-jg-sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 70vh;
  padding: 28rpx 32rpx 40rpx;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  box-sizing: border-box;
}

.dsl-jg-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dsl-jg-sheet__title {
  color: #5b8cff;
  font-size: 32rpx;
  font-weight: 700;
}

.dsl-jg-sheet__close {
  width: 56rpx;
  height: 56rpx;
  color: #94a3b8;
  font-size: 44rpx;
  line-height: 56rpx;
  text-align: center;
}

.dsl-jg-sheet__list {
  max-height: 56vh;
}

.dsl-jg-group {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.dsl-jg-group__icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #ffffff;
  font-size: 36rpx;
  background: #3b82f6;
  border-radius: 20rpx;
}

.dsl-jg-group__icon image {
  width: 100%;
  height: 100%;
}

.dsl-jg-group__name {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 30rpx;
  font-weight: 600;
}

.dsl-jg-group__arrow {
  color: #cbd5e1;
  font-size: 40rpx;
}

.dsl-jg-qr {
  position: relative;
  z-index: 1;
  width: 640rpx;
  max-width: calc(100vw - 80rpx);
  padding: 28rpx 32rpx 36rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.dsl-jg-qr__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.dsl-jg-qr__name {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
}

.dsl-jg-qr__img {
  display: block;
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto;
  background: #ffffff;
  border: 1rpx solid #e8edf5;
  border-radius: 20rpx;
}

.dsl-jg-qr__tip {
  display: block;
  margin-top: 20rpx;
  color: #94a3b8;
  font-size: 24rpx;
  text-align: center;
}

.dsl-jg-qr__save {
  margin: 24rpx auto 0;
  width: fit-content;
  padding: 16rpx 36rpx;
  color: #ffffff;
  font-size: 26rpx;
  background: #2f6bff;
  border-radius: 999rpx;
}

.dsl-jg-empty {
  padding: 36rpx 16rpx;
  color: #94a3b8;
  font-size: 26rpx;
  text-align: center;
}
