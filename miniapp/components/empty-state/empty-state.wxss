/* components/empty-state/empty-state.wxss */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
  text-align: center;
}

.empty-state__icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 20rpx;
  opacity: 0.45;
}

.empty-state__title {
  color: #111111;
  font-size: 28rpx;
  font-weight: 500;
}

.empty-state__desc {
  margin-top: 10rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-state__action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  color: #111111;
  font-size: 26rpx;
  background: #fff;
  border: 1rpx solid #111111;
  border-radius: 999rpx;
}

.empty-state__action.is-primary {
  color: #fff;
  background: #111111;
  border-color: #111111;
}
