.empty {
  padding: 80rpx 40rpx calc(80rpx + env(safe-area-inset-bottom));
  text-align: center;
}
.empty__title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}
.empty__desc {
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.5;
}
.empty__btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 36rpx;
  color: #fff;
  font-size: 26rpx;
  background: var(--brand, var(--brand));
  border-radius: 999rpx;
}
