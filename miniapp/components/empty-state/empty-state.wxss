/* components/empty-state/empty-state.wxss — D2：统一空态样式 */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
  text-align: center;
}

.empty-state__icon {
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 24rpx;
  opacity: 0.9;
}

.empty-state__title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-state__desc {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-state__action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  color: #1769ff;
  font-size: 26rpx;
  background: #fff;
  border: 1rpx solid #1769ff;
  border-radius: 999rpx;
}

.empty-state__action.is-primary {
  color: #fff;
  background: #1769ff;
  border-color: #1769ff;
}
