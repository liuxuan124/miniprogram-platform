<view class="dsl-planet-feed {{hasSectionBg ? 'has-bg' : ''}}">
  <!-- 标签栏：三种外观 + 可关吸顶，类名与后台预览同口径。
     stickyTop 由 JS 实测上方顶栏高度得出，避免与星球顶栏/通知公告层叠穿透 -->
  <scroll-view
    class="pl-segs pl-segs--{{tabStyle.variant}} {{tabStyle.sticky ? 'pl-segs--sticky' : ''}} {{stickyTop > 0 ? 'pl-segs--offset' : ''}}"
    style="{{stickyTop > 0 ? 'top:' + stickyTop + 'px' : ''}}"
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="pl-segs__inner">
      <text
        wx:for="{{segs}}"
        wx:key="key"
        class="pl-seg {{activeSeg === item.key ? 'pl-seg--on' : ''}}"
        style="{{item.style}}"
        data-key="{{item.key}}"
        bindtap="onSegTap"
      >{{item.label}}</text>
    </view>
  </scroll-view>

  <view class="pl-feed-wrap">
  <block wx:for="{{list}}" wx:key="uid">
    <view
      class="pl-fd {{item.top ? 'pl-fd--top' : ''}}"
      style="{{cardStyleInline}}"
      data-id="{{item.id}}"
      data-uid="{{item.uid}}"
      data-demo="{{item.isDemo}}"
      data-index="{{index}}"
      bindtap="onOpen"
    >
      <view class="pl-fd__hh">
        <image class="pl-fd__av warm-ph" src="{{item.avatar}}" mode="aspectFill" wx:if="{{item.avatar}}" />
        <view class="pl-fd__av pl-fd__av--fb" wx:else>{{item.authorInitial}}</view>
        <view class="pl-fd__who">
          <view class="pl-fd__nm">
            <text>{{item.author}}</text>
            <text class="warm-tag warm-tag--gold" wx:if="{{vis.showTopBadge && item.tagGold}}">{{item.tagGold}}</text>
            <text class="warm-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
          </view>
          <text class="pl-fd__tm">{{item.time}}</text>
        </view>
        <text
          class="pl-fd__mo"
          data-id="{{item.id}}"
          data-uid="{{item.uid}}"
          data-index="{{index}}"
          data-demo="{{item.isDemo}}"
          catchtap="onMoreTap"
        >···</text>
      </view>
      <text class="pl-fd__ct {{vis.clampLines > 0 ? 'pl-fd__ct--clamp' : ''}}" style="{{vis.clampLines > 0 ? '-webkit-line-clamp:' + vis.clampLines : ''}}">{{item.content}}</text>
      <view class="pl-fd__q" wx:if="{{item.answer}}">
        <view class="pl-fd__qlb">星主已回答</view>
        <text>{{item.answer}}</text>
      </view>
      <view class="pl-fd__files" wx:if="{{item.files.length || item.file}}">
        <view
          class="pl-fd__file"
          wx:for="{{item.files}}"
          wx:for-item="f"
          wx:key="fileId"
          catchtap="onOpenFile"
          data-file="{{f}}"
        >
          <text class="pl-fd__fic">📄</text>
          <view class="pl-fd__fmeta">
            <text class="pl-fd__fh">{{f.name}}</text>
            <text class="pl-fd__fp">{{f.meta}}</text>
          </view>
          <text class="pl-fd__fgo">{{f.open ? '预览 ›' : '开通 ›'}}</text>
        </view>
      </view>
      <view
        class="pl-fd__gg {{item.images.length === 2 ? 'pl-fd__gg--two' : ''}} {{cardStyle.imageRatio === 'auto' ? 'pl-fd__gg--auto' : ''}}"
        wx:if="{{item.images.length}}"
      >
        <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="pl-fd__img warm-ph" src="{{img}}" mode="{{cardStyle.imageRatio === 'auto' ? 'widthFix' : 'aspectFill'}}" />
      </view>
      <text class="pl-fd__tp" wx:if="{{item.topics}}">{{item.topics}}</text>
      <view class="pl-fd__ft" wx:if="{{vis.showInteractions}}">
        <text
          class="{{item.liked || item.hot ? 'pl-fd__hot' : ''}}"
          data-id="{{item.id}}"
          data-uid="{{item.uid}}"
          data-index="{{index}}"
          data-demo="{{item.isDemo}}"
          catchtap="onLikeTap"
        >❤️ {{item.likes}}</text>
        <text
          data-id="{{item.id}}"
          data-uid="{{item.uid}}"
          data-demo="{{item.isDemo}}"
          catchtap="onCommentTap"
        >💬 {{item.comments}}</text>
        <text
          data-id="{{item.id}}"
          data-uid="{{item.uid}}"
          data-index="{{index}}"
          data-demo="{{item.isDemo}}"
          catchtap="onFavoriteTap"
        >{{item.favorited ? '⭐️ 已收藏' : '⭐️ 收藏'}}</text>
        <text
          data-id="{{item.id}}"
          data-uid="{{item.uid}}"
          data-index="{{index}}"
          data-demo="{{item.isDemo}}"
          catchtap="onShareTap"
        >↗️ 分享</text>
      </view>
    </view>
  </block>
  </view>
  <view class="warm-end">{{footerText}}</view>
</view>
