.cube { display: grid; }
.cube--2x2 { grid-template-columns: 1fr 1fr; }
.cube--2x2 .cube__cell { height: 280rpx; }
.cube--1-2 { grid-template-columns: 1.15fr 1fr; grid-template-rows: 140rpx 140rpx; }
.cube--1-2 .cube__cell:first-child { grid-row: 1 / span 2; height: auto; }
.cube--1-2 .cube__cell { height: 140rpx; }
.cube--3x3 { grid-template-columns: 1fr 1fr 1fr; }
.cube--3x3 .cube__cell { height: 180rpx; }
.cube__cell { overflow: hidden; background: #eef2f7; }
.cube__img { width: 100%; height: 100%; display: block; }
.cube__ph { height: 100%; }
