<!-- pages/order-create/order-create.wxml — 确认订单（对齐 prototypes-warm/order.html ①） -->
<page-meta page-style="{{themePageStyle}}" />
<view class="order-page">
  <!-- 收货地址（实物） -->
  <view class="block address-block" bindtap="onSelectAddress" hover-class="block--pressed" wx:if="{{!isVirtual}}">
    <view wx:if="{{hasAddress && address}}" class="address">
      <view class="address__pin">
        <view class="address__pin-dot"></view>
      </view>
      <view class="address__body">
        <view class="address__meta">
          <text class="address__name">{{address.name}}</text>
          <text class="address__phone">{{address.phone}}</text>
        </view>
        <text class="address__detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail || address.address || ''}}</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <view wx:else class="address address--empty">
      <view class="address__pin address__pin--muted">
        <view class="address__pin-dot"></view>
      </view>
      <view class="address__body">
        <text class="address__title">添加收货地址</text>
        <text class="address__hint">实物商品需填写收货信息</text>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>

  <!-- 商品：虚拟无「商品信息」头，提示收进商品卡 -->
  <view class="block goods-block">
    <view class="block__head" wx:if="{{!isVirtual}}">
      <text class="block__title">商品信息</text>
      <text class="block__meta">共 {{totalQuantity}} 件</text>
    </view>
    <view
      wx:for="{{items}}"
      wx:key="index"
      class="goods {{index < items.length - 1 ? 'goods--divide' : ''}}"
    >
      <image
        class="goods__cover"
        src="{{item.product_image || item.productImage || item.image || item.cover_url || '/images/default-product.png'}}"
        mode="aspectFill"
      />
      <view class="goods__main">
        <text class="goods__name">{{item.product_name || item.productName || item.name}}</text>
        <text class="goods__sku" wx:if="{{virtualSubtitle || item.sku_name || item.skuName}}">{{virtualSubtitle || item.sku_name || item.skuName}}</text>
        <view class="goods__foot">
          <view class="price">
            <text class="price__yen">¥</text>
            <text class="price__num">{{item.price}}</text>
            <text class="price__origin" wx:if="{{originalPrice}}">¥{{originalPrice}}</text>
          </view>
          <text class="goods__qty" wx:if="{{!isVirtual}}">×{{item.quantity}}</text>
        </view>
      </view>
    </view>
    <view class="virtual-tip" wx:if="{{isVirtual}}">
      📦 数字内容，<text class="virtual-tip__b">支付成功后立即开通阅读权限</text>，无需填写收货地址，不产生物流
    </view>
  </view>

  <view class="viprow" wx:if="{{isVirtual}}" catchtap="onGoMember">
    <text class="viprow__ic">🎫</text>
    <view class="viprow__body">
      <view class="viprow__b">{{memberSaveText || '开通会员再买更划算'}}</view>
      <view class="viprow__p">{{memberSubText || '会员价更低 · 另解锁资料库'}}</view>
    </view>
    <text class="viprow__go">去开通</text>
  </view>

  <!-- 优惠券 / 暖豆 / 发票 / 备注（原型同一白卡；无独立「支付方式」） -->
  <view class="block opt-block" wx:if="{{isVirtual}}">
    <view class="opt-row" bindtap="onSelectCoupon">
      <text class="opt-row__k">优惠券</text>
      <text class="opt-row__v {{(couponLabel || couponAmount > 0) ? 'opt-row__v--cut' : 'opt-row__v--mute'}}">{{couponLabel || (couponAmount > 0 ? ('-¥' + couponAmount) : '暂无可用')}}</text>
      <text class="opt-row__ar">›</text>
    </view>
    <view class="opt-row" wx:if="{{showWarmVirtual}}" catchtap="onToggleBeans">
      <text class="opt-row__k">暖豆抵扣</text>
      <text class="opt-row__v opt-row__v--mute">{{beansLabel || ('可抵 ¥' + beansAmount)}}</text>
      <view class="sw {{beansOn ? 'on' : ''}}"><view class="sw__i"></view></view>
    </view>
    <view class="opt-row" wx:elif="{{userCouponId}}">
      <text class="opt-row__k">优惠</text>
      <text class="opt-row__v opt-row__v--cut">-¥{{discountAmount}}</text>
    </view>
    <view class="opt-row">
      <text class="opt-row__k">发票</text>
      <text class="opt-row__v opt-row__v--mute">暂不开具</text>
      <text class="opt-row__ar">›</text>
    </view>
    <view class="opt-row">
      <text class="opt-row__k">备注</text>
      <input
        class="opt-row__input"
        placeholder="选填"
        placeholder-class="opt-row__ph"
        value="{{remark}}"
        maxlength="100"
        bindinput="onRemarkInput"
      />
      <text class="opt-row__ar">›</text>
    </view>
  </view>

  <!-- 实物备注 -->
  <view class="block remark-block" wx:if="{{!isVirtual}}">
    <view class="remark-row">
      <text class="remark-row__label">订单备注</text>
      <input
        class="remark-row__input"
        placeholder="选填，如配送时间等"
        placeholder-class="remark-row__ph"
        value="{{remark}}"
        maxlength="100"
        bindinput="onRemarkInput"
      />
    </view>
  </view>

  <!-- 金额明细 -->
  <view class="block summary-block">
    <view class="summary-row">
      <text class="summary-row__label">商品金额</text>
      <text class="summary-row__value">¥{{totalPrice}}</text>
    </view>
    <view class="summary-row" wx:if="{{!isVirtual}}">
      <text class="summary-row__label">运费</text>
      <text class="summary-row__value summary-row__value--muted">免运费</text>
    </view>
    <view class="summary-row" wx:if="{{!isPay1 && (couponAmount > 0 || discountAmount > 0 || (showWarmVirtual && couponLabel))}}">
      <text class="summary-row__label">优惠券</text>
      <text class="summary-row__value summary-row__value--cut">-¥{{couponAmount || discountAmount}}</text>
    </view>
    <view class="summary-row" wx:if="{{!isPay1 && showWarmVirtual && beansOn}}">
      <text class="summary-row__label">暖豆抵扣</text>
      <text class="summary-row__value summary-row__value--cut">-¥{{beansAmount}}</text>
    </view>
    <view class="summary-row summary-row--total">
      <text class="summary-row__label">实付</text>
      <view class="sum-pay">
        <text class="sum-pay__yen">¥</text>
        <text class="sum-pay__num">{{payAmount}}</text>
      </view>
    </view>
  </view>

  <view class="agree" wx:if="{{isVirtual}}" bindtap="onToggleAgree">
    <view class="agree__cb {{agreedVirtual ? 'on' : ''}}">{{agreedVirtual ? '✓' : ''}}</view>
    <view class="agree__txt">
      我已阅读并同意<text class="agree__link">《虚拟商品购买协议》</text>，知悉：{{virtualRefundLabel}}
    </view>
  </view>
  <view class="safe-tip" wx:else>提交订单即表示同意相关购买须知，支付信息仅用于完成交易</view>

  <!-- 底栏：实付款上下排 + 胶囊「微信支付」（对齐原型 ①；「立即支付」仅在 pay-sheet） -->
  <view class="dock">
    <view class="dock__left">
      <text class="dock__caption">实付款</text>
      <view class="price price--dock">
        <text class="price__yen">¥</text>
        <text class="price__num">{{payAmount}}</text>
      </view>
    </view>
    <view
      class="dock__btn {{submitting ? 'dock__btn--disabled' : ''}}"
      bindtap="onSubmitOrder"
      hover-class="{{submitting ? '' : 'dock__btn--pressed'}}"
    >{{submitting ? '提交中…' : (isVirtual ? '微信支付' : '提交订单')}}</view>
  </view>

  <pay-sheet
    id="pay-sheet"
    show="{{showPaySheet}}"
    amount="{{payAmount}}"
    balance="{{walletBalance}}"
    bind:close="onPayClose"
    bind:confirm="onPayConfirm"
  />
</view>
<login-sheet id="global-login-sheet" />
