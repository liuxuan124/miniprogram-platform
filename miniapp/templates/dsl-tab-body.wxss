.dsl-tab-page__state {
  padding: 48rpx 32rpx;
  text-align: center;
  color: #98a2b5;
  font-size: 28rpx;
}

.dsl-tab-page__body {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  /* 允许负 margin 叠层露出，勿 overflow hidden */
  box-sizing: border-box;
}

.dsl-flow {
  /* 勿 width:100%：再叠加左右 margin 会撑出视口，右边被裁切贴边 */
  width: auto;
  max-width: 100%;
  box-sizing: border-box;
}

.dsl-flow--stack {
  position: relative;
  z-index: 20;
}

.dsl-flow--below {
  position: relative;
  z-index: 1;
}
