.serif {
  font-family: "Songti SC", "Noto Serif SC", "Iowan Old Style", serif;
}
.wh-top {
  padding: 0 18px 18px;
  background: linear-gradient(180deg, #f7e0c3 0%, #fbeeda 52%, #fdf6ec 100%);
  box-sizing: border-box;
}
.wh-greet {
  display: flex;
  align-items: center;
  gap: 12px;
}
.wh-greet__person {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.wh-av { width: 42px; height: 42px; border-radius: 99px; background: #f2dcc0; flex-shrink: 0; }
.wh-greet__tx { flex: 1; min-width: 0; }
.wh-greet__h { display: block; font-size: 40rpx; letter-spacing: -0.02em; font-weight: 640; }
.wh-greet__p { display: block; font-size: 22rpx; color: #6b5443; margin-top: 6rpx; }
.wh-b { font-weight: 750; color: #2a1c12; }
.wh-bell {
  margin-left: auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 99px;
  background: rgba(255,255,255,.7);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  z-index: 2;
}
.wh-bell__ico { font-size: 32rpx; line-height: 1; pointer-events: none; }
.wh-bell--pressed { opacity: 0.72; }
.wh-bell__dot {
  position: absolute; top: 16rpx; right: 18rpx; width: 14rpx; height: 14rpx;
  border-radius: 99px; background: #ea580c; border: 3rpx solid #fbeeda;
  pointer-events: none;
}

.wh-search {
  margin-top: 32rpx; height: 88rpx; border-radius: 99px;
  background: rgba(255,255,255,.85); display: flex; align-items: center; gap: 18rpx;
  padding: 0 12rpx 0 32rpx; box-shadow: 0 8px 20px rgba(120,64,24,.08);
}
.wh-search__ph { flex: 1; color: #b09a88; font-size: 26rpx; }
.wh-search__btn {
  height: 64rpx; padding: 0 30rpx; border-radius: 99px;
  background: linear-gradient(135deg, #ea580c, #c2410c); color: #fff;
  font-size: 24rpx; font-weight: 650; display: flex; align-items: center;
}

.wh-nav { display: flex; margin-top: 40rpx; }
.wh-nav__item {
  flex: 1; text-align: center; font-size: 21rpx; color: #6b5443; font-weight: 650;
}
.wh-nav__ic {
  width: 88rpx; height: 88rpx; margin: 0 auto 14rpx; border-radius: 32rpx;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
  background: #fffaf3; box-shadow: 0 6px 14px rgba(140,80,30,.09);
}

.wh-hd {
  padding: 36rpx 36rpx 16rpx; display: flex; justify-content: space-between; align-items: flex-end;
}
.wh-hd__t { font-size: 38rpx; letter-spacing: -0.02em; font-weight: 700; }
.wh-hd__a { font-size: 24rpx; color: #c2410c; font-weight: 650; }

.wh-authors { white-space: nowrap; padding: 8rpx 32rpx 12rpx; }
.wh-author {
  display: inline-block; width: 108rpx; text-align: center; margin-right: 28rpx; vertical-align: top;
}
.wh-author__av {
  display: block; width: 100rpx; height: 100rpx; margin: 0 auto 12rpx;
  border-radius: 99px; border: 3rpx solid #f2dcc0; background: #f8ecdd;
}
.wh-author__av--apply {
  border: 3rpx dashed #ddbe98; color: #c79a6c; font-size: 38rpx;
  display: flex; align-items: center; justify-content: center; background: #fffaf3;
}
.wh-author__n { display: block; font-size: 22rpx; font-weight: 680; }
.wh-author__r { display: block; font-size: 18rpx; color: #b45309; margin-top: 4rpx; }

.wh-feature {
  margin: 36rpx 32rpx 0; border-radius: 48rpx; overflow: hidden; position: relative;
  height: 420rpx; color: #fff; box-shadow: 0 18px 44px rgba(120,64,24,.14);
}
.wh-feature__img { position: absolute; inset: 0; width: 100%; height: 100%; }
.wh-feature__sc {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(60,26,8,.05) 18%, rgba(60,26,8,.82));
}
.wh-feature__bd { position: absolute; left: 0; right: 0; bottom: 0; padding: 32rpx 36rpx; }
.wh-feature__h {
  display: block; font-size: 40rpx; line-height: 1.32; letter-spacing: -0.02em;
  margin-top: 16rpx; white-space: pre-line; font-weight: 650;
}
.wh-feature__mt { margin-top: 18rpx; font-size: 22rpx; opacity: .82; }

.wh-tag {
  display: inline-block; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 8rpx;
  background: rgba(194,65,12,.12); color: #c2410c; font-weight: 700;
}
.wh-tag.soft { background: rgba(255,255,255,.22); color: #fff; }
.wh-tag.gold { background: rgba(180,83,9,.14); color: #b45309; }

.wh-rail { white-space: nowrap; padding: 4rpx 32rpx 12rpx; }
.wh-col {
  display: inline-block; width: 308rpx; margin-right: 24rpx; vertical-align: top; white-space: normal;
}
.wh-col__cv {
  height: 208rpx; border-radius: 32rpx; overflow: hidden; position: relative; background: #f8ecdd;
}
.wh-col__cv image { width: 100%; height: 100%; }
.wh-col__bdg { position: absolute; top: 16rpx; left: 16rpx; }
.wh-col__h { display: block; font-size: 27rpx; font-weight: 700; margin-top: 18rpx; line-height: 1.38; }
.wh-col__p { display: block; font-size: 21rpx; color: #a1897a; margin-top: 8rpx; }
.wh-col__pr { margin-top: 12rpx; font-size: 26rpx; font-weight: 800; color: #c2410c; }
.wh-col__s { font-size: 20rpx; color: #a1897a; font-weight: 500; margin-left: 10rpx; text-decoration: line-through; }

.wh-planet {
  margin: 12rpx 32rpx 0; border-radius: 44rpx; padding: 32rpx; color: #fff; position: relative; overflow: hidden;
  background: linear-gradient(135deg, #7c2d12, #b45309 62%, #d97706);
  box-shadow: 0 16px 34px rgba(124,45,18,.28);
}
.wh-planet__rw { display: flex; align-items: center; gap: 16rpx; position: relative; z-index: 1; }
.wh-planet__ic { font-size: 40rpx; }
.wh-planet__h { font-size: 32rpx; font-weight: 750; flex: 1; }
.wh-planet__num { font-size: 22rpx; opacity: .8; }
.wh-planet__ls { margin-top: 24rpx; position: relative; z-index: 1; }
.wh-planet__li {
  background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.14);
  border-radius: 26rpx; padding: 18rpx 22rpx; font-size: 24rpx; line-height: 1.45;
  display: flex; gap: 16rpx; margin-bottom: 16rpx;
}
.wh-planet__tag { font-weight: 750; opacity: .9; flex-shrink: 0; }
.wh-planet__tx { opacity: .9; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wh-planet__go {
  margin-top: 8rpx; height: 68rpx; border-radius: 99px; background: #fff; color: #9a3412;
  font-size: 25rpx; font-weight: 750; display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 1;
}

.wh-segs { display: flex; gap: 36rpx; padding: 32rpx 36rpx 8rpx; }
.wh-seg { font-size: 30rpx; font-weight: 650; color: #a1897a; padding-bottom: 12rpx; position: relative; }
.wh-seg.on { color: #2a1c12; font-weight: 800; font-size: 32rpx; }
.wh-seg.on::after {
  content: ""; position: absolute; left: 0; bottom: 0; width: 40rpx; height: 6rpx;
  border-radius: 6rpx; background: #ea580c;
}
.wh-feed-empty {
  padding: 48rpx 32rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a1897a;
}

.wh-post {
  display: flex; gap: 24rpx; padding: 28rpx 32rpx;
  border-bottom: 1px solid rgba(120,72,40,.12);
}
.wh-post__tx { flex: 1; min-width: 0; }
.wh-post__h {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
  font-size: 30rpx; font-weight: 700; line-height: 1.42;
}
.wh-post__p {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
  font-size: 23rpx; color: #6b5443; margin-top: 12rpx; line-height: 1.5;
}
.wh-post__mt {
  margin-top: 18rpx; font-size: 21rpx; color: #a1897a;
  display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap;
}
.wh-post__im {
  width: 192rpx; height: 192rpx; border-radius: 28rpx; flex-shrink: 0; background: #f8ecdd;
}

.wh-three {
  padding: 28rpx 32rpx; border-bottom: 1px solid rgba(120,72,40,.12);
}
.wh-three__gg { display: flex; gap: 12rpx; margin-top: 20rpx; }
.wh-three__gg image {
  flex: 1; height: 156rpx; border-radius: 20rpx; background: #f8ecdd;
}

.wh-end {
  text-align: center; font-size: 21rpx; color: #a1897a; padding: 36rpx 0 12rpx; letter-spacing: .2em;
}
.wh-safe { height: 24rpx; }
