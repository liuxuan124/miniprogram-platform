/* ---- h_metric_strip 指标条 ---- */
.wk-met { position: relative; padding: 28rpx 24rpx 32rpx; }
.wk-met__head { padding: 0 4rpx; margin-bottom: 24rpx; }
.wk-met__row { display: flex; align-items: stretch; }
/* flex:1 挡不住长文案折行，必须显式 min-width:0，否则会把卡片撑破 */
.wk-met__item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 0 8rpx;
}
.wk-met__item--div { border-left: 2rpx solid #F5E6D4; }
.wk-met__num-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  min-width: 0;
}
.wk-met__num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.15;
