}
.wk-met__suffix { font-size: 26rpx; font-weight: 600; }
.wk-met__unit {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  flex-shrink: 0;
}
.wk-met__label {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  min-width: 0;
  word-break: break-all;
}

/* ---- h_filter_chips 筛选芯片 ---- */
.wk-chips { position: relative; padding: 28rpx 0 24rpx; }
.wk-chips__head { padding: 0 28rpx; margin-bottom: 20rpx; }
.wk-chips__track {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 28rpx 12rpx;
  white-space: nowrap;
}
.wk-chips__pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 auto;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #F5E6D4;
  background: #FFFAF3;
  font-size: 26rpx;
  line-height: 1.5;
  color: #57534E;
  box-sizing: border-box;
}
.wk-chips__pill--on {
  color: #FFFDF9;
  font-weight: 600;
  border-color: #C2410C;
  background: #C2410C;
}
.wk-chips__text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.wk-chips__count {
  flex-shrink: 0;
  min-width: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  color: #B45309;
  background: #F5E6D4;
}
.wk-chips__count--on { color: #C2410C; background: #FFFDF9; }
.wk-chips__empty {
  margin: 0 28rpx;
  padding: 40rpx 0;
  border-radius: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #78716C;
  background: #FFFAF3;
}

/* ---- h_split_banner 左右分屏 ---- */
.wk-split { position: relative; padding: 24rpx; }
.wk-split__row { display: flex; align-items: stretch; }
/* flex:1 挡不住长文案折行，必须显式 min-width:0 */
.wk-split__cell {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  border: 2rpx solid #F5E6D4;
  box-shadow: 0 8rpx 32rpx rgba(180, 83, 9, 0.06);
  box-sizing: border-box;
}
.wk-split__icon {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  border-radius: 16rpx;
  background: #FFFDF9;
  border: 2rpx solid #F5E6D4;
  overflow: hidden;
}
.wk-split__icon-img { width: 100%; height: 100%; }
.wk-split__text { flex: 1; min-width: 0; }
.wk-split__title {
  margin: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}
.wk-split__sub {
  margin: 8rpx 0 0;
  font-size: 22rpx;
  line-height: 1.6;
  color: #57534E;
  word-break: break-all;
}
.wk-split__arrow {
  flex-shrink: 0;
  align-self: center;
  font-size: 30rpx;
  line-height: 1;
}

/* ============================================================
 * 深度内容
 * ========================================================== */

/* ---- content_faq_accordion 折叠手风琴 ----
   小程序基础库对 grid-template-rows 0fr 支持不稳定，
   展开动效改为「直接切 height/opacity + opacity 过渡」：
   展开时给 .wk-faq__body--open 固定 auto 高度由内容撑开，
   收起时 height:0 + opacity:0。 */
.wk-faq { position: relative; padding: 28rpx; }
.wk-faq__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 8rpx;
}
.wk-faq__all {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 4rpx 0;
}
.wk-faq__item { border-bottom: 2rpx solid #F5E6D4; }
.wk-faq__item--last { border-bottom: none; }
.wk-faq__q {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 100%;
  padding: 24rpx 0;
}
.wk-faq__qtext {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #57534E;
}
.wk-faq__q--on .wk-faq__qtext { color: #B45309; }
.wk-faq__tag {
  flex-shrink: 0;
  max-width: 176rpx;
  padding: 2rpx 14rpx;
  border: 2rpx solid #F5E6D4;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wk-faq__arrow {
  flex-shrink: 0;
  margin-top: 2rpx;
  font-size: 26rpx;
  line-height: 1.5;
  transition: transform 0.28s ease;
}
.wk-faq__arrow--open { transform: rotate(180deg); }
.wk-faq__body {
  height: 0;
  opacity: 0;
  overflow: hidden;
  transition: height 0.28s ease, opacity 0.28s ease;
}
.wk-faq__body--open {
  height: auto;
  opacity: 1;
}
.wk-faq__inner { overflow: hidden; min-width: 0; }
.wk-faq__a {
  margin: 0;
  padding: 0 0 24rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #78716C;
}
.wk-faq__hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #B45309;
  background: #FFFAF3;
}

/* ---- content_mini_audio 迷你音频条 ---- */
.wk-audio {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
}
.wk-audio__cover {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #F5E6D4;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wk-audio__cover-img { width: 100%; height: 100%; }
.wk-audio__cover-icon { font-size: 30rpx; color: #B45309; }
.wk-audio__play {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.wk-audio__play--peek { box-shadow: 0 0 0 8rpx rgba(194, 65, 12, 0.16); }
.wk-audio__play-icon { font-size: 22rpx; line-height: 1; color: #FFFDF9; }
.wk-audio__main { flex: 1; min-width: 0; }
.wk-audio__title {
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #57534E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wk-audio__track { margin-top: 10rpx; padding: 8rpx 0; }
.wk-audio__bar {
  position: relative;
  height: 8rpx;
  border-radius: 999rpx;
  background: #F5E6D4;
}
.wk-audio__played { height: 100%; border-radius: 999rpx; }
.wk-audio__thumb {
  position: absolute;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  border: 4rpx solid #C2410C;
  background: #FFFDF9;
  transform: translateY(-50%);
  box-sizing: border-box;
}
.wk-audio__time {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #78716C;
  white-space: nowrap;
}
.wk-audio__speed {
  flex-shrink: 0;
  min-width: 76rpx;
  padding: 6rpx 16rpx;
  border: 2rpx solid #C2410C;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  color: #C2410C;
  box-sizing: border-box;
}

/* ---- content_milestone_tracker 里程碑时间线 ---- */
.wk-ms { position: relative; padding: 28rpx; }
.wk-ms__head { margin-bottom: 24rpx; }
.wk-ms__node { display: flex; align-items: stretch; gap: 20rpx; }
.wk-ms__rail {
  position: relative;
  flex-shrink: 0;
  width: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wk-ms__dot {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  width: 20rpx;
  height: 20rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  border: 4rpx solid #FDF6EC;
  box-sizing: border-box;
}
.wk-ms__pulse {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #F05B5B;
  border-radius: 50%;
  box-sizing: border-box;
  animation: wk-ms-pulse 1.8s ease-out infinite;
}
@keyframes wk-ms-pulse {
  0% { transform: scale(0.6); opacity: 0.7; }
  70% { transform: scale(1.5); opacity: 0; }
  100% { transform: scale(1.5); opacity: 0; }
}
.wk-ms__line {
  flex: 1;
  width: 4rpx;
  margin: 8rpx 0;
  border-radius: 999rpx;
}
.wk-ms__content {
  flex: 1;
  min-width: 0;
  padding-bottom: 32rpx;
}
.wk-ms__node--last .wk-ms__content { padding-bottom: 0; }
.wk-ms__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.wk-ms__date {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #78716C;
}
.wk-ms__badge {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border: 2rpx solid #EDE0CB;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.7;
}
.wk-ms__t {
  margin: 0 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #57534E;
}
.wk-ms__point {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 4rpx 0;
  min-width: 0;
}
.wk-ms__bullet {
  flex-shrink: 0;
  width: 8rpx;
  height: 8rpx;
  margin-top: 16rpx;
  border-radius: 50%;
}
.wk-ms__point-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.7;
  color: #78716C;
}

/* ============================================================
 * 布局容器
 * ========================================================== */

/* ---- layout_overlap_wrapper 层叠穿透 ----
   负 margin + position:relative + z-index:2。
   ⚠️ 依赖 app.wxss 中 page 未设 overflow-x:hidden，否则会被裁掉。 */
.wk-ovl { position: relative; }
.wk-ovl__body { position: relative; min-height: 112rpx; }
.wk-ovl__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  padding: 24rpx;
  border: 2rpx dashed #EDE0CB;
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #B45309;
  text-align: center;
}

/* ---- layout_paper_sheet 纸感包裹容器 ---- */
.wk-sheet { position: relative; }
.wk-sheet__title {
  padding: 28rpx 32rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #B45309;
}
.wk-sheet__body { min-height: 96rpx; }
.wk-sheet__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 128rpx;
  padding: 28rpx;
  border: 2rpx dashed #EDE0CB;
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #B45309;
  text-align: center;
}

/* ---- layout_sticky_wrapper 吸顶容器 ----
   ⚠️ 小程序不支持 CSS position:sticky。
   运行时方案：wk-stick__holder（占位，撑出原始高度）
   + wk-stick__fix（position:fixed 吸顶层），由 wx:if 二选一切换。
   状态在 dsl-renderer 的 data.stickyOn。 */
.wk-stick { position: relative; }
/* 1rpx 哨兵：IntersectionObserver 观测它，滚出视口上边界即触发吸顶 */
.wk-stick__sentinel { width: 100%; }
.wk-stick__holder { width: 100%; }
.wk-stick__fix {
  position: fixed;
  left: 0;
  right: 0;
  box-sizing: border-box;
  padding-left: 20rpx;
  padding-right: 20rpx;
}
.wk-stick__inner { position: relative; }
.wk-stick__card {
  background: #FDF6EC;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(180, 83, 9, 0.06);
  box-sizing: border-box;
}
.wk-stick__body { min-height: 88rpx; }
.wk-stick__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 2rpx dashed #EDE0CB;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #B45309;
  text-align: center;
}

/* ---- layout_flexible_grid 弹性非对称栅格 ---- */
.wk-grid { position: relative; }
.wk-grid__row {
  display: flex;
  width: 100%;
  box-sizing: border-box;
}
.wk-grid__cell {
  position: relative;
  min-height: 112rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.wk-grid__cell-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  padding: 20rpx 12rpx;
  border: 2rpx dashed #EDE0CB;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
}
.wk-grid__cell-grow {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  opacity: 0.75;
}
