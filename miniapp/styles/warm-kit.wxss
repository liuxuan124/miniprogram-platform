/* styles/warm-kit.wxss — 暖调装修器 22 个新组件样式
 *
 * 与后台 admin/src/components/page-builder/shared/warm-kit.scss 同源同值，
 * 所有 px 已按小程序口径 ×2 换成 rpx。
 * 调色板只有暖调，拒绝冷灰：#FDF6EC / #C2410C / #B45309 / #FFFDF9 / #FFFAF3 /
 * #F5E6D4 / #EDE0CB / #0AAA75 / #F05B5B
 * 投影统一 0 8rpx 32rpx rgba(180,83,9,0.06)（后台 0 4px 16px rgba(180,83,9,0.06)）
 */

/* ============ 卡片基底 ============ */
.wk-card {
  background: #FDF6EC;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 83, 9, 0.06);
  overflow: hidden;
  box-sizing: border-box;
}

/* ============ 通用文本 ============ */
.wk-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #B45309;
}

.wk-sub {
  font-size: 24rpx;
  line-height: 1.6;
  color: #78716C;
}

/* 通用空态 */
.wk-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #78716C;
  background: #FFFAF3;
  border-radius: 20rpx;
}

/* ============================================================
 * 星球互动
 * ========================================================== */

/* ---- planet_qa_card 精选问答卡 ---- */
.wk-qa { padding: 28rpx; }
.wk-qa__head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.wk-qa__item {
  padding: 24rpx 0;
  border-top: 2rpx solid #F5E6D4;
}
.wk-qa__q {
  margin: 0 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #292524;
}
.wk-qa__answerer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  min-width: 0;
}
.wk-qa__avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  background: #FDE8D8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wk-qa__avatar-img { width: 100%; height: 100%; }
.wk-qa__avatar--text {
  font-size: 22rpx;
  color: #C2410C;
}
.wk-qa__who {
  font-size: 24rpx;
  font-weight: 500;
  color: #57534E;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wk-qa__role {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #B45309;
  background: #FDE8D8;
}
.wk-qa__a {
  margin: 0;
  font-size: 26rpx;
  line-height: 1.7;
  color: #57534E;
  overflow: hidden;
}
.wk-qa__meta {
  display: flex;
  gap: 28rpx;
  margin-top: 16rpx;
}
/* 后台此处用中性灰 #A8A29E，属冷灰，小程序端按硬性规范换成暖调 ink3 */
.wk-qa__stat { font-size: 22rpx; color: #78716C; }
.wk-qa__more {
  padding-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
}

/* ---- planet_ask_banner 向主理人提问 ---- */
.wk-ask { position: relative; padding: 28rpx; }
.wk-ask__head { margin-bottom: 20rpx; }
.wk-ask__host {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}
.wk-ask__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  background: #FDE8D8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: #C2410C;
}
.wk-ask__avatar-img { width: 100%; height: 100%; }
.wk-ask__who { flex: 1; min-width: 0; }
.wk-ask__name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}
.wk-ask__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #292524;
  flex-shrink: 0;
}
.wk-ask__role {
  font-size: 22rpx;
  color: #78716C;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wk-ask__stat {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.wk-ask__answered { font-size: 22rpx; color: #57534E; }
.wk-ask__sla {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #0AAA75;
}
.wk-ask__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #0AAA75;
  margin-right: 8rpx;
}
.wk-ask__desc {
  margin: 20rpx 0 0;
  font-size: 25rpx;
  line-height: 1.75;
  color: #57534E;
}
.wk-ask__cta {
  display: block;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFDF9;
}

/* ---- planet_members_strip 活跃成员排 ---- */
.wk-members { position: relative; padding: 28rpx 0 24rpx; }
.wk-members__head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
}
.wk-members__count { font-size: 22rpx; color: #78716C; }
.wk-members__track {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 28rpx 20rpx;
}
.wk-members__cell {
  flex: 0 0 62%;
  min-width: 0;
}
.wk-members__avatar {
  position: relative;
  width: 100%;
  height: 200rpx;
  border-radius: 50%;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFAF3;
  border: 4rpx solid #F5E6D4;
  box-shadow: 0 8rpx 32rpx rgba(180, 83, 9, 0.06);
  box-sizing: border-box;
}
.wk-members__avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.wk-members__initial {
  font-size: 60rpx;
  font-weight: 600;
  color: #C2410C;
  background: #FDE8D8;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wk-members__tag {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  transform: translateX(-50%);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #FFFDF9;
  white-space: nowrap;
}
.wk-members__name {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #57534E;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wk-members__more {
  width: 100%;
  height: 200rpx;
  border-radius: 50%;
  border: 2rpx dashed #C2410C;
  background: #FFFAF3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.wk-members__plus { font-size: 44rpx; font-weight: 600; }
.wk-members__more-label { font-size: 22rpx; color: #78716C; margin-top: 8rpx; }
.wk-members__empty {
  margin: 0 28rpx;
  padding: 52rpx 0;
  border-radius: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #78716C;
  background: #FFFAF3;
}

/* ---- planet_challenge_card 打卡挑战营 ---- */
.wk-chal { position: relative; padding: 28rpx; }
.wk-chal__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.wk-chal__head-left { min-width: 0; flex: 1; }
.wk-chal__cycle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #78716C;
}
.wk-chal__pct { font-size: 36rpx; font-weight: 700; line-height: 1.2; flex-shrink: 0; }
.wk-chal__cal {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #FFFAF3;
}
.wk-chal__cell {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  background: #F5E6D4;
}
.wk-chal__cell--on { box-shadow: 0 8rpx 32rpx rgba(180, 83, 9, 0.06); }
.wk-chal__body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
}
.wk-chal__streak {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-shrink: 0;
}
.wk-chal__num { font-size: 68rpx; font-weight: 700; line-height: 1; }
.wk-chal__unit { font-size: 24rpx; color: #57534E; }
.wk-chal__meta {
  text-align: right;
  min-width: 0;
  flex: 1;
}
.wk-chal__done {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #57534E;
}
.wk-chal__tip {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #78716C;
}
.wk-chal__cta {
  display: block;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFDF9;
}

/* ---- planet_benefit_card 轻量权益卡 ---- */
.wk-benefit { position: relative; padding: 32rpx 28rpx 28rpx; }
.wk-benefit__badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.wk-benefit__head { margin-top: 20rpx; }
.wk-benefit__name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #292524;
}
.wk-benefit__tagline {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #78716C;
}
.wk-benefit__item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #F5E6D4;
}
.wk-benefit__item--first { border-top: none; padding-top: 0; }
.wk-benefit__icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: #FFFAF3;
}
.wk-benefit__text { min-width: 0; flex: 1; }
.wk-benefit__btitle {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #292524;
}
.wk-benefit__bdesc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #78716C;
}
.wk-benefit__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #F5E6D4;
}
.wk-benefit__price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}
.wk-benefit__orig {
  font-size: 24rpx;
  color: #78716C;
  text-decoration: line-through;
}
.wk-benefit__now { font-size: 48rpx; font-weight: 700; line-height: 1; }
.wk-benefit__symbol { font-size: 28rpx; font-style: normal; margin-right: 2rpx; }
.wk-benefit__unit { font-size: 22rpx; color: #78716C; }
.wk-benefit__cta {
  flex-shrink: 0;
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFDF9;
}

/* ============================================================
 * 增长转化
 * ========================================================== */

/* ---- op_creator_banner 创作者招募 ---- */
.wk-creator { position: relative; padding: 28rpx; }
.wk-creator__head { display: flex; flex-direction: column; gap: 12rpx; }
.wk-creator__tag {
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: #FFFDF9;
}
.wk-creator__slogan {
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.65;
  color: #292524;
}
.wk-creator__income {
  margin: 16rpx 0 0;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #B45309;
  background: #FFFAF3;
}
.wk-creator__foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F5E6D4;
}
.wk-creator__cta {
  display: inline-block;
  padding: 10rpx 28rpx;
  border: 2rpx solid;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* ---- op_quote_card 金句卡 ---- */
.wk-quote { position: relative; padding: 44rpx 36rpx; }
.wk-quote__body { position: relative; }
.wk-quote--center { text-align: center; }
.wk-quote--left { text-align: left; }
.wk-quote__mark {
  position: absolute;
  top: -28rpx;
  font-size: 112rpx;
  line-height: 1;
  pointer-events: none;
}
.wk-quote--center .wk-quote__mark { transform: translateX(-50%); }
.wk-quote__text {
  position: relative;
  margin: 0;
  font-weight: 600;
  line-height: 1.75;
  color: #292524;
}
.wk-quote__by {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.wk-quote__author { font-size: 24rpx; font-weight: 500; }
.wk-quote__title { font-size: 22rpx; line-height: 1.6; color: #78716C; }

/* ---- op_smart_group_card 智能群卡 ---- */
.wk-group { position: relative; padding: 28rpx; }
.wk-group__head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
  min-width: 0;
}
.wk-group__name {
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #292524;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wk-group__scale { font-size: 22rpx; color: #B45309; flex-shrink: 0; }
.wk-group__main { display: flex; gap: 24rpx; }
.wk-group__qrbox { flex: 0 0 168rpx; text-align: center; }
.wk-group__qr {
  width: 168rpx;
  height: 168rpx;
  border-radius: 20rpx;
  background: #FFFAF3;
  border: 2rpx solid #F5E6D4;
}
.wk-group__qr--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #B45309;
}
.wk-group__qrtip {
  margin: 12rpx 0 0;
  font-size: 20rpx;
  line-height: 1.5;
  color: #0AAA75;
}
.wk-group__benefits {
  flex: 1;
  min-width: 0;
}
.wk-group__benefit {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 0;
  min-width: 0;
}
.wk-group__benefit--sep { border-top: 2rpx solid #F5E6D4; }
.wk-group__bicon { flex-shrink: 0; font-size: 26rpx; line-height: 1.6; }
.wk-group__btext {
  font-size: 24rpx;
  line-height: 1.6;
  color: #57534E;
  min-width: 0;
  flex: 1;
}
.wk-group__foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F5E6D4;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}
.wk-group__cta {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border: 2rpx solid;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.wk-group__wechat {
  font-size: 22rpx;
  color: #78716C;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- op_referral_banner 邀请banner ---- */
.wk-referral { position: relative; padding: 28rpx; }
.wk-referral__incentive {
  margin: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.65;
  color: #292524;
}
.wk-referral__progress { margin-top: 24rpx; }
.wk-referral__bar {
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #F5E6D4;
}
.wk-referral__fill {
  display: block;
  height: 100%;
  border-radius: 999rpx;
}
.wk-referral__nums {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}
.wk-referral__count { font-size: 22rpx; color: #78716C; }
.wk-referral__pct { font-size: 26rpx; font-weight: 600; }
.wk-referral__rewards {
  margin: 24rpx 0 0;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #FFFAF3;
}
.wk-referral__reward {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 6rpx 0;
  min-width: 0;
}
.wk-referral__ricon { flex-shrink: 0; font-size: 24rpx; line-height: 1.7; }
.wk-referral__rtext {
  font-size: 24rpx;
  line-height: 1.7;
  color: #57534E;
  min-width: 0;
  flex: 1;
}
.wk-referral__foot { margin-top: 24rpx; }
.wk-referral__cta {
  display: block;
  padding: 16rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFDF9;
}

/* ---- op_gated_download_card 门控下载卡 ---- */
.wk-gate { position: relative; padding: 28rpx; }
.wk-gate__top { display: flex; gap: 24rpx; }
.wk-gate__cover {
  flex: 0 0 144rpx;
  width: 144rpx;
  height: 192rpx;
  border-radius: 16rpx;
  background: #FFFAF3;
  border: 2rpx solid #F5E6D4;
}
.wk-gate__cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #B45309;
}
.wk-gate__info { flex: 1; min-width: 0; }
.wk-gate__title {
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #292524;
}
.wk-gate__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.wk-gate__chip {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: #B45309;
  background: #FFFAF3;
  border: 2rpx solid #F5E6D4;
}
.wk-gate__chip--lock {
  color: #FFFDF9;
  background: #B45309;
  border-color: #B45309;
}
.wk-gate__desc {
  margin: 20rpx 0 0;
  font-size: 24rpx;
  line-height: 1.7;
  color: #57534E;
}
.wk-gate__form {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.wk-gate__input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid #F5E6D4;
  background: #FFFAF3;
  font-size: 24rpx;
  color: #292524;
}
.wk-gate__foot { margin-top: 28rpx; }
.wk-gate__cta {
  display: block;
  padding: 18rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFDF9;
}
.wk-gate__tip {
  margin: 16rpx 0 0;
  font-size: 20rpx;
  line-height: 1.6;
  color: #78716C;
}

/* ============================================================
 * 平排横滑
 * ========================================================== */

/* ---- h_peek_carousel 半露横滑 ---- */
.wk-peekc { position: relative; padding: 28rpx 0 24rpx; }
.wk-peekc__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
}
.wk-peekc__tip { font-size: 22rpx; color: #78716C; }
.wk-peekc__track {
  display: flex;
  white-space: nowrap;
  padding-right: 28rpx;
}
.wk-peekc__card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  border-radius: 28rpx;
  background: #FFFAF3;
  border: 2rpx solid #F5E6D4;
