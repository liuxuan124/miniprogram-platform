/* ---- h_comparison_card 对比卡 ---- */
.wk-cmp { position: relative; padding: 28rpx; }
.wk-cmp__head { margin-bottom: 24rpx; }
.wk-cmp__cols { display: flex; align-items: stretch; gap: 20rpx; }
.wk-cmp__col {
