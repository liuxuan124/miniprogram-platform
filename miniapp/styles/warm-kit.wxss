}
.wk-cmp__row--muted .wk-cmp__text { color: #78716C; }
.wk-cmp__note {
  margin: 12rpx 20rpx 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #F5E6D4;
