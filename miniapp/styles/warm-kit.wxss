  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 12rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}
.wk-cmp__label-text {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #FFFDF9;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wk-cmp__badge {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #C2410C;
