@import "./warm-theme.wxss";

.pl-hero {
  position: relative;
  padding: 24rpx 36rpx 36rpx;
  color: #fff;
  overflow: hidden;
  background: linear-gradient(150deg, #7c2d12 0%, #b45309 55%, #d97706 100%);
}

.pl-hero::after {
  content: "";
  position: absolute;
  width: 460rpx;
  height: 460rpx;
  border-radius: 999rpx;
  right: -160rpx;
  top: -192rpx;
  background: rgba(255, 255, 255, 0.09);
  pointer-events: none;
}

.pl-hero::before {
  content: "";
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 999rpx;
  left: -120rpx;
  bottom: -160rpx;
  background: rgba(255, 255, 255, 0.07);
  pointer-events: none;
}

.pl-hero__rw {
  display: flex;
  align-items: center;
  gap: 26rpx;
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
}

.pl-hero__lg {
  width: 116rpx;
  height: 116rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex: none;
  overflow: hidden;
}
/* 图标库模式（logo_mode=image）：铺满圆角框，避免素材本身留白露底 */
.pl-hero__lg-img { width: 100%; height: 100%; }

/* 会员态的续费按钮：与游客态「加入」同一位置，用暖金底区分语义 */
.pl-hero__rn {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #fde68a;
  color: #7c2d12;
  font-size: 24rpx;
  font-weight: 780;
  display: flex;
  align-items: center;
  flex: none;
}

.pl-hero__meta { flex: 1; min-width: 0; }
.pl-hero__mode {
  display: block;
  font-size: 20rpx;
  font-weight: 650;
  opacity: 0.75;
  margin-bottom: 4rpx;
  letter-spacing: 0.04em;
}
.pl-hero__title {
  display: block;
  font-size: 40rpx;
  font-weight: 750;
  letter-spacing: -0.02em;
}
.pl-hero__sb {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  opacity: 0.82;
}
.pl-hero__acts {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: none;
  position: relative;
  z-index: 2;
}
.pl-hero__sw {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}
.pl-hero__jn {
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #9a3412;
  font-size: 25rpx;
  font-weight: 780;
  display: flex;
  align-items: center;
  flex: none;
}

.pl-kpi {
  position: relative;
  margin-top: 32rpx;
  display: grid;
  gap: 14rpx;
  min-height: 112rpx;
}
/*
 * KPI 列数由 wxml 的行内 style 动态给出：repeat(visibleKpis.length, minmax(0,1fr))。
 * ⚠️ 此前这里按数量写了 --quad/--triple/--compact 三档类名，但 wxml 挂的是
 * --{{kpiStyle}}（只有 glass/plain），两套命名对不上 → grid-template-columns 从未生效，
 * 4 项 KPI 在真机上竖排成 4 行。类名已移除，列数改由行内 style 承担。
 * 保留 minmax(0,1fr) 的原因：1fr 的最小尺寸是 auto，长数字会撑破列宽。
 */
.pl-kpi__item {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 26rpx;
  padding: 18rpx 8rpx;
  text-align: center;
}
/* 无底色极简：去掉色块，只用底部细线分隔 */
.pl-kpi--plain .pl-kpi__item {
  background: transparent;
  border: none;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 0;
}
.pl-kpi__b { display: block; font-size: 30rpx; font-weight: 780; }
/* 单位/后缀：数值大、后缀小一号，避免「8折」和「3,241」抢视觉 */
.pl-kpi__sfx { margin-left: 2rpx; font-size: 20rpx; font-weight: 600; opacity: 0.8; }
.pl-kpi__s { font-size: 19rpx; opacity: 0.78; }

.pl-exp {
  position: relative;
  margin-top: 22rpx;
  font-size: 21rpx;
  opacity: 0.72;
}

.pl-joinrow {
  position: relative;
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
}
.pl-joinrow__go {
  margin-left: auto;
  flex: none;
  font-weight: 760;
}

.pl-fc {
  margin: -24rpx 32rpx 0;
  position: relative;
  z-index: 4;
  border-radius: 40rpx;
  padding: 30rpx 32rpx 28rpx;
  background: var(--sheet);
  box-shadow: var(--shadow);
}
.pl-fc__t { display: flex; align-items: center; gap: 14rpx; }
.pl-fc__ic { font-size: 34rpx; }
.pl-fc__h { font-size: 29rpx; font-weight: 780; flex: 1; }
.pl-fc__bar {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-height: 200rpx;
}
.pl-fc__row { display: flex; align-items: center; gap: 18rpx; font-size: 24rpx; }
.pl-fc__nm { width: 176rpx; flex: none; color: var(--ink-2); font-weight: 620; }
.pl-fc__tr {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: #f3e3d0;
  overflow: hidden;
}
.pl-fc__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--gold), var(--brand-2));
}
.pl-fc__pct {
  width: 88rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 750;
  color: var(--brand);
}
.pl-fc__pct--dn { color: #78716c; }
.pl-fc__note {
  margin-top: 22rpx;
  font-size: 21rpx;
  color: var(--mute);
  line-height: 1.55;
  border-top: 1rpx dashed var(--line);
  padding-top: 18rpx;
}

/* ========== 分段标签栏：三种外观 + 可关吸顶 ==========
   ⚠️ 这里的默认值必须与后台预览 PlanetFeedRenderer.vue 的同名类保持一致，
   「继承品牌色」时后台不下行内样式，靠这堆默认值呈现，两端才长得一样。
   ⚠️ 选中态刻意不加 !important：运营自定义 active_bg 时，
   行内样式必须能盖掉下面的默认渐变（!important 会把行内样式压掉）。 */
.pl-segs {
  white-space: nowrap;
  padding: 32rpx 0 16rpx;
  min-height: 96rpx;
}
/* 吸顶做成可选：默认不加，靠 .pl-segs--sticky 显式打开 */
.pl-segs--sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  background: linear-gradient(180deg, var(--bg) 72%, transparent);
}
/* 下沉避让：top 由行内 style 给出（JS 实测上方顶栏高度）。
   渐变背景此时盖不住从下方滚上来的内容，改不透明底 + 投影，否则会「透字」 */
.pl-segs--offset {
  background: var(--bg);
  box-shadow: 0 4rpx 12rpx rgba(120, 72, 40, 0.08);
}

.pl-feed-wrap {
  min-height: 960rpx;
}
.pl-segs__inner {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 32rpx;
}
.pl-seg {
  flex: none;
  font-size: 25rpx;
  font-weight: 650;
  color: #6b5443;
}

/* —— 胶囊（默认，与线上现状一致）—— */
.pl-segs--pill .pl-segs__inner { gap: 14rpx; }
.pl-segs--pill .pl-seg {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fffaf3;
  border: 1rpx solid rgba(120, 72, 40, 0.12);
}
.pl-segs--pill .pl-seg--on {
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: #fff;
  border-color: transparent;
}

/* —— 底部滑块 —— */
.pl-segs--line .pl-segs__inner { gap: 0; }
.pl-segs--line .pl-seg {
  padding: 18rpx 24rpx;
  background: transparent;
  border-bottom: 4rpx solid transparent;
}
.pl-segs--line .pl-seg--on {
  color: var(--brand);
  border-bottom-color: var(--brand);
}

/* —— 纯文本 —— */
.pl-segs--text .pl-segs__inner { gap: 0; }
.pl-segs--text .pl-seg {
  padding: 16rpx 22rpx;
  background: transparent;
}
.pl-segs--text .pl-seg--on {
  color: var(--brand);
}

/* 卡片：margin-bottom / padding / border-radius / box-shadow 由行内样式接管，
   这里的值只是「运营什么都没配」时的兜底，与后台预览默认值一致。 */
.pl-fd {
  margin: 0 32rpx 24rpx;
  border-radius: 32rpx;
  background: var(--sheet);
  box-shadow: var(--shadow-s);
  padding: 28rpx 30rpx 20rpx;
}
/*
 * 配了通栏底色（style.background_color）时，卡片让位成半透明，
 * 否则不透明米白会把底色整块遮死 —— 表现为「配了背景色没生效」。
 * ⚠️ 与后台 PlanetFeedRenderer 的 `.pf.has-bg .pf__card` 同规则、同 alpha(0.82)，
 * 两端观感必须一致，否则会出现「预览透蓝、真机不透」。
 */
.has-bg .pl-fd { background: rgba(255, 253, 249, 0.82); }
.has-bg .pl-fd--top { background: linear-gradient(150deg, rgba(255, 247, 236, 0.9), rgba(255, 250, 243, 0.82)); }
/* 吸顶条同理：跟随通栏底色，避免顶部留一条米白与下方割裂 */
.has-bg .pl-segs--sticky { background: rgba(255, 253, 249, 0.96); }
.pl-fd--top {
  border: 1rpx solid #f0d3ad;
  background: linear-gradient(150deg, #fff7ec, #fffaf3);
}
.pl-fd__hh { display: flex; align-items: center; gap: 18rpx; }
.pl-fd__av {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex: none;
  background: var(--sheet-2);
}
.pl-fd__av--fb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  font-weight: 700;
  background: #fbe6d4;
}
.pl-fd__who { flex: 1; min-width: 0; }
.pl-fd__nm {
  font-size: 26rpx;
  font-weight: 720;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.pl-fd__tm { font-size: 21rpx; color: var(--mute); margin-top: 4rpx; display: block; }
.pl-fd__mo { margin-left: auto; color: var(--mute); flex: none; }
.pl-fd__ct {
  display: block;
  margin-top: 22rpx;
  font-size: 29rpx;
  line-height: 1.72;
  color: #3a2a1c;
}
/* 正文截断：行数由行内样式注入 -webkit-line-clamp；未开启截断时无此 class */
.pl-fd__ct--clamp {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
}
.pl-fd__q {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: var(--sheet-2);
  font-size: 27rpx;
  line-height: 1.65;
}
.pl-fd__qlb {
  font-size: 20rpx;
  color: var(--gold);
  font-weight: 750;
  letter-spacing: 0.1em;
  margin-bottom: 10rpx;
}
/* 附件容器：一条动态可挂多份资料，卡片间留 16rpx 间距。
   旧的 .pl-fd__file 自带 margin-top:22rpx，多附件时由容器统一承担首卡上边距。 */
.pl-fd__files { margin-top: 22rpx; display: flex; flex-direction: column; gap: 16rpx; }
.pl-fd__files .pl-fd__file { margin-top: 0; }
.pl-fd__file {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  border: 1rpx dashed #e3c9a8;
  background: #fffdf9;
}
.pl-fd__fic { font-size: 40rpx; }
.pl-fd__fmeta { flex: 1; min-width: 0; }
.pl-fd__fh { display: block; font-size: 25rpx; font-weight: 700; }
.pl-fd__fp { display: block; font-size: 20rpx; color: var(--mute); margin-top: 4rpx; }
.pl-fd__fgo { margin-left: auto; font-size: 22rpx; color: var(--brand); flex: none; }
.pl-fd__gg {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}
.pl-fd__gg--two { grid-template-columns: repeat(2, 1fr); }
.pl-fd__img {
  width: 100%;
  height: 168rpx;
  border-radius: 18rpx;
  background: var(--sheet-2);
}
.pl-fd__gg--two .pl-fd__img { height: 224rpx; }
/* 原图比例自适应：不设固定高度，配合 mode="widthFix" 由图片自身比例撑开 */
.pl-fd__gg--auto { display: block; }
.pl-fd__gg--auto .pl-fd__img {
  display: block;
  height: auto;
  margin-bottom: 10rpx;
}
.pl-fd__gg--auto .pl-fd__img:last-child { margin-bottom: 0; }
.pl-fd__tp {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}
.pl-fd__ft {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  font-size: 23rpx;
  color: var(--mute);
}
.pl-fd__ft text { flex: 1; text-align: center; }
.pl-fd__hot { color: var(--brand); font-weight: 680; }

.pl-fab {
  position: fixed;
  right: 34rpx;
  bottom: calc(184rpx + env(safe-area-inset-bottom));
  z-index: 16;
  height: 92rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: #fff;
  font-size: 28rpx;
  font-weight: 750;
  box-shadow: 0 24rpx 52rpx rgba(194, 65, 12, 0.4);
}

.warm-serif { font-family: "Songti SC", "Noto Serif SC", serif; }
.warm-tag {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 700;
  background: #fbe6d4; color: #c2410c;
}
.warm-tag--gold {
  background: linear-gradient(135deg,#f6d9a8,#efc27a); color: #8a4b12;
}
.warm-ph { background: #f3e3d0; }
.warm-end {
  text-align: center;
  color: var(--mute, #a1897a);
  font-size: 21rpx;
  padding: 28rpx 0 12rpx;
  letter-spacing: 0.1em;
}

/* ---------------------------------------------------------------- *
 * 加群活码弹窗（group_action_type=qrcode）
 * 端上不依赖任何 UI 库，纯 view 实现，避免为一个弹窗引组件。
 * ---------------------------------------------------------------- */
.pl-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pl-modal__mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
}
.pl-modal__bd {
  position: relative;
  z-index: 1;
  width: 560rpx;
  padding: 48rpx 40rpx 36rpx;
  background: #fff;
  border-radius: 32rpx;
  text-align: center;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
}
.pl-modal__t {
  display: block;
  color: #172033;
  font-size: 32rpx;
  font-weight: 780;
}
/* 二维码固定 1:1，否则非正方形素材会被拉伸变形 */
.pl-modal__qr {
  width: 320rpx;
  height: 320rpx;
  margin: 32rpx auto 24rpx;
  display: block;
  background: #f5f5f4;
  border-radius: 16rpx;
}
.pl-modal__d {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}
.pl-modal__d--warn { color: #b42318; }
.pl-modal__x {
  margin-top: 36rpx;
  padding: 20rpx;
  color: #8c3208;
  font-size: 27rpx;
  font-weight: 700;
  background: #f7efe7;
  border-radius: 999rpx;
}
