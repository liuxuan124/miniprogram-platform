<page-meta page-style="{{themePageStyle}}" />
<view class="page">
  <block wx:if="{{list.length}}">
    <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openItem">
      <image class="cover" src="{{item.cover || item.coverImage || '/images/default-product.png'}}" mode="aspectFill" />
      <view class="meta">
        <view class="title">{{item.title}}</view>
        <view class="sub">{{item.summary || item.categoryName || '已收藏'}}</view>
      </view>
      <view class="rm" data-id="{{item.id}}" catchtap="removeItem">移除</view>
    </view>
  </block>
  <empty-state
    wx:else
    icon="⭐️"
    title="还没有收藏任何内容"
    desc="读到好文章时点一下右下角的星星\n之后在这里随时找得到"
    buttonText="去逛逛长文"
    subText="也可以看看"
    subLink="大家在读什么"
    bind:action="goContent"
    bind:subaction="goDiscover"
  />
</view>
<login-sheet id="global-login-sheet" />
