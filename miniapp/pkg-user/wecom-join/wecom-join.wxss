.page { padding: 48rpx 32rpx; }
.hd { font-size: 34rpx; font-weight: 700; color: #172033; margin-bottom: 24rpx; }
.box { background: #fff; border-radius: 16rpx; padding: 24rpx; }
.url { font-size: 24rpx; color: #334155; word-break: break-all; line-height: 1.5; }
.btn { margin-top: 24rpx; height: 80rpx; line-height: 80rpx; text-align: center; background: var(--brand); color: #fff; border-radius: 12rpx; font-size: 28rpx; }
.empty { color: #94a3b8; font-size: 26rpx; }
.tip { margin-top: 32rpx; font-size: 22rpx; color: #94a3b8; line-height: 1.6; }
