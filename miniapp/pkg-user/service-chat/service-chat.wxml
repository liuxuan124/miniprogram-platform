<page-meta page-style="{{themePageStyle}}" />
<view class="svc-page">
  <view class="svc-header">
    <view class="svc-header__main">
      <text class="svc-header__title">暖阁客服 · 小助手</text>
      <view class="svc-header__status">● 在线 · 平均 1 分钟回复</view>
    </view>
    <text class="svc-join" bindtap="onJoin">加入读者群</text>
  </view>

  <scroll-view scroll-y class="chat" scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="day">今天</view>

    <view class="sysbar">
      <text>工作日 9:00-21:00 客服在线 · 非工作时间留言，我们会尽快回复</text>
      <text>\n客服</text><text class="sysbar__b">不会索要支付密码或验证码</text><text>，谨防冒充</text>
    </view>

    <view class="delivery-card" wx:if="{{deliveryCard}}">
      <view class="delivery-card__head">
        <text class="delivery-card__title">{{deliveryCard.isManualGuide ? '开通指引' : '自动发货'}}</text>
        <text class="delivery-card__copy" wx:if="{{deliveryCard.content}}" bindtap="onCopyDelivery">复制内容</text>
      </view>
      <view class="delivery-card__name">{{deliveryCard.name}}</view>
      <view class="delivery-card__body" wx:if="{{deliveryCard.content}}">{{deliveryCard.content}}</view>
      <view class="delivery-card__body" wx:else>{{deliveryCard.isManualGuide ? '支付已完成，开通指引稍后由客服发送给你。' : '支付已完成，可在下方直接咨询发货问题。'}}</view>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <!-- text -->
      <view wx:if="{{item.type === 'text' || !item.type}}" id="m{{item.id}}" class="msg {{item.role === 'me' || item.role === 'user' ? 'me' : ''}}">
        <image
          wx:if="{{!item.hideAvatar}}"
          class="av"
          src="{{item.role === 'me' || item.role === 'user' ? meAvatar : botAvatar}}"
          mode="aspectFill"
        />
        <view wx:else class="av av--ghost"></view>
        <view class="bb-wrap">
          <view class="nm" wx:if="{{item.role !== 'me' && item.role !== 'user' && !item.hideAvatar}}">暖阁小助手</view>
          <view class="bb">{{item.text}}</view>
        </view>
      </view>

      <!-- order card -->
      <view wx:elif="{{item.type === 'ordcard'}}" id="m{{item.id}}" class="msg {{item.role === 'me' || item.role === 'user' ? 'me' : ''}}">
        <image
          wx:if="{{!item.hideAvatar}}"
          class="av"
          src="{{item.role === 'me' || item.role === 'user' ? meAvatar : botAvatar}}"
          mode="aspectFill"
        />
        <view wx:else class="av av--ghost"></view>
        <view class="ordcard">
          <view class="ordcard__rw">
            <image class="ordcard__im" src="{{item.order.cover}}" mode="aspectFill" />
            <view>
              <view class="ordcard__h">{{item.order.title}}</view>
              <view class="ordcard__p">订单号 {{item.order.orderNo}}</view>
            </view>
          </view>
          <view class="ordcard__ft">
            <text class="ordcard__price">{{item.order.priceLabel}}</text>
            <text class="ordcard__link" bindtap="onViewOrder" data-id="{{item.order.orderId}}">查看订单 ›</text>
          </view>
        </view>
      </view>

      <!-- image -->
      <view wx:elif="{{item.type === 'imgmsg'}}" id="m{{item.id}}" class="msg {{item.role === 'me' || item.role === 'user' ? 'me' : ''}}">
        <image
          wx:if="{{!item.hideAvatar}}"
          class="av"
          src="{{item.role === 'me' || item.role === 'user' ? meAvatar : botAvatar}}"
          mode="aspectFill"
        />
        <view wx:else class="av av--ghost"></view>
        <image class="imgmsg" src="{{item.imageUrl}}" mode="aspectFill" data-url="{{item.imageUrl}}" bindtap="onPreviewImg" />
      </view>

      <!-- act card -->
      <view wx:elif="{{item.type === 'actcard'}}" id="m{{item.id}}" class="actcard">
        <view class="actcard__h">{{item.act.title}}</view>
        <view class="actcard__p">{{item.act.desc}}</view>
        <view class="actcard__btns">
          <view class="actcard__bt" bindtap="onJoin">{{item.act.primary || '立即进群'}}</view>
          <button class="actcard__bt ghost" open-type="contact" bindtap="onTransferHuman" style="margin:0;padding:0;border:0;line-height:68rpx">
            {{item.act.secondary || '转人工'}}
          </button>
        </view>
      </view>

      <view class="quick" wx:if="{{showQuick && index === 0}}">
        <view wx:for="{{quick}}" wx:for-item="q" wx:key="*this" class="q" data-q="{{q}}" bindtap="onQuick">{{q}}</view>
      </view>
    </block>

    <!-- ===== 真实 IM 消息区（客服发的商品卡 / 物流卡 / 系统事件）=====
         ⚠️ payload 字段名与后台 ImCardService 完全一致，两端任一处改都会导致
            另一端渲染空白卡片。改字段必须同步两端。 -->
    <block wx:for="{{imMessages}}" wx:key="id">
      <!-- 系统事件胶囊 -->
      <view wx:if="{{item.msgType === 'system_event'}}" class="im-sys">
        <text class="im-sys__title">{{item.payload.title}}</text>
        <text wx:if="{{item.payload.desc}}" class="im-sys__desc">{{item.payload.desc}}</text>
      </view>

      <!-- 商品卡 -->
      <view wx:elif="{{item.msgType === 'product_card'}}" class="im-card">
        <view class="im-card__body">
          <image wx:if="{{item.payload.coverUrl}}" class="im-card__cover" src="{{item.payload.coverUrl}}" mode="aspectFill" />
          <view wx:else class="im-card__cover im-card__cover--empty">无图</view>
          <view class="im-card__info">
            <view class="im-card__title">{{item.payload.title}}</view>
            <view class="im-card__meta">
              <text class="im-card__price">¥{{item.payload.price}}</text>
              <text wx:if="{{item.payload.originalPrice}}" class="im-card__origin">¥{{item.payload.originalPrice}}</text>
              <text class="im-card__stock">库存 {{item.payload.stock}}</text>
            </view>
          </view>
        </view>
        <view class="im-card__cta" bindtap="onOpenLink" data-link="{{item.payload.linkPath}}">
          查看商品详情 ›
        </view>
        <view wx:if="{{item.payload.id}}" class="im-card__cta im-card__cta--sub" bindtap="onAskSame" data-pid="{{item.payload.id}}">
          咨询同款
        </view>
      </view>

      <!-- 物流卡 -->
      <view wx:elif="{{item.msgType === 'logistics_card'}}" class="im-card">
        <view class="im-card__row">
          <text class="im-card__express">{{item.payload.expressName}}</text>
          <text class="im-card__status">{{item.payload.status}}</text>
        </view>
        <view wx:if="{{item.payload.orderNo}}" class="im-card__orderno">订单 {{item.payload.orderNo}}</view>
        <view
          wx:if="{{item.payload.orderId}}"
          class="im-card__orderno im-card__orderno--link"
          bindtap="onOpenOrder"
          data-oid="{{item.payload.orderId}}"
        >查看订单进度 ›</view>
        <view wx:if="{{item.payload.trackingNo}}" class="im-card__no" bindtap="onCopyTracking" data-no="{{item.payload.trackingNo}}">
          {{item.payload.trackingNo}}
          <text class="im-card__copy">复制</text>
        </view>
        <view wx:if="{{item.payload.latestTrack}}" class="im-card__latest">{{item.payload.latestTrack}}</view>
        <view wx:if="{{item.payload.tracks && item.payload.tracks.length > 1}}" class="im-card__tracks">
          <view wx:for="{{item.payload.tracks}}" wx:for-item="t" wx:key="time" class="im-track">
            <text class="im-track__time">{{t.time}}</text>
            <text class="im-track__text">{{t.context}}</text>
          </view>
        </view>
        <view class="im-card__cta" bindtap="onOpenLink" data-link="{{item.payload.linkPath}}">
          查看订单详情 ›
        </view>
      </view>

      <!-- 图片 -->
      <view wx:elif="{{item.msgType === 'image'}}" class="im-card">
        <image class="im-card__img" src="{{item.payload.url}}" mode="widthFix" bindtap="onPreviewImage" data-url="{{item.payload.url}}" />
      </view>

      <!-- 文本 -->
      <view wx:else class="msg">
        <view class="av av--ghost"></view>
        <view class="bb-wrap">
          <view class="bb">{{item.text}}</view>
        </view>
      </view>
    </block>

    <view class="typing" wx:if="{{typing || imAgentTyping}}">对方正在输入…</view>
    <view id="mbot" style="height:24rpx"></view>
  </scroll-view>

  <view class="inputbar">
    <view class="inputbar__rw">
      <text class="inputbar__emoji" bindtap="onToggleEmoji">😊</text>
      <input
        class="inputbar__ipt"
        value="{{inputText}}"
        placeholder="输入你的问题…"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSend"
        disabled="{{sending}}"
      />
      <view class="inputbar__send" wx:if="{{inputText}}" bindtap="onSend">发送</view>
      <text class="inputbar__plus" wx:else>＋</text>
    </view>
    <view class="inputbar__emoji-panel" wx:if="{{showEmoji}}">
      <text
        wx:for="{{emojis}}"
        wx:key="*this"
        class="emoji-item"
        data-e="{{item}}"
        bindtap="onPickEmoji"
      >{{item}}</text>
    </view>
    <view class="inputbar__tools">
      <view class="tool" bindtap="onPickImage"><text class="tool__ic">🖼️</text>图片</view>
      <view class="tool" bindtap="onPickOrder"><text class="tool__ic">🧾</text>发订单</view>
      <button class="tool tool--btn" open-type="contact" bindtap="onTransferHuman" style="margin:0;padding:0;border:0;background:transparent;line-height:1.2">
        <text class="tool__ic">👤</text>转人工
      </button>
      <view class="tool" bindtap="onJoin"><text class="tool__ic">👥</text>进群</view>
    </view>
  </view>
</view>
<login-sheet id="global-login-sheet" />
