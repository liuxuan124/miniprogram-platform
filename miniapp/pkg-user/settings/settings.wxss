.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section-label {
  margin: 8rpx 8rpx 14rpx;
  color: #8b93a7;
  font-size: 24rpx;
}

.edit-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e8ebf2;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.avatar-wrap {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto;
}

.avatar-lg {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #e8eef7;
  border: 4rpx solid #d7dde6;
  display: block;
}

.avatar-cam {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(23, 105, 255, 0.92);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  line-height: 1;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
}

.field-input {
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d7dde6;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1f2937;
  background: #fff;
}

.field-input--error {
  border-color: #ef4444;
  color: #d14343;
}

.field-input--warn {
  border-color: #f59e0b;
}

.field-tip {
  font-size: 22rpx;
  color: #ef4444;
  line-height: 1.3;
}

.field-soft {
  font-size: 22rpx;
  color: #d97706;
  line-height: 1.3;
}

.field-hint {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.3;
}

.save-btn {
  margin-top: 8rpx;
  height: 84rpx;
  line-height: 84rpx;
  border: none;
  border-radius: 999rpx;
  background: #1769ff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.save-btn::after { border: 0; }

.save-btn--disabled {
  opacity: 0.45;
}

.group {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid #e8ebf2;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  font-size: 28rpx;
  color: #111827;
  border-bottom: 1rpx solid #f0f1f5;
  background: #fff;
  margin: 0;
  line-height: 1.4;
  text-align: left;
}

.row--last,
.row:last-child { border-bottom: none; }
.row.muted { color: #888; }

.login-tip-text {
  flex: 1;
  min-width: 0;
  color: #374151;
  font-size: 26rpx;
}

.login-tip .link {
  color: #315efb;
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.logout {
  margin-top: 12rpx;
  background: #fff;
  color: #d14343;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid #e8ebf2;
  line-height: 92rpx;
}
.logout::after { border: 0; }
