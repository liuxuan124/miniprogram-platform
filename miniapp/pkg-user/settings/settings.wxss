.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section-label {
  margin: 8rpx 8rpx 14rpx;
  color: #8b93a7;
  font-size: 24rpx;
}

.group {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid #e8ebf2;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  font-size: 28rpx;
  color: #111827;
  border-bottom: 1rpx solid #f0f1f5;
  background: #fff;
  margin: 0;
  line-height: 1.4;
  text-align: left;
}

.row--last,
.row:last-child { border-bottom: none; }
.row--btn::after { border: 0; }
.row--pressed { background: #f7f8fb; }
.row.muted { color: #888; }

.label {
  width: 140rpx;
  flex-shrink: 0;
  color: #374151;
  font-size: 28rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #eef2ff;
  margin-left: auto;
}

.hint {
  margin-left: 12rpx;
  color: #9ca3af;
  font-size: 22rpx;
}

.ar { color: #c4c9d4; margin-left: 8rpx; font-size: 30rpx; }

.nick-input {
  flex: 1;
  text-align: right;
  color: #111827;
  font-size: 28rpx;
  min-width: 0;
}

.phone {
  flex: 1;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.val { color: #6b7280; font-size: 26rpx; }

.bind-btn {
  margin: 0 0 0 16rpx;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #eaf0ff;
  color: #315efb;
  font-size: 22rpx;
  font-weight: 700;
}
.bind-btn::after { border: 0; }
.bind-btn--pressed { opacity: 0.85; }

.login-tip .link {
  color: #315efb;
  font-size: 26rpx;
  font-weight: 600;
}

.logout {
  margin-top: 12rpx;
  background: #fff;
  color: #d14343;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid #e8ebf2;
  line-height: 92rpx;
}
.logout::after { border: 0; }
