<!-- pkg-user/settings/settings.wxml -->
<view class="page">
  <!-- 编辑资料 -->
  <view class="section-label">编辑资料</view>
  <view class="edit-card" wx:if="{{isLoggedIn}}">
    <view class="avatar-wrap" bindtap="onChooseAvatar">
      <image class="avatar-lg" src="{{editAvatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill" />
      <view class="avatar-cam">📷</view>
    </view>

    <view class="field">
      <text class="field-label">昵称</text>
      <input
        class="field-input {{nicknameError ? 'field-input--error' : ''}}"
        type="nickname"
        maxlength="20"
        placeholder="请输入昵称"
        value="{{editNickName}}"
        bindinput="onNickInput"
        bindnicknamereview="onNicknameReview"
      />
      <text class="field-tip" wx:if="{{nicknameError}}">昵称不能超过10个字</text>
      <text class="field-hint" wx:else>最多 10 个字</text>
    </view>

    <view class="field">
      <text class="field-label">手机号</text>
      <input
        class="field-input {{phoneSoftTip ? 'field-input--warn' : ''}}"
        type="number"
        maxlength="15"
        placeholder="请输入手机号"
        value="{{editPhone}}"
        bindinput="onPhoneInput"
      />
      <text class="field-soft" wx:if="{{phoneSoftTip}}">{{phoneSoftTip}}</text>
    </view>

    <view class="field">
      <text class="field-label">邮箱</text>
      <input
        class="field-input {{emailSoftTip ? 'field-input--warn' : ''}}"
        type="text"
        maxlength="64"
        placeholder="请输入邮箱"
        value="{{editEmail}}"
        bindinput="onEmailInput"
      />
      <text class="field-soft" wx:if="{{emailSoftTip}}">{{emailSoftTip}}</text>
    </view>

    <button
      class="save-btn {{canSave ? '' : 'save-btn--disabled'}}"
      bindtap="onSaveProfile"
      loading="{{savingProfile}}"
      disabled="{{!canSave || savingProfile}}"
    >保存</button>
  </view>
  <view class="group login-tip" wx:else bindtap="onLoginTap">
    <view class="row row--last">
      <text class="login-tip-text">登录后可编辑头像、昵称、手机号与邮箱</text>
      <text class="link">去登录 ›</text>
    </view>
  </view>

  <view class="section-label">其他</view>
  <view class="group">
    <view class="row" bindtap="goAddress">
      <text>收货地址</text>
      <text class="ar">›</text>
    </view>
    <view class="row" bindtap="goTerms">
      <text>用户协议</text>
      <text class="ar">›</text>
    </view>
    <view class="row" bindtap="goPrivacy">
      <text>隐私政策</text>
      <text class="ar">›</text>
    </view>
    <view class="row row--last" bindtap="goFeedback">
      <text>意见反馈</text>
      <text class="ar">›</text>
    </view>
  </view>

  <view class="group">
    <view class="row row--last muted">
      <text>当前版本</text>
      <text class="val">{{version}}</text>
    </view>
  </view>

  <button class="logout" wx:if="{{isLoggedIn}}" bindtap="onLogout">退出登录</button>
</view>
<login-sheet id="global-login-sheet" />
