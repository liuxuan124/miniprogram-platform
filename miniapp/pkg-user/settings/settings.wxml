<!-- pkg-user/settings/settings.wxml -->
<view class="page">
  <!-- 个人信息 -->
  <view class="section-label">个人信息</view>
  <view class="group" wx:if="{{isLoggedIn}}">
    <button
      class="row row--btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
      hover-class="row--pressed"
    >
      <text class="label">头像</text>
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill" />
      <text class="hint">点击更换</text>
      <text class="ar">›</text>
    </button>

    <view class="row">
      <text class="label">昵称</text>
      <input
        class="nick-input"
        type="nickname"
        maxlength="20"
        placeholder="请输入昵称"
        value="{{editNickName}}"
        bindinput="onNickInput"
        bindblur="onNickBlur"
        bindchange="onNickBlur"
      />
    </view>

    <view class="row row--last">
      <text class="label">手机号</text>
      <text class="val phone">{{phoneMasked}}</text>
      <button
        class="bind-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onBindPhone"
        hover-class="bind-btn--pressed"
      >{{phoneBound ? '更换' : '去绑定'}}</button>
    </view>
  </view>
  <view class="group login-tip" wx:else bindtap="onLoginTap">
    <view class="row row--last">
      <text class="label">登录后可编辑头像、昵称与手机号</text>
      <text class="link">去登录 ›</text>
    </view>
  </view>

  <view class="section-label">其他</view>
  <view class="group">
    <view class="row" bindtap="goAddress">
      <text>收货地址</text>
      <text class="ar">›</text>
    </view>
    <view class="row" bindtap="goTerms">
      <text>用户协议</text>
      <text class="ar">›</text>
    </view>
    <view class="row" bindtap="goPrivacy">
      <text>隐私政策</text>
      <text class="ar">›</text>
    </view>
    <view class="row row--last" bindtap="goFeedback">
      <text>意见反馈</text>
      <text class="ar">›</text>
    </view>
  </view>

  <view class="group">
    <view class="row row--last muted">
      <text>当前版本</text>
      <text class="val">{{version}}</text>
    </view>
  </view>

  <button class="logout" wx:if="{{isLoggedIn}}" bindtap="onLogout">退出登录</button>
</view>
<login-sheet id="global-login-sheet" />
