.page {
  min-height: 100vh;
  background: #fdf6ec;
  padding: 24rpx;
  box-sizing: border-box;
}
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 8rpx 20rpx;
}
.toolbar__count { font-size: 24rpx; color: #a1897a; }
.toolbar__all { font-size: 24rpx; color: #c2410c; font-weight: 600; }
.card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #fffaf3;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(120, 72, 40, 0.12);
  box-shadow: 0 8rpx 20rpx rgba(120, 64, 24, 0.06);
}
.card--unread {
  border-color: rgba(194, 65, 12, 0.22);
  background: linear-gradient(150deg, #fff7ee, #fffaf3);
}
.card__dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #ea580c;
  flex-shrink: 0;
}
.card__main { flex: 1; min-width: 0; }
.card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.card__tag {
  font-size: 20rpx;
  color: #c2410c;
  background: rgba(194, 65, 12, 0.1);
  border-radius: 99rpx;
  padding: 2rpx 12rpx;
  font-weight: 600;
}
.card__time { font-size: 22rpx; color: #a1897a; }
.card__title { font-size: 30rpx; font-weight: 600; color: #2a1c12; line-height: 1.4; }
.card__content { margin-top: 8rpx; font-size: 24rpx; color: #6b5443; line-height: 1.55; }
.card__chevron { color: #ccb49c; font-size: 32rpx; line-height: 1; }
