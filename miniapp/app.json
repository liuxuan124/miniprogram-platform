{
  "pages": [
    "pages/index/index",
    "pages/content-list/content-list",
    "pages/knowledge-mall/knowledge-mall",
    "pages/product-list/product-list",
    "pages/mine/mine",
    "pages/login/login",
    "pages/search/search",
    "pages/product-detail/product-detail",
    "pages/content-detail/content-detail",
    "pages/moment-detail/moment-detail",
    "pages/question-ask/question-ask",
    "pages/question-detail/question-detail",
    "pages/cart/cart",
    "pages/order-create/order-create",
    "pages/custom/custom",
    "pages/custom-nav/custom-nav"
  ],
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "出海笔记",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f5f7fb"
  },
  "permission": {
    "scope.writePhotosAlbum": {
      "desc": "用于保存群二维码到相册"
    }
  },
  "lazyCodeLoading": "requiredComponents",
  "__usePrivacyCheck__": true,
  "usingComponents": {
    "login-sheet": "/components/login-sheet/login-sheet"
  },
  "tabBar": {
    "custom": true,
    "color": "#999999",
    "selectedColor": "#002FA7",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "images/tab/home.png",
        "selectedIconPath": "images/tab/home-active.png"
      },
      {
        "pagePath": "pages/content-list/content-list",
        "text": "内容",
        "iconPath": "images/tab/content.png",
        "selectedIconPath": "images/tab/content-active.png"
      },
      {
        "pagePath": "pages/knowledge-mall/knowledge-mall",
        "text": "商城",
        "iconPath": "images/tab/shop.png",
        "selectedIconPath": "images/tab/shop-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "images/tab/mine.png",
        "selectedIconPath": "images/tab/mine-active.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "subPackages": [
    {
      "root": "pkg-trade",
      "name": "pkg-trade",
      "pages": [
        "appointment-book/appointment-book",
        "appointment-calendar/appointment-calendar",
        "appointment-success/appointment-success",
        "category/category",
        "order-detail/order-detail",
        "order-list/order-list",
        "order-paid/order-paid",
        "reviews/reviews",
        "write-review/write-review"
      ]
    },
    {
      "root": "pkg-user",
      "name": "pkg-user",
      "pages": [
        "address-list/address-list",
        "agreement/agreement",
        "appointment-list/appointment-list",
        "coupon-list/coupon-list",
        "favorites/favorites",
        "feedback/feedback",
        "member-center/member-center",
        "my-appointments/my-appointments",
        "points-log/points-log",
        "service-chat/service-chat",
        "settings/settings",
        "sign-in/sign-in",
        "webview/webview"
      ]
    },
    {
      "root": "pkg-extra",
      "name": "pkg-extra",
      "pages": [
        "activity-detail/activity-detail",
        "activity-list/activity-list",
        "detail/detail",
        "form/form"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "wifi",
      "packages": [
        "pkg-extra"
      ]
    },
    "pages/mine/mine": {
      "network": "all",
      "packages": [
        "pkg-user",
        "pkg-trade"
      ]
    },
    "pages/content-list/content-list": {
      "network": "wifi",
      "packages": [
        "pkg-extra"
      ]
    }
  }
}
