<!-- pages/library/library.wxml — 已购资料 -->
<view class="library-page">
  <view class="hint">数字资料包支付成功后可永久阅读；可随时从这里打开。</view>

  <skeleton wx:if="{{loading && items.length === 0}}" type="list" rows="{{3}}" />

  <view class="list" wx:elif="{{!isEmpty}}">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      data-title="{{item.name}}"
      data-purchased="{{item.purchased}}"
      bindtap="onOpen"
    >
      <image class="cover" src="{{item.cover || '/images/default-product.svg'}}" mode="aspectFill" />
      <view class="info">
        <view class="badge">{{item.badge}}</view>
        <view class="title">{{item.name}}</view>
        <view class="meta">{{item.meta}}</view>
      </view>
      <view class="go">{{item.purchased ? '阅读 ›' : '去购买 ›'}}</view>
    </view>
  </view>

  <empty-state
    wx:if="{{isEmpty && !loading}}"
    title="还没有已购资料"
    desc="去商城看看资料包，购买后会出现在这里"
    action-text="去商城"
    bind:action="onGoShop"
  />
</view>
