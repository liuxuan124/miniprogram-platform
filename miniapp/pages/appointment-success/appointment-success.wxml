<!-- pages/appointment-success/appointment-success.wxml -->
<page-meta page-style="{{themePageStyle}}" />
<view class="as-page">
  <view class="hero" wx:if="{{!loadError && bookingNo}}">
    <view class="ok">🗓️</view>
    <view class="title">预约成功</view>
    <view class="sub">请按预约时段准时出席</view>
  </view>
  <view class="hero" wx:else>
    <view class="ok">!</view>
    <view class="title">未能确认预约</view>
    <view class="sub">{{loadError || '请到我的预约核对'}}</view>
  </view>

  <view class="card voucher" wx:if="{{bookingNo}}">
    <view class="row"><text>服务</text><b>{{serviceName}}</b></view>
    <view class="row"><text>时段</text><b>{{slotText}}</b></view>
    <view class="row" wx:if="{{price}}"><text>费用</text><b class="price">¥{{price}}</b></view>
    <view class="row"><text>预约号</text><b>{{bookingNo}}</b></view>
  </view>

  <view class="actions">
    <view class="btn btn-o" bindtap="goHome">返回首页</view>
    <view class="btn btn-p" bindtap="goMineAppt">查看我的预约</view>
  </view>
</view>
<login-sheet id="global-login-sheet" />
