<!-- pages/product-list/product-list.wxml — 商品列表页 -->
<view class="product-list-page">
  <!-- 搜索栏 -->
  <view class="shop-banner">
    <view class="shop-banner__row">
      <view>
        <view class="shop-banner__t">资料包与 1v1 咨询</view>
        <view class="shop-banner__d">资料包购买后永久可看并季度更新 · 咨询下单后自选时段</view>
      </view>
      <view class="shop-cart" bindtap="onGoCart">车</view>
    </view>
  </view>

  <view class="search-bar">
    <view class="search-input-wrap">
      <input
        class="search-input"
        placeholder="搜索商品"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <image
        wx:if="{{keyword}}"
        class="search-clear"
        src="/images/icon-close.svg"
        mode="aspectFit"
        bindtap="onSearchClear"
      />
    </view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{typeTabs}}"
      wx:key="key"
      class="category-item {{activeType === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTypeTap"
    >
      <text>{{item.label}}</text>
    </view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view class="sort-btn" bindtap="onSortToggle">
      <text wx:for="{{sortOptions}}" wx:key="key" wx:if="{{activeSort === item.key}}">{{item.label}}</text>
      <text class="sort-arrow {{showSortPanel ? 'up' : 'down'}}">&#9660;</text>
    </view>
  </view>

  <!-- 排序面板遮罩 -->
  <view class="sort-mask" wx:if="{{showSortPanel}}" bindtap="onSortMaskTap">
    <view class="sort-panel" catchtap="">
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="sort-option {{activeSort === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSortSelect"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- 首次加载：D1 骨架屏，替代空白页面 -->
  <skeleton wx:if="{{loading && products.length === 0}}" type="grid" rows="{{6}}" />

  <!-- 商品列表 -->
  <view class="product-grid" wx:else>
    <view
      wx:for="{{products}}"
      wx:key="id"
      class="product-card"
      data-id="{{item.id}}"
      bindtap="onProductTap"
    >
      <image
        class="product-image"
        src="{{item.image || item.cover_url || item.main_image || item.mainImage || '/images/default-product.svg'}}"
        mode="aspectFill"
        lazy-load
        data-index="{{index}}"
        binderror="onImageError"
      />
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <view class="product-price-row">
          <text class="product-price">&#165;{{item.price}}</text>
          <text class="product-original-price" wx:if="{{item.original_price || item.originalPrice}}">&#165;{{item.original_price || item.originalPrice}}</text>
        </view>
        <text class="product-sales" wx:if="{{item.sales}}">已售 {{item.sales}}</text>
      </view>
    </view>
  </view>

  <!-- 加载更多状态（首次加载已由骨架屏承接，这里只覆盖翻页场景） -->
  <view class="loading-area" wx:if="{{loading && products.length > 0}}">
    <text class="loading-text">加载中...</text>
  </view>
  <view class="loading-area" wx:elif="{{!hasMore && products.length > 0}}">
    <text class="loading-text">没有更多了</text>
  </view>

  <!-- 空状态：D2 统一空态组件 -->
  <empty-state
    wx:if="{{isEmpty && !loading}}"
    icon="/images/empty-product.png"
    title="暂无商品"
    desc="换个分类或关键词试试"
    actionText="查看全部"
    actionType="primary"
    bind:action="onClearFilters"
  />
</view>
