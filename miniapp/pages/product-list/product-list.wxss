/* pages/product-list/product-list.wxss — 知识商城 2.0 */

.product-list-page {
  min-height: 100vh;
  padding-bottom: calc(146rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.shop-banner {
  position: relative;
  margin: 20rpx 24rpx 0;
  padding: 30rpx;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(140deg, #152443 0%, #315efb 100%);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 44rpx rgba(36, 70, 175, 0.22);
}

.shop-banner__orb {
  position: absolute;
  top: -110rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
}

.shop-banner__row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.shop-banner__row > view:first-child {
  flex: 1;
}

.shop-banner__eyebrow {
  margin-bottom: 9rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.shop-banner__t {
  width: 92%;
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.4;
}

.shop-banner__d {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.67);
  font-size: 21rpx;
}

.shop-cart {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 70rpx;
  height: 70rpx;
  color: #fff;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 22rpx;
}

.shop-benefits {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 22rpx;
  margin-top: 26rpx;
  padding-top: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.search-bar {
  padding: 20rpx 24rpx 14rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 82rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 23rpx;
  box-shadow: var(--sh1);
}

.search-icon-text {
  margin-right: 12rpx;
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 600;
  transform: rotate(-16deg);
}

.search-input {
  flex: 1;
  height: 82rpx;
  color: var(--ink);
  font-size: 24rpx;
}

.search-clear {
  width: 30rpx;
  height: 30rpx;
  margin-left: 12rpx;
  opacity: 0.45;
}

.category-scroll {
  width: 100%;
  padding: 4rpx 0 14rpx 24rpx;
  white-space: nowrap;
}

.category-item {
  display: inline-block;
  margin-right: 12rpx;
  padding: 11rpx 23rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}

.category-item.active {
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, var(--brand), #6386ff);
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(49, 94, 251, 0.18);
}

.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 8rpx;
}

.sort-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.sort-title text {
  margin-left: 7rpx;
  color: var(--ink-3);
  font-size: 18rpx;
  font-weight: 400;
}

.sort-btn {
  display: flex;
  align-items: center;
  padding: 9rpx 16rpx;
  color: var(--ink-2);
  font-size: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}

.sort-arrow {
  margin-left: 5rpx;
  font-size: 16rpx;
  transition: transform 0.2s;
}

.sort-arrow.up {
  transform: rotate(180deg);
}

.sort-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(16, 25, 45, 0.38);
}

.sort-panel {
  position: absolute;
  top: 330rpx;
  right: 24rpx;
  min-width: 210rpx;
  padding: 10rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: var(--sh2);
}

.sort-option {
  padding: 18rpx 28rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  text-align: center;
  border-radius: 14rpx;
}

.sort-option.active {
  color: var(--brand);
  font-weight: 700;
  background: var(--brand-soft);
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 16rpx 24rpx;
}

.product-card {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  box-shadow: var(--sh1);
}

.product-image {
  width: 100%;
  height: 310rpx;
  background: linear-gradient(135deg, #eef3ff, #e5eafe);
}

.product-info {
  padding: 17rpx 18rpx 21rpx;
}

.product-badge {
  display: inline-block;
  margin-bottom: 9rpx;
  padding: 4rpx 10rpx;
  color: var(--brand);
  font-size: 16rpx;
  font-weight: 700;
  background: var(--brand-soft);
  border-radius: 999rpx;
}

.product-name {
  display: -webkit-box;
  min-height: 76rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 13rpx;
}

.product-price {
  color: #f05b45;
  font-size: 32rpx;
  font-weight: 800;
}

.product-original-price {
  margin-left: 8rpx;
  color: var(--ink-4);
  font-size: 19rpx;
  text-decoration: line-through;
}

.product-sales {
  display: block;
  margin-top: 7rpx;
  color: var(--ink-3);
  font-size: 18rpx;
}

.loading-area {
  padding: 36rpx 0;
  text-align: center;
}

.loading-text {
  color: var(--ink-3);
  font-size: 22rpx;
}
