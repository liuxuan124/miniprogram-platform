<!--pages/index/index.wxml — 原型首页（与完整版 HTML 同结构同数据）-->
<view class="home">
  <!-- Hero -->
  <view class="hero">
    <view class="hero-orb hero-orb--one"></view>
    <view class="hero-orb hero-orb--two"></view>
    <view class="hero-eyebrow">CROSS-BORDER GROWTH LAB</view>
    <view class="hero-who">
      <view class="hero-av">海</view>
      <view class="hero-meta">
        <view class="hero-nm">出海笔记 · 阿哲 <text class="hero-vf">已认证</text></view>
        <view class="hero-bio">陪你把跨境生意，从经验变成方法</view>
      </view>
    </view>
    <view class="hero-kpi">
      <view><text class="hero-kpi-b">238</text>篇内容</view>
      <view><text class="hero-kpi-b">1.2w</text>关注者</view>
      <view><text class="hero-kpi-b">4.9</text>咨询评分</view>
    </view>
  </view>

  <!-- Search -->
  <view class="searchbar" bindtap="goSearch">
    <text class="searchbar__icon">⌕</text>
    <text class="searchbar__text">搜索选品、验厂、VAT、TikTok</text>
    <text class="searchbar__action">搜索</text>
  </view>

  <!-- Quick nav -->
  <view class="quick-head">
    <text>快速开始</text>
    <text class="quick-head__sub">常用工具与服务</text>
  </view>
  <view class="quicknav">
    <view class="q" data-action="content" bindtap="onQuickNav">
      <view class="ic ic-1">✦</view>
      <text>内容中心</text>
    </view>
    <view class="q" data-action="ebook" bindtap="onQuickNav">
      <view class="ic ic-2">▤</view>
      <text>资料包</text>
    </view>
    <view class="q" data-action="consult" bindtap="onQuickNav">
      <view class="ic ic-3">◌</view>
      <text>1v1咨询</text>
    </view>
    <view class="q" data-action="member" bindtap="onQuickNav">
      <view class="ic ic-4">♢</view>
      <text>会员权益</text>
    </view>
  </view>

  <!-- Feature banner -->
  <view class="feature" bindtap="openFeature">
    <view class="feature-art" style="{{featureArtStyle}}">
      <view class="feature-art__ring"></view>
      <view class="feature-art__mark">↗</view>
    </view>
    <view class="feature-ov">
      <text class="feature-tg">EDITOR'S PICK · 本周精选</text>
      <view class="feature-h4">2026 下半年跨境选品趋势清单</view>
      <view class="feature-m">12 分钟读懂趋势 <text class="feature-m__go">立即阅读 →</text></view>
    </view>
  </view>

  <!-- Topics -->
  <view class="sec sec-tight">
    <view class="sec-h">
      <view>
        <view class="sec-title">按主题逛</view>
        <view class="sec-sub">内容都按业务环节归好类了</view>
      </view>
    </view>
  </view>
  <scroll-view class="topicscroll" scroll-x enable-flex>
    <view
      class="tc"
      wx:for="{{topics}}"
      wx:key="id"
      data-topic="{{item.id}}"
      bindtap="goTopic"
    >
      <view class="tc-e" style="background:{{item.chipBg}}">{{item.emoji}}</view>
      <view class="tc-n">{{item.name}}</view>
      <view class="tc-c">{{item.count}} 篇</view>
    </view>
  </scroll-view>

  <!-- Feed -->
  <view class="sec">
    <view class="sec-h">
      <view>
        <view class="sec-title">最新更新</view>
        <view class="sec-sub">笔记 · 长文 · 视频 · 数据混合流</view>
      </view>
      <view class="sec-more" bindtap="goContent">全部 ›</view>
    </view>

    <block wx:for="{{feedCards}}" wx:key="id">
      <!-- video -->
      <view
        wx:if="{{item.format === 'video'}}"
        class="c-video"
        data-id="{{item.id}}"
        bindtap="openItem"
      >
        <view class="c-video-cv" style="{{item.artStyle}}">
          <view class="glyph">{{item.glyph}}</view>
          <view class="play">▶</view>
          <view class="dur">{{item.dur}}</view>
        </view>
        <view class="c-video-txt">
          <view>
            <text class="fmt video">视频</text>
            <text class="topic">{{item.topicName}}</text>
          </view>
          <view class="c-h4">{{item.title}}</view>
          <view class="c-m">{{item.date}} · {{item.stat}}</view>
        </view>
      </view>

      <!-- data -->
      <view
        wx:elif="{{item.format === 'data'}}"
        class="c-data"
        data-id="{{item.id}}"
        bindtap="openItem"
      >
        <view>
          <text class="fmt data">数据</text>
          <text class="topic">{{item.topicName}}</text>
        </view>
        <view class="c-h4">{{item.title}}</view>
        <view class="nums">
          <view wx:for="{{item.nums}}" wx:for-item="n" wx:key="k">
            <text class="nums-b {{n.d}}">{{n.v}}</text>
            <text>{{n.k}}</text>
          </view>
        </view>
        <view class="c-m">{{item.stat}}</view>
      </view>

      <!-- longform -->
      <view
        wx:elif="{{item.format === 'longform'}}"
        class="c-long"
        data-id="{{item.id}}"
        bindtap="openItem"
      >
        <view class="c-long-thumb" style="{{item.artStyle}}">
          <view class="glyph sm">{{item.glyph}}</view>
        </view>
        <view class="c-long-in">
          <view>
            <text class="fmt longform">长文</text>
            <text class="topic">{{item.topicName}}</text>
          </view>
          <view class="c-h4">{{item.title}}</view>
          <view class="c-m">
            <text>{{item.date}}</text>
            <text>·</text>
            <text>{{item.read}}</text>
            <text>·</text>
            <text>{{item.stat}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- masonry notes -->
    <view class="masonry">
      <view
        class="c-note"
        wx:for="{{masonry}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openItem"
      >
        <view class="c-note-art" style="{{item.artStyle}}">
          <view class="glyph">{{item.glyph}}</view>
        </view>
        <view class="c-note-txt">
          <view class="c-note-h4">{{item.title}}</view>
          <view class="c-note-foot">
            <text class="av">哲</text>
            <text>出海笔记</text>
            <text class="lk">♡ {{item.stat}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Products -->
  <view class="sec">
    <view class="sec-h">
      <view>
        <view class="sec-title">知识产品</view>
        <view class="sec-sub">资料包永久可看 · 咨询按时段预约</view>
      </view>
      <view class="sec-more" bindtap="goShop">商城 ›</view>
    </view>
    <view
      class="p-card"
      wx:for="{{products}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openProduct"
    >
      <view class="p-ic" style="{{item.artStyle}}">
        <view class="glyph sm">{{item.glyph}}</view>
      </view>
      <view class="p-in">
        <view class="p-h4">{{item.title}}</view>
        <view class="p-sub">{{item.sub}}</view>
        <view class="p-pr">¥{{item.price}}<text class="p-pr-s">{{item.ratingLine}}</text></view>
      </view>
    </view>
  </view>

  <view class="pad"></view>

  <!-- AI FAB -->
  <view class="fab" bindtap="goAi">
    <text class="fab__spark">✦</text>
    <text>AI</text>
  </view>
</view>
