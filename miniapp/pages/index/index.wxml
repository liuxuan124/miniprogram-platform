<!-- pages/index/index.wxml — 默认暖阁原生区块；可插入通用装修组件 -->
<page-meta page-style="{{themePageStyle}}" />
<block wx:if="{{dslMode && !dslPending}}">
  <view wx:if="{{loading && !flowComponents.length}}" class="dsl-tab-page__state">加载中...</view>
  <view wx:elif="{{error}}" class="dsl-tab-page__state">{{error}}</view>
  <block wx:else>
    <view class="dsl-tab-page__body" style="{{statusPadPx ? 'padding-top:' + statusPadPx + 'px;' : ''}}">
      <view wx:for="{{flowComponents}}" wx:key="id" class="dsl-flow {{item._stackClass}}" style="{{item.hostStyle}}">
        <dsl-renderer component="{{item}}" />
      </view>
      <view wx:if="{{!flowComponents.length && !floatComponents.length}}" class="dsl-tab-page__state">页面暂无内容</view>
    </view>
    <dsl-float-button
      wx:for="{{floatComponents}}"
      wx:key="id"
      config="{{item.props}}"
      actions="{{item.actions}}"
      styleString="{{item.styleString}}"
    />
  </block>
</block>
<view wx:else class="wh">
  <block wx:for="{{homeBlocks}}" wx:key="id">
    <dsl-warm-block
      wx:if="{{item._native}}"
      type="{{item.type}}"
      config="{{item.props}}"
      warm="{{warmView}}"
      bind:greettap="onGreetTap"
      bind:notice="onNotice"
      bind:search="goSearch"
      bind:nav="onNav"
      bind:author="onAuthor"
      bind:feature="onFeature"
      bind:column="onColumn"
      bind:planet="goPlanet"
      bind:seg="onSeg"
      bind:retry="onRetry"
    />
    <view wx:else class="dsl-flow {{item._stackClass}}" style="{{item.hostStyle}}">
      <dsl-renderer component="{{item}}" />
    </view>
  </block>
  <view wx:if="{{!homeBlocks.length && loadError}}" class="wh-feed-empty" bindtap="onRetry">加载失败，点此重试</view>
  <dsl-float-button
    wx:for="{{floatComponents}}"
    wx:key="id"
    config="{{item.props}}"
    actions="{{item.actions}}"
    styleString="{{item.styleString}}"
  />
  <login-sheet id="global-login-sheet" />
</view>
