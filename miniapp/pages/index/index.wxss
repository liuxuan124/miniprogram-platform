/* pages/index/index.wxss — 极简首页 */

.home {
  min-height: 100vh;
  background: #fafafa;
  color: #111111;
  padding-bottom: calc(56px + env(safe-area-inset-bottom));
  position: relative;
}

.hero {
  padding: 20px 20px 28px;
  position: relative;
  overflow: hidden;
  color: #111111;
  background: #ffffff;
  border-bottom: 1px solid #eeeeee;
  border-radius: 0;
}

.hero-who {
  display: flex;
  align-items: center;
  gap: 14px;
  position: relative;
  z-index: 1;
}

.hero-av {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  font-size: 20px;
  background: #f3f3f3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  border: 1px solid #eeeeee;
}

.hero-nm {
  font-size: 17px;
  font-weight: 600;
  letter-spacing: 0;
  color: #111111;
}

.hero-vf {
  font-size: 10px;
  background: #f3f3f3;
  color: #666666;
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: 500;
  margin-left: 6px;
}

.hero-bio {
  font-size: 12px;
  color: #888888;
  margin-top: 4px;
  opacity: 1;
}

.hero-kpi {
  display: flex;
  gap: 28px;
  margin-top: 22px;
  position: relative;
  z-index: 1;
  font-size: 11px;
  color: #888888;
  opacity: 1;
}

.hero-kpi-b {
  display: block;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 2px;
  letter-spacing: 0;
  opacity: 1;
  color: #111111;
}

.searchbar {
  margin: 16px 16px 0;
  background: #f3f3f3;
  border-radius: 10px;
  box-shadow: none;
  border: none;
  padding: 12px 16px;
  font-size: 13px;
  color: #999999;
  position: relative;
  z-index: 3;
}

.quicknav {
  display: flex;
  padding: 20px 8px 0;
}

.q {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: #333333;
  font-weight: 400;
}

.q .ic {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: none;
  background: #f3f3f3;
}

.ic-1,
.ic-2,
.ic-3,
.ic-4 {
  background: #f3f3f3;
}

.feature {
  margin: 20px 16px 0;
  border-radius: 12px;
  overflow: hidden;
  height: 148px;
  position: relative;
  border: 1px solid #eeeeee;
}

.feature-art {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}

.feature-ov {
  position: absolute;
  inset: 0;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: #111111;
  background: linear-gradient(180deg, transparent 30%, rgba(255, 255, 255, 0.92) 100%);
}

.feature-tg {
  align-self: flex-start;
  font-size: 10px;
  background: #111111;
  color: #ffffff;
  padding: 3px 8px;
  border-radius: 4px;
  margin-bottom: 10px;
}

.feature-h4 {
  font-size: 17px;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: 0;
  margin-bottom: 6px;
  text-shadow: none;
  color: #111111;
}

.feature-m {
  font-size: 11px;
  color: #888888;
  opacity: 1;
}

.sec {
  padding: 24px 16px 0;
}

.sec-tight {
  padding-bottom: 0;
}

.sec-h {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 14px;
}

.sec-title {
  font-size: 17px;
  font-weight: 600;
  letter-spacing: 0;
}

.sec-sub {
  font-size: 12px;
  color: #999999;
  margin-top: 4px;
}

.sec-more {
  font-size: 12px;
  color: #888888;
  font-weight: 400;
  padding-bottom: 2px;
}

.topicscroll {
  white-space: nowrap;
  padding: 0 16px;
  width: 100%;
  box-sizing: border-box;
}

.tc {
  display: inline-block;
  vertical-align: top;
  width: 108px;
  background: #fff;
  border-radius: 12px;
  padding: 13px 14px;
  box-shadow: none;
  border: 1px solid #eeeeee;
  margin-right: 10px;
  box-sizing: border-box;
}

.tc-e {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  background: #f3f3f3 !important;
}

.tc-n {
  font-size: 13px;
  font-weight: 600;
  margin-top: 9px;
  letter-spacing: 0;
}

.tc-c {
  font-size: 10px;
  color: #999999;
  margin-top: 3px;
}

.fmt {
  display: inline-block;
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 4px;
  font-weight: 500;
  margin-right: 6px;
  background: #f3f3f3;
  color: #666666;
}

.fmt.note,
.fmt.longform,
.fmt.video,
.fmt.data {
  background: #f3f3f3;
  color: #666666;
}

.topic {
  display: inline-block;
  font-size: 10px;
  color: #888888;
  background: #f3f3f3;
  padding: 2px 7px;
  border-radius: 4px;
}

.glyph {
  font-size: 42px;
  position: relative;
  z-index: 1;
  opacity: 0.35;
}

.glyph.sm {
  font-size: 24px;
}

.c-video {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: none;
  border: 1px solid #eeeeee;
  margin-bottom: 11px;
}

.c-video-cv {
  height: 158px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  color: #111111;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  box-shadow: none;
  border: 1px solid #eeeeee;
  padding-left: 3px;
}

.dur {
  position: absolute;
  right: 10px;
  bottom: 10px;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 10.5px;
  padding: 3px 7px;
  border-radius: 6px;
}

.c-video-txt {
  padding: 12px 13px 14px;
}

.c-h4 {
  margin: 7px 0;
  font-size: 14px;
  line-height: 1.42;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.c-m {
  font-size: 10.5px;
  color: #a5abb9;
  display: flex;
  gap: 7px;
  align-items: center;
}

.c-data {
  background: #ffffff;
  border: 1px solid #eeeeee;
  border-radius: 16px;
  padding: 14px 15px 15px;
  margin-bottom: 11px;
  box-shadow: none; border: 1px solid #eeeeee;
}

.nums {
  display: flex;
  gap: 22px;
}

.nums view {
  font-size: 10.5px;
  color: #727a8c;
}

.nums-b {
  display: block;
  font-size: 19px;
  font-weight: 700;
  letter-spacing: -0.035em;
  margin-bottom: 2px;
}

.nums-b.up { color: #0fb47f; }
.nums-b.dn { color: #e2564a; }

.c-long {
  display: flex;
  gap: 12px;
  padding: 12px;
  background: #fff;
  border-radius: 16px;
  box-shadow: none; border: 1px solid #eeeeee;
  margin-bottom: 11px;
}

.c-long-thumb {
  width: 96px;
  height: 74px;
  border-radius: 12px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.c-long-in {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.c-long .c-h4 {
  margin: 6px 0 7px;
  font-size: 13.5px;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.c-long .c-m {
  margin-top: auto;
}

.masonry {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 11px;
  margin-top: 0;
}

.c-note {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: none; border: 1px solid #eeeeee;
  display: flex;
  flex-direction: column;
}

.c-note-art {
  width: 100%;
  height: 0;
  padding-bottom: 125%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.c-note-art .glyph {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.c-note-txt {
  padding: 10px 11px 11px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.c-note-h4 {
  margin: 0 0 9px;
  font-size: 12.5px;
  line-height: 1.5;
  font-weight: 600;
  height: 37px;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.c-note-foot {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 10.5px;
  color: #a5abb9;
  margin-top: auto;
}

.c-note-foot .av {
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #111111;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 9px;
}

.c-note-foot .lk {
  margin-left: auto;
}

.p-card {
  display: flex;
  gap: 13px;
  padding: 13px;
  background: #fff;
  border-radius: 16px;
  box-shadow: none; border: 1px solid #eeeeee;
  margin-bottom: 11px;
}

.p-ic {
  width: 72px;
  height: 72px;
  border-radius: 15px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.p-in {
  flex: 1;
  min-width: 0;
}

.p-h4 {
  margin: 0 0 6px;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.42;
}

.p-sub {
  font-size: 11px;
  color: #a5abb9;
  margin-bottom: 7px;
}

.p-pr {
  font-size: 17px;
  color: #111111;
  font-weight: 600;
  letter-spacing: 0;
}

.p-pr-s {
  font-size: 10.5px;
  color: #a5abb9;
  font-weight: 500;
  margin-left: 6px;
  letter-spacing: 0;
}

.pad {
  height: 28px;
}

.fab {
  position: fixed;
  right: 16px;
  bottom: calc(96px + env(safe-area-inset-bottom));
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #111111;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.5px;
  box-shadow: none;
  z-index: 20;
}
