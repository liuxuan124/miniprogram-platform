.pi-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #fdf6ec;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.pi-state {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #a1897a;
  font-size: 28rpx;
}

.pi-hero {
  position: relative;
  min-height: 420rpx;
  padding: 72rpx 40rpx 56rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(145deg, #7c2d12 0%, #b45309 55%, #d97706 100%);
  color: #fff;
}

.pi-hero__cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.35;
}

.pi-hero__mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(60, 20, 8, 0.15), rgba(60, 20, 8, 0.55));
}

.pi-hero__inner {
  position: relative;
  z-index: 1;
}

.pi-hero__emoji {
  display: block;
  font-size: 64rpx;
  line-height: 1.2;
  margin-bottom: 16rpx;
}

.pi-hero__title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: -0.02em;
}

.pi-hero__sub {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.55;
  opacity: 0.88;
}

.pi-hero__meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 28rpx;
  font-size: 22rpx;
  opacity: 0.82;
}

.pi-dot { opacity: 0.6; }

.pi-body {
  margin: -36rpx 28rpx 0;
  position: relative;
  z-index: 2;
}

.pi-intro,
.pi-hl {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: #fffaf3;
  box-shadow: 0 14rpx 36rpx rgba(140, 80, 30, 0.08);
}

.pi-intro__label,
.pi-hl__label {
  display: block;
  margin-bottom: 18rpx;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 0.12em;
  color: #c2410c;
}

.pi-intro__p {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #3a2a1c;
  margin-bottom: 16rpx;
}
.pi-intro__p:last-child { margin-bottom: 0; }

.pi-exp {
  margin: 8rpx 0 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(194, 65, 12, 0.08);
  color: #9a3412;
  font-size: 24rpx;
  line-height: 1.5;
}
.pi-exp--muted {
  background: rgba(120, 72, 40, 0.06);
  color: #a1897a;
}

.pi-hl__card {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(120, 72, 40, 0.08);
}
.pi-hl__card:first-of-type { border-top: none; padding-top: 0; }

.pi-hl__ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fdeedb, #f6ddbf);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex: none;
  text-align: center;
  line-height: 64rpx;
}

.pi-hl__txt { flex: 1; min-width: 0; }
.pi-hl__t {
  display: block;
  font-size: 28rpx;
  font-weight: 750;
  color: #2a1c12;
}
.pi-hl__d {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8a6a4a;
}

.pi-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(253, 246, 236, 0), #fdf6ec 28%);
  z-index: 20;
}

.pi-foot__hint {
  display: block;
  text-align: center;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  color: #a1897a;
}

.pi-foot__btns {
  display: flex;
  gap: 16rpx;
}

.pi-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 750;
}

.pi-btn--ghost {
  background: #fbe6d4;
  color: #c2410c;
}

.pi-btn--primary {
  flex: 1.35;
  background: linear-gradient(135deg, #ea580c, #c2410c);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(194, 65, 12, 0.32);
}

.pi-foot__set {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 650;
  color: #c2410c;
}
.pi-foot__set--muted { color: #a1897a; font-weight: 500; }
