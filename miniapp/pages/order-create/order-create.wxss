/* pages/order-create/order-create.wxss — 确认订单 */

.order-page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(120% 60% at 0% 0%, rgba(49, 94, 251, 0.08), transparent 55%),
    radial-gradient(90% 50% at 100% 8%, rgba(7, 193, 96, 0.06), transparent 50%),
    var(--bg);
}

.block {
  margin-bottom: 20rpx;
  padding: 28rpx 28rpx;
  background: var(--card);
  border-radius: 28rpx;
  box-shadow: var(--sh1);
}

.block--pressed {
  opacity: 0.92;
}

.block__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.block__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.block__meta {
  font-size: 22rpx;
  color: var(--ink-3);
}

.chevron {
  margin-left: 12rpx;
  color: var(--ink-4);
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
}

/* —— 地址 —— */
.address {
  display: flex;
  align-items: center;
}

.address__pin {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #6d8cff, var(--brand));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(49, 94, 251, 0.22);
}

.address__pin--muted {
  background: linear-gradient(145deg, #d7deef, #b8c4df);
  box-shadow: none;
}

.address__pin-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.28);
}

.address__body {
  flex: 1;
  min-width: 0;
}

.address__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.address__name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.address__phone {
  font-size: 26rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.address__detail {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink-2);
}

.address__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6rpx;
}

.address__hint {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* —— 商品 —— */
.goods {
  display: flex;
  padding: 8rpx 0;
}

.goods--divide {
  margin-bottom: 20rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line-2);
}

.goods__cover {
  flex-shrink: 0;
  width: 148rpx;
  height: 148rpx;
  margin-right: 22rpx;
  border-radius: 20rpx;
  background: var(--line-2);
}

.goods__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods__sku {
  margin-top: 10rpx;
  align-self: flex-start;
  max-width: 100%;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  background: var(--line-2);
  border-radius: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods__foot {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.goods__qty {
  font-size: 24rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

/* —— 价格 —— */
.price {
  display: inline-flex;
  align-items: baseline;
  color: var(--brand);
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}

.price__yen {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.price__num {
  font-size: 30rpx;
  letter-spacing: -0.02em;
}

.price--lg .price__yen {
  font-size: 26rpx;
}

.price--lg .price__num {
  font-size: 40rpx;
}

.price--dock {
  color: var(--brand);
}

.price--dock .price__yen {
  font-size: 26rpx;
}

.price--dock .price__num {
  font-size: 44rpx;
  letter-spacing: -0.03em;
}

/* —— 支付 —— */
.pay-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0 4rpx;
}

.pay-row__icon {
  margin-right: 18rpx;
}

.wx-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #1aad19, #07c160);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-row__label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio--on {
  border-color: var(--brand);
  background: var(--brand);
}

.radio__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fff;
}

/* —— 备注 —— */
.remark-row {
  display: flex;
  align-items: center;
}

.remark-row__label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.remark-row__input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: 28rpx;
  color: var(--ink);
  text-align: right;
}

.remark-row__ph {
  color: var(--ink-4);
  text-align: right;
}

/* —— 汇总 —— */
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.summary-row__label {
  font-size: 26rpx;
  color: var(--ink-3);
}

.summary-row__value {
  font-size: 26rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.summary-row__value--muted {
  color: var(--ok);
  font-weight: 600;
}

.summary-row--total {
  margin-top: 12rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed var(--line);
}

.summary-row--total .summary-row__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.safe-tip {
  padding: 8rpx 12rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-4);
  text-align: center;
}

/* —— 底部栏 —— */
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(231, 235, 243, 0.9);
  box-shadow: 0 -12rpx 40rpx rgba(30, 49, 91, 0.06);
}

.dock__left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.dock__caption {
  font-size: 24rpx;
  color: var(--ink-3);
}

.dock__btn {
  flex-shrink: 0;
  min-width: 240rpx;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--brand), #5980ff);
  box-shadow: 0 14rpx 32rpx rgba(49, 94, 251, 0.28);
}

.dock__btn--pressed {
  opacity: 0.88;
  transform: scale(0.98);
}

.dock__btn--disabled {
  background: #c9d0df;
  box-shadow: none;
}
