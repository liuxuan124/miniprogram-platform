@import "/styles/warm-theme.wxss";

.ct-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 28rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.ct-page.has-bar {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 顶栏：标题 + 右上角阶段标签（非双 Tab） */
.ct-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  background: rgba(253, 246, 236, 0.92);
  border-bottom: 1rpx solid var(--line);
  box-sizing: border-box;
}
.ct-topbar__row {
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  box-sizing: border-box;
}
.ct-topbar__bk {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ink);
  flex-shrink: 0;
}
.ct-topbar__tt {
  flex: 1;
  text-align: left;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  padding-left: 4rpx;
}
.ct-stage-tag {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  background: #fdf0d6;
  color: var(--gold);
}

.ct-hero {
  border-radius: 44rpx;
  padding: 44rpx 36rpx 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  background: linear-gradient(140deg, #7c2d12, #b45309 60%, #d97706);
  box-shadow: 0 32rpx 68rpx rgba(124, 45, 18, 0.26);
}
.ct-hero::after {
  content: "";
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 999rpx;
  right: -128rpx;
  top: -148rpx;
  background: rgba(255, 255, 255, 0.1);
}
.ct-hero__title {
  position: relative;
  font-size: 42rpx;
  font-weight: 760;
  line-height: 1.35;
  letter-spacing: -0.02em;
  white-space: pre-line;
}
.ct-hero__desc {
  position: relative;
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.84;
}

.ct-st {
  position: relative;
  margin-top: 32rpx;
  display: flex;
  gap: 16rpx;
}
.ct-st__item {
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  padding: 18rpx 12rpx;
  text-align: center;
  box-sizing: border-box;
}
.ct-st__b {
  display: block;
  font-size: 30rpx;
  font-weight: 780;
  line-height: 1.2;
}
.ct-st__s {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  opacity: 0.78;
  line-height: 1.3;
}

.ct-why {
  margin-top: 28rpx;
  display: grid;
  gap: 18rpx;
}
.ct-why__item {
  background: var(--sheet);
  border-radius: 30rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(120, 64, 24, 0.06);
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
}
.ct-why__ic { font-size: 38rpx; line-height: 1.2; }
.ct-why__b { font-size: 27rpx; font-weight: 740; line-height: 1.35; }
.ct-why__p {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
  line-height: 1.6;
}

.ct-sec-hd {
  margin: 28rpx 4rpx 0;
  font-size: 34rpx;
  font-weight: 760;
  line-height: 1.35;
}

.ct-form {
  margin-top: 16rpx;
  border-radius: 36rpx;
  background: var(--sheet);
  box-shadow: 0 6rpx 16rpx rgba(120, 64, 24, 0.06);
  padding: 8rpx 30rpx 28rpx;
}

.ct-field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.ct-field:last-child { border: 0; }

.ct-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-2);
  line-height: 1.4;
}
.ct-label em {
  font-style: normal;
  color: var(--brand);
  margin-left: 6rpx;
}

.ct-input,
.ct-textarea {
  margin-top: 18rpx;
  width: 100%;
  border-radius: 22rpx;
  background: #f8ecdd;
  padding: 0 26rpx;
  font-size: 26rpx;
  color: var(--ink);
  box-sizing: border-box;
}
.ct-input { height: 80rpx; }
.ct-textarea {
  min-height: 156rpx;
  max-height: 220rpx;
  padding: 22rpx 26rpx;
  line-height: 1.65;
}

.ct-picks {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.ct-pick {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.3;
  background: #f8ecdd;
  color: var(--ink-2);
  border: 1rpx solid transparent;
  box-sizing: border-box;
}
.ct-pick.on {
  background: #fbe6d4;
  color: var(--brand);
  border-color: #f0c49c;
  font-weight: 700;
}

.ct-up {
  margin-top: 18rpx;
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.ct-up__sl,
.ct-up__add {
  width: 132rpx;
  height: 132rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}
.ct-up__sl image {
  width: 100%;
  height: 100%;
}
.ct-up__x {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 99rpx;
  background: rgba(30, 14, 4, 0.6);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ct-up__add {
  border: 2rpx dashed #ddbe98;
  background: #fffdf9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c79a6c;
  font-size: 40rpx;
}

.ct-note {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  border: 1rpx dashed #e3c9a8;
  background: #fffdf9;
  font-size: 22rpx;
  line-height: 1.72;
  color: var(--ink-2);
}
.ct-em { color: var(--brand); font-weight: 700; }
.ct-spacer { height: 28rpx; }

/* 底栏提交：宽矩形 + 轻圆角 + 柔和阴影（非胶囊重光晕） */
.ct-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 250, 243, 0.96);
  border-top: 1rpx solid var(--line);
  box-sizing: border-box;
}
.ct-submit {
  height: 88rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: #fff;
  font-size: 30rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(194, 65, 12, 0.22);
}
.ct-submit--off { opacity: 0.5; }

/* ===== stage 2：发布编辑器（小红书风格：白底 + 红色主操作） ===== */
.ct-page.is-editor {
  background: #fff;
  padding: 0;
}
.ct-page.is-editor::before {
  content: "";
  display: block;
  height: 0;
}

.ct-etop-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}
.ct-etop {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.ct-etop__cc {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333;
}
.ct-etop__tt {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
}
.ct-etop__ph { width: 96rpx; flex-shrink: 0; }

.ct-stage2 {
  position: relative;
  padding: 0 32rpx calc(210rpx + env(safe-area-inset-bottom));
}
.ct-stage2.is-locked .ct-editor,
.ct-stage2.is-locked .ct-types,
.ct-stage2.is-locked .ct-opts,
.ct-stage2.is-locked .ct-vhd,
.ct-stage2.is-locked .ct-vbox,
.ct-stage2.is-locked .ct-vops {
  filter: grayscale(0.35);
  opacity: 0.45;
  pointer-events: none;
}

/* 类型 Tab：下划线式 */
.ct-types {
  display: flex;
  gap: 44rpx;
  padding: 20rpx 8rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.ct-type {
  position: relative;
  padding: 20rpx 4rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  line-height: 1.2;
}
.ct-type.on {
  color: #111;
  font-weight: 700;
}
.ct-type__bar {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 44rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #ff2442;
}

/* 视频区：比例选择 + 预览框 */
.ct-vhd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 4rpx 20rpx;
}
.ct-vhd__lb {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
}
.ct-vratio {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ct-vratio__lb {
  font-size: 22rpx;
  color: #999;
}
.ct-vratio__seg {
  display: flex;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 4rpx;
}
.ct-vratio__opt {
  padding: 8rpx 26rpx;
  border-radius: 10rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #666;
  line-height: 1.3;
}
.ct-vratio__opt.on {
  background: #fff;
  color: #ff2442;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 预览框：3:4 默认，1:1 切换（padding 撑比例，兼容低版本 webview） */
.ct-vbox {
  position: relative;
  width: 100%;
  padding-top: 133.33%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #111;
}
.ct-vbox.is-square { padding-top: 100%; }
.ct-vbox__empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}
.ct-vbox__plus {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffe9ee;
  color: #ff2442;
  font-size: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.ct-vbox__hint {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}
.ct-vbox__sub {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #999;
}
.ct-vbox__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.ct-vbox__dur {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 21rpx;
  line-height: 1.4;
}
.ct-vops {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  padding: 18rpx 4rpx 0;
}
.ct-vops__op {
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
  padding: 8rpx 8rpx;
}
.ct-vops__op.is-danger { color: #ff2442; }

/* 编辑区 */
.ct-editor { padding: 24rpx 4rpx 0; }
.ct-editor__ti {
  width: 100%;
  font-size: 36rpx;
  font-weight: 780;
  color: #111;
}
.ct-editor__bdy {
  margin-top: 24rpx;
  width: 100%;
  min-height: 220rpx;
  font-size: 29rpx;
  line-height: 1.8;
  color: #333;
}
.ct-editor__ph { color: #c2c2c2; }

.ct-imgs {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.ct-img {
  height: 184rpx;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
  background: #fafafa;
}
.ct-img image { width: 100%; height: 100%; }
.ct-img__x {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 99rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ct-img.add {
  border: 2rpx dashed #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 42rpx;
}

/* 选项行 */
.ct-opts {
  margin-top: 32rpx;
  border-top: 1rpx solid #f2f2f2;
}
.ct-opts__li {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid #f2f2f2;
  font-size: 27rpx;
  color: #333;
}
.ct-opts__ic { font-size: 32rpx; width: 40rpx; }
.ct-opts__vv {
  margin-left: auto;
  font-size: 23rpx;
  color: #999;
  max-width: 52%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ct-opts__ar {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #ccc;
  line-height: 1;
}

.ct-sw {
  margin-left: auto;
  width: 76rpx;
  height: 44rpx;
  border-radius: 99rpx;
  background: #e5e5e5;
  position: relative;
}
.ct-sw.on { background: #ff2442; }
.ct-sw__dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 99rpx;
  background: #fff;
  transition: left 0.2s ease;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}
.ct-sw.on .ct-sw__dot { left: 36rpx; }

/* 编辑器内提示 */
.ct-stage2 .ct-note {
  margin-top: 24rpx;
  padding: 0 4rpx;
  border: 0;
  background: transparent;
  font-size: 22rpx;
  line-height: 1.7;
  color: #b0b0b0;
}

/* 底部发布栏（小红书式大按钮） */
.ct-pubbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}
.ct-pubbar__btn {
  height: 88rpx;
  border-radius: 20rpx;
  background: #ff2442;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(255, 36, 66, 0.24);
}
.ct-pubbar__btn.is-off { opacity: 0.5; }

/* 锁定遮罩 */
.ct-lockmask {
  position: absolute;
  inset: 0;
  z-index: 8;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 120rpx;
  background: rgba(255, 255, 255, 0.4);
}
.ct-lockmask__card {
  width: 86%;
  text-align: center;
  padding: 40rpx 32rpx 36rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid #f0f0f0;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.08);
}
.ct-lockmask__ic { font-size: 44rpx; }
.ct-lockmask__h {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 780;
  color: #111;
}
.ct-lockmask__p {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #888;
}
.ct-lockmask__btn {
  margin: 28rpx auto 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 40rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 740;
  color: #fff;
  background: #ff2442;
  box-shadow: 0 10rpx 22rpx rgba(255, 36, 66, 0.2);
}
