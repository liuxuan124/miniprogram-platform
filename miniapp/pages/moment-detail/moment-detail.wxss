.moment-page { padding: 24rpx; background: #f5f7fb; min-height: 100vh; box-sizing: border-box; }
.moment-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.moment-av, .moment-av-img { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.moment-av { display: flex; align-items: center; justify-content: center; background: linear-gradient(140deg, #5c7cff, #2f5bff); color: #fff; font-size: 30rpx; font-weight: 700; }
.moment-name { display: block; font-size: 30rpx; font-weight: 700; color: #0f172a; }
.moment-time { display: block; margin-top: 4rpx; font-size: 22rpx; color: #94a3b8; }
.moment-title { font-size: 36rpx; font-weight: 800; color: #0f172a; line-height: 1.4; margin-bottom: 16rpx; }
.moment-body { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; }
.moment-p { display: block; font-size: 28rpx; line-height: 1.8; color: #334155; margin-bottom: 12rpx; white-space: pre-wrap; }
.moment-images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin-bottom: 16rpx; }
.moment-img { width: 100%; aspect-ratio: 1; border-radius: 12rpx; background: #eef2f7; }
.moment-files { background: #fff; border-radius: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.moment-files__title { font-size: 28rpx; font-weight: 700; color: #0f172a; margin-bottom: 12rpx; }
.moment-file { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 0; border-bottom: 1rpx solid #edf2f7; }
.moment-file:last-child { border-bottom: none; }
.moment-file__icon { font-size: 34rpx; }
.moment-file__meta { flex: 1; min-width: 0; }
.moment-file__name { display: block; font-size: 26rpx; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.moment-file__size { display: block; margin-top: 4rpx; font-size: 22rpx; color: #94a3b8; }
.moment-file__lock { display: block; margin-top: 4rpx; font-size: 20rpx; color: #f59e0b; }
.moment-file--locked .moment-file__action { color: #94a3b8; }
.moment-file__action { font-size: 24rpx; color: #2f5bff; font-weight: 600; }
.moment-share-tip { text-align: center; color: #94a3b8; font-size: 22rpx; padding: 12rpx 0 40rpx; }
.moment-loading { padding: 80rpx 0; text-align: center; color: #94a3b8; font-size: 28rpx; }
