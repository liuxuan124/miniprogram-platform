<!-- pages/appointment-book/appointment-book.wxml — 预约：选时段 → 填信息(短信) → 确认提交 -->
<view class="appointment-book-page">
  <view class="steps">
    <view class="d {{bookStep>=1?'on':''}}">1</view>
    <view class="bar {{bookStep>=2?'on':''}}"></view>
    <view class="d {{bookStep>=2?'on':''}}">2</view>
    <view class="bar {{bookStep>=3?'on':''}}"></view>
    <view class="d {{bookStep>=3?'on':''}}">3</view>
  </view>
  <view class="steps-lb"><text>选时段</text><text>填信息</text><text>确认</text></view>

  <view class="service-section" wx:if="{{serviceInfo}}">
    <image
      class="service-cover"
      src="{{serviceInfo.cover_url || serviceInfo.image || '/images/default-service.svg'}}"
      mode="aspectFill"
    />
    <view class="service-detail">
      <text class="service-name">{{serviceInfo.name}}</text>
      <text class="service-price" wx:if="{{serviceInfo.price !== undefined && serviceInfo.price !== null}}">
        <text class="price-symbol">&#165;</text>{{serviceInfo.price}}
      </text>
      <text class="service-price" wx:else>免费</text>
      <text class="service-duration" wx:if="{{serviceInfo.duration}}">时长: {{serviceInfo.duration}}分钟</text>
    </view>
  </view>

  <block wx:if="{{bookStep===1}}">
    <view class="section">
      <view class="section-title">① 选择日期</view>
      <scroll-view class="date-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{dates}}"
          wx:key="date"
          class="date-item {{selectedDate === item.date ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}"
          data-date="{{item.date}}"
          data-disabled="{{item.disabled}}"
          bindtap="onDateTap"
        >
          <text class="date-label">{{item.label}}</text>
          <text class="date-weekday">{{item.weekday}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="section">
      <view class="section-title">② 选择时段 <text class="rt" wx:if="{{serviceInfo.duration}}">{{serviceInfo.duration}} 分钟 / 场</text></view>
      <view class="slots-grid" wx:if="{{slots.length > 0}}">
        <view
          wx:for="{{slots}}"
          wx:key="index"
          class="slot-item {{selectedSlot === index ? 'active' : ''}} {{!item.available ? 'unavailable' : ''}}"
          data-index="{{index}}"
          bindtap="onSlotTap"
        >
          <text class="slot-time">{{item.label}}</text>
          <text class="slot-status" wx:if="{{!item.available}}">已满</text>
        </view>
      </view>
      <view class="slots-empty" wx:else>
        <text class="slots-empty-text">暂无可用时段</text>
      </view>
    </view>
  </block>

  <block wx:if="{{bookStep===2}}">
    <view class="section">
      <view class="section-title">③ 联系信息</view>
      <view class="form-group">
        <text class="form-label">姓名</text>
        <input class="form-input" placeholder="请输入姓名" value="{{contactName}}" bindinput="onNameInput" />
      </view>
      <view class="form-group">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" placeholder="用于接收预约提醒" value="{{contactPhone}}" bindinput="onPhoneInput" />
      </view>
      <view class="form-group">
        <text class="form-label">短信验证码</text>
        <view class="sms-row">
          <input class="form-input sms-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{smsCode}}" bindinput="onSmsCodeInput" />
          <view class="sms-btn {{smsCountdown>0?'disabled':''}}" bindtap="onSendSms">{{smsCountdown>0 ? smsCountdown+'s' : '获取验证码'}}</view>
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">备注（选填）</text>
        <textarea class="form-textarea" placeholder="如有特殊需求请备注" value="{{remark}}" maxlength="200" auto-height bindinput="onRemarkInput" />
      </view>
    </view>
  </block>

  <block wx:if="{{bookStep===3}}">
    <view class="section">
      <view class="section-title">确认预约</view>
      <view class="fee-row"><text>服务</text><text class="b">{{serviceInfo.name || '-'}}</text></view>
      <view class="fee-row"><text>时间</text><text class="b">{{selectedDate}} {{selectedSlotLabel}}</text></view>
      <view class="fee-row"><text>联系人</text><text class="b">{{contactName}} {{contactPhone}}</text></view>
      <view class="fee-row total"><text>费用</text><text class="b accent lg">{{priceLabel}}</text></view>
      <view class="fee-tip">提交后等待商家确认；到店后由商家核销。</view>
    </view>
  </block>

  <view class="bottom-bar">
    <view class="nav-btns">
      <view class="btn-o" wx:if="{{bookStep>1}}" bindtap="onPrevStep">上一步</view>
      <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onNextOrSubmit">
        {{submitting ? '提交中...' : (bookStep===3 ? '确认提交预约' : '下一步')}}
      </view>
    </view>
  </view>
</view>
<login-sheet id="global-login-sheet" />
