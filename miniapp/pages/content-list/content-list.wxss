/* pages/content-list/content-list.wxss — 内容灵感库 2.0 */

.content-list-page {
  min-height: 100vh;
  padding-bottom: calc(146rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.content-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 32rpx 28rpx 26rpx;
  background: #fff;
}

.content-hero__eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: var(--brand);
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.content-hero__title {
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 800;
}

.content-hero__desc {
  margin-top: 9rpx;
  color: var(--ink-3);
  font-size: 21rpx;
}

.content-hero__badge {
  display: flex;
  align-items: center;
  flex-direction: column;
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 18rpx;
}

.content-hero__badge text:first-child {
  font-size: 26rpx;
  font-weight: 800;
}

.content-hero__badge text:last-child {
  margin-top: 1rpx;
  font-size: 17rpx;
}

.toolbar {
  padding: 4rpx 24rpx 18rpx;
  background: #fff;
}

.search-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 10rpx 0 20rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  background: #f3f6fb;
  border: 1rpx solid #edf0f6;
  border-radius: 22rpx;
}

.search-entry__icon {
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 600;
  transform: rotate(-16deg);
}

.search-entry__text {
  flex: 1;
}

.search-entry__key {
  padding: 9rpx 16rpx;
  color: var(--brand);
  font-size: 19rpx;
  font-weight: 600;
  background: #fff;
  border-radius: 13rpx;
}

.format-scroll,
.topic-scroll {
  width: 100%;
  padding-left: 24rpx;
  white-space: nowrap;
  background: #fff;
}

.format-scroll {
  padding-top: 4rpx;
  padding-bottom: 14rpx;
}

.topic-scroll {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.format-item,
.topic-item {
  display: inline-block;
  margin-right: 12rpx;
  font-size: 22rpx;
  transition: all 0.2s;
}

.format-item {
  padding: 11rpx 23rpx;
  color: var(--ink-2);
  background: #f4f6fa;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
}

.format-item.active {
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, var(--brand), #6386ff);
  box-shadow: 0 8rpx 18rpx rgba(49, 94, 251, 0.2);
}

.topic-item {
  padding: 9rpx 2rpx 7rpx;
  color: var(--ink-3);
  border-bottom: 4rpx solid transparent;
}

.topic-item + .topic-item {
  margin-left: 22rpx;
}

.topic-item.active {
  color: var(--ink);
  font-weight: 700;
  border-bottom-color: var(--brand);
}

.content-list {
  padding: 30rpx 24rpx 0;
}

.list-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 20rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.list-heading__count {
  color: var(--ink-3);
  font-size: 19rpx;
  font-weight: 400;
}

.content-card {
  display: flex;
  gap: 22rpx;
  min-height: 198rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  box-shadow: var(--sh1);
}

.content-cover {
  flex-shrink: 0;
  width: 210rpx;
  height: 166rpx;
  background: #eef1f6;
  border-radius: 20rpx;
}

.content-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.content-tags {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.content-tags .tag {
  display: inline-block;
  padding: 4rpx 11rpx;
  color: var(--brand);
  font-size: 17rpx;
  font-weight: 700;
  background: var(--brand-soft);
  border-radius: 999rpx;
}

.content-topic {
  margin-left: 9rpx;
  color: var(--ink-3);
  font-size: 18rpx;
}

.content-title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.content-summary {
  display: -webkit-box;
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--ink-3);
  font-size: 20rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.content-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 10rpx;
}

.content-date,
.content-views {
  color: var(--ink-4);
  font-size: 18rpx;
}

.content-views {
  color: var(--ink-3);
}

.loading-area {
  padding: 36rpx 0;
  text-align: center;
}

.loading-text {
  color: var(--ink-3);
  font-size: 22rpx;
}
