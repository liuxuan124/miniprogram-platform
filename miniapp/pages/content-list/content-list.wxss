@import "/styles/warm-theme.wxss";

.dsl-tab-page__state {
  padding: 80rpx 32rpx;
  text-align: center;
  color: var(--mute);
}

.cl-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

.cl-head {
  position: sticky;
  top: 0;
  z-index: 12;
  background: linear-gradient(180deg, #fbeeda, #fdf6ec 92%);
  padding-top: env(safe-area-inset-top);
}

.cl-tt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx 0;
}

.cl-bk { font-size: 42rpx; width: 52rpx; }
.cl-title {
  font-size: 36rpx;
  font-weight: 780;
  flex: 1;
  letter-spacing: -0.02em;
}
.cl-sr {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.cl-cats {
  white-space: nowrap;
  padding: 24rpx 32rpx 12rpx;
}

.cl-cat {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 650;
  background: #fffaf3;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  margin-right: 14rpx;
}

.cl-cat.on {
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: #fff;
  border-color: transparent;
}

.cl-sort {
  display: flex;
  gap: 32rpx;
  padding: 12rpx 36rpx 20rpx;
  font-size: 24rpx;
  color: var(--mute);
}

.cl-sort .on {
  color: var(--brand);
  font-weight: 750;
}

.cl-sort__rt { margin-left: auto; }

.cl-scroll {
  flex: 1;
  height: 0;
}

.cl-rank {
  margin: 4rpx 32rpx 8rpx;
  border-radius: 40rpx;
  padding: 30rpx 32rpx 24rpx;
  background: linear-gradient(150deg, #fff4e6, #fffaf3);
  box-shadow: var(--shadow-s);
}

.cl-rank__t {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cl-rank__h { font-size: 29rpx; font-weight: 780; }
.cl-rank__more { margin-left: auto; font-size: 22rpx; color: var(--mute); }

.cl-rank__li {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.cl-rank__li:last-child { border: 0; padding-bottom: 4rpx; }

.cl-rank__no {
  width: 36rpx;
  font-size: 28rpx;
  font-weight: 820;
  color: #d9c0a4;
  font-family: "Songti SC", serif;
}

.cl-rank__no.t1 { color: var(--brand); }

.cl-rank__title {
  flex: 1;
  font-size: 27rpx;
  font-weight: 640;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cl-rank__hv { font-size: 21rpx; color: var(--mute); }

.cl-big {
  margin: 24rpx 32rpx 0;
  border-radius: 40rpx;
  overflow: hidden;
  background: var(--sheet);
  box-shadow: var(--shadow-s);
}

.cl-big__cv {
  height: 312rpx;
  position: relative;
  background: #f3e3d0;
}

.cl-big__img { width: 100%; height: 100%; }
.cl-big__tag { position: absolute; left: 20rpx; top: 20rpx; }
.cl-big__bd { padding: 26rpx 30rpx 28rpx; }
.cl-big__title {
  font-size: 33rpx;
  font-weight: 740;
  line-height: 1.42;
  letter-spacing: -0.01em;
}
.cl-big__sum {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 14rpx;
  line-height: 1.55;
}
.cl-big__mt {
  margin-top: 22rpx;
  font-size: 21rpx;
  color: var(--mute);
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.cl-big__av {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
}
.cl-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 99rpx;
  background: var(--mute);
}

.cl-row {
  display: flex;
  gap: 24rpx;
  margin: 0 32rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.cl-row__tx { flex: 1; min-width: 0; }
.cl-row__title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.44;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cl-row__sum {
  font-size: 23rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cl-row__mt {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: var(--mute);
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.cl-row__im {
  width: 200rpx;
  height: 152rpx;
  border-radius: 26rpx;
  overflow: hidden;
  flex: none;
  position: relative;
  background: #f3e3d0;
}
.cl-row__im image { width: 100%; height: 100%; }
.cl-row__dur {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(40, 18, 6, 0.6);
  color: #fff;
}

.cl-audio {
  margin: 30rpx 32rpx;
  padding: 26rpx 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fdeedb, #fffaf3);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.cl-audio__pl {
  width: 84rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex: none;
  box-shadow: 0 16rpx 36rpx rgba(194, 65, 12, 0.28);
}

.cl-audio__main { flex: 1; min-width: 0; }
.cl-audio__title { font-size: 28rpx; font-weight: 720; }
.cl-audio__wave {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 32rpx;
}
.cl-audio__wave view {
  width: 5rpx;
  border-radius: 4rpx;
  background: #e3bf98;
}
.cl-audio__dur { font-size: 21rpx; color: var(--mute); flex: none; }

.cl-grid3 {
  margin: 0 32rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.cl-grid3__title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.44;
}

.cl-grid3__gg {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
}

.cl-grid3__cell {
  height: 164rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background: #f3e3d0;
}

.cl-grid3__cell image { width: 100%; height: 100%; }

.cl-grid3__more {
  position: absolute;
  inset: 0;
  background: rgba(40, 18, 6, 0.45);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 750;
}

.cl-grid3__mt {
  margin-top: 20rpx;
  font-size: 21rpx;
  color: var(--mute);
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cl-end {
  text-align: center;
  font-size: 21rpx;
  color: var(--mute);
  padding: 32rpx 0 12rpx;
  letter-spacing: 0.1em;
}

.cl-offline {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 120rpx 56rpx 80rpx;
}
.cl-offline__art {
  width: 200rpx; height: 200rpx; border-radius: 60rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 80rpx;
  background: linear-gradient(150deg, #fdeedb, #f6ddbf);
  box-shadow: 0 28rpx 60rpx rgba(140, 80, 30, 0.12);
}
.cl-offline__h { margin-top: 40rpx; font-size: 34rpx; font-weight: 760; }
.cl-offline__p {
  margin-top: 20rpx; font-size: 25rpx; line-height: 1.72;
  color: var(--ink-2); white-space: pre-line;
}
.cl-offline__btn {
  margin-top: 40rpx; height: 80rpx; padding: 0 48rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: #fff; font-size: 28rpx; font-weight: 750;
  display: inline-flex; align-items: center; justify-content: center;
}
.cl-offline__sub { margin-top: 26rpx; font-size: 22rpx; color: var(--mute); }
.cl-offline__sub .link { color: var(--brand); font-weight: 680; }
