/* pages/content-list — 对齐出海笔记原型内容中心 */
@import "../../templates/dsl-tab-body.wxss";

.cc-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f7f8fc;
}

.cc-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 8rpx 28rpx 16rpx 32rpx;
  background: #f7f8fc;
}

.cc-nav__title {
  color: #0f1219;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

.cc-nav--under-sys {
  justify-content: flex-end;
}

.cc-nav__search {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: #3a4150;
  font-size: 34rpx;
  font-weight: 600;
  background: #fff;
  border: 1rpx solid #edeff4;
  border-radius: 50%;
}

.cc-nav__search--on {
  opacity: 0.7;
}

.cc-sticky {
  flex-shrink: 0;
  z-index: 20;
  background: #f7f8fc;
}

.catbar,
.fmtbar {
  width: 100%;
  white-space: nowrap;
}

.catbar {
  padding: 0 32rpx;
  border-bottom: 1rpx solid #edeff4;
}

.cat {
  display: inline-block;
  padding: 8rpx 0 24rpx;
  margin-right: 44rpx;
  color: #727a8c;
  font-size: 28rpx;
  font-weight: 500;
}

.cat.on {
  position: relative;
  color: #0f1219;
  font-size: 32rpx;
  font-weight: 700;
}

.cat.on::after {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 40rpx;
  height: 6rpx;
  background: #2f5bff;
  border-radius: 4rpx;
  transform: translateX(-50%);
  content: '';
}

.fmtbar {
  padding: 24rpx 32rpx 16rpx;
}

.fmt-chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 12rpx 28rpx;
  color: #727a8c;
  font-size: 24rpx;
  font-weight: 500;
  background: #fff;
  border: 1rpx solid #edeff4;
  border-radius: 999rpx;
}

.fmt-chip.on {
  color: #fff;
  background: #0f1219;
  border-color: #0f1219;
}

.cc-scroll {
  flex: 1;
  height: 0;
}

.cc-body {
  padding: 8rpx 32rpx 0;
}

/* —— 长文横卡 —— */
.c-long {
  display: flex;
  gap: 24rpx;
  margin-bottom: 22rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(15, 18, 25, 0.04), 0 6rpx 20rpx rgba(15, 18, 25, 0.045);
}

.c-long__thumb {
  position: relative;
  flex-shrink: 0;
  width: 192rpx;
  height: 148rpx;
  overflow: hidden;
  border-radius: 24rpx;
}

.c-long__cover {
  width: 100%;
  height: 100%;
  display: block;
}

.c-long__glyph {
  position: absolute;
  top: 50%;
  left: 50%;
  font-size: 44rpx;
  transform: translate(-50%, -50%);
}

.c-long__in {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.c-long__tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.c-long__title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: #0f1219;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.c-long__meta {
  margin-top: auto;
  padding-top: 12rpx;
  color: #a5abb9;
  font-size: 21rpx;
}

/* —— 视频 —— */
.c-video {
  overflow: hidden;
  margin-bottom: 22rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(15, 18, 25, 0.04), 0 6rpx 20rpx rgba(15, 18, 25, 0.045);
}

.c-video__cv {
  position: relative;
  height: 316rpx;
}

.c-video__cover {
  width: 100%;
  height: 100%;
  display: block;
}

.c-video__glyph {
  position: absolute;
  top: 50%;
  left: 50%;
  font-size: 64rpx;
  transform: translate(-50%, -50%);
  opacity: 0.85;
}

.c-video__play {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  padding-left: 6rpx;
  color: #fff;
  font-size: 32rpx;
  background: rgba(12, 16, 26, 0.44);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.c-video__dur {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 4rpx 14rpx;
  color: #fff;
  font-size: 21rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 12rpx;
}

.c-video__txt {
  padding: 24rpx 26rpx 28rpx;
}

.c-video__tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.c-video__title {
  display: block;
  margin-top: 14rpx;
  color: #0f1219;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.42;
}

.c-video__meta {
  display: block;
  margin-top: 12rpx;
  color: #a5abb9;
  font-size: 21rpx;
}

/* —— 数据 —— */
.c-data {
  margin-bottom: 22rpx;
  padding: 30rpx;
  background: linear-gradient(145deg, #fffbf2, #fff);
  border: 1rpx solid #f7e6c4;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(15, 18, 25, 0.04), 0 6rpx 20rpx rgba(15, 18, 25, 0.045);
}

.c-data__tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.c-data__title {
  display: block;
  margin: 16rpx 0 26rpx;
  color: #0f1219;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.42;
}

.c-data__nums {
  display: flex;
  gap: 44rpx;
}

.c-data__num {
  display: flex;
  flex-direction: column;
}

.c-data__val {
  margin-bottom: 4rpx;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.c-data__val.up {
  color: #0fb47f;
}

.c-data__val.dn {
  color: #e2564a;
}

.c-data__key {
  color: #727a8c;
  font-size: 21rpx;
}

.c-data__meta {
  display: block;
  margin-top: 24rpx;
  color: #a5abb9;
  font-size: 21rpx;
}

/* pills */
.pill {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 8rpx;
}

.pill--longform,
.pill--article {
  color: #2f9350;
  background: #e7f5ea;
}

.pill--note {
  color: #ec2f55;
  background: #ffedf1;
}

.pill--video {
  color: #4a5ae8;
  background: #ecefff;
}

.pill--data {
  color: #c07f05;
  background: #fff4e2;
}

.pill--topic {
  color: #727a8c;
  font-weight: 500;
  background: #f5f6f9;
  border-radius: 999rpx;
}

/* —— 笔记 masonry —— */
.masonry {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 4rpx 0 8rpx;
}

.c-note {
  display: flex;
  flex-direction: column;
  width: calc(50% - 11rpx);
  overflow: hidden;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(15, 18, 25, 0.04), 0 6rpx 20rpx rgba(15, 18, 25, 0.045);
}

.c-note__art {
  position: relative;
  width: 100%;
  padding-top: 125%;
}

.c-note__cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.c-note__glyph {
  position: absolute;
  top: 50%;
  left: 50%;
  font-size: 56rpx;
  transform: translate(-50%, -50%);
}

.c-note__txt {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 20rpx 22rpx 22rpx;
}

.c-note__title {
  display: -webkit-box;
  overflow: hidden;
  color: #0f1219;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
  height: 74rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.c-note__foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: auto;
  padding-top: 12rpx;
  color: #a5abb9;
  font-size: 20rpx;
}

.c-note__av,
.c-note__av-img {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
}

.c-note__av {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 16rpx;
  font-weight: 600;
  background: linear-gradient(140deg, #5c7cff, #2f5bff);
}

.c-note__meta {
  margin-left: auto;
}

.cc-safe {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
