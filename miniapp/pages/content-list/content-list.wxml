<!-- pages/content-list/content-list.wxml — 内容中心（对齐原型） -->
<view class="content-list-page">
  <view class="toolbar">
    <view class="search-entry" bindtap="onSearchTap">🔍 搜索内容</view>
  </view>

  <!-- 形态筛选：笔记 / 长文 / 视频 / 数据 -->
  <scroll-view class="format-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{formatTabs}}"
      wx:key="key"
      class="format-item {{activeFormat === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFormatTap"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 业务主题 -->
  <scroll-view class="topic-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{topicTabs}}"
      wx:key="id"
      class="topic-item {{activeTopic === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTopicTap"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 主题分类 -->
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <skeleton wx:if="{{loading && articles.length === 0}}" type="list" rows="{{4}}" />

  <view class="content-list" wx:elif="{{!isEmpty}}">
    <view
      wx:for="{{articles}}"
      wx:key="id"
      class="content-card"
      data-id="{{item.id}}"
      bindtap="onContentTap"
    >
      <image
        class="content-cover"
        src="{{item.cover_url || item.image || '/images/default-article.svg'}}"
        mode="aspectFill"
        lazy-load
        data-index="{{index}}"
        binderror="onImageError"
      />
      <view class="content-info">
        <view class="content-tags" wx:if="{{item.formatLabel || item.source}}">
          <text class="tag">{{item.formatLabel || item.source}}</text>
        </view>
        <text class="content-title text-ellipsis-2">{{item.title}}</text>
        <text class="content-summary text-ellipsis-2" wx:if="{{item.summary}}">{{item.summary}}</text>
        <view class="content-meta">
          <text class="content-date">{{item.publish_time || item.created_at}}</text>
          <text class="content-views">{{item.views || 0}} 阅读</text>
        </view>
      </view>
    </view>
  </view>

  <view class="loading-area" wx:if="{{loading && articles.length > 0}}">
    <text class="loading-text">加载中...</text>
  </view>
  <view class="loading-area" wx:elif="{{!hasMore && articles.length > 0}}">
    <text class="loading-text">没有更多了</text>
  </view>

  <empty-state
    wx:if="{{isEmpty && !loading}}"
    title="暂无内容"
    desc="精彩内容即将上线，敬请期待"
  />
</view>
