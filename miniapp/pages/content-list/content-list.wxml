<!-- pages/content-list/content-list.wxml — Tab 内容页：装修 DSL 或原型兜底 -->
<import src="../../templates/dsl-tab-body.wxml" />
<block wx:if="{{dslMode}}">
  <template
    is="dsl-tab-body"
    data="{{loading, error, flowComponents, floatComponents, hasBrandHeader, statusBarHeight, statusPadPx}}"
  />
</block>
<block wx:else>
<view class="cc-page">
  <view class="cc-nav cc-nav--under-sys">
    <view class="cc-nav__search" bindtap="onSearchTap" hover-class="cc-nav__search--on">⌕</view>
  </view>

  <view class="cc-sticky">
    <scroll-view class="catbar" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{topicTabs}}"
        wx:key="id"
        class="cat {{activeTopic === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTopicTap"
      >{{item.name}}</view>
    </scroll-view>
    <scroll-view class="fmtbar" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{formatTabs}}"
        wx:key="key"
        class="fmt-chip {{activeFormat === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onFormatTap"
      >{{item.label}}</view>
    </scroll-view>
  </view>

  <skeleton wx:if="{{loading && allArticles.length === 0}}" type="list" rows="{{4}}" />

  <scroll-view
    wx:elif="{{!isEmpty}}"
    class="cc-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="cc-body">
      <block wx:for="{{feed}}" wx:key="id">
        <!-- 长文：左缩略图 + 右文案 -->
        <view
          wx:if="{{item.formatKey === 'longform' || item.formatKey === 'article'}}"
          class="c-long"
          data-id="{{item.id}}"
          bindtap="onContentTap"
        >
          <view class="c-long__thumb" style="{{item.artStyle}}">
            <image wx:if="{{item.cover_url}}" class="c-long__cover" src="{{item.cover_url}}" mode="aspectFill" />
            <text wx:else class="c-long__glyph">{{item.glyph}}</text>
          </view>
          <view class="c-long__in">
            <view class="c-long__tags">
              <text class="pill pill--longform">长文</text>
              <text class="pill pill--topic">{{item.topicName}}</text>
            </view>
            <text class="c-long__title">{{item.title}}</text>
            <text class="c-long__meta">{{item.meta}}</text>
          </view>
        </view>

        <!-- 视频 -->
        <view
          wx:elif="{{item.formatKey === 'video'}}"
          class="c-video"
          data-id="{{item.id}}"
          bindtap="onContentTap"
        >
          <view class="c-video__cv" style="{{item.artStyle}}">
            <image wx:if="{{item.cover_url}}" class="c-video__cover" src="{{item.cover_url}}" mode="aspectFill" />
            <text wx:else class="c-video__glyph">{{item.glyph}}</text>
            <view class="c-video__play">▶</view>
            <view wx:if="{{item.dur}}" class="c-video__dur">{{item.dur}}</view>
          </view>
          <view class="c-video__txt">
            <view class="c-video__tags">
              <text class="pill pill--video">视频</text>
              <text class="pill pill--topic">{{item.topicName}}</text>
            </view>
            <text class="c-video__title">{{item.title}}</text>
            <text class="c-video__meta">{{item.meta}}</text>
          </view>
        </view>

        <!-- 数据速报 -->
        <view
          wx:elif="{{item.formatKey === 'data'}}"
          class="c-data"
          data-id="{{item.id}}"
          bindtap="onContentTap"
        >
          <view class="c-data__tags">
            <text class="pill pill--data">数据</text>
            <text class="pill pill--topic">{{item.topicName}}</text>
          </view>
          <text class="c-data__title">{{item.title}}</text>
          <view class="c-data__nums" wx:if="{{item.nums && item.nums.length}}">
            <view wx:for="{{item.nums}}" wx:for-item="n" wx:key="k" class="c-data__num">
              <text class="c-data__val {{n.up ? 'up' : 'dn'}}">{{n.v}}</text>
              <text class="c-data__key">{{n.k}}</text>
            </view>
          </view>
          <text class="c-data__meta">{{item.meta}}</text>
        </view>
      </block>

      <!-- 笔记双列 -->
      <view class="masonry" wx:if="{{notes.length}}">
        <view
          wx:for="{{notes}}"
          wx:key="id"
          class="c-note"
          data-id="{{item.id}}"
          bindtap="onContentTap"
        >
          <view class="c-note__art" style="{{item.artStyle}}">
            <image wx:if="{{item.cover_url}}" class="c-note__cover" src="{{item.cover_url}}" mode="aspectFill" />
            <text wx:else class="c-note__glyph">{{item.glyph}}</text>
          </view>
          <view class="c-note__txt">
            <text class="c-note__title">{{item.title}}</text>
            <view class="c-note__foot">
              <image wx:if="{{item.author_avatar}}" class="c-note__av-img" src="{{item.author_avatar}}" mode="aspectFill" />
              <text wx:else class="c-note__av">{{item.author_initial}}</text>
              <text>{{item.author}}</text>
              <text class="c-note__meta">♡ {{item.likeText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="cc-safe"></view>
  </scroll-view>

  <empty-state
    wx:if="{{isEmpty && !loading}}"
    title="该主题下暂无此形态的内容"
    desc="试试切换主题，或清除筛选条件"
    actionText="清除筛选"
    bind:action="clearFilters"
  />
</view>
</block>
<login-sheet id="global-login-sheet" />
