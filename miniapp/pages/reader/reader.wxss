/* pages/reader/reader.wxss */
.reader-page { min-height: 100vh; background: #fff; display: flex; flex-direction: column; }
.topbar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 24rpx; border-bottom: 1rpx solid #edeff4; background: #fff;
}
.topbar .back {
  width: 64rpx; height: 64rpx; border-radius: 999rpx; background: #f5f6f9;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx;
}
.topbar .title { flex: 1; font-size: 30rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.topbar .act { font-size: 26rpx; color: #2f5bff; font-weight: 600; }
.scroll { flex: 1; height: 0; }
.cover { height: 360rpx; background: #dfe4f5; }
.cover image { width: 100%; height: 100%; }
.body { padding: 36rpx 32rpx 0; }
.badge {
  display: inline-block; font-size: 20rpx; font-weight: 700; color: #2f5bff;
  background: #eef2ff; padding: 6rpx 14rpx; border-radius: 8rpx; margin-bottom: 18rpx;
}
.h1 { font-size: 40rpx; font-weight: 800; line-height: 1.35; letter-spacing: -0.03em; color: #0f1219; }
.meta { margin-top: 16rpx; font-size: 24rpx; color: #a5abb9; }
.content { display: block; margin-top: 36rpx; font-size: 30rpx; line-height: 1.9; color: #39404f; }
.pad { height: 160rpx; }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,.96); border-top: 1rpx solid var(--line-2); z-index: 20;
}
.fbtn { font-size: 24rpx; color: var(--ink-500); font-weight: 600; }
.prog { font-size: 24rpx; color: var(--brand); font-weight: 700; }

.toc-mask { display: none; }
.toc-sheet { display: none; }
.toc-sheet.on { display: none; }
.toc-h, .toc-b, .toc-item { display: none; }
