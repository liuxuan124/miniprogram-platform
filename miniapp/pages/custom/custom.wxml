<!--pages/custom/custom.wxml — 装修器自定义页/专题页通用入口-->
<page-meta page-style="{{themePageStyle}}{{pageBackgroundColor ? ';background-color:' + pageBackgroundColor : ''}}" />
<view class="custom-page" style="{{pageBackgroundCss ? 'background:' + pageBackgroundCss + ';' : ''}}{{pageBackgroundColor ? 'background-color:' + pageBackgroundColor + ';' : ''}}">
  <view wx:if="{{loading}}" class="custom-page__state">加载中...</view>
  <view wx:elif="{{error}}" class="custom-page__state">{{error}}</view>
  <block wx:else>
    <view class="custom-page__body">
      <view
        wx:for="{{flowComponents}}"
        wx:key="id"
        class="dsl-flow {{item._stackClass}}"
        style="{{item.hostStyle}}"
        data-parity-type="{{item.type}}"
        data-parity-id="{{item.id}}"
      >
        <dsl-renderer component="{{item}}" />
      </view>
      <view wx:if="{{!flowComponents.length && !floatComponents.length}}" class="custom-page__state">页面暂无内容</view>
    </view>
    <!--
      动态防录屏水印（2026-06 新增）：访客 ID + 手机尾号 + 时间，60s 刷新。
      🔴 cover-view + pointer-events:none —— 水印层绝不能吃掉用户点击与滚动；
         用 cover-image 是因为它是唯一能盖在 native 组件之上的普通层。
    -->
    <cover-view wx:if="{{watermarkUrl}}" class="custom-page__wm">
      <cover-image class="custom-page__wm-img" src="{{watermarkUrl}}" />
    </cover-view>
    <!-- 底部渐隐融合遮罩：悬浮于内容流上方、悬浮按钮（z-index:999）与 TabBar 之下，pointer-events:none 不阻断点击/滚动 -->
    <view
      wx:if="{{bottomOverlay}}"
      class="custom-page__overlay"
      style="height:{{bottomOverlay.height}}rpx;background:linear-gradient(180deg, rgba(0,0,0,0) 0%, {{bottomOverlay.color}} 100%);"
    ></view>
    <!-- 悬浮按钮独立浮层：相对屏幕固定，不随页面内容滚动 -->
    <view
      wx:for="{{floatComponents}}"
      wx:key="id"
      data-parity-type="float_button"
      data-parity-id="{{item.id}}"
    >
      <dsl-float-button
        config="{{item.props}}"
        actions="{{item.actions}}"
        styleString="{{item.styleString}}"
      />
    </view>
  </block>
</view>
