<!-- pages/login/login.wxml -->
<view class="page">
  <view class="ambient ambient--top"></view>
  <view class="ambient ambient--bottom"></view>

  <view class="nav safe-top">
    <view class="nav__back" bindtap="onBack" hover-class="is-active" aria-label="返回">
      <text class="nav__back-icon">‹</text>
    </view>
    <view class="nav__brand">
      <image class="nav__logo" src="/images/logo.svg" mode="aspectFit" />
      <view class="nav__brand-copy">
        <text class="nav__brand-name">出海笔记</text>
        <text class="nav__brand-en">CROSS-BORDER NOTES</text>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="hero">
      <view class="hero__eyebrow">
        <view class="hero__eyebrow-dot"></view>
        <text>MEMBER ACCESS</text>
      </view>
      <text class="hero__title">欢迎回来</text>
      <text class="hero__desc">登录后同步订单、已购资料与会员权益</text>
      <view class="hero__tip" wx:if="{{interceptAction}}">
        <text class="hero__tip-dot">✓</text>
        <text class="hero__tip-text">登录后即可{{interceptAction}}</text>
      </view>
    </view>

    <view class="login-panel">
      <view class="panel-head">
        <view class="panel-head__copy">
          <text class="panel-head__title">完善个人资料</text>
          <text class="panel-head__desc">首次登录只需完成一次</text>
        </view>
        <view class="panel-head__badge">01</view>
      </view>

      <view class="profile-row">
        <button
          class="avatar"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          hover-class="is-active"
          aria-label="选择头像"
        >
          <view class="avatar__ring {{avatarUrl ? 'avatar__ring--on' : ''}}">
            <image
              class="avatar__img"
              src="{{avatarUrl || '/images/default-avatar.svg'}}"
              mode="aspectFill"
            />
          </view>
          <view class="avatar__action">
            <text>{{avatarUrl ? '↻' : '+'}}</text>
          </view>
        </button>

        <view class="profile-row__copy">
          <text class="profile-row__label">个人头像</text>
          <text class="profile-row__desc">{{avatarUrl ? '已选择，可随时更换' : '点击使用你的头像'}}</text>
        </view>
        <text class="profile-row__link">{{avatarUrl ? '更换' : '选择'}}</text>
      </view>

      <view class="field">
        <view class="field__head">
          <text class="field__label">昵称</text>
          <text class="field__state {{nickName ? 'field__state--done' : ''}}">
            {{nickName ? '已填写' : '必填'}}
          </text>
        </view>
        <view class="field__control {{nickName ? 'field__control--done' : ''}}">
          <input
            class="field__input"
            type="nickname"
            maxlength="20"
            placeholder="填写你希望展示的昵称"
            placeholder-class="field__placeholder"
            value="{{nickName}}"
            bindinput="onNicknameInput"
            bindblur="onNicknameBlur"
            bindfocus="onNicknameFocus"
            bindnicknamereview="onNicknameReview"
          />
          <view class="field__status">
            <text>{{nickName ? '✓' : 'Aa'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="action">
      <view class="agree" bindtap="onTogglePrivacy">
        <view class="agree__box {{agreePrivacy ? 'agree__box--on' : ''}}">
          <text wx:if="{{agreePrivacy}}" class="agree__tick">✓</text>
        </view>
        <view class="agree__copy">
          <text class="agree__plain">我已阅读并同意</text>
          <text class="agree__link" catchtap="onViewTerms">《用户协议》</text>
          <text class="agree__plain">与</text>
          <text class="agree__link" catchtap="onViewPrivacy">《隐私政策》</text>
        </view>
      </view>

      <button
        wx:if="{{canSubmit}}"
        class="cta {{loading ? 'cta--disabled' : ''}}"
        open-type="getPhoneNumber"
        bindgetphonenumber="onOneTapLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        <text>手机号快捷登录</text>
        <text class="cta__arrow">→</text>
      </button>
      <button
        wx:else
        class="cta cta--inactive {{loading ? 'cta--disabled' : ''}}"
        bindtap="onPrecheckLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        <text>手机号快捷登录</text>
        <text class="cta__arrow">→</text>
      </button>

      <view class="trust-note">
        <view class="trust-note__icon">✓</view>
        <text>手机号仅用于登录及必要的服务通知，不会公开展示</text>
      </view>
    </view>
  </view>
</view>
