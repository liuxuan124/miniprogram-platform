/* pages/login/login.wxss — 干净、克制的账号登录页 */

.page {
  --ink: #172033;
  --muted: #7c879d;
  --line: #e8ebf1;
  --surface: #f5f7fa;
  --brand: #315efb;
  min-height: 100vh;
  color: var(--ink);
  background: #fff;
}

.nav {
  padding: 0 20rpx;
}

.safe-top {
  padding-top: calc(env(safe-area-inset-top) + 8rpx);
}

.nav__back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.nav__back-icon {
  color: #5f6879;
  font-size: 58rpx;
  font-weight: 300;
  line-height: 1;
}

.is-active {
  opacity: 0.58;
}

.body {
  min-height: calc(100vh - 108rpx);
  padding: 24rpx 42rpx calc(env(safe-area-inset-bottom) + 36rpx);
}

.hero {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 28rpx 0 60rpx;
}

.hero__brand {
  color: var(--ink);
  font-size: 46rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.hero__desc {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.hero__tip {
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  background: #f2f5ff;
  border-radius: 999rpx;
}

.hero__tip-text {
  color: #687bad;
  font-size: 20rpx;
}

.login-card {
  padding: 0;
  background: transparent;
}

.card-head {
  margin-bottom: 18rpx;
}

.card-head__title {
  display: block;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 650;
}

.card-head__desc,
.card-head__step {
  display: none;
}

.profile {
  overflow: hidden;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

.profile__row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.avatar {
  position: relative;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  line-height: 1;
}

.avatar::after {
  border: 0;
}

.avatar__ring {
  box-sizing: border-box;
  width: 88rpx;
  height: 88rpx;
  padding: 3rpx;
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 50%;
}

.avatar__ring--on {
  border-color: rgba(49, 94, 251, 0.5);
}

.avatar__img {
  display: block;
  width: 100%;
  height: 100%;
  background: #eef1f5;
  border-radius: 50%;
}

.avatar__badge {
  display: none;
}

.profile__copy {
  flex: 1;
  min-width: 0;
}

.profile__title,
.profile__desc {
  display: block;
}

.profile__title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.profile__desc {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.profile__status {
  flex-shrink: 0;
  padding: 8rpx 15rpx;
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 600;
  background: #eef3ff;
  border-radius: 999rpx;
}

.profile__status.is-done {
  color: #0a996f;
  background: #eaf8f3;
}

.nickname {
  margin: 0 24rpx;
  padding: 22rpx 0 24rpx;
  border-top: 1rpx solid var(--line);
}

.nickname__label {
  display: block;
  margin-bottom: 11rpx;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 600;
}

.nickname__box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 8rpx 0 18rpx;
  background: var(--surface);
  border: 1rpx solid transparent;
  border-radius: 16rpx;
}

.nickname--done .nickname__box {
  background: #f1faf6;
  border-color: rgba(7, 193, 96, 0.18);
}

.nickname__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 500;
  text-align: left;
}

.nickname__ph {
  color: #a4acba;
  font-size: 24rpx;
  font-weight: 400;
}

.nickname__tag {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 600;
}

.nickname__hint {
  display: none;
}

.card-divider {
  display: none;
}

.action {
  margin-top: 30rpx;
}

.agree {
  display: flex;
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.agree__box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-top: 1rpx;
  background: #fff;
  border: 2rpx solid #cbd1dc;
  border-radius: 8rpx;
}

.agree__box--on {
  background: var(--brand);
  border-color: var(--brand);
}

.agree__tick {
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.agree__copy {
  display: flex;
  align-items: center;
  flex: 1;
  flex-wrap: wrap;
  margin-left: 12rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.agree__plain {
  color: var(--muted);
}

.agree__link {
  color: var(--brand);
  font-weight: 500;
}

.cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 94rpx;
  padding: 0;
  margin: 0;
  color: #fff;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 94rpx;
  background: var(--brand);
  border: 0;
  border-radius: 18rpx;
  box-shadow: none;
}

.cta::after {
  border: 0;
}

.cta--disabled {
  color: #fff;
  background: #9aafff;
  opacity: 1;
}

.trust-note {
  display: flex;
  justify-content: center;
  margin-top: 18rpx;
  color: #9aa3b2;
  font-size: 19rpx;
}
