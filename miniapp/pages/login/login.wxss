/* pages/login/login.wxss — Half-screen login, aligned with app design system */

page {
  background: #f5f7fb;
}

.login-page {
  --brand: #315efb;
  --brand-dark: #2446c7;
  --brand-soft: #eef3ff;
  --ink: #172033;
  --ink-2: #44506a;
  --ink-3: #7c879d;
  --line: #e7ebf3;
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  overflow: hidden;
  color: var(--ink);
  background: #f5f7fb;
}

.login-backdrop {
  position: relative;
  flex: 1;
  min-height: 42vh;
  padding: 0 24rpx 74rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 84% 18%, rgba(49, 94, 251, 0.13) 0%, rgba(49, 94, 251, 0) 31%),
    #f5f7fb;
  animation: backdrop-fade-in 320ms ease-out both;
}

.safe-top {
  display: flex;
  align-items: center;
  height: calc(env(safe-area-inset-top) + 90rpx);
  padding-top: env(safe-area-inset-top);
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  color: var(--ink-2);
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid var(--line);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(30, 49, 91, 0.07);
}

.back-button text {
  margin-top: -6rpx;
}

.back-button--pressed {
  opacity: 0.62;
}

.brand-hero {
  position: relative;
  min-height: 300rpx;
  padding: 34rpx 34rpx 30rpx;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(138deg, #152443 0%, #2547af 60%, #315efb 100%);
  border-radius: 32rpx;
  box-shadow: 0 22rpx 48rpx rgba(30, 55, 125, 0.22);
  animation: hero-settle-in 420ms 60ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.brand-hero__orb {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 50%;
}

.brand-hero__orb--one {
  top: -135rpx;
  right: -82rpx;
  width: 340rpx;
  height: 340rpx;
}

.brand-hero__orb--two {
  right: 85rpx;
  bottom: -195rpx;
  width: 310rpx;
  height: 310rpx;
  background: rgba(111, 147, 255, 0.14);
}

.brand-identity {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  color: #173068;
  font-size: 33rpx;
  font-weight: 750;
  background: linear-gradient(145deg, #fff, #dfe7ff);
  border: 3rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(7, 20, 54, 0.18);
}

.brand-copy {
  display: flex;
  flex-direction: column;
  margin-left: 18rpx;
}

.brand-copy__eyebrow {
  color: rgba(255, 255, 255, 0.57);
  font-size: 16rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.brand-copy__name {
  margin-top: 5rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 720;
}

.brand-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 32rpx;
  color: #fff;
  font-size: 45rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.brand-description {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  line-height: 1.5;
}

.intercept-tip {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 8rpx 15rpx 8rpx 9rpx;
  color: #f0f4ff;
  font-size: 19rpx;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 999rpx;
}

.intercept-tip__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  color: var(--brand);
  font-size: 15rpx;
  font-weight: 800;
  background: #fff;
  border-radius: 50%;
}

.login-sheet {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  min-height: 58vh;
  padding: 18rpx 38rpx calc(env(safe-area-inset-bottom) + 28rpx);
  margin-top: -50rpx;
  background: #fff;
  border: 1rpx solid rgba(222, 227, 239, 0.9);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -18rpx 48rpx rgba(30, 49, 91, 0.1);
  transform-origin: center bottom;
  animation: login-sheet-slide-up 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
  will-change: transform, opacity;
}

@keyframes backdrop-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes hero-settle-in {
  from {
    opacity: 0;
    transform: translateY(18rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes login-sheet-slide-up {
  from {
    opacity: 0.7;
    transform: translateY(100%);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.sheet-handle {
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 28rpx;
  background: #dfe4ee;
  border-radius: 999rpx;
}

.sheet-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-heading__title {
  display: block;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.sheet-heading__description {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 20rpx;
}

.security-badge {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  padding: 9rpx 14rpx;
  color: #238963;
  font-size: 18rpx;
  font-weight: 650;
  background: #eaf8f2;
  border-radius: 999rpx;
}

.security-badge__dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 8rpx;
  background: #20a876;
  border-radius: 50%;
  box-shadow: 0 0 0 5rpx rgba(32, 168, 118, 0.1);
}

.avatar-section {
  margin-top: 28rpx;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-heading__label {
  color: var(--ink-2);
  font-size: 21rpx;
  font-weight: 700;
}

.field-heading__state {
  padding: 5rpx 10rpx;
  color: var(--ink-3);
  font-size: 17rpx;
  font-weight: 650;
  background: #f1f3f7;
  border-radius: 999rpx;
}

.field-heading__state--done {
  color: #0a8f6a;
  background: #eaf8f2;
}

.profile-avatar {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  padding: 0;
  margin: 18rpx auto 0;
  overflow: visible;
  background: transparent;
  border: 0;
  line-height: 1;
}

.profile-avatar::after {
  border: 0;
}

.profile-avatar--pressed {
  opacity: 0.68;
}

.profile-avatar__image {
  display: block;
  width: 108rpx;
  height: 108rpx;
  background: #eaf0ff;
  border: 4rpx solid #fff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 26rpx rgba(36, 70, 175, 0.15);
}

.profile-avatar__action {
  position: absolute;
  right: -8rpx;
  bottom: -7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 750;
  background: var(--brand);
  border: 3rpx solid #fff;
  border-radius: 50%;
}

.avatar-section__hint {
  display: block;
  margin-top: 13rpx;
  color: var(--ink-3);
  font-size: 18rpx;
  text-align: center;
}

.avatar-section--error .profile-avatar__image {
  border-color: #ffd2cc;
  box-shadow: 0 0 0 6rpx rgba(255, 91, 74, 0.08);
}

.nickname-section {
  margin-top: 24rpx;
}

.nickname-control {
  position: relative;
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 18rpx 0 22rpx;
  background: #f7f9fd;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  transition: border-color 180ms ease, background 180ms ease;
}

.nickname-control__tap {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: transparent;
  line-height: normal;
}

.nickname-control__tap::after {
  border: none;
}

.nickname-control:active {
  background: #f1f5fd;
}

.nickname-control__label {
  flex-shrink: 0;
  color: var(--ink-2);
  font-size: 21rpx;
  font-weight: 700;
}

.nickname-control__divider {
  flex-shrink: 0;
  width: 1rpx;
  height: 30rpx;
  margin: 0 18rpx;
  background: #dfe4ee;
}

.nickname-control__input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 550;
  opacity: 1;
}

.nickname-control__placeholder {
  color: #a1aabd;
  font-size: 21rpx;
  font-weight: 400;
}

.nickname-control--locked {
  opacity: 0.55;
  pointer-events: none;
}

.nickname-control--error {
  background: #fff8f7;
  border-color: #ffb8ae;
}

.agreement {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin-top: 24rpx;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1.5;
  text-align: left;
}

.agreement::after {
  border: 0;
}

.agreement__check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 31rpx;
  height: 31rpx;
  margin-top: 2rpx;
  color: #fff;
  font-size: 19rpx;
  font-weight: 800;
  background: #fff;
  border: 2rpx solid #b7c0d2;
  border-radius: 9rpx;
}

.agreement__check--active {
  background: var(--brand);
  border-color: var(--brand);
}

.agreement__copy {
  display: flex;
  align-items: center;
  flex: 1;
  flex-wrap: wrap;
  margin-left: 12rpx;
  color: var(--ink-3);
  font-size: 19rpx;
  line-height: 1.6;
}

.agreement__link {
  color: var(--brand);
  font-weight: 650;
}

.agreement--error .agreement__check {
  background: #fff8f7;
  border-color: #ff8f80;
}

.form-hint {
  display: block;
  margin-top: 14rpx;
  color: #db4f3f;
  font-size: 18rpx;
  font-weight: 600;
}

.form-hint--muted {
  color: #8a8f98;
  font-weight: 500;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 94rpx;
  padding: 0 24rpx;
  margin: 22rpx 0 0;
  color: #fff;
  line-height: 1;
  background: linear-gradient(135deg, var(--brand), #5980ff);
  border: 0;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 32rpx rgba(49, 94, 251, 0.25);
}

.login-button::after {
  border: 0;
}

.login-button__title {
  color: inherit;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1;
  text-align: center;
}

.login-button--pending {
  color: var(--brand);
  background: #eef3ff;
  border: 1rpx solid #d9e2ff;
  box-shadow: none;
}

.login-button--pressed {
  opacity: 0.86;
  transform: scale(0.99);
}

.login-button--disabled {
  opacity: 0.7;
  box-shadow: none;
}

.sheet-footer {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 18rpx;
}

.privacy-note {
  color: #a1a9b9;
  font-size: 18rpx;
  text-align: center;
}

.privacy-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10000;
}

.privacy-layer__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(11, 18, 33, 0.48);
}

.privacy-layer__panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 36rpx 40rpx calc(env(safe-area-inset-bottom) + 28rpx);
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 48rpx rgba(23, 32, 51, 0.14);
}

.privacy-layer__title {
  display: block;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
}

.privacy-layer__desc {
  display: block;
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.7;
}

.privacy-layer__link {
  color: var(--brand);
  font-weight: 650;
}

.privacy-layer__agree {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 32rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, var(--brand), #5980ff);
  border: 0;
  border-radius: 22rpx;
}

.privacy-layer__agree::after {
  border: 0;
}

.privacy-layer__agree--pressed {
  opacity: 0.86;
}

.privacy-layer__refuse {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  background: transparent;
  border: 0;
}

.privacy-layer__refuse::after {
  border: 0;
}


@media (max-height: 700px) {
  .login-backdrop {
    min-height: 38vh;
    padding-bottom: 62rpx;
  }

  .safe-top {
    height: calc(env(safe-area-inset-top) + 76rpx);
  }

  .brand-hero {
    min-height: 250rpx;
    padding-top: 26rpx;
  }

  .brand-title {
    margin-top: 22rpx;
    font-size: 39rpx;
  }

  .login-sheet {
    min-height: 62vh;
  }

  .sheet-handle {
    margin-bottom: 20rpx;
  }

  .avatar-section {
    margin-top: 20rpx;
  }

  .profile-avatar,
  .profile-avatar__image {
    width: 92rpx;
    height: 92rpx;
  }

  .nickname-section {
    margin-top: 18rpx;
  }

  .agreement {
    margin-top: 18rpx;
  }

  .login-button {
    margin-top: 18rpx;
  }
}
