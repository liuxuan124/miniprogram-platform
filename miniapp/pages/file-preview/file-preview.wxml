<page-meta page-style="{{themePageStyle}}" />
<view class="fp-page">
  <!-- 文件头卡 -->
  <view class="fp-fhead">
    <view class="fp-ic">{{fileType || 'FILE'}}</view>
    <view class="fp-fhead__body">
      <view class="fp-name">{{name || '文件预览'}}</view>
      <view class="fp-meta" wx:if="{{summary}}">{{summary}}</view>
      <view class="fp-meta fp-meta--status" wx:if="{{statusText}}">
        <text class="{{locked ? 'fp-status--locked' : 'fp-status--ok'}}">{{statusText}}</text>
      </view>
    </view>
  </view>

  <!-- 来源条 -->
  <view class="fp-src" wx:if="{{sourceText || sourceContentId}}">
    <image class="fp-src__av" src="{{sourceAvatar}}" mode="aspectFill" wx:if="{{sourceAvatar}}" />
    <text class="fp-src__tx">{{sourceText || '来源动态'}}</text>
    <text class="fp-src__go" bindtap="onGoSource">查看原帖 ›</text>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="fp-loading">
    <view class="fp-loading__rw"><text>⏳</text>正在打开文件… {{loadProgress || 0}}%</view>
    <view class="fp-loading__bar">
      <view class="fp-loading__fill" style="width:{{loadProgress || 0}}%"></view>
    </view>
    <view class="fp-loading__tx">首次打开需缓存到本地，之后再看无需等待</view>
  </view>

  <block wx:elif="{{loadError}}">
    <view class="fp-empty" bindtap="onRetry">加载失败，点此重试</view>
  </block>

  <block wx:else>
    <!-- 位图预览：PDF 原页 1:1 渲染成图片，左右滑动翻页。视觉 100% 保真（配色/图表/表格全保留），
         优先于下面的文字版；非 PDF 或渲染失败时自动回退文字版。 -->
    <block wx:if="{{imgPages && imgPages.length}}">
      <view class="fp-imgwrap {{locked ? 'fp-imgwrap--blur' : ''}}">
        <swiper class="fp-swiper" current="{{imgIndex}}" bindchange="onImgSwiper"
                circular="{{false}}" duration="220">
          <swiper-item wx:for="{{imgPages}}" wx:key="no">
            <image class="fp-img" src="{{item.url}}" mode="widthFix"
                   data-no="{{item.no}}" />
          </swiper-item>
        </swiper>
        <view class="fp-img__bar">
          <text class="fp-img__pg">{{pageLabel}}</text>
          <view class="fp-img__dots" wx:if="{{imgTotal > 1}}">
            <view class="fp-img__dot {{index === imgIndex ? 'is-on' : ''}}"
                  wx:for="{{imgPages}}" wx:key="no" wx:for-index="index"></view>
          </view>
        </view>
        <view class="fp-img__wm" wx:if="{{hasTrial}}">试读 · 已加水印</view>
      </view>
    </block>

    <!-- 纸张：由后端按 PDF 字号拆成 h1/h2/p，页面内直接铺开（小程序无法内嵌 PDF 阅读器） -->
    <block wx:elif="{{previewPagesData && previewPagesData.length}}">
      <view class="fp-paper {{locked ? 'fp-paper--blur' : ''}}" wx:for="{{previewPagesData}}" wx:key="pageNo">
        <text class="fp-paper__pg">{{item.pageLabel}}</text>
        <view class="fp-paper__wm" wx:if="{{hasTrial}}">试读 · 已加水印</view>
        <block wx:for="{{item.blocks}}" wx:for-item="blk" wx:key="index">
          <view wx:if="{{blk.kind === 'h1'}}" class="fp-paper__h1">{{blk.text}}</view>
          <view wx:elif="{{blk.kind === 'h2'}}" class="fp-paper__h2">{{blk.text}}</view>
          <view wx:else class="fp-paper__p">{{blk.text}}</view>
        </block>
      </view>
      <view class="fp-end" wx:if="{{hasTrial}}">—— 试读 {{loadedPages}} / {{pageCount}} 页 · 上滑查看已解锁部分 ——</view>
      <view class="fp-end" wx:elif="{{endText}}">—— {{endText}} ——</view>
    </block>

    <!-- 演示纸张（本地 mock） -->
    <block wx:elif="{{papers && papers.length}}">
      <view class="fp-paper" wx:for="{{papers}}" wx:key="pageLabel">
        <text class="fp-paper__pg">{{item.pageLabel}}</text>
        <view class="fp-paper__h1" wx:if="{{item.title}}">{{item.title}}</view>
        <view class="fp-paper__sub" wx:if="{{item.sub}}">{{item.sub}}</view>
        <block wx:for="{{item.sections}}" wx:for-item="sec" wx:key="h2">
          <view class="fp-paper__h2" wx:if="{{sec.h2}}">{{sec.h2}}</view>
          <view class="fp-paper__p" wx:if="{{sec.li}}">{{sec.li}}</view>
          <view class="fp-paper__ln" wx:if="{{sec.lines && sec.lines.length}}">
            <view wx:for="{{sec.lines}}" wx:for-item="w" wx:for-index="li" wx:key="li" style="width:{{w}}%"></view>
          </view>
        </block>
      </view>
    </block>

    <!-- 文本试读 -->
    <view class="fp-paper" wx:elif="{{previewText}}">
      <text class="fp-paper__pg" wx:if="{{pageLabel}}">{{pageLabel}}</text>
      <view class="fp-paper__h1">{{paperTitle || name}}</view>
      <view class="fp-paper__p">{{previewText}}</view>
    </view>

    <!-- 拉不到结构化文本的兜底：提示可打开完整文件 -->
    <view class="fp-trial" wx:elif="{{hasTrial && !loadingPapers}}">
      <view class="fp-trial__ic">📖</view>
      <view class="fp-trial__h">可试读前 {{previewPages}} 页</view>
      <view class="fp-trial__p" wx:if="{{pageCount}}">全文共 {{pageCount}} 页，开通后可查看完整内容与下载</view>
      <view class="fp-trial__p" wx:else>开通后可查看完整内容与下载</view>
      <view class="fp-trial__bar"><view class="fp-trial__fill" style="width:{{trialRatio}}%"></view></view>
      <view class="fp-trial__meta">试读内容由服务端裁切并加个人水印，仅供判断是否需要开通</view>
      <view class="fp-trial__acts">
        <view class="warm-btn fp-trial__btn" bindtap="onPrimaryCta">{{primaryCta}}</view>
        <view class="fp-trial__link" wx:if="{{lockedReason}}" bindtap="onUnlockCta">开通会员看完整版 ›</view>
      </view>
    </view>

    <view class="fp-empty" wx:else>暂无可预览内容</view>

    <!-- 锁定遮罩：纸张已渲染时，底部压一层模糊 + 开通卡（对齐原型未解锁态） -->
    <block wx:if="{{locked}}">
      <view class="fp-lockbox">
        <view class="fp-lockbox__ic">🔒</view>
        <view class="fp-lockbox__h">该资料仅限星球会员查看</view>
        <view class="fp-lockbox__p">{{lockedReason || '开通会员后可查看完整内容与下载'}}</view>
        <view class="fp-lockbox__tip" wx:if="{{previewPages}}">当前仅展示前 {{previewPages}} 页，开通后可阅读全文并转发保存</view>
        <view class="warm-btn fp-lockbox__btn" catchtap="onUnlockCta">开通会员看完整版</view>
      </view>
    </block>

    <view class="fp-hint">
      💡 小程序内为<text class="fp-hint__em">在线预览</text>，文件不会保存到手机相册或文件夹。需要留存请点下方<text class="fp-hint__em">「转发保存」</text>发到自己的微信，或用「···」在其他应用中打开。
    </view>
    <view class="fp-end" wx:if="{{!previewPagesData.length && endText}}">—— {{endText}} ——</view>
  </block>
</view>

<view class="warm-actionbar" wx:if="{{!loading && !loadError}}">
  <button
    class="fp-ac share-button-reset"
    open-type="{{locked ? '' : 'share'}}"
    disabled="{{locked}}"
    style="opacity:{{locked ? 0.4 : 1}}"
  >
    <text class="fp-ac__ic">↗️</text>
    <text class="fp-ac__lb">转发保存</text>
  </button>
  <view class="fp-ac" style="opacity:{{locked ? 0.4 : 1}}" bindtap="onFavorite">
    <text class="fp-ac__ic">⭐️</text>
    <text class="fp-ac__lb">收藏</text>
  </view>
  <view class="warm-btn fp-primary" bindtap="{{sourceContentId ? 'onGoSource' : 'onUnlockCta'}}">
    {{sourceContentId ? '回到原帖讨论' : (locked ? '解锁后查看' : primaryCta)}}
  </view>
</view>
