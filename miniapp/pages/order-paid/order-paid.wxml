<!-- pages/order-paid/order-paid.wxml -->
<view class="paid-page">
  <view class="hero">
    <view class="ok">✓</view>
    <view class="title">支付成功</view>
    <view class="sub">资料已解锁，可立即开始阅读</view>
  </view>

  <view class="card receipt">
    <view class="row"><text>订单号</text><text>{{orderNo}}</text></view>
    <view class="row"><text>实付金额</text><text class="price">¥{{payAmount}}</text></view>
    <view class="row"><text>商品</text><text class="ellipsis">{{productName}}</text></view>
  </view>

  <view class="card reward" wx:if="{{rewardText}}" bindtap="goCoupons">
    <text class="ic">🎁</text>
    <view class="txt">
      <view class="t">支付成功奖励</view>
      <view class="d">{{rewardText}}</view>
    </view>
    <text class="go">去查看 ›</text>
  </view>

  <view class="actions">
    <view class="btn btn-o" bindtap="goOrders">查看订单</view>
    <view class="btn btn-p" bindtap="goReader" wx:if="{{isDigital}}">立即阅读</view>
    <view class="btn btn-p" bindtap="goAppointments" wx:else>查看预约</view>
  </view>

  <view class="sec" wx:if="{{recs.length}}">
    <view class="sec-h">买了这份的人还在看</view>
    <view class="recs">
      <view wx:for="{{recs}}" wx:key="id" class="rec" data-id="{{item.id}}" bindtap="goProduct">
        <image src="{{item.cover}}" mode="aspectFill" />
        <view class="n">{{item.name}}</view>
        <view class="p">¥{{item.price}}</view>
      </view>
    </view>
  </view>
</view>
