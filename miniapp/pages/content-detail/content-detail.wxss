/* pages/content-detail/content-detail.wxss */

.content-detail-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.content-detail-page.is-article {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.skeleton-wrap {
  padding: 32rpx;
}

/* chips */
.n-chips {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.fmt {
  display: inline-block;
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.fmt.note { background: #ffedf1; color: #ec2f55; }
.fmt.article,
.fmt.longform { background: #e7f5ea; color: #2f9350; }
.fmt.video { background: #ecefff; color: #4a5ae8; }
.fmt.data { background: #fff4e2; color: #c07f05; }

.topic {
  display: inline-block;
  font-size: 21rpx;
  color: #727a8c;
  background: #f5f6f9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* author row */
.a-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #edeff4;
  margin-bottom: 28rpx;
}

.av {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(140deg, #5c7cff, #2f5bff);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.a-meta-txt {
  flex: 1;
  min-width: 0;
}

.nm {
  font-size: 26rpx;
  font-weight: 600;
}

.dt {
  font-size: 21rpx;
  color: #a5abb9;
  margin-top: 6rpx;
}

.follow {
  margin-left: auto;
  font-size: 24rpx;
  color: #fff;
  background: var(--brand);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.follow.on {
  background: #edeff4;
  color: #a5abb9;
}

/* ========== 笔记模式 ========== */
.n-gallery-wrap {
  position: relative;
  background: #0f1219;
}

.n-gallery {
  height: 720rpx;
}

.n-img,
.n-art {
  width: 100%;
  height: 720rpx;
}

.n-art {
  display: flex;
  align-items: center;
  justify-content: center;
}

.n-glyph {
  font-size: 112rpx;
}

.n-idx {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  z-index: 4;
}

.n-body {
  background: #fff;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
}

.n-title {
  font-size: 36rpx;
  line-height: 1.48;
  font-weight: 700;
  letter-spacing: -0.028em;
  margin-bottom: 28rpx;
  color: #0f1219;
}

.n-paras {
  margin-bottom: 8rpx;
}

.n-p {
  font-size: 29rpx;
  line-height: 1.95;
  color: #39404f;
  margin-bottom: 28rpx;
  white-space: pre-wrap;
}

.n-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.n-tags text {
  font-size: 25rpx;
  color: #2f5bff;
  font-weight: 500;
}

.n-actions {
  display: flex;
  gap: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #edeff4;
  font-size: 25rpx;
  color: #727a8c;
}

.n-actions .hot {
  color: #ec2f55;
}

.n-share {
  margin-left: auto;
}

/* ========== 文章模式 ========== */
.progress-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  z-index: 30;
  background: transparent;
}

.progress {
  height: 6rpx;
  background: var(--brand);
  border-radius: 0 4rpx 4rpx 0;
  transition: width 0.1s ease-out;
}

.a-cover {
  height: 476rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.a-cover-glyph {
  font-size: 104rpx;
}

.a-wrap {
  background: #fff;
  border-radius: 52rpx 52rpx 0 0;
  margin-top: -48rpx;
  position: relative;
  z-index: 2;
  padding: 40rpx 36rpx 36rpx;
}

.a-title {
  font-size: 44rpx;
  line-height: 1.42;
  margin: 0 0 32rpx;
  letter-spacing: -0.035em;
  font-weight: 700;
  color: #0f1219;
}

.a-body {
  font-size: 30rpx;
  line-height: 2;
  color: #39404f;
}

.a-body rich-text {
  width: 100%;
  word-break: break-word;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 40rpx;
}

.tag-comp {
  --td-tag-primary-light-color: #315efb;
  --td-tag-primary-light-background-color: rgba(47, 91, 255, 0.08);
}

/* cross sell */
.cross {
  margin: 24rpx 32rpx 40rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(140deg, #f1f5ff, #fff);
  border: 1rpx solid #e2e9ff;
}

.cross-lb {
  font-size: 23rpx;
  color: #727a8c;
  margin-bottom: 22rpx;
  font-weight: 600;
}

.cross-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.cross-card:last-child {
  margin-bottom: 0;
}

.cross-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  background: #dfe4f5;
}

.cross-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #0f1219;
}

.cross-price {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #ff6b3d;
  font-weight: 700;
}

.footer-spacer {
  height: 24rpx;
}

/* bottom bar — article only */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -10rpx 30rpx rgba(30, 49, 91, 0.07);
  z-index: 40;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 100rpx;
}

.action-text {
  font-size: 20rpx;
  color: #a5abb9;
}

.action-item.active .action-text {
  color: #39404f;
}
