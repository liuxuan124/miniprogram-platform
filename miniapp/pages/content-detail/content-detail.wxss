/* pages/content-detail/content-detail.wxss */

.content-detail-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.content-detail-page.is-article,
.content-detail-page.is-note {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.skeleton-wrap {
  padding: 32rpx;
}

.sk-line {
  height: 28rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(90deg, #eef0f5 25%, #f7f8fb 37%, #eef0f5 63%);
  background-size: 400% 100%;
  border-radius: 12rpx;
  animation: sk-shine 1.2s ease infinite;
}

.sk-line--sm { width: 120rpx; height: 36rpx; }
.sk-line--md { width: 60%; }
.sk-line--lg { width: 80%; }

.sk-block {
  width: 100%;
  height: 400rpx;
  margin: 12rpx 0 24rpx;
  background: linear-gradient(90deg, #eef0f5 25%, #f7f8fb 37%, #eef0f5 63%);
  background-size: 400% 100%;
  border-radius: 20rpx;
  animation: sk-shine 1.2s ease infinite;
}

@keyframes sk-shine {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

/* chips */
.n-chips {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.fmt {
  display: inline-block;
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.fmt.note { background: #ffedf1; color: #ec2f55; }
.fmt.article,
.fmt.longform { background: #e7f5ea; color: #2f9350; }
.fmt.video { background: #ecefff; color: #4a5ae8; }
.fmt.data { background: #fff4e2; color: #c07f05; }

.topic {
  display: inline-block;
  font-size: 21rpx;
  color: #727a8c;
  background: #f5f6f9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* author row */
.a-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #edeff4;
  margin-bottom: 28rpx;
}

.av {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(140deg, #5c7cff, #2f5bff);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.av-img {
  display: block;
  object-fit: cover;
  background: #eef2f7;
}

.a-meta-txt {
  flex: 1;
  min-width: 0;
}

.nm {
  font-size: 26rpx;
  font-weight: 600;
}

.dt {
  font-size: 21rpx;
  color: #a5abb9;
  margin-top: 6rpx;
}

.follow {
  margin-left: auto;
  font-size: 24rpx;
  color: #fff;
  background: var(--brand);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.follow.on {
  background: #edeff4;
  color: #727a8c;
}

.follow--pressed {
  opacity: 0.82;
}

/* ========== 笔记模式 ========== */
.n-gallery-wrap {
  position: relative;
  background: #0f1219;
}

.n-gallery {
  width: 100%;
}

.n-img {
  width: 100%;
  display: block;
  vertical-align: top;
}

.n-art {
  width: 100%;
  height: 100%;
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.n-glyph {
  font-size: 112rpx;
}

.n-idx {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  z-index: 4;
}

.n-dots {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10rpx;
  z-index: 4;
}

.n-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.2s ease;
}

.n-dot.on {
  width: 30rpx;
  border-radius: 6rpx;
  background: #fff;
}

.n-body {
  background: #fff;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
}

.n-title {
  font-size: 36rpx;
  line-height: 1.48;
  font-weight: 700;
  letter-spacing: -0.028em;
  margin-bottom: 24rpx;
  color: #0f1219;
}

.n-paras {
  margin-bottom: 4rpx;
}

.n-p {
  font-size: 29rpx;
  line-height: 1.95;
  color: #39404f;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
}

.n-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.n-tags text {
  font-size: 25rpx;
  color: #2f5bff;
  font-weight: 500;
}

.a-meta--note {
  border-bottom: none;
  padding-bottom: 0;
  margin-bottom: 0;
}

.share-button-reset {
  padding: 8rpx 12rpx;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: inherit;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.share-button-reset::after {
  border: 0;
}

/* ========== 文章模式 ========== */
.progress-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  z-index: 30;
  background: transparent;
}

.progress {
  height: 6rpx;
  background: var(--brand);
  border-radius: 0 4rpx 4rpx 0;
  transition: width 0.1s ease-out;
}

.a-cover {
  height: 476rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.a-cover-glyph {
  font-size: 104rpx;
}

.a-wrap {
  background: #fff;
  border-radius: 52rpx 52rpx 0 0;
  margin-top: -48rpx;
  position: relative;
  z-index: 2;
  padding: 40rpx 36rpx 36rpx;
}

.a-title {
  font-size: 44rpx;
  line-height: 1.42;
  margin: 0 0 32rpx;
  letter-spacing: -0.035em;
  font-weight: 700;
  color: #0f1219;
}

.a-body {
  font-size: 30rpx;
  line-height: 2;
  color: #39404f;
}

.a-body rich-text {
  width: 100%;
  word-break: break-word;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 40rpx;
}

.tag-comp {
  display: inline-block;
  margin: 0 12rpx 12rpx 0;
  padding: 6rpx 16rpx;
  color: #2f5bff;
  font-size: 22rpx;
  background: #eef2ff;
  border-radius: 999rpx;
}

/* cross sell */
.cross {
  margin: 24rpx 32rpx 40rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(140deg, #f1f5ff, #fff);
  border: 1rpx solid #e2e9ff;
}

.cross-lb {
  font-size: 23rpx;
  color: #727a8c;
  margin-bottom: 22rpx;
  font-weight: 600;
}

.cross-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.cross-card:last-child {
  margin-bottom: 0;
}

.cross-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  background: #dfe4f5;
}

.cross-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #0f1219;
}

.cross-price {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #ff6b3d;
  font-weight: 700;
}

.footer-spacer {
  height: 24rpx;
}

/* bottom bar — article only */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -10rpx 30rpx rgba(30, 49, 91, 0.07);
  z-index: 40;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 100rpx;
}

.action-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #a5abb9;
}

.action-icon--liked {
  color: #ff4d4f;
}

.action-icon--star {
  color: #ffaa00;
}

.action-text {
  font-size: 20rpx;
  color: #a5abb9;
}

.action-item.active .action-text {
  color: #39404f;
}

.footer-spacer--bar {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* —— 评论半屏 —— */
.cmt-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(17, 24, 39, 0.45);
}

.cmt-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 81;
  height: 72vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 48rpx rgba(30, 49, 91, 0.12);
  transform: translateY(110%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  padding-bottom: env(safe-area-inset-bottom);
}

.cmt-sheet--on {
  transform: none;
}

.cmt-sheet__handle {
  width: 64rpx;
  height: 8rpx;
  margin: 14rpx auto 6rpx;
  border-radius: 999rpx;
  background: #e7ebf3;
}

.cmt-sheet__head {
  display: flex;
  align-items: center;
  padding: 8rpx 28rpx 16rpx;
}

.cmt-sheet__title {
  font-size: 30rpx;
  font-weight: 750;
  color: #172033;
}

.cmt-sheet__close {
  margin-left: auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f3f8;
  color: #7c879d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.cmt-list {
  flex: 1;
  height: 0;
  padding: 0 28rpx;
}

.cmt-empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #aeb6c7;
  font-size: 26rpx;
}

.cmt-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f3f8;
}

.cmt-av {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #6d8cff, #315efb);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmt-main {
  flex: 1;
  min-width: 0;
}

.cmt-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.cmt-nick {
  font-size: 24rpx;
  font-weight: 650;
  color: #44506a;
}

.cmt-time {
  font-size: 20rpx;
  color: #aeb6c7;
}

.cmt-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.55;
  color: #172033;
  white-space: pre-wrap;
}

.cmt-list__pad {
  height: 24rpx;
}

.cmt-composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 20rpx;
  border-top: 1rpx solid #eef1f6;
  background: #fff;
}

.cmt-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  font-size: 26rpx;
  color: #172033;
}

.cmt-input__ph {
  color: #aeb6c7;
}

.cmt-send {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #315efb, #5980ff);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmt-send--off {
  background: #d7deef;
  color: #fff;
}
