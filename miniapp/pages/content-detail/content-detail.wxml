<!-- pages/content-detail/content-detail.wxml -->
<view class="content-detail-page {{isNote ? 'is-note' : 'is-article'}}">
  <view class="skeleton-wrap" wx:if="{{loading}}">
    <view class="sk-line sk-line--sm"></view>
    <view class="sk-line"></view>
    <view class="sk-line sk-line--md"></view>
    <view class="sk-block"></view>
    <view class="sk-line"></view>
    <view class="sk-line sk-line--lg"></view>
  </view>

  <!-- ========== 笔记：小红书图文 ========== -->
  <view class="note-mode" wx:elif="{{isNote}}">
    <view class="n-gallery-wrap">
      <swiper
        class="n-gallery"
        style="height: {{galleryHeight}}rpx;"
        circular
        bindchange="onGalleryChange"
      >
        <swiper-item wx:for="{{gallerySlides}}" wx:key="key">
          <image
            wx:if="{{item.type === 'image'}}"
            src="{{item.url}}"
            mode="widthFix"
            class="n-img"
            bindload="onGalleryImageLoad"
          />
          <view wx:else class="n-art" style="{{item.artStyle}}">
            <text class="n-glyph">{{item.glyph}}</text>
          </view>
        </swiper-item>
      </swiper>
      <view class="n-idx" wx:if="{{galleryCount > 1}}">{{galleryIndex + 1}} / {{galleryCount}}</view>
      <view class="n-dots" wx:if="{{galleryCount > 1}}">
        <view
          wx:for="{{gallerySlides}}"
          wx:key="key"
          class="n-dot {{galleryIndex === index ? 'on' : ''}}"
        ></view>
      </view>
    </view>

    <view class="n-body">
      <view class="n-title">{{article.title}}</view>

      <view class="n-paras" wx:if="{{noteParagraphs.length}}">
        <view class="n-p" wx:for="{{noteParagraphs}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="n-tags" wx:if="{{hashTags.length}}">
        <text wx:for="{{hashTags}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="a-meta a-meta--note">
        <image wx:if="{{authorAvatar}}" class="av av-img" src="{{authorAvatar}}" mode="aspectFill" />
        <view wx:else class="av">{{authorInitial}}</view>
        <view class="a-meta-txt">
          <view class="nm">{{authorName}}</view>
          <view class="dt">{{article.publish_time}}</view>
        </view>
        <view
          class="follow {{followed ? 'on' : ''}}"
          catchtap="onFollowTap"
          hover-class="follow--pressed"
        >{{followed ? '已关注' : '+ 关注'}}</view>
      </view>
    </view>

    <view class="cross" wx:if="{{relatedProducts.length}}">
      <view class="cross-lb">这篇内容相关的好物</view>
      <view
        wx:for="{{relatedProducts}}"
        wx:key="id"
        class="cross-card"
        data-id="{{item.id}}"
        bindtap="onProductTap"
      >
        <image src="{{item.cover}}" mode="aspectFill" class="cross-cover" />
        <view class="cross-info">
          <view class="cross-name">{{item.name}}</view>
          <view class="cross-price">¥{{item.price}}</view>
        </view>
      </view>
    </view>
    <view class="footer-spacer footer-spacer--bar"></view>
  </view>

  <!-- ========== 长文 / 视频 / 数据：普通文章 ========== -->
  <view class="article-mode" wx:else>
    <view class="progress-wrap">
      <view class="progress" style="width: {{readProgress}}%;"></view>
    </view>

    <view class="a-cover" style="{{artStyle}}">
      <text class="a-cover-glyph">{{glyph}}</text>
    </view>

    <view class="a-wrap">
      <view class="n-chips">
        <text class="fmt {{formatKey}}">{{formatLabel}}</text>
        <text class="topic" wx:if="{{topicName}}">{{topicName}}</text>
      </view>
      <view class="a-title">{{article.title}}</view>

      <view class="a-meta">
        <image wx:if="{{authorAvatar}}" class="av av-img" src="{{authorAvatar}}" mode="aspectFill" />
        <view wx:else class="av">{{authorInitial}}</view>
        <view class="a-meta-txt">
          <view class="nm">{{authorName}}</view>
          <view class="dt">{{article.publish_time}} · {{metaLine}}</view>
        </view>
        <view
          class="follow {{followed ? 'on' : ''}}"
          catchtap="onFollowTap"
          hover-class="follow--pressed"
        >{{followed ? '已关注' : '+ 关注'}}</view>
      </view>

      <view class="a-body">
        <rich-text nodes="{{article.content || article.body}}"></rich-text>
      </view>

      <view class="detail-tags" wx:if="{{article.tags && article.tags.length}}">
        <text
          wx:for="{{article.tags}}"
          wx:key="index"
          class="tag-comp"
        >{{item}}</text>
      </view>
    </view>

    <view class="cross" wx:if="{{relatedProducts.length}}">
      <view class="cross-lb">这篇内容相关的好物</view>
      <view
        wx:for="{{relatedProducts}}"
        wx:key="id"
        class="cross-card"
        data-id="{{item.id}}"
        bindtap="onProductTap"
      >
        <image src="{{item.cover}}" mode="aspectFill" class="cross-cover" />
        <view class="cross-info">
          <view class="cross-name">{{item.name}}</view>
          <view class="cross-price">¥{{item.price}}</view>
        </view>
      </view>
    </view>
    <view class="footer-spacer footer-spacer--bar"></view>
  </view>

  <!-- 底部栏 -->
  <view class="bottom-bar" wx:if="{{!loading}}">
    <view class="action-item {{liked ? 'active' : ''}}" bindtap="onLikeTap">
      <text class="action-icon {{liked ? 'action-icon--liked' : ''}}">{{liked ? '♥' : '♡'}}</text>
      <text class="action-text">{{likeDisplay}}</text>
    </view>
    <view class="action-item" bindtap="onCommentTap">
      <text class="action-icon">💬</text>
      <text class="action-text">{{commentCountDisplay}}</text>
    </view>
    <view class="action-item {{favorited ? 'active' : ''}}" bindtap="onFavoriteTap">
      <text class="action-icon {{favorited ? 'action-icon--star' : ''}}">{{favorited ? '★' : '☆'}}</text>
      <text class="action-text">{{favorited ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="action-item share-button-reset" open-type="share">
      <text class="action-icon">↗</text>
      <text class="action-text">分享</text>
    </button>
  </view>

  <!-- 评论半屏 -->
  <view class="cmt-mask" wx:if="{{showCommentSheet}}" catchtouchmove="noop" bindtap="onCloseCommentSheet"></view>
  <view class="cmt-sheet {{showCommentSheet ? 'cmt-sheet--on' : ''}}" wx:if="{{showCommentSheet}}" catchtouchmove="noop">
    <view class="cmt-sheet__handle"></view>
    <view class="cmt-sheet__head">
      <text class="cmt-sheet__title">评论 {{commentCount}}</text>
      <view class="cmt-sheet__close" bindtap="onCloseCommentSheet">✕</view>
    </view>

    <scroll-view scroll-y class="cmt-list" enhanced show-scrollbar="{{false}}">
      <view wx:if="{{!comments.length}}" class="cmt-empty">
        <text>还没有评论，来说两句吧</text>
      </view>
      <view wx:for="{{comments}}" wx:key="id" class="cmt-item">
        <view class="cmt-av">{{item.avatarText || '用'}}</view>
        <view class="cmt-main">
          <view class="cmt-top">
            <text class="cmt-nick">{{item.nickName}}</text>
            <text class="cmt-time">{{item.timeText}}</text>
          </view>
          <text class="cmt-text">{{item.content}}</text>
        </view>
      </view>
      <view class="cmt-list__pad"></view>
    </scroll-view>

    <view class="cmt-composer">
      <input
        class="cmt-input"
        placeholder="友善评论，交流经验"
        placeholder-class="cmt-input__ph"
        value="{{commentDraft}}"
        maxlength="200"
        confirm-type="send"
        bindinput="onCommentInput"
        bindconfirm="onSubmitComment"
      />
      <view
        class="cmt-send {{commentDraft ? '' : 'cmt-send--off'}} {{commentSubmitting ? 'cmt-send--off' : ''}}"
        bindtap="onSubmitComment"
      >发送</view>
    </view>
  </view>
</view>
<login-sheet id="global-login-sheet" />
