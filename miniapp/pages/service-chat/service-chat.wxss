.svc-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fb;
}

.svc-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  border: 2rpx solid #e7eaf2;
  border-radius: 28rpx;
  background: #ffffff;
}

.svc-header__icon {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 22rpx;
  background: #1f4fd1;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.svc-header__main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.svc-header__title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
}

.svc-header__status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #778198;
  font-size: 22rpx;
}

.svc-header__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #18a76d;
  box-shadow: 0 0 0 6rpx rgba(24, 167, 109, 0.1);
}

.chat {
  flex: 1;
  height: 0;
  padding: 28rpx 24rpx 12rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.msg.me {
  flex-direction: row-reverse;
}

.av {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: #1f4fd1;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.msg.me .av {
  background: #e5e9f2;
  color: #5f6b82;
}

.bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e7eaf2;
  border-radius: 8rpx 26rpx 26rpx;
  background: #ffffff;
  color: #35405a;
  font-size: 28rpx;
  line-height: 1.65;
}

.msg.me .bubble {
  border-color: #1f4fd1;
  border-radius: 26rpx 8rpx 26rpx 26rpx;
  background: #1f4fd1;
  color: #ffffff;
}

.quick-title {
  padding: 0 28rpx 14rpx;
  color: #778198;
  font-size: 24rpx;
}

.quick {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 0 24rpx 22rpx;
}

.q {
  padding: 14rpx 24rpx;
  border: 2rpx solid #dfe4ee;
  border-radius: 999rpx;
  background: #ffffff;
  color: #35405a;
  font-size: 25rpx;
}

.contact-bar {
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #e8ebf2;
  background: #ffffff;
}

.contact-btn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 0;
  border-radius: 24rpx;
  background: #1f4fd1;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.contact-btn::after {
  border: 0;
}

.contact-btn__arrow {
  font-size: 40rpx;
  font-weight: 400;
}

.contact-tip {
  display: block;
  margin-top: 14rpx;
  color: #98a1b3;
  font-size: 22rpx;
  text-align: center;
}
