/* pages/mine/mine.wxss — 对齐后台搭建预览结构 */
.mine-page {
  position: relative;
  min-height: 100vh;
  background: #f2f4fa;
  box-sizing: border-box;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.mine-decor {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 440rpx;
  z-index: 0;
  pointer-events: none;
}

.mine-decor--basic {
  background: linear-gradient(
    180deg,
    #6b8ef5 0%,
    #7b9cf7 42%,
    #a8c0fa 78%,
    rgba(168, 192, 250, 0.12) 100%
  );
}

.mine-decor--member {
  background: linear-gradient(
    180deg,
    #9bbfe8 0%,
    #b8d0f0 42%,
    #d8e6f6 78%,
    rgba(216, 230, 246, 0.12) 100%
  );
}

.mine-body {
  position: relative;
  z-index: 1;
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 8rpx 28rpx;
}

.profile-row--on-decor .user-title {
  color: #fff;
}

.profile-row--on-decor .user-subtitle {
  color: rgba(255, 255, 255, 0.88);
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(31, 56, 120, 0.12);
}

.user-avatar-img {
  width: 100%;
  height: 100%;
}

.user-avatar-fallback {
  font-size: 40rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.user-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.35;
}

.user-level {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
}

.user-level--member {
  background: rgba(255, 255, 255, 0.45);
  color: #3a5f8a;
}

.user-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(59, 99, 180, 0.18);
}

.member-card--basic {
  background: linear-gradient(135deg, #5b7fea 0%, #6b6fe8 100%);
}

.member-card--member {
  background: linear-gradient(135deg, #e8eef8 0%, #c5d8f0 55%, #9bbfe8 100%);
  color: #2c4a6e;
  box-shadow: 0 10rpx 28rpx rgba(120, 150, 190, 0.2);
}

.member-card__main {
  flex: 1;
  min-width: 0;
}

.member-card__title {
  font-size: 32rpx;
  font-weight: 700;
}

.member-card__level {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
}

.member-card--member .member-card__level {
  background: rgba(255, 255, 255, 0.55);
  color: #3a5f8a;
}

.member-card__benefits {
  margin-top: 12rpx;
  font-size: 22rpx;
  opacity: 0.92;
  line-height: 1.4;
}

.member-card__cta {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #3b6fd9;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
}

.member-card__cta::after {
  border: none;
}

.member-card__cta--pressed {
  opacity: 0.88;
}

.member-card--member .member-card__cta {
  color: #3a5f8a;
}

.order-card,
.menu-card {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 56, 120, 0.05);
}

.order-card {
  padding: 24rpx 20rpx 8rpx;
}

.order-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.order-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.order-card__all {
  font-size: 24rpx;
  color: #8b93a7;
}

.order-tabs {
  display: flex;
  padding-bottom: 12rpx;
}

.order-tab {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0 20rpx;
}

.order-tab__icon {
  font-size: 40rpx;
  line-height: 1;
}

.order-tab__label {
  font-size: 22rpx;
  color: #4b5563;
}

.order-tab__badge {
  position: absolute;
  top: 8rpx;
  right: 28rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

.menu-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #f1f3f7;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-row__icon {
  width: 48rpx;
  margin-right: 16rpx;
  font-size: 34rpx;
  text-align: center;
}

.menu-row__text {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.menu-row__chevron {
  font-size: 32rpx;
  color: #c0c6d4;
}

.mine-pad {
  height: 24rpx;
}
