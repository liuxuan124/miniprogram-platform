@import "../../styles/warm-theme.wxss";

.mn-page {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

.mn-scroll { height: 100vh; }

.mn-hero {
  position: relative;
  padding: 0 36rpx 92rpx;
  color: #fff;
  overflow: hidden;
  background: linear-gradient(150deg, var(--brand-dark), var(--brand) 58%, var(--accent, var(--brand)));
}
.mn-page--member .mn-hero {
  color: #1e3a5f;
  background: linear-gradient(150deg, var(--brand-soft), var(--brand-100) 55%, var(--page-bg, var(--bg)));
}
.mn-page--member .mn-hero__sb,
.mn-page--member .mn-st__s,
.mn-page--member .mn-hero__set {
  opacity: 0.72;
  color: #334155;
}
.mn-page--member .mn-hero__av {
  border-color: rgba(30, 58, 95, 0.18);
  background: rgba(255, 255, 255, 0.55);
}
.mn-hero::after {
  content: "";
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 999rpx;
  right: -152rpx;
  top: -176rpx;
  background: rgba(255, 255, 255, 0.09);
}
.mn-hero__rw {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  margin-top: 20rpx;
}
.mn-hero__main {
  display: flex;
  align-items: center;
  gap: 26rpx;
  flex: 1;
  min-width: 0;
}
.mn-hero__av {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.2);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mn-hero__av image,
.mn-hero__av-img { width: 100%; height: 100%; background: #f3e3d0; }
.mn-hero__fb { font-size: 48rpx; }
.mn-hero__meta { flex: 1; min-width: 0; }
.mn-hero__name {
  font-size: 40rpx;
  font-weight: 760;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.mn-hero__sb {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  opacity: 0.8;
}
.mn-hero__set {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 99px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  opacity: 0.9;
  z-index: 2;
}
.mn-hero__set--pressed { opacity: 0.6; }

.mn-st {
  position: relative;
  margin-top: 36rpx;
  display: flex;
}
.mn-st view { flex: 1; text-align: center; }
.mn-st__b { display: block; font-size: 34rpx; font-weight: 780; }
.mn-st__s { font-size: 20rpx; opacity: 0.78; }

.mn-vip {
  margin: -60rpx 32rpx 0;
  position: relative;
  z-index: 4;
  border-radius: 36rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: linear-gradient(120deg, var(--brand-dark), var(--brand));
  color: #fff;
  box-shadow: 0 28rpx 60rpx rgba(0, 0, 0, 0.12);
}
.mn-page--member .mn-vip {
  background: linear-gradient(120deg, var(--brand), var(--accent, var(--brand)));
  color: #102a43;
  box-shadow: 0 28rpx 60rpx rgba(107, 159, 217, 0.22);
}
.mn-page--member .mn-vip__h { color: #0f2744; }
.mn-page--member .mn-vip__b {
  color: #0f2744;
  background: linear-gradient(135deg, #fff, #e8eef8);
}
.mn-vip__ic { font-size: 44rpx; }
.mn-vip__tx { flex: 1; min-width: 0; }
.mn-vip__h { display: block; font-size: 27rpx; font-weight: 760; color: #fbe3bc; }
.mn-vip__p { display: block; font-size: 21rpx; opacity: 0.7; margin-top: 6rpx; }
.mn-vip__b {
  margin-left: auto;
  font-size: 23rpx;
  font-weight: 760;
  color: #3b2110;
  background: linear-gradient(135deg, #fbd38d, #e0a355);
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  flex: none;
}

.mn-quick {
  margin: 24rpx 32rpx 0;
  border-radius: 40rpx;
  background: var(--sheet);
  box-shadow: var(--shadow-s);
  padding: 32rpx 16rpx 28rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
.mn-quick__it {
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-2);
  font-weight: 620;
  position: relative;
}
.mn-quick__ic { display: block; font-size: 42rpx; margin-bottom: 14rpx; }
.mn-quick__bdg {
  position: absolute;
  top: -8rpx;
  right: 36rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--brand-2);
  color: #fff;
  font-size: 19rpx;
  line-height: 32rpx;
}

.mn-cont {
  margin: 28rpx 32rpx 0;
  border-radius: 36rpx;
  background: var(--sheet);
  box-shadow: var(--shadow-s);
  padding: 28rpx 30rpx;
}
.mn-cont__t { display: flex; align-items: center; }
.mn-cont__h { font-size: 28rpx; font-weight: 760; }
.mn-cont__a { margin-left: auto; font-size: 22rpx; color: var(--mute); }
.mn-cont__it {
  display: flex;
  gap: 22rpx;
  align-items: center;
  margin-top: 24rpx;
}
.mn-cont__im {
  width: 124rpx;
  height: 92rpx;
  border-radius: 22rpx;
  flex: none;
  background: var(--sheet-2);
}
.mn-cont__main { flex: 1; min-width: 0; }
.mn-cont__name { font-size: 26rpx; font-weight: 680; display: block; }
.mn-cont__pg {
  margin-top: 14rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #f3e3d0;
  overflow: hidden;
}
.mn-cont__fill {
  display: block;
  height: 100%;
  width: 46%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--gold), var(--brand-2));
}
.mn-cont__pt { margin-top: 10rpx; font-size: 20rpx; color: var(--mute); display: block; }
.mn-cont__go {
  flex: none;
  font-size: 23rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.mn-pl {
  margin: 28rpx 32rpx 0;
  border-radius: 36rpx;
  overflow: hidden;
  background: var(--sheet);
  box-shadow: var(--shadow-s);
}
.mn-pl__t {
  padding: 28rpx 30rpx 8rpx;
  display: flex;
  align-items: center;
}
.mn-pl__h { font-size: 28rpx; font-weight: 760; }
.mn-pl__a { margin-left: auto; font-size: 22rpx; color: var(--mute); }
.mn-pl__it {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid var(--line);
}
.mn-pl__it:first-of-type { border: 0; }
.mn-pl__lg {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(135deg, #fdeedb, #f6ddbf);
  flex: none;
}
.mn-pl__meta { flex: 1; min-width: 0; }
.mn-pl__name { display: block; font-size: 27rpx; font-weight: 700; }
.mn-pl__p { display: block; font-size: 21rpx; color: var(--mute); margin-top: 6rpx; }
.mn-pl__rt { margin-left: auto; text-align: right; flex: none; }
.mn-pl__rb { display: block; font-size: 22rpx; color: var(--brand); font-weight: 720; }
.mn-pl__rs { font-size: 19rpx; color: var(--mute); }

.mn-menu {
  margin: 28rpx 32rpx 0;
  border-radius: 36rpx;
  background: var(--sheet);
  box-shadow: var(--shadow-s);
  overflow: hidden;
}
.mn-menu__row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 30rpx;
  border-top: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--ink);
}
.mn-menu__row:first-child { border: 0; }
.mn-menu__ic { font-size: 34rpx; width: 44rpx; flex: none; }
.mn-menu__vv {
  margin-left: auto;
  font-size: 23rpx;
  color: var(--mute);
  flex: none;
  max-width: 52%;
  text-align: right;
}
.mn-menu__ar {
  margin-left: auto;
  color: #ccb49c;
  font-size: 32rpx;
}

.mn-empty {
  margin: 8rpx 8rpx 8rpx;
  padding: 36rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--mute);
  background: rgba(253, 246, 236, 0.6);
  border-radius: 24rpx;
}
.mn-logout {
  margin: 36rpx 32rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  border-radius: 44rpx;
  background: #fffaf3;
  color: #9a3412;
  font-size: 28rpx;
  font-weight: 600;
}
.mn-logout::after { border: none; }

.mn-foot {
  text-align: center;
  font-size: 20rpx;
  color: var(--mute);
  padding: 40rpx 0 16rpx;
  letter-spacing: 0.12em;
  line-height: 1.7;
}
