/* pages/mine/mine.wxss — 极简我的页 */
.mine-page {
  min-height: 100vh;
  background: #fafafa;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.m-hero {
  padding: 48rpx 32rpx 40rpx;
  color: #111111;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.m-hero .av {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #f3f3f3;
  border: 1rpx solid #eeeeee;
  flex-shrink: 0;
}

.m-stats .num {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
  line-height: 1.2;
}

.m-stats .label {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #999999;
}

.m-quick .ic {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto;
  border-radius: 14rpx;
  background: #f3f3f3;
  color: #111111;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-text {
  flex: 1;
  min-width: 0;
}

.m-list .r {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 32rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-weight: 400;
}

.m-hero .nk {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.m-hero .lv {
  font-size: 22rpx;
  color: #888888;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.m-hero .lv .b {
  background: #111111;
  color: #ffffff;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 500;
  font-size: 20rpx;
}

.m-hero .info {
  flex: 1;
  min-width: 0;
}

.m-hero .login-cta {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.m-stats {
  display: flex;
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid #eeeeee;
  box-shadow: none;
  padding: 28rpx 0;
  position: relative;
  z-index: 2;
}

.m-stats .s {
  flex: 1;
  text-align: center;
}

.m-stats b {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.m-stats span {
  font-size: 20rpx;
  color: #999999;
}

.m-quick {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: 16rpx 24rpx 0;
  padding: 28rpx 0;
  border: 1rpx solid #eeeeee;
  box-shadow: none;
}

.m-quick .q {
  flex: 1;
  text-align: center;
  position: relative;
}

.m-quick .n {
  font-size: 22rpx;
  color: #333333;
  margin-top: 12rpx;
  font-weight: 400;
}

.m-quick .bg {
  position: absolute;
  top: -4rpx;
  right: 22%;
  background: #111111;
  color: #fff;
  font-size: 18rpx;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  font-weight: 500;
}

.tip {
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border: 1rpx solid #eeeeee;
  color: #666666;
  font-size: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  gap: 12rpx;
  line-height: 1.65;
  align-items: center;
}

.tip .go {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
  color: #111111;
}

.m-list {
  background: #fff;
  border-radius: 16rpx;
  margin: 16rpx 24rpx 0;
  overflow: hidden;
  border: 1rpx solid #eeeeee;
  box-shadow: none;
}

.m-list .r:last-child {
  border-bottom: none;
}

.m-list .n {
  flex: 1;
  color: #111111;
}

.m-list .ar {
  color: #cccccc;
  font-size: 30rpx;
}

.pad {
  height: 40rpx;
}
