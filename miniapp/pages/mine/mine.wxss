/* pages/mine/mine.wxss — 个人中心 2.0 */

.mine-page {
  min-height: 100vh;
  padding-bottom: calc(146rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.mine-head {
  display: flex;
  flex-direction: column;
  padding: 28rpx 28rpx 18rpx;
}

.mine-head__eyebrow {
  color: var(--brand);
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.mine-head__title {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 800;
}

.m-hero {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 0 24rpx;
  padding: 30rpx;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(138deg, #152443 0%, #2547af 62%, #315efb 100%);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 46rpx rgba(36, 70, 175, 0.22);
}

.m-hero__orb {
  position: absolute;
  top: -120rpx;
  right: -70rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
}

.m-hero .av {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  background: #edf2ff;
  border: 4rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 24rpx rgba(8, 22, 58, 0.18);
}

.m-hero .info {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.m-hero .nk {
  color: #fff;
  font-size: 31rpx;
  font-weight: 700;
}

.m-hero .lv {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9rpx;
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.67);
  font-size: 20rpx;
  line-height: 1.45;
}

.m-hero .lv .b {
  padding: 4rpx 12rpx;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 999rpx;
}

.m-hero .login-cta {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  color: var(--brand);
  font-size: 21rpx;
  font-weight: 700;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(8, 20, 54, 0.14);
}

.m-stats {
  position: relative;
  z-index: 2;
  display: flex;
  margin: -2rpx 38rpx 0;
  padding: 24rpx 0;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 0 0 26rpx 26rpx;
  box-shadow: var(--sh1);
}

.m-stats .s {
  position: relative;
  flex: 1;
  text-align: center;
}

.m-stats .s + .s::before {
  content: '';
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 1rpx;
  background: var(--line);
}

.m-stats .num {
  display: block;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
}

.m-stats .label {
  display: block;
  margin-top: 7rpx;
  color: var(--ink-3);
  font-size: 18rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 38rpx 28rpx 16rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.section-head--menu {
  margin-top: 32rpx;
}

.section-head__sub {
  color: var(--ink-3);
  font-size: 19rpx;
  font-weight: 400;
}

.m-quick {
  display: flex;
  margin: 0 24rpx;
  padding: 26rpx 4rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--sh1);
}

.m-quick .q {
  position: relative;
  flex: 1;
  text-align: center;
}

.m-quick .ic {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin: 0 auto;
  font-size: 27rpx;
  font-weight: 700;
  border-radius: 20rpx;
}

.ic--blue { color: #315efb; background: #eaf0ff; }
.ic--green { color: #0a9d74; background: #e7f8f2; }
.ic--orange { color: #e58a22; background: #fff3df; }
.ic--purple { color: #8a56d6; background: #f3ebff; }

.m-quick .n {
  margin-top: 11rpx;
  color: var(--ink-2);
  font-size: 20rpx;
  font-weight: 500;
}

.m-quick .bg {
  position: absolute;
  top: -5rpx;
  right: 20%;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  color: #fff;
  font-size: 17rpx;
  font-weight: 600;
  background: var(--warn);
  border: 3rpx solid #fff;
  border-radius: 999rpx;
}

.tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 24rpx 0;
  padding: 20rpx 22rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.6;
  background: #fff8e8;
  border: 1rpx solid #f8e5b8;
  border-radius: 20rpx;
}

.tip-text {
  flex: 1;
  min-width: 0;
}

.tip .go {
  margin-left: auto;
  color: #bd7620;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.m-list {
  margin: 0 24rpx;
  padding: 4rpx 20rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--sh1);
}

.m-list .r {
  display: flex;
  align-items: center;
  gap: 17rpx;
  padding: 25rpx 6rpx;
  font-size: 25rpx;
  border-bottom: 1rpx solid var(--line-2);
}

.m-list .r:last-child {
  border-bottom: 0;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  font-size: 25rpx;
  background: #f3f6fb;
  border-radius: 16rpx;
}

.m-list .n {
  flex: 1;
  color: var(--ink);
  font-weight: 500;
}

.m-list .ar {
  color: var(--ink-4);
  font-size: 30rpx;
}

.pad {
  height: 36rpx;
}
