/* pages/mine/mine.wxss — 对齐原型 */
.mine-page { min-height: 100vh; background: var(--bg); padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.m-hero {
  padding: 48rpx 32rpx 56rpx; color: #fff; display: flex; align-items: center; gap: 24rpx;
  border-radius: 0 0 56rpx 56rpx; position: relative; overflow: hidden;
  background: linear-gradient(155deg, #1b1f31 0%, #2f3654 55%, #454d78 100%);
}
.m-hero .av {
  width: 112rpx; height: 112rpx; border-radius: 50%; background: rgba(255,255,255,.13);
  border: 4rpx solid rgba(255,255,255,.32); display:flex; align-items:center; justify-content:center; font-size: 48rpx;
}
.m-hero .nk { font-size: 34rpx; font-weight: 700; letter-spacing: -0.02em; }
.m-hero .lv { font-size: 22rpx; opacity: .85; margin-top: 10rpx; display:flex; align-items:center; gap: 10rpx; flex-wrap: wrap; }
.m-hero .lv .b {
  background: linear-gradient(125deg, #f7d264, #e9a319); color: #4a3200;
  padding: 4rpx 16rpx; border-radius: 999rpx; font-weight: 700; font-size: 20rpx;
}
.m-stats {
  display:flex; background:#fff; margin: -36rpx 24rpx 0; border-radius: 32rpx; box-shadow: var(--sh2); padding: 28rpx 0; position: relative; z-index: 2;
}
.m-stats .s { flex:1; text-align:center; }
.m-stats b { display:block; font-size: 34rpx; font-weight: 700; letter-spacing: -0.03em; color: var(--ink); }
.m-stats span { font-size: 20rpx; color: var(--ink-300); }
.m-quick {
  display:flex; background:#fff; border-radius: 32rpx; margin: 24rpx 24rpx 0; padding: 28rpx 0; box-shadow: var(--sh1);
}
.m-quick .q { flex:1; text-align:center; position: relative; }
.m-quick .ic { font-size: 40rpx; }
.m-quick .n { font-size: 22rpx; color: var(--ink-700); margin-top: 12rpx; font-weight: 500; }
.m-quick .bg {
  position:absolute; top: -4rpx; right: 22%; background: var(--accent); color:#fff; font-size: 18rpx;
  min-width: 28rpx; height: 28rpx; border-radius: 999rpx; display:flex; align-items:center; justify-content:center; padding: 0 8rpx; font-weight:700;
}
.tip {
  margin: 24rpx 24rpx 0; background: linear-gradient(135deg,#fff9ea,#fffdf7); border: 1rpx solid #f7e6c4;
  color: #a37200; font-size: 24rpx; padding: 20rpx 24rpx; border-radius: 24rpx; display:flex; gap: 12rpx; line-height: 1.65; align-items:center;
}
.tip .go { margin-left: auto; font-size: 22rpx; font-weight: 600; white-space: nowrap; }
.m-list { background:#fff; border-radius: 32rpx; margin: 24rpx 24rpx 0; overflow:hidden; box-shadow: var(--sh1); }
.m-list .r {
  display:flex; align-items:center; gap: 20rpx; padding: 28rpx 32rpx; font-size: 28rpx;
  border-bottom: 1rpx solid var(--line-2); font-weight: 500;
}
.m-list .r:last-child { border-bottom: none; }
.m-list .ic { width: 44rpx; text-align:center; font-size: 32rpx; }
.m-list .n { flex:1; }
.m-list .ar { color: var(--ink-300); font-size: 30rpx; }
.pad { height: 40rpx; }
