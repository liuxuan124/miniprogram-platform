<!-- pages/mine/mine.wxml — 对齐原型 s-mine -->
<view class="mine-page">
  <view class="m-hero" bindtap="onUserAreaTap">
    <view class="av">{{isLoggedIn ? '🙂' : '👤'}}</view>
    <view class="info">
      <view class="nk">{{isLoggedIn ? (userInfo.nickName || '微信用户') : (mineConfig.loginTitle || '登录出海笔记')}}</view>
      <view class="lv" wx:if="{{isLoggedIn}}">
        <text class="b">{{memberInfo.level_name || mineConfig.memberCardTitle || '出海会员'}}</text>
        <text> 已加入 {{memberInfo.days || continuousDays || 0}} 天</text>
      </view>
      <view class="lv" wx:else>{{mineConfig.loginSubtitle}}</view>
    </view>
  </view>

  <view class="m-stats">
    <view class="s" bindtap="goCoupons"><b>{{stats.coupons}}</b><span>优惠券</span></view>
    <view class="s" bindtap="goMemberCenter"><b>{{stats.points}}</b><span>积分</span></view>
    <view class="s" bindtap="goMemberCenter"><b>{{stats.growth}}</b><span>成长值</span></view>
    <view class="s" bindtap="goLibrary"><b>{{stats.library}}</b><span>已购资料</span></view>
  </view>

  <view class="m-quick">
    <view class="q" data-key="pending_payment" bindtap="onOrderTabTap">
      <view class="ic">💳</view><view class="n">待付款</view>
      <view class="bg" wx:if="{{badges.pending}}">{{badges.pending}}</view>
    </view>
    <view class="q" bindtap="goLibrary"><view class="ic">📘</view><view class="n">已购资料</view></view>
    <view class="q" bindtap="goAppointments">
      <view class="ic">🗓️</view><view class="n">我的预约</view>
      <view class="bg" wx:if="{{badges.appoint}}">{{badges.appoint}}</view>
    </view>
    <view class="q" bindtap="goWriteReview">
      <view class="ic">✍️</view><view class="n">待评价</view>
      <view class="bg" wx:if="{{badges.review}}">{{badges.review}}</view>
    </view>
  </view>

  <view class="tip" wx:if="{{tipText}}" bindtap="goAppointments">
    {{tipText}}<text class="go">去准备 ›</text>
  </view>

  <view class="m-list">
    <view
      wx:for="{{visibleMenuList}}"
      wx:key="id"
      class="r"
      data-id="{{item.id}}"
      bindtap="onMenuTap"
    >
      <text class="ic">{{item.icon}}</text>
      <text class="n">{{item.title}}</text>
      <text class="ar">›</text>
    </view>
  </view>

  <view class="pad"></view>
</view>
