<page-meta page-style="{{themePageStyle}}" />
<view class="mn-page mn-page--{{styleKey}}">
  <scroll-view class="mn-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="mn-hero" style="padding-top: {{statusBarHeight + 10}}px;">
      <view class="mn-hero__rw" bindtap="onUserAreaTap">
        <view class="mn-hero__av">
          <image
            wx:if="{{isLoggedIn && userInfo.avatarUrl}}"
            class="warm-ph"
            src="{{userInfo.avatarUrl}}"
            mode="aspectFill"
          />
          <image
            wx:elif="{{!isLoggedIn}}"
            class="warm-ph"
            src="{{demoAvatar || '/images/default-avatar.svg'}}"
            mode="aspectFill"
          />
          <text wx:else class="mn-hero__fb">👤</text>
        </view>
        <view class="mn-hero__meta">
          <view class="mn-hero__name warm-serif" wx:if="{{isLoggedIn}}">
            {{userInfo.nickName || '微信用户'}}
            <text class="warm-tag warm-tag--soft">{{memberInfo.level_name || 'LV.4 常读者'}}</text>
          </view>
          <view class="mn-hero__name warm-serif" wx:elif="{{styleKey === 'warm'}}">
            {{demoNickName || '林砚'}}
            <text class="warm-tag warm-tag--soft">{{demoLevelName || 'LV.4 常读者'}}</text>
          </view>
          <view class="mn-hero__name warm-serif" wx:else>点击登录</view>
          <text class="mn-hero__sb" wx:if="{{isLoggedIn || styleKey === 'warm'}}">连续阅读 {{continuousDays || 18}} 天 · 加入暖阁 {{joinDays || 342}} 天</text>
          <text class="mn-hero__sb" wx:else>登录后同步收藏与阅读偏好</text>
        </view>
        <text class="mn-hero__set" catchtap="onSettingsTap">⚙︎</text>
      </view>
      <view class="mn-st">
        <view wx:for="{{stats}}" wx:key="label">
          <text class="mn-st__b">{{item.value}}</text>
          <text class="mn-st__s">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="mn-vip" catchtap="onMemberCardTap">
      <text class="mn-vip__ic">🎫</text>
      <view class="mn-vip__tx">
        <text class="mn-vip__h">{{vipTitle || '暖阁年度会员'}}</text>
        <text class="mn-vip__p">{{vipDesc}}</text>
      </view>
      <text class="mn-vip__b">{{isLoggedIn || styleKey === 'warm' ? '去续费' : '去开通'}}</text>
    </view>

    <view class="mn-quick">
      <view class="mn-quick__it" bindtap="onGoFavorites">
        <text class="mn-quick__ic">⭐️</text>我的收藏
      </view>
      <view class="mn-quick__it" bindtap="onGoHistory">
        <text class="mn-quick__ic">🕘</text>浏览历史
      </view>
      <view class="mn-quick__it" bindtap="onGoOrders">
        <text class="mn-quick__ic">📘</text>已购内容
      </view>
      <view class="mn-quick__it" bindtap="onNoticeTap">
        <text class="mn-quick__ic">💬</text>消息
        <text class="mn-quick__bdg" wx:if="{{noticeUnread}}">{{noticeUnread > 99 ? '99+' : noticeUnread}}</text>
      </view>
    </view>

    <view class="mn-cont">
      <view class="mn-cont__t">
        <text class="mn-cont__h">继续学习</text>
        <text class="mn-cont__a" bindtap="onGoLearnMore">全部 3 门 ›</text>
      </view>
      <view class="mn-cont__it" bindtap="onGoLearnMore">
        <image class="mn-cont__im warm-ph" src="{{learnCover || '/images/default-product.svg'}}" mode="aspectFill" />
        <view class="mn-cont__main">
          <text class="mn-cont__name">一个人的内容生意</text>
          <view class="mn-cont__pg"><view class="mn-cont__fill"></view></view>
          <text class="mn-cont__pt">第 15 / 32 讲 · 上次看到 12:40</text>
        </view>
        <text class="mn-cont__go">继续</text>
      </view>
    </view>

    <view class="mn-pl">
      <view class="mn-pl__t">
        <text class="mn-pl__h">我的星球</text>
        <text class="mn-pl__a" bindtap="onGoPlanet">管理 ›</text>
      </view>
      <view class="mn-pl__it" bindtap="onGoPlanet">
        <view class="mn-pl__lg">🪐</view>
        <view class="mn-pl__meta">
          <text class="mn-pl__name">{{planetTitle || '暖阁星球'}}</text>
          <text class="mn-pl__p">3,241 位球友 · 今日 27 条新动态</text>
        </view>
        <view class="mn-pl__rt">
          <text class="mn-pl__rb">剩余 185 天</text>
          <text class="mn-pl__rs">续费 8 折</text>
        </view>
      </view>
      <view class="mn-pl__it" bindtap="onGoPlanet">
        <view class="mn-pl__lg">✍️</view>
        <view class="mn-pl__meta">
          <text class="mn-pl__name">晨写打卡营</text>
          <text class="mn-pl__p">已打卡 42 / 90 天</text>
        </view>
        <view class="mn-pl__rt">
          <text class="mn-pl__rb">进行中</text>
          <text class="mn-pl__rs">今日未打卡</text>
        </view>
      </view>
    </view>

    <view class="mn-menu">
      <view class="mn-menu__row" bindtap="onGoAsk">
        <text class="mn-menu__ic">🙋</text>我的提问与打卡
        <text class="mn-menu__vv">4 个提问 · 已打卡 42 天</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoContribute">
        <text class="mn-menu__ic">✍️</text>成为创作者
        <text class="mn-menu__vv">投稿招募中</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoOrders">
        <text class="mn-menu__ic">🛍</text>我的订单
        <text class="mn-menu__vv">2 笔待评价</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoResources">
        <text class="mn-menu__ic">🗂</text>我的资料库
        <text class="mn-menu__vv">128 份已解锁</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoOrders">
        <text class="mn-menu__ic">🧾</text>发票管理
        <text class="mn-menu__ar">›</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoCoupons">
        <text class="mn-menu__ic">🎁</text>优惠券
        <text class="mn-menu__vv">2 张可用</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoShare">
        <text class="mn-menu__ic">🤝</text>邀请好友
        <text class="mn-menu__vv">已邀 3 人 · 得 21 天会员</text>
      </view>
    </view>

    <view class="mn-menu">
      <view class="mn-menu__row" bindtap="onGoJoin">
        <text class="mn-menu__ic">👥</text>加入读者群
        <text class="mn-menu__vv">2,860 人已加入</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoService">
        <text class="mn-menu__ic">💬</text>联系客服
        <text class="mn-menu__vv">9:00-21:00 在线</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoFeedback">
        <text class="mn-menu__ic">📮</text>意见反馈
        <text class="mn-menu__ar">›</text>
      </view>
      <view class="mn-menu__row" bindtap="onSettingsTap">
        <text class="mn-menu__ic">⚙️</text>设置
        <text class="mn-menu__ar">›</text>
      </view>
    </view>

    <view class="mn-foot">暖阁 · 慢一点，也很好<br />v1.0.0</view>
    <view class="warm-safe"></view>
  </scroll-view>

  <login-sheet id="global-login-sheet" />
</view>
