<page-meta page-style="{{themePageStyle}}" />
<view class="mn-page mn-page--{{styleKey}}">
  <scroll-view class="mn-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="mn-hero" style="padding-top: {{statusBarHeight + 10}}px;">
      <view class="mn-hero__rw">
        <view class="mn-hero__main" bindtap="onUserAreaTap">
          <view class="mn-hero__av">
            <image
              class="warm-ph mn-hero__av-img"
              src="{{displayAvatarUrl}}"
              mode="aspectFill"
              binderror="onAvatarError"
            />
          </view>
          <view class="mn-hero__meta">
            <view class="mn-hero__name warm-serif" wx:if="{{isLoggedIn}}">
              {{userInfo.nickName || '微信用户'}}
              <text class="warm-tag warm-tag--soft" wx:if="{{memberInfo.level_name}}">{{memberInfo.level_name}}</text>
            </view>
            <view class="mn-hero__name warm-serif" wx:else>点击登录</view>
            <text class="mn-hero__sb" wx:if="{{isLoggedIn}}">连续阅读 {{continuousDays}} 天 · 加入暖阁 {{joinDays}} 天</text>
            <text class="mn-hero__sb" wx:else>登录后同步收藏、会员与学习记录</text>
          </view>
        </view>
        <view
          class="mn-hero__set"
          catchtap="onSettingsTap"
          hover-class="mn-hero__set--pressed"
          hover-stay-time="80"
          aria-role="button"
          aria-label="设置"
        >⚙︎</view>
      </view>
      <view class="mn-st">
        <view wx:for="{{stats}}" wx:key="label" bindtap="{{item.label === '收藏' ? 'onGoFavorites' : ''}}">
          <text class="mn-st__b">{{item.value}}</text>
          <text class="mn-st__s">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="mn-vip" catchtap="onMemberCardTap">
      <text class="mn-vip__ic">🎫</text>
      <view class="mn-vip__tx">
        <text class="mn-vip__h">{{vipTitle || '暖阁年度会员'}}</text>
        <text class="mn-vip__p">{{vipDesc}}</text>
      </view>
      <text class="mn-vip__b">{{vipCta}}</text>
    </view>

    <view class="mn-quick">
      <view class="mn-quick__it" bindtap="onGoFavorites">
        <text class="mn-quick__ic">⭐️</text>我的收藏
      </view>
      <view class="mn-quick__it" bindtap="onGoHistory">
        <text class="mn-quick__ic">🕘</text>浏览历史
      </view>
      <view class="mn-quick__it" bindtap="onGoOrders">
        <text class="mn-quick__ic">📘</text>已购内容
      </view>
      <view class="mn-quick__it" bindtap="onNoticeTap">
        <text class="mn-quick__ic">💬</text>消息
        <text class="mn-quick__bdg" wx:if="{{noticeUnread}}">{{noticeUnread > 99 ? '99+' : noticeUnread}}</text>
      </view>
    </view>

    <view class="mn-cont">
      <view class="mn-cont__t">
        <text class="mn-cont__h">继续学习</text>
        <text class="mn-cont__a" wx:if="{{isLoggedIn && learnItem}}" bindtap="onGoLearnMore">查看 ›</text>
      </view>
      <view class="mn-cont__it" wx:if="{{isLoggedIn && learnItem}}" bindtap="onGoLearnMore">
        <image class="mn-cont__im warm-ph" src="{{learnItem.cover || '/images/default-product.svg'}}" mode="aspectFill" />
        <view class="mn-cont__main">
          <text class="mn-cont__name">{{learnItem.title}}</text>
          <text class="mn-cont__pt">已购买 · 点此继续</text>
        </view>
        <text class="mn-cont__go">继续</text>
      </view>
      <view class="mn-empty" wx:else bindtap="onGoLearnMore">
        {{isLoggedIn ? '还没有在学的课程' : '登录后同步学习进度'}}
      </view>
    </view>

    <view class="mn-pl">
      <view class="mn-pl__t">
        <text class="mn-pl__h">我的星球</text>
        <text class="mn-pl__a" bindtap="onGoPlanet">进入 ›</text>
      </view>
      <view class="mn-pl__it" wx:if="{{isLoggedIn && planetItem && planetItem.active}}" bindtap="onGoPlanet">
        <view class="mn-pl__lg">🪐</view>
        <view class="mn-pl__meta">
          <text class="mn-pl__name">{{planetItem.title || planetTitle || '暖阁星球'}}</text>
          <text class="mn-pl__p">会员有效</text>
        </view>
        <view class="mn-pl__rt" wx:if="{{planetItem.remainDays != null}}">
          <text class="mn-pl__rb">剩余 {{planetItem.remainDays}} 天</text>
        </view>
      </view>
      <view class="mn-empty" wx:else bindtap="onGoPlanet">
        {{isLoggedIn ? '尚未加入星球' : '登录后查看已加入的星球'}}
      </view>
    </view>

    <view class="mn-menu">
      <view class="mn-menu__row" bindtap="onGoAsk">
        <text class="mn-menu__ic">🙋</text>我的提问与打卡
        <text class="mn-menu__vv" wx:if="{{isLoggedIn && questionCount}}">{{questionCount}} 个提问</text>
        <text class="mn-menu__ar" wx:else>›</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoContribute">
        <text class="mn-menu__ic">✍️</text>成为创作者
        <text class="mn-menu__vv">投稿招募中</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoOrders">
        <text class="mn-menu__ic">🛍</text>我的订单
        <text class="mn-menu__vv" wx:if="{{isLoggedIn && pendingOrderCount}}">{{pendingOrderCount}} 笔待支付</text>
        <text class="mn-menu__ar" wx:else>›</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoResources">
        <text class="mn-menu__ic">🗂</text>我的资料库
        <text class="mn-menu__ar">›</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoOrders">
        <text class="mn-menu__ic">🧾</text>发票管理
        <text class="mn-menu__ar">›</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoCoupons">
        <text class="mn-menu__ic">🎁</text>优惠券
        <text class="mn-menu__vv" wx:if="{{isLoggedIn && unusedCouponCount}}">{{unusedCouponCount}} 张可用</text>
        <text class="mn-menu__ar" wx:else>›</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoShare">
        <text class="mn-menu__ic">🤝</text>邀请好友
        <text class="mn-menu__vv" wx:if="{{isLoggedIn && inviteCount}}">已邀 {{inviteCount}} 人</text>
        <text class="mn-menu__ar" wx:else>›</text>
      </view>
    </view>

    <view class="mn-menu">
      <view class="mn-menu__row" bindtap="onGoJoin">
        <text class="mn-menu__ic">👥</text>加入读者群
        <text class="mn-menu__ar">›</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoService">
        <text class="mn-menu__ic">💬</text>联系客服
        <text class="mn-menu__vv">9:00-21:00 在线</text>
      </view>
      <view class="mn-menu__row" bindtap="onGoFeedback">
        <text class="mn-menu__ic">📮</text>意见反馈
        <text class="mn-menu__ar">›</text>
      </view>
      <view class="mn-menu__row" bindtap="onSettingsTap">
        <text class="mn-menu__ic">⚙️</text>设置
        <text class="mn-menu__ar">›</text>
      </view>
    </view>

    <button class="mn-logout" wx:if="{{isLoggedIn}}" bindtap="onLogoutTap">退出登录</button>

    <view class="mn-foot">暖阁 · 慢一点，也很好<br />v1.25.1</view>
    <view class="warm-safe"></view>
  </scroll-view>

  <login-sheet id="global-login-sheet" />
</view>
