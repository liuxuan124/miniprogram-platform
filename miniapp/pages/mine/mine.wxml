<!-- pages/mine/mine.wxml — 对齐后台搭建「我的」配置 -->
<page-meta page-style="{{themePageStyle}}" />
<view class="mine-page">
  <view
    wx:if="{{showDecor}}"
    class="mine-decor mine-decor--{{styleKey}}"
    style="{{decorStyle}}"
  ></view>

  <view class="mine-body {{showDecor ? 'mine-body--decor' : ''}}" style="padding-top: {{statusBarHeight + (showDecor ? 28 : 12)}}px;">
    <!-- 头像资料行 -->
    <view class="profile-row {{showDecor ? 'profile-row--on-decor' : ''}}" bindtap="onUserAreaTap">
      <view class="user-avatar" wx:if="{{showAvatar}}">
        <image
          wx:if="{{isLoggedIn && userInfo.avatarUrl}}"
          class="user-avatar-img"
          src="{{userInfo.avatarUrl}}"
          mode="aspectFill"
        />
        <text wx:else class="user-avatar-fallback">👤</text>
      </view>
      <view class="user-info">
        <block wx:if="{{isLoggedIn}}">
          <view class="user-name-row">
            <text class="user-title">{{userInfo.nickName || '微信用户'}}</text>
            <text
              wx:if="{{mineConfig.userProfile.showMemberLevel !== false}}"
              class="user-level user-level--{{styleKey}}"
            >{{memberInfo.level_name || levelLabel}}</text>
          </view>
          <view class="user-subtitle">会员至：— · 已加入 {{continuousDays || 0}} 天</view>
        </block>
        <block wx:else>
          <view class="user-title">{{mineConfig.loginTitle || '点击登录，解锁会员权益'}}</view>
          <view class="user-subtitle" wx:if="{{mineConfig.loginSubtitle}}">{{mineConfig.loginSubtitle}}</view>
        </block>
      </view>
    </view>

    <!-- 会员中心卡片 -->
    <view
      wx:if="{{showMemberCard}}"
      class="member-card member-card--{{styleKey}}"
      style="{{memberCardStyle}}"
      bindtap="onMemberCardTap"
    >
      <view class="member-card__main">
        <view class="member-card__title">{{mineConfig.memberCardTitle || '会员中心'}}</view>
        <view
          class="member-card__level"
          wx:if="{{mineConfig.userProfile.showMemberLevel !== false}}"
        >{{isLoggedIn ? (memberInfo.level_name || levelLabel) : levelLabel}}</view>
        <view class="member-card__benefits">{{memberBenefits}}</view>
      </view>
      <button class="member-card__cta" catchtap="onLoginTap" hover-class="member-card__cta--pressed">{{memberCta}}</button>
    </view>

    <!-- 我的订单 -->
    <view class="order-card" wx:if="{{showOrderTabs}}">
      <view class="order-card__header">
        <text class="order-card__title">我的订单</text>
        <text
          wx:if="{{showAllOrdersBtn}}"
          class="order-card__all"
          bindtap="onViewAllOrders"
        >全部订单 ›</text>
      </view>
      <view class="order-tabs">
        <view
          wx:for="{{orderTabs}}"
          wx:key="key"
          class="order-tab"
          data-key="{{item.key}}"
          bindtap="onOrderTabTap"
        >
          <menu-icon wx:if="{{showMenuIcons}}" icon="{{item.icon}}" size="24" class="order-tab__icon" />
          <text wx:else class="order-tab__icon order-tab__icon--text">•</text>
          <text class="order-tab__label">{{item.label}}</text>
          <view class="order-tab__badge" wx:if="{{item.key === 'pending' && badges.pending}}">{{badges.pending}}</view>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-card" wx:if="{{menuList.length}}">
      <view
        wx:for="{{menuList}}"
        wx:key="id"
        class="menu-row"
        data-id="{{item.id}}"
        data-url="{{item.url}}"
        data-title="{{item.title}}"
        bindtap="onMenuTap"
      >
        <menu-icon wx:if="{{showMenuIcons}}" icon="{{item.icon}}" size="26" class="menu-row__icon" />
        <text class="menu-row__text">{{item.title}}</text>
        <text class="menu-row__chevron">›</text>
      </view>
    </view>

    <view class="mine-pad"></view>
  </view>

  <login-sheet id="global-login-sheet" />
</view>
