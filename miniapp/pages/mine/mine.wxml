<global-resource />
<env-badge />
<page-meta page-style="{{themePageStyle}}{{pageBackgroundColor ? ';background-color:' + pageBackgroundColor : ''}}" />
<!-- 绑定了装修页则走 DSL；未绑定（系统页）走下方内置模板 -->
<block wx:if="{{dslMode && !dslPending}}">
  <view wx:if="{{loading && !flowComponents.length}}" class="dsl-tab-page__state">加载中...</view>
  <view wx:elif="{{error}}" class="dsl-tab-page__state">{{error}}</view>
  <block wx:else>
    <view class="dsl-tab-page__body" style="background-color:{{pageBackgroundColor}};{{statusPadPx ? 'padding-top:' + statusPadPx + 'px;' : ''}}">
      <view wx:for="{{flowComponents}}" wx:key="id" class="dsl-flow {{item._stackClass}}" style="{{item.hostStyle}}">
        <dsl-renderer component="{{item}}" />
      </view>
      <view wx:if="{{!flowComponents.length && !floatComponents.length}}" class="dsl-tab-page__state">页面暂无内容</view>
    </view>
    <dsl-float-button
      wx:for="{{floatComponents}}"
      wx:key="id"
      config="{{item.props}}"
      actions="{{item.actions}}"
      styleString="{{item.styleString}}"
    />
    <login-sheet id="global-login-sheet" />
  </block>
</block>
<view wx:else class="mn-page mn-page--{{styleKey}}">
  <scroll-view class="mn-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="mn-hero" style="padding-top: {{statusBarHeight + 10}}px;">
      <view class="mn-hero__rw">
        <view class="mn-hero__main" bindtap="onUserAreaTap">
          <view class="mn-hero__av" wx:if="{{mineToggles.showAvatar}}">
            <image
              class="warm-ph mn-hero__av-img"
              src="{{displayAvatarUrl}}"
              mode="aspectFill"
              binderror="onAvatarError"
            />
          </view>
          <view class="mn-hero__meta">
            <view class="mn-hero__name warm-serif" wx:if="{{isLoggedIn}}">
              {{userInfo.nickName || '微信用户'}}
              <text
                class="warm-tag warm-tag--soft"
                wx:if="{{mineToggles.showMemberLevel && memberInfo.level_name}}"
              >{{memberInfo.level_name}}</text>
            </view>
            <view class="mn-hero__name warm-serif" wx:else>{{mineText.loginTitle}}</view>
            <text class="mn-hero__sb" wx:if="{{isLoggedIn}}">连续阅读 {{continuousDays}} 天 · 加入暖阁 {{joinDays}} 天</text>
            <text class="mn-hero__sb" wx:else>{{mineText.loginSubtitle}}</text>
          </view>
        </view>
        <view
          class="mn-hero__set"
          catchtap="onSettingsTap"
          hover-class="mn-hero__set--pressed"
          hover-stay-time="80"
          aria-role="button"
          aria-label="设置"
        >⚙︎</view>
      </view>
      <view class="mn-st">
        <view wx:for="{{stats}}" wx:key="label" bindtap="{{item.label === '收藏' ? 'onGoFavorites' : ''}}">
          <text class="mn-st__b">{{item.value}}</text>
          <text class="mn-st__s">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="mn-vip" wx:if="{{mineToggles.showMemberCard}}" catchtap="onMemberCardTap">
      <text class="mn-vip__ic">🎫</text>
      <view class="mn-vip__tx">
        <text class="mn-vip__h">{{vipTitle || '暖阁年度会员'}}</text>
        <text class="mn-vip__p">{{vipDesc}}</text>
      </view>
      <text class="mn-vip__b">{{vipCta}}</text>
    </view>

    <view class="mn-quick">
      <view class="mn-quick__it" bindtap="onGoFavorites">
        <text class="mn-quick__ic" wx:if="{{mineToggles.showMenuIcons}}">⭐️</text>我的收藏
      </view>
      <view class="mn-quick__it" bindtap="onGoHistory">
        <text class="mn-quick__ic" wx:if="{{mineToggles.showMenuIcons}}">🕘</text>浏览历史
      </view>
      <view class="mn-quick__it" bindtap="onGoLibrary">
        <text class="mn-quick__ic" wx:if="{{mineToggles.showMenuIcons}}">📘</text>已购内容
      </view>
      <view class="mn-quick__it" bindtap="onNoticeTap">
        <text class="mn-quick__ic" wx:if="{{mineToggles.showMenuIcons}}">💬</text>消息
        <text class="mn-quick__bdg" wx:if="{{noticeUnread}}">{{noticeUnread > 99 ? '99+' : noticeUnread}}</text>
      </view>
    </view>

    <view class="mn-cont">
      <view class="mn-cont__t">
        <text class="mn-cont__h">继续学习</text>
        <text class="mn-cont__a" wx:if="{{isLoggedIn && learnItem}}" bindtap="onGoLearnMore">查看 ›</text>
      </view>
      <view class="mn-cont__it" wx:if="{{isLoggedIn && learnItem}}" bindtap="onGoLearnMore">
        <image class="mn-cont__im warm-ph" src="{{learnItem.cover || '/images/default-product.png'}}" mode="aspectFill" />
        <view class="mn-cont__main">
          <text class="mn-cont__name">{{learnItem.title}}</text>
          <text class="mn-cont__pt">已购买 · 点此继续</text>
        </view>
        <text class="mn-cont__go">继续</text>
      </view>
      <view class="mn-empty" wx:else bindtap="onGoLearnMore">
        {{isLoggedIn ? '还没有在学的课程' : '登录后同步学习进度'}}
      </view>
    </view>

    <view class="mn-pl">
      <view class="mn-pl__t">
        <text class="mn-pl__h">我的星球</text>
        <text class="mn-pl__a" bindtap="onGoPlanet">进入 ›</text>
      </view>
      <view class="mn-pl__it" wx:if="{{isLoggedIn && planetItem && planetItem.active}}" bindtap="onGoPlanet">
        <view class="mn-pl__lg">🪐</view>
        <view class="mn-pl__meta">
          <text class="mn-pl__name">{{planetItem.title || planetTitle || '暖阁星球'}}</text>
          <text class="mn-pl__p">本星球会员有效</text>
        </view>
        <view class="mn-pl__rt" wx:if="{{planetItem.remainDays != null}}">
          <text class="mn-pl__rb">剩余 {{planetItem.remainDays}} 天</text>
        </view>
      </view>
      <view class="mn-empty" wx:else bindtap="onGoPlanet">
        {{isLoggedIn ? '尚未开通本星球会员' : '登录后查看已加入的星球'}}
      </view>
    </view>

    <view
      class="mn-menu"
      wx:for="{{menuGroups}}"
      wx:for-item="group"
      wx:key="name"
    >
      <view
        class="mn-menu__row"
        wx:for="{{group.items}}"
        wx:for-item="item"
        wx:key="id"
        bindtap="onMenuRowTap"
        data-url="{{item.url}}"
        data-login="{{item.needLogin ? 1 : 0}}"
        data-title="{{item.title}}"
        hover-class="mn-menu__row--pressed"
        hover-stay-time="80"
        aria-role="button"
        aria-label="{{item.title}}"
      >
        <text class="mn-menu__ic" wx:if="{{mineToggles.showMenuIcons}}">{{item.iconText}}</text>{{item.title}}
        <text class="mn-menu__vv" wx:if="{{item.hint}}">{{item.hint}}</text>
        <text class="mn-menu__ar" wx:else>›</text>
      </view>
    </view>

    <button class="mn-logout" wx:if="{{isLoggedIn}}" bindtap="onLogoutTap">退出登录</button>

    <view class="mn-foot">暖阁 · 慢一点，也很好<br />v1.25.1</view>
    <view class="warm-safe"></view>
  </scroll-view>

  <login-sheet id="global-login-sheet" />
</view>
