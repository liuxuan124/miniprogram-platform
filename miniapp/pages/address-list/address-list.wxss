.page { min-height: 100vh; background: #fafafa; padding: 32rpx; box-sizing: border-box; }
.tip {
  background: #f3f3f3; color: #555555; font-size: 24rpx; line-height: 1.6;
  padding: 20rpx 24rpx; border-radius: 16rpx; margin-bottom: 24rpx;
}
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; border: 1rpx solid #eeeeee; }
.name { font-size: 30rpx; font-weight: 500; color: #111111; }
.detail { margin-top: 12rpx; font-size: 24rpx; color: #888888; line-height: 1.6; }
.empty { text-align: center; color: #999999; font-size: 26rpx; padding: 80rpx 0 40rpx; }
.btn {
  margin-top: 16rpx; background: #111111; color: #fff; border-radius: 999rpx;
  font-size: 28rpx; font-weight: 500;
}
.btn-ghost { background: #fff; color: #111111; border: 1rpx solid #111111; }
