<!-- pages/product-detail/product-detail.wxml — 商品详情页 -->
<view class="product-detail-page" wx:if="{{!loading}}">
  <!-- 图片轮播 -->
  <swiper
    class="detail-swiper"
    indicator-dots="{{product.images.length > 1}}"
    indicator-active-color="#fff"
    autoplay="{{true}}"
    circular="{{true}}"
    current="{{swiperCurrent}}"
    bindchange="onSwiperChange"
  >
    <swiper-item
      wx:for="{{product.images}}"
      wx:key="index"
    >
      <image
        class="swiper-image"
        src="{{item}}"
        mode="aspectFill"
        data-src="{{item}}"
        bindtap="onImagePreview"
      />
    </swiper-item>
  </swiper>

  <!-- 价格与标题 -->
  <view class="detail-header">
    <view class="price-row">
      <text class="price-symbol">&#165;</text>
      <text class="price-value">{{selectedSku ? selectedSku.price : product.price}}</text>
      <text class="original-price" wx:if="{{product.original_price}}">&#165;{{product.original_price}}</text>
    </view>
    <text class="product-title">{{product.name}}</text>
    <view class="product-meta">
      <text class="meta-item" wx:if="{{product.sales}}">已售 {{product.sales}}</text>
      <text class="meta-item" wx:if="{{product.stock !== undefined}}">库存 {{stock}}</text>
    </view>
  </view>

  <!-- 规格 / 优惠 / 服务 -->
  <view class="pick-rows">
    <view class="pick" bindtap="onBuyNowTap">
      <text class="k">规格</text>
      <text class="v">{{selectedSku ? (selectedSku.skuName || selectedSku.name || '已选') : '请选择版本'}}</text>
      <text class="ar">›</text>
    </view>
    <view class="pick" bindtap="onCouponEntry">
      <text class="k">优惠券</text>
      <text class="v">满减可用</text>
      <text class="ar">›</text>
    </view>
    <view class="pick">
      <text class="k">服务</text>
      <text class="v">{{isDigital ? '虚拟发货 · 订单可查' : (isService ? '开始前24h可改期' : '售后保障')}}</text>
      <text class="ar">›</text>
    </view>
  </view>

  <view class="author-card">
    <view class="av">🧭</view>
    <view class="info">
      <view class="nm">出海笔记 · 阿哲 <text class="vf">已认证</text></view>
      <view class="bio">跨境电商实战 · 选品 / 供应链 / 独立站</view>
    </view>
  </view>

  <view class="detail-section" wx:if="{{gains.length}}">
    <view class="section-title">你将获得</view>
    <view wx:for="{{gains}}" wx:key="*this" class="bullet">· {{item}}</view>
  </view>

  <view class="detail-section" wx:if="{{whoFor}}">
    <view class="section-title">适合谁</view>
    <view class="text-content">{{whoFor}}</view>
  </view>

  <!-- 商品详情（富文本） -->
  <view class="detail-section">
    <view class="section-title">{{isDigital ? '资料介绍' : (isService ? '服务说明' : '商品详情')}}</view>
    <rich-text wx:if="{{richContent}}" nodes="{{richContent}}" class="rich-content"></rich-text>
    <view wx:else class="text-content">
      <text>{{product.description || '暂无详情'}}</text>
    </view>
  </view>

  <view class="detail-section" wx:if="{{faqs.length}}">
    <view class="section-title">常见问题</view>
    <view wx:for="{{faqs}}" wx:key="q" class="faq">
      <view class="q">Q：{{item.q}}</view>
      <view class="a">A：{{item.a}}</view>
    </view>
  </view>

  <!-- 评价入口 -->
  <view class="review-entry" bindtap="onReviewsTap">
    <view class="review-entry__l">
      <text class="review-entry__t">用户评价</text>
      <text class="review-entry__s">{{reviewScore || '4.9'}} 分 · {{reviewCount || 0}} 条</text>
    </view>
    <text class="review-entry__ar">全部 ›</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-bar__icon" bindtap="onServiceTap">
      <text class="bottom-bar__icon-emoji">💬</text>
      <text class="bottom-bar__icon-text">客服</text>
    </view>
    <view class="bottom-bar__icon" wx:if="{{!isDigital && !isService}}" bindtap="onAddCartTap">
      <image class="bottom-bar__icon-img" src="/images/icon-cart.svg" mode="aspectFit" />
      <text class="bottom-bar__icon-text">购物车</text>
    </view>
    <view
      class="bottom-bar__btn bottom-bar__btn--cart"
      wx:if="{{isService}}"
      bindtap="onBookTap"
    >选时段预约</view>
    <view
      class="bottom-bar__btn bottom-bar__btn--cart"
      wx:elif="{{!isDigital}}"
      bindtap="onAddCartTap"
    >加入购物车</view>
    <view class="bottom-bar__btn bottom-bar__btn--buy" bindtap="onBuyNowTap">
      {{isDigital ? '立即购买' : (isService ? '立即下单' : '立即购买')}}
    </view>
  </view>

  <sku-sheet
    show="{{showSkuPanel}}"
    image="{{product.images[0] || product.image}}"
    price="{{selectedSku ? selectedSku.price : product.price}}"
    stock="{{stock}}"
    groups="{{product.specList}}"
    selectedMap="{{selectedSkuValues}}"
    selectedLabel="{{selectedSku ? (selectedSku.name || selectedSku.skuName || '') : ''}}"
    quantity="{{quantity}}"
    mode="{{skuMode}}"
    bind:close="onSkuPanelClose"
    bind:pick="onSkuSheetPick"
    bind:qty="onSkuSheetQty"
    bind:cart="onSkuSheetCart"
    bind:buy="onSkuSheetBuy"
  />
</view>
<login-sheet id="global-login-sheet" />

<!-- 加载状态 -->
<view class="loading-page" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
