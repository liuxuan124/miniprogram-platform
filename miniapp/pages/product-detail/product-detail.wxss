/* pages/product-detail/product-detail.wxss — 商品详情页样式 */

.product-detail-page {
  min-height: 100vh;
  background: var(--bg);
  /* 预留贴底操作栏高度，避免正文被挡住 */
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ========== 轮播图 ========== */
.detail-swiper-wrap {
  width: 100%;
  height: 650rpx;
  background: #e8eef8;
  overflow: hidden;
  flex-shrink: 0;
}

.detail-swiper {
  width: 100%;
  height: 650rpx;
}

.swiper-image {
  width: 100%;
  height: 650rpx;
  display: block;
  background: #e8eef8;
}

.swiper-placeholder {
  width: 100%;
  height: 650rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #e8eef8;
  color: #98a2b5;
}

.swiper-placeholder__icon {
  font-size: 64rpx;
  line-height: 1.2;
}

.swiper-placeholder__text {
  margin-top: 12rpx;
  font-size: 24rpx;
}

/* ========== 价格与标题 ========== */
.detail-header {
  position: relative;
  z-index: 2;
  margin: -30rpx 24rpx 18rpx;
  padding: 28rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--sh1);
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: #f05b45;
  font-weight: 700;
}

.price-value {
  font-size: 48rpx;
  color: #f05b45;
  font-weight: 700;
  margin-left: 4rpx;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 16rpx;
}

.coupon-price-tag {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #f05b45;
  background: rgba(240, 91, 69, 0.1);
  border-radius: 6rpx;
  font-weight: 600;
  align-self: center;
}

.product-title {
  font-size: 32rpx;
  color: var(--ink);
  font-weight: 700;
  line-height: 1.5;
}

.product-meta {
  display: flex;
  margin-top: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
  margin-right: 24rpx;
}

/* ========== 规格入口 ========== */
.spec-entry {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.spec-label {
  font-size: 28rpx;
  color: #999;
  margin-right: 16rpx;
}

.spec-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.spec-arrow {
  font-size: 24rpx;
  color: #ccc;
}

.pick-rows { margin:0 24rpx 18rpx; overflow:hidden; background:#fff; border:1rpx solid var(--line); border-radius:26rpx; box-shadow:var(--sh1); }
.pick { display:flex; align-items:center; padding:25rpx 26rpx; border-bottom:1rpx solid var(--line-2); font-size:25rpx; }
.pick .k { width:100rpx; color:#727a8c; }
.pick .v { flex:1; color:#0f1219; font-weight:500; }
.pick .v--coupon { color:#f05b45; }
.pick .ar { color:#a5abb9; }
.author-card {
  display:flex; gap:20rpx; align-items:center; margin:0 24rpx 18rpx; padding:26rpx; background:#fff; border:1rpx solid var(--line); border-radius:26rpx; box-shadow:var(--sh1);
}
.author-card .av {
  width:88rpx; height:88rpx; border-radius:50%; background:linear-gradient(145deg,#6d8cff,#2f5bff);
  color:#fff; display:flex; align-items:center; justify-content:center; font-size:36rpx;
}
.author-card .nm { font-size:30rpx; font-weight:700; }
.author-card .vf { font-size:20rpx; color:#2f5bff; background:#eef2ff; padding:2rpx 10rpx; border-radius:8rpx; margin-left:8rpx; }
.author-card .bio { margin-top:8rpx; font-size:22rpx; color:#a5abb9; }
.bullet { font-size:28rpx; color:#39404f; line-height:1.8; padding:4rpx 0; }
.faq { padding:16rpx 0; border-bottom:1rpx solid #f5f6f9; }
.faq .q { font-size:28rpx; font-weight:600; color:#0f1219; }
.faq .a { margin-top:10rpx; font-size:26rpx; color:#727a8c; line-height:1.7; }

/* ========== 商品详情 ========== */
.detail-section {
  margin: 0 24rpx 18rpx;
  padding: 30rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  box-shadow: var(--sh1);
}

.review-entry {
  margin: 0 24rpx 18rpx;
  background: #fff;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  box-shadow: var(--sh1);
}
.review-entry__t { font-size: 30rpx; font-weight: 700; color: #0f1219; }
.review-entry__s { display: block; margin-top: 8rpx; font-size: 24rpx; color: #a5abb9; }
.review-entry__ar { color: #2f5bff; font-size: 26rpx; font-weight: 600; }

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.rich-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 详情长图拼图：去掉图间距与行内空隙 */
.rich-content image,
.rich-content img {
  display: block !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  vertical-align: top;
}

.text-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* ========== 底部操作栏（贴底固定，不随页面滚动） ========== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  min-height: 104rpx;
  background-color: #fff;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  border-radius: 0;
  box-shadow: 0 -8rpx 24rpx rgba(30, 49, 91, 0.08);
  z-index: 100;
  box-sizing: border-box;
}

.bottom-bar__icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  padding: 0 12rpx;
}

.bottom-bar__icon-img {
  width: 44rpx;
  height: 44rpx;
}
.bottom-bar__icon-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.bottom-bar__icon-text {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

.bottom-bar__btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-left: 12rpx;
}

.bottom-bar__btn--cart {
  color: var(--brand);
  background: var(--brand-soft);
}

.bottom-bar__btn--buy {
  color: #fff;
  background: linear-gradient(135deg, var(--brand), #6386ff);
  box-shadow: 0 9rpx 20rpx rgba(49, 94, 251, 0.2);
}

/* ========== SKU 弹窗 ========== */
.sku-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.sku-panel {
  width: 100%;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.sku-panel__header {
  display: flex;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.sku-panel__image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.sku-panel__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.sku-panel__price {
  font-size: 40rpx;
  color: #ff4d4f;
  font-weight: 700;
}

.sku-panel__stock {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.sku-panel__selected {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.sku-panel__close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
}

.sku-panel__body {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 50vh;
}

.spec-group {
  margin-bottom: 32rpx;
}

.spec-group__name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.spec-group__values {
  display: flex;
  flex-wrap: wrap;
}

.spec-value-tag {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333;
  background-color: #f5f5f5;
  border: 2rpx solid transparent;
}

.spec-value-tag.active {
  color: #ff4d4f;
  background-color: #fff1f0;
  border-color: #ff4d4f;
}

/* 数量选择 */
.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.quantity-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333;
  background-color: #f5f5f5;
}

.quantity-btn.disabled {
  color: #ccc;
}

.quantity-input {
  width: 80rpx;
  height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  margin: 0 8rpx;
}

.sku-panel__footer {
  padding: 16rpx 32rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.sku-confirm-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.sku-confirm-btn.cart {
  background-color: #ffa940;
}

.sku-confirm-btn.buy {
  background-color: #ff4d4f;
}

/* D4：提交中态，防止重复点击造成的误解 */
.sku-confirm-btn.is-submitting {
  opacity: 0.6;
  pointer-events: none;
}

/* ========== 加载 ========== */
.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999;
}

/* ========== 服务说明弹层 ========== */
.svc-mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 13, 20, 0.45);
  z-index: 180;
}
.svc-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 181;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.svc-sheet__handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e5e7eb;
  margin: 16rpx auto 0;
}
.svc-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
}
.svc-sheet__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
}
.svc-sheet__close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}
.svc-sheet__body {
  max-height: 55vh;
  padding: 0 32rpx 32rpx;
  box-sizing: border-box;
}
.svc-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.svc-item__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.svc-item__icon { font-size: 28rpx; }
.svc-item__title { font-size: 28rpx; font-weight: 600; color: #222; }
.svc-item__desc { font-size: 24rpx; color: #666; line-height: 1.6; }
.svc-item__rules { margin-top: 8rpx; }
.svc-rule { display: block; font-size: 22rpx; color: #999; line-height: 1.6; }
.svc-foot {
  margin-top: 24rpx;
  padding-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.svc-foot__text { font-size: 22rpx; color: #999; }
.svc-foot__btn {
  height: 72rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  background: var(--brand, #315efb);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
